{%- render 'section-spacing-collapsing' -%}

{%- capture trustpilot_star_icon -%}
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M8 1.166l1.905 3.859 4.26.62-3.082 3.004.728 4.241L8 10.886l-3.811 2.004.729-4.241L1.835 5.645l4.26-.62L8 1.166Z" fill="currentColor"></path>
  </svg>
{%- endcapture -%}

<style>
  #shopify-section-{{ section.id }} {
    --customer-proof-bg: {{ section.settings.background.rgb }};
    --customer-proof-card-bg: {{ section.settings.card_background.rgb }};
    --customer-proof-heading: {{ section.settings.heading_color.rgb }};
    --customer-proof-text: {{ section.settings.text_color.rgb }};
    --customer-proof-muted: {{ section.settings.muted_color.rgb }};
    --customer-proof-green: {{ section.settings.brand_green.rgb }};
    --customer-proof-green-dark: {{ section.settings.brand_green_dark.rgb }};
    --customer-proof-star-empty: {{ section.settings.star_empty_color.rgb }};
    --customer-proof-quote: {{ section.settings.quote_color.rgb }};
    --customer-proof-shadow: {{ section.settings.shadow_color.rgb }};
    --customer-proof-card-radius: {{ section.settings.card_radius }}px;
    --customer-proof-card-gap: {{ section.settings.card_gap }}px;
    --customer-proof-section-space: {{ section.settings.section_spacing }}px;
    --customer-proof-heading-max: {{ section.settings.heading_max_width }}px;
    --customer-proof-mobile-card-width: {{ section.settings.mobile_card_width }}px;
    --customer-proof-rating-fill: {{ section.settings.rating_fill_percent }}%;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall {
    background: rgb(var(--customer-proof-bg));
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__shell {
    padding-block: clamp(16px, var(--customer-proof-section-space), 24px);
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__layout {
    display: grid;
    gap: clamp(24px, 4vw, 40px);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__intro {
    max-width: min(100%, var(--customer-proof-heading-max));
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating-strip {
    display: inline-flex;
    gap: 3px;
    align-items: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating-box {
    width: 39px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--customer-proof-green));
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating-box svg,
  #shopify-section-{{ section.id }} .customer-proof-wall__card-star svg,
  #shopify-section-{{ section.id }} .customer-proof-wall__brand-star svg {
    width: 17px;
    height: 17px;
    display: block;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating-box--partial {
    background: linear-gradient(90deg, rgb(var(--customer-proof-green)) var(--customer-proof-rating-fill), rgb(var(--customer-proof-star-empty)) var(--customer-proof-rating-fill));
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating-copy {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 10px;
    color: rgb(var(--customer-proof-text));
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.42;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating-count {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rating-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__brand-star {
    display: inline-flex;
    color: rgb(var(--customer-proof-green));
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__headline {
    margin: 28px 0 0;
    max-width: min(100%, var(--customer-proof-heading-max));
    color: rgb(var(--customer-proof-heading));
    font-size: clamp(42px, 5.6vw, 56px);
    line-height: 0.92;
    letter-spacing: -0.065em;
    font-weight: 800;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__lede {
    max-width: 18ch;
    margin-top: 24px;
    color: rgb(var(--customer-proof-text));
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.48;
    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__lede p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__feed {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rail {
    display: flex;
    gap: var(--customer-proof-card-gap);
    overflow-x: auto;
    overflow-y: hidden;
    margin-inline: -20px;
    padding: 0 20px 10px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__rail::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card {
    position: relative;
    width: min(var(--customer-proof-mobile-card-width), calc(100vw - 76px));
    min-width: min(var(--customer-proof-mobile-card-width), calc(100vw - 76px));
    padding: 30px 30px 28px;
    border-radius: var(--customer-proof-card-radius);
    background: rgb(var(--customer-proof-card-bg));
    box-shadow: 0 24px 60px rgba(var(--customer-proof-shadow), 0.08);
    color: rgb(var(--customer-proof-heading));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    break-inside: avoid;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__quote {
    color: rgb(var(--customer-proof-quote));
    font-size: 74px;
    line-height: 0.7;
    font-weight: 700;
    letter-spacing: -0.08em;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-wrap: nowrap;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-star {
    width: 40px;
    height: 31px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--customer-proof-green));
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-star.is-empty {
    background: rgb(var(--customer-proof-star-empty));
    color: rgba(255, 255, 255, 0.92);
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-title {
    margin: 34px 0 0;
    color: rgb(var(--customer-proof-heading));
    font-size: clamp(30px, 4.5vw, 38px);
    line-height: 1.06;
    letter-spacing: -0.045em;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-body {
    margin-top: 28px;
    color: rgb(var(--customer-proof-text));
    font-size: clamp(17px, 2.3vw, 22px);
    line-height: 1.56;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-footer {
    margin-top: 26px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    color: rgb(var(--customer-proof-heading));
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-author {
    font-size: clamp(17px, 2.4vw, 22px);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__card-date {
    font-size: clamp(17px, 2.2vw, 21px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__dots {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 26px;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__dot {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 999px;
    background: rgba(var(--customer-proof-heading), 0.18);
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .customer-proof-wall__dot.is-active {
    background: rgb(var(--customer-proof-heading));
    transform: scale(1.02);
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .customer-proof-wall__rating {
      gap: 14px 18px;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__rating-box {
      width: 42px;
      height: 32px;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__headline {
      margin-top: 24px;
      font-size: clamp(32px, 9vw, 56px);
      line-height: 0.94;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__lede {
      max-width: 15ch;
      margin-top: 38px;
      font-size: 24px;
      line-height: 1.7;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .customer-proof-wall__shell {
      padding-block: clamp(16px, var(--customer-proof-section-space), 24px);
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__layout {
      grid-template-columns: minmax(300px, 0.92fr) minmax(0, 1.18fr);
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__intro {
      position: sticky;
      top: 24px;
      padding-top: 24px;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__headline {
      font-size: clamp(48px, 5vw, 56px);
      max-width: 8.4ch;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__lede {
      max-width: 16ch;
      margin-top: 24px;
      font-size: 24px;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__rail {
      display: block;
      column-count: 3;
      column-gap: var(--customer-proof-card-gap);
      overflow: visible;
      margin: 0;
      padding: 0;
      scroll-snap-type: none;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__card {
      width: auto;
      min-width: 0;
      margin: 0 0 var(--customer-proof-card-gap);
      padding: 34px 34px 30px;
      border-radius: 28px;
      box-shadow: none;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__card:first-child {
      margin-top: 36px;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__card:nth-child(2) {
      margin-top: 14px;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__card:nth-child(3) {
      margin-top: -18px;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__card-title {
      font-size: clamp(26px, 2vw, 34px);
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__card-body {
      font-size: 18px;
      -webkit-line-clamp: 5;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__card-author,
    #shopify-section-{{ section.id }} .customer-proof-wall__card-date {
      font-size: 17px;
    }

    #shopify-section-{{ section.id }} .customer-proof-wall__dots {
      display: none;
    }
  }
</style>

<section class="customer-proof-wall">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.text_color %}>
    <div class="container customer-proof-wall__shell" data-review-wall="{{ section.id }}">
      <div class="customer-proof-wall__layout">
        <div class="customer-proof-wall__intro">
          <div class="customer-proof-wall__rating" aria-label="{{ section.settings.average_rating_label | escape }} op {{ section.settings.review_source_label | escape }}">
            <div class="customer-proof-wall__rating-strip" aria-hidden="true">
              <span class="customer-proof-wall__rating-box">{{ trustpilot_star_icon }}</span>
              <span class="customer-proof-wall__rating-box">{{ trustpilot_star_icon }}</span>
              <span class="customer-proof-wall__rating-box">{{ trustpilot_star_icon }}</span>
              <span class="customer-proof-wall__rating-box">{{ trustpilot_star_icon }}</span>
              <span class="customer-proof-wall__rating-box customer-proof-wall__rating-box--partial">{{ trustpilot_star_icon }}</span>
            </div>

            <div class="customer-proof-wall__rating-copy">
              <span class="customer-proof-wall__rating-count">{{ section.settings.review_count | escape }}</span>
              <span>{{ section.settings.review_count_suffix | escape }}</span>
              <span>{{ section.settings.review_source_prefix | escape }}</span>
              <span class="customer-proof-wall__rating-brand">
                <span class="customer-proof-wall__brand-star">{{ trustpilot_star_icon }}</span>
                <span>{{ section.settings.review_source_label | escape }}</span>
              </span>
            </div>
          </div>

          {%- if section.settings.heading != blank -%}
            <h2 class="customer-proof-wall__headline">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.lede != blank -%}
            <div class="customer-proof-wall__lede rte">
              {{ section.settings.lede }}
            </div>
          {%- endif -%}
        </div>

        <div class="customer-proof-wall__feed">
          <div class="customer-proof-wall__rail" data-review-rail role="list" aria-label="Klantreviews">
            {%- for block in section.blocks -%}
              <article class="customer-proof-wall__card" data-review-card data-review-index="{{ forloop.index0 }}" role="listitem" {{ block.shopify_attributes }}>
                <div class="customer-proof-wall__card-top">
                  <span class="customer-proof-wall__quote" aria-hidden="true">“</span>

                  <div class="customer-proof-wall__card-stars" aria-label="{{ block.settings.rating }} van 5 sterren">
                    {%- for i in (1..5) -%}
                      <span class="customer-proof-wall__card-star{% if i > block.settings.rating %} is-empty{% endif %}">{{ trustpilot_star_icon }}</span>
                    {%- endfor -%}
                  </div>
                </div>

                <h3 class="customer-proof-wall__card-title">{{ block.settings.title | escape }}</h3>

                <div class="customer-proof-wall__card-body">{{ block.settings.body | escape | newline_to_br }}</div>

                <div class="customer-proof-wall__card-footer">
                  <span class="customer-proof-wall__card-author">{{ block.settings.author | escape }}</span>
                  <span class="customer-proof-wall__card-date">{{ block.settings.relative_date | escape }}</span>
                </div>
              </article>
            {%- endfor -%}
          </div>

          {%- if section.blocks.size > 1 -%}
            <div class="customer-proof-wall__dots" aria-label="Review navigatie">
              {%- for block in section.blocks -%}
                <button
                  class="customer-proof-wall__dot{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-review-dot="{{ forloop.index0 }}"
                  aria-label="Ga naar review {{ forloop.index }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector('[data-review-wall="{{ section.id }}"]');
      if (!root) return;

      const rail = root.querySelector('[data-review-rail]');
      const cards = Array.from(root.querySelectorAll('[data-review-card]'));
      const dots = Array.from(root.querySelectorAll('[data-review-dot]'));
      if (!rail || cards.length === 0 || dots.length === 0) return;

      const mobileQuery = window.matchMedia('(max-width: 989px)');

      const setActiveDot = (activeIndex) => {
        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          if (isActive) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      };

      const syncActiveDot = () => {
        if (!mobileQuery.matches) return;

        const railLeft = rail.getBoundingClientRect().left;
        let activeIndex = 0;
        let smallestDelta = Number.POSITIVE_INFINITY;

        cards.forEach((card, index) => {
          const delta = Math.abs(card.getBoundingClientRect().left - railLeft - 20);
          if (delta < smallestDelta) {
            smallestDelta = delta;
            activeIndex = index;
          }
        });

        setActiveDot(activeIndex);
      };

      let ticking = false;
      rail.addEventListener(
        'scroll',
        () => {
          if (!mobileQuery.matches || ticking) return;
          ticking = true;
          window.requestAnimationFrame(() => {
            syncActiveDot();
            ticking = false;
          });
        },
        { passive: true }
      );

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const index = Number(dot.getAttribute('data-review-dot'));
          const card = cards[index];
          if (!card) return;

          rail.scrollTo({
            left: card.offsetLeft - 20,
            behavior: 'smooth'
          });

          setActiveDot(index);
        });
      });

      syncActiveDot();
      mobileQuery.addEventListener('change', syncActiveDot);
    })();
  </script>
</section>

