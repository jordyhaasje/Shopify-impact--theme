{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --gz-bg: {{ section.settings.background_color }};
    --gz-card: {{ section.settings.card_color }};
    --gz-text: {{ section.settings.text_color }};
    --gz-muted: {{ section.settings.muted_text_color }};
    --gz-accent: {{ section.settings.accent_color }};
    --gz-star: {{ section.settings.star_color }};
    --gz-cream: #fbf8f4;
    --gz-soft: #f5eee9;
    --gz-border: rgba(59, 20, 36, .095);
    --gz-border-light: rgba(59, 20, 36, .06);
    --gz-shadow: 0 24px 70px rgba(41, 27, 24, .075);
  }

  #shopify-section-{{ section.id }} .gz {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--gz-text);
    background:
      linear-gradient(180deg, #fff 0%, var(--gz-cream) 50%, #fff 100%);
  }

  #shopify-section-{{ section.id }} .gz::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 22%, color-mix(in srgb, var(--gz-accent) 8%, transparent), transparent 30%),
      radial-gradient(circle at 84% 14%, rgba(255,255,255,.92), transparent 28%);
    opacity: .8;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .gz__shell {
    max-width: {{ section.settings.content_width }}px;
    margin-inline: auto;
    padding: {{ section.settings.padding_y }}px 20px;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .gz__header {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(260px, .58fr);
    gap: clamp(26px, 5vw, 74px);
    align-items: end;
    padding-bottom: clamp(28px, 4vw, 46px);
    border-bottom: 1px solid var(--gz-border-light);
  }

  #shopify-section-{{ section.id }} .gz__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: color-mix(in srgb, var(--gz-text) 62%, var(--gz-accent));
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gz__eyebrow::before {
    content: '';
    width: 34px;
    height: 1px;
    background: color-mix(in srgb, var(--gz-accent) 45%, var(--gz-text));
    opacity: .55;
  }

  #shopify-section-{{ section.id }} .gz__title {
    margin: 18px 0 0;
    max-width: 760px;
    font-family: var(--heading-font-family);
    font-size: clamp(40px, 6.2vw, 78px);
    line-height: .92;
    letter-spacing: -.062em;
    color: var(--gz-text);
  }

  #shopify-section-{{ section.id }} .gz__title span {
    color: color-mix(in srgb, var(--gz-accent) 56%, var(--gz-text));
    font-style: italic;
    font-weight: inherit;
  }

  #shopify-section-{{ section.id }} .gz__text {
    color: color-mix(in srgb, var(--gz-muted) 82%, var(--gz-text));
    font-size: clamp(15px, 1.35vw, 17px);
    line-height: 1.8;
    max-width: 390px;
    justify-self: end;
  }

  #shopify-section-{{ section.id }} .gz__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0 24px;
  }

  #shopify-section-{{ section.id }} .gz__rating-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 11px;
    color: var(--gz-muted);
    font-size: 13px;
    letter-spacing: .02em;
  }

  #shopify-section-{{ section.id }} .gz__rating-stars {
    color: color-mix(in srgb, var(--gz-star) 74%, #9b705f);
    letter-spacing: .08em;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .gz__hint {
    color: color-mix(in srgb, var(--gz-muted) 75%, var(--gz-text));
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gz__reviews-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .gz__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 2px 22px;
  }

  #shopify-section-{{ section.id }} .gz__track::-webkit-scrollbar { display: none; }

  #shopify-section-{{ section.id }} .gz-card {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - 36px) / 3);
    min-height: 276px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(22px, 2.5vw, 30px);
    border-radius: 4px;
    border: 1px solid var(--gz-border);
    background: color-mix(in srgb, var(--gz-card) 82%, #fbf8f4);
    box-shadow: 0 14px 34px rgba(41,27,24,.04);
    position: relative;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  #shopify-section-{{ section.id }} .gz-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--gz-shadow);
    border-color: color-mix(in srgb, var(--gz-accent) 16%, var(--gz-border));
  }

  #shopify-section-{{ section.id }} .gz-card__stars {
    display: inline-flex;
    gap: 3px;
    color: color-mix(in srgb, var(--gz-star) 72%, #9b705f);
    font-size: {{ section.settings.star_size }}px;
    letter-spacing: .02em;
  }

  #shopify-section-{{ section.id }} .gz-card__quote {
    margin: 0;
    color: var(--gz-text);
    font-family: var(--heading-font-family);
    font-size: clamp(18px, 1.8vw, 25px);
    line-height: 1.28;
    letter-spacing: -.035em;
  }

  #shopify-section-{{ section.id }} .gz-card__meta {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-top: 18px;
    border-top: 1px solid var(--gz-border-light);
  }

  #shopify-section-{{ section.id }} .gz-card__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--gz-text);
    font-size: 13px;
    font-weight: 850;
    background: linear-gradient(135deg, #fff, var(--gz-soft));
    border: 1px solid rgba(59,20,36,.11);
  }

  #shopify-section-{{ section.id }} .gz-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .gz-card__name {
    color: var(--gz-text);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -.01em;
  }

  #shopify-section-{{ section.id }} .gz-card__label {
    margin-top: 2px;
    color: var(--gz-muted);
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .gz__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .gz__btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--gz-border);
    background: rgba(255,255,255,.62);
    color: var(--gz-text);
    display: grid;
    place-items: center;
    cursor: pointer;
    opacity: .72;
    transition: opacity .2s ease, background .2s ease, transform .2s ease;
  }

  #shopify-section-{{ section.id }} .gz__btn:hover {
    opacity: 1;
    background: #fff;
    transform: translateY(-1px);
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .gz__controls { margin-top: -4px; }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gz__header {
      grid-template-columns: 1fr;
      gap: 18px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .gz__eyebrow { justify-content: center; }
    #shopify-section-{{ section.id }} .gz__eyebrow::after { content: ''; width: 34px; height: 1px; background: color-mix(in srgb, var(--gz-accent) 45%, var(--gz-text)); opacity: .55; }
    #shopify-section-{{ section.id }} .gz__text { justify-self: center; margin-inline: auto; }
    #shopify-section-{{ section.id }} .gz-card { flex-basis: calc((100% - 18px) / 2); }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .gz__shell {
      padding: {{ section.settings.mobile_padding_y }}px 16px;
    }

    #shopify-section-{{ section.id }} .gz__header {
      padding-bottom: 26px;
    }

    #shopify-section-{{ section.id }} .gz__title {
      font-size: clamp(36px, 12vw, 54px);
      line-height: .94;
    }

    #shopify-section-{{ section.id }} .gz__summary {
      align-items: flex-start;
      padding: 18px 0 18px;
    }

    #shopify-section-{{ section.id }} .gz__hint {
      display: none;
    }

    #shopify-section-{{ section.id }} .gz__track {
      gap: 12px;
      padding-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .gz-card {
      flex-basis: 86%;
      min-height: 260px;
      padding: 22px;
    }

    #shopify-section-{{ section.id }} .gz-card__quote {
      font-size: 21px;
    }

    #shopify-section-{{ section.id }} .gz__controls {
      justify-content: center;
    }
  }
</style>

<section class="gz" data-glozzy-reviews data-section-id="{{ section.id }}">
  <div class="gz__shell" data-section-bounded-shell>
    <div class="gz__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="gz__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="gz__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.text != blank -%}
        <div class="gz__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="gz__summary">
      <div class="gz__rating-line">
        <span class="gz__rating-stars" aria-hidden="true">★★★★★</span>
        <span>Customer notes from the Glozzy community</span>
      </div>
      <span class="gz__hint">Drag to explore</span>
    </div>

    <div class="gz__reviews-wrap">
      <div class="gz__track" data-section-slider aria-label="{{ section.settings.heading | strip_html | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <article class="gz-card" data-section-slide data-section-review-item {{ block.shopify_attributes }}>
              <div>
                <div class="gz-card__stars" data-section-rating-badge aria-label="{{ block.settings.rating }} van 5 sterren">
                  {%- for i in (1..5) -%}<span>{% if i <= block.settings.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}
                </div>

                {%- if block.settings.quote != blank -%}
                  <p class="gz-card__quote">{{ block.settings.quote | escape }}</p>
                {%- endif -%}
              </div>

              <div class="gz-card__meta">
                <div class="gz-card__avatar">
                  {%- if block.settings.avatar != blank -%}
                    {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: block.settings.author }}
                  {%- else -%}
                    {{ block.settings.author | slice: 0 | upcase }}
                  {%- endif -%}
                </div>
                <div>
                  <div class="gz-card__name">{{ block.settings.author | escape }}</div>
                  {%- if block.settings.label != blank -%}<div class="gz-card__label">{{ block.settings.label | escape }}</div>{%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="gz__controls" aria-label="Review navigatie">
        <button class="gz__btn" type="button" data-glozzy-prev aria-label="Vorige review">‹</button>
        <button class="gz__btn" type="button" data-glozzy-next aria-label="Volgende review">›</button>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    function initGlozzyReviews() {
      var section = root.querySelector('[data-glozzy-reviews]');
      if (!section || section.dataset.glozzyReady === 'true') return;
      section.dataset.glozzyReady = 'true';

      var track = section.querySelector('[data-section-slider]');
      var prev = section.querySelector('[data-glozzy-prev]');
      var next = section.querySelector('[data-glozzy-next]');
      if (!track || !prev || !next) return;

      function getStep() {
        var slide = track.querySelector('[data-section-slide]');
        if (!slide) return track.clientWidth;
        var styles = window.getComputedStyle(track);
        var gap = parseFloat(styles.columnGap || styles.gap || 0);
        return slide.getBoundingClientRect().width + gap;
      }

      prev.addEventListener('click', function() {
        track.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });

      next.addEventListener('click', function() {
        track.scrollBy({ left: getStep(), behavior: 'smooth' });
      });
    }

    initGlozzyReviews();

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        root = document.getElementById('shopify-section-{{ section.id }}');
        initGlozzyReviews();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Glozzy premium reviews",
  "class": "shopify-section--glozzy-premium-reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by beauty lovers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glozzy glow, <span>real reviews</span>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Een rustige premium reviewsectie met subtiele tinten, veel witruimte en verfijnde customer proof.</p>" },
    { "type": "text", "id": "beauty_icons", "label": "Legacy beauty products text", "default": "Lip Gloss, Blush, Serum, Mascara, Highlighter, Lip Oil, Primer, Setting Spray" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 900, "max": 1120, "step": 20, "unit": "px", "default": 1060 },
    { "type": "range", "id": "padding_y", "label": "Desktop vertical padding", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "mobile_padding_y", "label": "Mobile vertical padding", "min": 36, "max": 84, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "star_size", "label": "Star size", "min": 16, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "marquee_speed", "label": "Legacy icon speed", "min": 12, "max": 42, "step": 2, "unit": "s", "default": 24 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fbf8f4" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2f2421" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#786b66" },
    { "type": "color", "id": "accent_color", "label": "Soft accent", "default": "#b88a80" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#b88a80" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "De gloss voelt luxe, blijft mooi zitten en geeft precies die soft pink shine waar ik naar zocht." },
        { "type": "text", "id": "author", "label": "Name", "default": "Sophie M." },
        { "type": "text", "id": "label", "label": "Label", "default": "Verified Glozzy customer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glozzy premium reviews",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "De kleur, shine en verpakking voelen echt high-end. Mijn everyday lip gloss.", "author": "Lina R.", "label": "Verified customer" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Super zacht op mijn lippen en de roze glow past perfect bij mijn make-up routine.", "author": "Amira K.", "label": "Beauty lover" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Glozzy ziet eruit als een premium beauty brand. De finish is glossy maar niet plakkerig.", "author": "Noor V.", "label": "Repeat customer" } },
        { "type": "review", "settings": { "rating": 4, "quote": "Prachtige zachte tinten en heel professioneel. Ik krijg er vaak complimenten over.", "author": "Eva S.", "label": "Verified customer" } }
      ]
    }
  ]
}
{% endschema %}