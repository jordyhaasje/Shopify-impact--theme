{%- comment -%}
  JSections - Footer #7
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-footer-7.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo_alt = section.settings.logo_alt | default: section.settings.brand_text
  assign logo_image = section.settings.logo_image
  assign logo_image_mobile = section.settings.logo_image_mobile

  if logo_image_mobile == blank
    assign logo_image_mobile = logo_image
  endif
-%}

<footer
  class="jfooter7 jfooter7--{{ section.settings.style_preset }}{% if section.settings.use_preset_colors %} jfooter7--preset-colors{% endif %}"
  style="
    --jfooter7-bg: {{ section.settings.background_color }};
    --jfooter7-text: {{ section.settings.text_color }};
    --jfooter7-muted: {{ section.settings.muted_color }};
    --jfooter7-logo: {{ section.settings.logo_color }};
    --jfooter7-divider: {{ section.settings.divider_color }};
    --jfooter7-input-bg: {{ section.settings.input_background }};
    --jfooter7-button-bg: {{ section.settings.button_background }};
    --jfooter7-button-text: {{ section.settings.button_text_color }};
    --jfooter7-button-hover-bg: {{ section.settings.button_hover_background }};
    --jfooter7-button-hover-text: {{ section.settings.button_hover_text_color }};
    --jfooter7-radius: {{ section.settings.card_radius }}px;
    --jfooter7-margin-top: {{ section.settings.margin_top }}px;
    --jfooter7-margin-bottom: {{ section.settings.margin_bottom }}px;
    --jfooter7-margin-x: {{ section.settings.margin_x_px }}px;
    --jfooter7-padding-top: {{ section.settings.padding_top }}px;
    --jfooter7-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jfooter7-logo-size: {{ section.settings.logo_size }}px;
    --jfooter7-logo-size-mobile: {{ section.settings.logo_size_mobile }}px;
    --jfooter7-logo-image-width: {{ section.settings.logo_image_width }}px;
    --jfooter7-logo-image-width-mobile: {{ section.settings.logo_image_width_mobile }}px;
  "
  data-jfooter7-section="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="jfooter7__inner">
    <div class="jfooter7__brand">
      <a href="{{ section.settings.brand_link | default: routes.root_url }}" class="jfooter7__brand-link">
        {%- if logo_image != blank -%}
          <picture class="jfooter7__brand-picture">
            {%- if section.settings.logo_image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ logo_image_mobile | image_url: width: 900 }}">
            {%- endif -%}
            {{
              logo_image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 1024px) 80vw, 92vw',
                alt: logo_alt,
                class: 'jfooter7__brand-image'
            }}
          </picture>
        {%- else -%}
          <span>{{ section.settings.brand_text }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="jfooter7__body">
      <div class="jfooter7__left">
        {%- if section.settings.newsletter_text != blank -%}
          <div class="jfooter7__intro">{{ section.settings.newsletter_text }}</div>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', class: 'jfooter7__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="jfooter7__visually-hidden" for="JFooter7Email-{{ section.id }}">
              {{ section.settings.newsletter_label }}
            </label>
            <div class="jfooter7__row">
              <input
                id="JFooter7Email-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="jfooter7__input"
                value="{{ form.email }}"
                aria-required="true"
                aria-label="{{ section.settings.newsletter_label | escape }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                required
              >
              <button type="submit" class="jfooter7__button" name="commit">
                {{ section.settings.newsletter_button }}
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="jfooter7__success">{{ section.settings.newsletter_success }}</p>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="jfooter7__errors">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.privacy_text != blank -%}
          <div class="jfooter7__privacy">{{ section.settings.privacy_text }}</div>
        {%- endif -%}
      </div>

      <div class="jfooter7__right">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_column' -%}
              <nav class="jfooter7__column" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="jfooter7__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="jfooter7__list" role="list">
                  {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for index in (1..8) -%}
                      {%- liquid
                        assign label_key = 'label_' | append: index
                        assign link_key = 'link_' | append: index
                        assign label = block.settings[label_key]
                        assign link = block.settings[link_key]
                      -%}
                      {%- if label != blank -%}
                        {%- if link != blank -%}
                          <li><a href="{{ link }}">{{ label }}</a></li>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </nav>

            {%- when 'social_column' -%}
              <div
                class="jfooter7__column"
                style="--jfooter7-social-size: {{ block.settings.icon_size }}px; --jfooter7-social-size-mobile: {{ block.settings.icon_size_mobile }}px;"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.heading != blank -%}
                  <p class="jfooter7__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="jfooter7__social-list" role="list">
                  {%- for index in (1..6) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: index
                      assign link_key = 'link_' | append: index
                      assign label = block.settings[label_key]
                      assign link = block.settings[link_key]
                      assign short_label = label | slice: 0, 1
                      assign normalized_label = label | downcase
                    -%}
                    {%- if label != blank -%}
                      <li>
                        <a href="{{ link | default: '#' }}" aria-label="{{ label | escape }}">
                          <span class="jfooter7__social-icon" aria-hidden="true">
                            {%- case normalized_label -%}
                              {%- when 'instagram' -%}
                                <svg viewBox="0 0 24 24" focusable="false"><path d="M12 0C8.74 0 8.33.02 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.39C1.35 2.68.94 3.35.63 4.14.33 4.9.13 5.78.07 7.05.02 8.33 0 8.74 0 12s.02 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13.66.66 1.34 1.08 2.13 1.38.76.3 1.63.5 2.91.56 1.28.05 1.69.07 4.95.07s3.67-.02 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.08-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.05-1.28.07-1.69.07-4.95s-.02-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.63-.5-2.91-.56C15.67.02 15.26 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.81.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.81-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.81-.25-2.23-.41a3.71 3.71 0 0 1-1.38-.9 3.71 3.71 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.81.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"/></svg>
                              {%- when 'facebook' -%}
                                <svg viewBox="0 0 24 24" focusable="false"><path d="M15.7 8.1h-2.4V6.6c0-.7.46-.86.78-.86h1.56V3.04L13.48 3c-2.4 0-2.94 1.8-2.94 2.95V8.1H8.7v2.78h1.84V21h2.78V10.88h2.1l.28-2.78Z"/></svg>
                              {%- when 'x', 'twitter' -%}
                                <svg viewBox="0 0 24 24" focusable="false"><path d="M13.9 10.5 21.3 2h-1.8l-6.4 7.4L8 2H2l7.8 11.3L2 22h1.8l6.8-7.8L16 22h6l-8.1-11.5Zm-2.4 2.8-.8-1.1L4.4 3.3h2.8l5 7.1.8 1.1 6.6 9.4h-2.8l-5.3-7.6Z"/></svg>
                              {%- when 'linkedin', 'linked in' -%}
                                <svg viewBox="0 0 24 24" focusable="false"><path d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.34 8h4.32v14H.34V8Zm7.12 0h4.14v1.92h.06c.58-1.1 1.98-2.26 4.08-2.26 4.36 0 5.16 2.86 5.16 6.58V22h-4.32v-6.88c0-1.64-.02-3.76-2.28-3.76-2.3 0-2.64 1.8-2.64 3.66V22H7.46V8Z"/></svg>
                              {%- when 'tiktok', 'tik tok' -%}
                                <svg viewBox="0 0 24 24" focusable="false"><path d="M17.5 6.6A5.8 5.8 0 0 1 14 5.45v8.48a5.55 5.55 0 1 1-5.54-5.54c.35 0 .7.04 1.03.1v3.05a2.55 2.55 0 1 0 1.8 2.44V1h2.73a5.8 5.8 0 0 0 3.48 3.02v2.58Z"/></svg>
                              {%- when 'youtube', 'you tube' -%}
                                <svg viewBox="0 0 24 24" focusable="false"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5v-7l6.2 3.5-6.2 3.5Z"/></svg>
                              {%- else -%}
                                <span>{{ short_label }}</span>
                            {%- endcase -%}
                          </span>
                          <span>{{ label }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'text_column' -%}
              <div class="jfooter7__column jfooter7__column--text" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="jfooter7__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="jfooter7__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

