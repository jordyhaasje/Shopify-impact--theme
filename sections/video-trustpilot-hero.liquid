{%- render 'section-spacing-collapsing' -%}

<style>
#shopify-section-{{ section.id }} {
  --tp-green: 0,182,122;
  --tp-dark: 18,18,18;
  --tp-gray: 102,102,102;
  --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
}

.video-hero { position: relative; overflow: hidden; }
.video-hero__media,
.video-hero__overlay { position:absolute; inset:0; }
.video-hero__media video { width:100%; height:100%; object-fit:cover; }
.video-hero__overlay { background: rgba(0,0,0,var(--overlay-opacity)); z-index:2; }

.video-hero__content {
  position:relative;
  z-index:3;
  padding:90px 20px;
  text-align:center;
  color:#fff;
}

.tp-strip {
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:8px 14px;
  border-radius:6px;
  font-size:14px;
  font-weight:600;
}

.tp-strip.bg-white { background:#fff; color:rgb(var(--tp-dark)); }
.tp-strip.bg-transparent { background:transparent; color:#fff; }
.tp-strip.bg-custom { background: {{ section.settings.widget_bg_color }}; color: {{ section.settings.widget_text_color }}; }

.tp-stars { display:flex; gap:2px; }
.tp-star {
  width:18px;
  height:18px;
  background:rgb(var(--tp-green));
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:2px;
}
.tp-star svg { width:10px; height:10px; fill:#fff; }

.tp-meta { font-weight:500; color:rgb(var(--tp-gray)); }

.video-hero__heading {
  font-size:clamp(34px,5vw,56px);
  margin-top:22px;
  font-weight:600;
}

.video-hero__sub { margin-top:14px; font-size:18px; opacity:.92; }
.video-hero__actions { margin-top:28px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }

@media(max-width:699px){
  .video-hero__content{padding:70px 16px}
  .video-hero__heading{font-size:32px}
}
</style>

<section class="video-hero">
  <div {% render 'section-properties' %}>

    <div class="video-hero__media">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
      {% endif %}
    </div>

    <div class="video-hero__overlay"></div>

    <div class="container video-hero__content">

      {%- assign bg_mode = section.settings.widget_bg_mode -%}
      <div class="tp-strip bg-{{ bg_mode }}" data-count="{{ section.settings.review_count }}">
        <div class="tp-stars">
          {% for i in (1..5) %}
            <span class="tp-star">
              <svg viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09L5.5 11.545 1 7.41l6.061-.881L10 1l2.939 5.529L19 7.41l-4.5 4.136 1.378 6.545z"/></svg>
            </span>
          {% endfor %}
        </div>
        <span><strong>{{ section.settings.rating_score }}</strong> / 5</span>
        <span class="tp-meta"><span class="tp-counter">0</span>+ reviews</span>
      </div>

      <h2 class="video-hero__heading">{{ section.settings.heading }}</h2>

      <div class="video-hero__sub rte">
        {{ section.settings.subheading }}
      </div>

      <div class="video-hero__actions">
        {% render 'button', content: section.settings.button_1_label, href: section.settings.button_1_link, size: 'lg', background: section.settings.primary_color %}
        {% render 'button', content: section.settings.button_2_label, href: section.settings.button_2_link, style: 'outline', size: 'lg', text_color: section.settings.primary_color %}
      </div>

    </div>

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const el = document.querySelector('#shopify-section-{{ section.id }} .tp-counter');
  if(!el) return;
  const target = parseInt(document.querySelector('#shopify-section-{{ section.id }} .tp-strip').dataset.count);
  let count = 0;
  const step = Math.ceil(target / 60);

  const interval = setInterval(()=>{
    count += step;
    if(count >= target){
      count = target;
      clearInterval(interval);
    }
    el.textContent = count;
  },20);
});
</script>

{% schema %}
{
  "name": "Video Hero Trustpilot",
  "settings": [
    {"type":"video","id":"video","label":"Background video"},
    {"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"default":30},

    {"type":"text","id":"rating_score","label":"Rating score","default":"4.8"},
    {"type":"number","id":"review_count","label":"Review count","default":1200},

    {"type":"select","id":"widget_bg_mode","label":"Widget background","default":"white","options":[
      {"value":"white","label":"White"},
      {"value":"transparent","label":"Transparent"},
      {"value":"custom","label":"Custom"}
    ]},
    {"type":"color","id":"widget_bg_color","label":"Custom background","default":"#ffffff"},
    {"type":"color","id":"widget_text_color","label":"Custom text color","default":"#000000"},

    {"type":"text","id":"heading","label":"Heading","default":"Excellent reviews"},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Trusted by thousands</p>"},

    {"type":"color","id":"primary_color","label":"Primary color","default":"#00B67A"},

    {"type":"text","id":"button_1_label","label":"Primary button label","default":"Shop now"},
    {"type":"url","id":"button_1_link","label":"Primary button link"},
    {"type":"text","id":"button_2_label","label":"Secondary button label","default":"Read reviews"},
    {"type":"url","id":"button_2_link","label":"Secondary button link"}
  ],
  "presets": [{"name":"Video Hero Trustpilot"}]
}
{% endschema %}