{% liquid
  assign section_id = section.id
  assign ticker_text = section.settings.ticker_text | strip
  if ticker_text == blank
    assign ticker_text = 'just in'
  endif
%}

<section class="animated-header section-{{ section_id }}">
  <div class="animated-header__inner">
    <div class="animated-header__content-column">
      <div class="animated-header__content">
        {% if section.settings.heading != blank %}
          <h2 class="animated-header__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="animated-header__text rte">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="animated-header__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="animated-header__ticker" aria-hidden="true">
      <div class="animated-header__ticker-track">
        {% for i in (1..12) %}
          <span class="animated-header__ticker-item">{{ ticker_text }}</span>
          <span class="animated-header__ticker-icon">✺</span>
        {% endfor %}
      </div>
    </div>

    <div class="animated-header__media-column">
      <div class="animated-header__media-wrap">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2400 | image_tag:
            class: 'animated-header__image',
            widths: '750, 1100, 1500, 1800, 2200, 2400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt | escape
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'animated-header__image animated-header__image--placeholder' }}
        {% endif %}

        <div class="animated-header__device-card">
          <div class="animated-header__device-notch" aria-hidden="true">
            <span></span>
            <span></span>
          </div>

          <div class="animated-header__device-top-image">
            {% if section.settings.mobile_card_image != blank %}
              {{ section.settings.mobile_card_image | image_url: width: 1200 | image_tag:
                class: 'animated-header__device-top-image-tag',
                widths: '300, 500, 700, 900, 1200',
                sizes: '(max-width: 749px) 78vw, 360px',
                loading: 'lazy',
                alt: section.settings.mobile_card_image.alt | escape
              }}
            {% elsif section.settings.image != blank %}
              {{ section.settings.image | image_url: width: 1200 | image_tag:
                class: 'animated-header__device-top-image-tag',
                widths: '300, 500, 700, 900, 1200',
                sizes: '(max-width: 749px) 78vw, 360px',
                loading: 'lazy',
                alt: section.settings.image.alt | escape
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'animated-header__device-top-image-tag animated-header__image--placeholder' }}
            {% endif %}
          </div>

          <div class="animated-header__device-body">
            {% if section.settings.heading != blank %}
              <h3 class="animated-header__device-heading">{{ section.settings.heading }}</h3>
            {% endif %}

            {% if section.settings.text != blank %}
              <div class="animated-header__device-text rte">{{ section.settings.text }}</div>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <a
                class="animated-header__device-button"
                {% if section.settings.button_link != blank %}
                  href="{{ section.settings.button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.button_label }}
              </a>
            {% endif %}
          </div>

          <div class="animated-header__device-ticker" aria-hidden="true">
            <div class="animated-header__device-ticker-track">
              {% for i in (1..7) %}
                <span>{{ ticker_text }}</span>
                <span class="animated-header__ticker-icon">✺</span>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-{{ section_id }} {
    --ah-bg: {{ section.settings.background_color }};
    --ah-text: {{ section.settings.text_color }};
    --ah-muted: {{ section.settings.muted_text_color }};
    --ah-border: {{ section.settings.border_color }};
    --ah-card-bg: {{ section.settings.card_background_color }};
    --ah-card-text: {{ section.settings.card_text_color }};
    --ah-radius: {{ section.settings.section_radius }}px;
    --ah-card-radius: {{ section.settings.card_radius }}px;
    --ah-button-radius: {{ section.settings.button_radius }}px;
    --ah-max-width: {{ section.settings.max_width }}px;
    --ah-desktop-height: {{ section.settings.desktop_height }}px;
    --ah-ticker-width: {{ section.settings.ticker_width }}px;
    --ah-card-width: {{ section.settings.card_width }}px;
    --ah-card-right: {{ section.settings.card_right_offset }}px;
    --ah-card-bottom: {{ section.settings.card_bottom_offset }}px;
    --ah-card-border: {{ section.settings.card_border_width }}px;
    --ah-heading-size: {{ section.settings.heading_size }}px;
    --ah-body-size: {{ section.settings.body_size }}px;
    --ah-device-heading-size: {{ section.settings.device_heading_size }}px;
    --ah-ticker-size: {{ section.settings.ticker_size }}px;
    --ah-padding-top: {{ section.settings.padding_top }}px;
    --ah-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ah-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --ah-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section_id }}.animated-header {
    padding-top: var(--ah-padding-top);
    padding-bottom: var(--ah-padding-bottom);
  }

  .section-{{ section_id }} .animated-header__inner {
    max-width: min(100%, var(--ah-max-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--ah-ticker-width) minmax(0, 1fr);
    min-height: var(--ah-desktop-height);
    background: var(--ah-bg);
    border-radius: var(--ah-radius);
    overflow: hidden;
  }

  .section-{{ section_id }} .animated-header__content-column {
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  .section-{{ section_id }} .animated-header__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 2rem;
    padding: 5.6rem 4.8rem 4.4rem;
    color: var(--ah-text);
  }

  .section-{{ section_id }} .animated-header__heading,
  .section-{{ section_id }} .animated-header__device-heading {
    margin: 0;
    font-size: clamp(3.4rem, 4vw, var(--ah-heading-size));
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .section-{{ section_id }} .animated-header__text,
  .section-{{ section_id }} .animated-header__device-text {
    max-width: 54rem;
    color: var(--ah-muted);
    font-size: var(--ah-body-size);
    line-height: 1.5;
  }

  .section-{{ section_id }} .animated-header__text p,
  .section-{{ section_id }} .animated-header__device-text p {
    margin: 0;
  }

  .section-{{ section_id }} .animated-header__button,
  .section-{{ section_id }} .animated-header__device-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    min-width: 16.8rem;
    padding: 0 2.4rem;
    border: 1px solid var(--ah-border);
    border-radius: var(--ah-button-radius);
    background: transparent;
    color: var(--ah-text);
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .section-{{ section_id }} .animated-header__ticker {
    position: relative;
    overflow: hidden;
    border-left: 1px solid rgba(0,0,0,0.05);
    border-right: 1px solid rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-{{ section_id }} .animated-header__ticker-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.2rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: var(--ah-ticker-size);
    line-height: 1;
    font-weight: 700;
    color: var(--ah-text);
    animation: animatedHeaderVertical-{{ section_id }} {{ section.settings.ticker_speed }}s linear infinite;
  }

  .section-{{ section_id }} .animated-header__ticker-icon {
    font-size: 0.55em;
  }

  .section-{{ section_id }} .animated-header__media-column,
  .section-{{ section_id }} .animated-header__media-wrap {
    position: relative;
    min-width: 0;
    height: 100%;
  }

  .section-{{ section_id }} .animated-header__image,
  .section-{{ section_id }} .animated-header__image--placeholder,
  .section-{{ section_id }} .animated-header__image--placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-{{ section_id }} .animated-header__device-card {
    position: absolute;
    right: var(--ah-card-right);
    bottom: var(--ah-card-bottom);
    width: min(calc(100% - 2.4rem), var(--ah-card-width));
    background: var(--ah-card-bg);
    color: var(--ah-card-text);
    border: var(--ah-card-border) solid #000;
    border-radius: var(--ah-card-radius);
    overflow: hidden;
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.16);
  }

  .section-{{ section_id }} .animated-header__device-notch {
    position: absolute;
    top: 0.9rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    z-index: 2;
  }

  .section-{{ section_id }} .animated-header__device-notch span:first-child {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: #fff;
  }

  .section-{{ section_id }} .animated-header__device-notch span:last-child {
    width: 4.4rem;
    height: 1rem;
    border-radius: 999px;
    background: #fff;
  }

  .section-{{ section_id }} .animated-header__device-top-image {
    aspect-ratio: 1.72 / 1;
    overflow: hidden;
  }

  .section-{{ section_id }} .animated-header__device-top-image-tag {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-{{ section_id }} .animated-header__device-body {
    padding: 2.6rem 2.6rem 2.4rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
  }

  .section-{{ section_id }} .animated-header__device-heading {
    font-size: var(--ah-device-heading-size);
  }

  .section-{{ section_id }} .animated-header__device-ticker {
    overflow: hidden;
    padding: 0 0 1.8rem;
  }

  .section-{{ section_id }} .animated-header__device-ticker-track {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    white-space: nowrap;
    font-size: clamp(2.2rem, 4vw, 4.8rem);
    line-height: 1;
    font-weight: 700;
    animation: animatedHeaderHorizontal-{{ section_id }} {{ section.settings.ticker_speed }}s linear infinite;
  }

  @keyframes animatedHeaderVertical-{{ section_id }} {
    from { transform: rotate(180deg) translateY(0); }
    to { transform: rotate(180deg) translateY(45%); }
  }

  @keyframes animatedHeaderHorizontal-{{ section_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-35%); }
  }

  @media screen and (max-width: 989px) {
    .section-{{ section_id }} .animated-header__inner {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .section-{{ section_id }} .animated-header__ticker {
      display: none;
    }

    .section-{{ section_id }} .animated-header__media-wrap {
      min-height: {{ section.settings.tablet_image_height }}px;
    }

    .section-{{ section_id }} .animated-header__content {
      padding: 3rem 2.6rem 3.2rem;
    }

    .section-{{ section_id }} .animated-header__device-card {
      right: {{ section.settings.tablet_card_right_offset }}px;
      bottom: {{ section.settings.tablet_card_bottom_offset }}px;
      width: min(calc(100% - 2rem), {{ section.settings.tablet_card_width }}px);
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section_id }}.animated-header {
      padding-top: var(--ah-mobile-padding-top);
      padding-bottom: var(--ah-mobile-padding-bottom);
    }

    .section-{{ section_id }} .animated-header__inner {
      border-radius: {{ section.settings.mobile_section_radius }}px;
    }

    .section-{{ section_id }} .animated-header__media-wrap {
      min-height: {{ section.settings.mobile_image_height }}px;
    }

    .section-{{ section_id }} .animated-header__content {
      padding: 2.2rem 1.8rem 2.4rem;
      gap: 1.5rem;
    }

    .section-{{ section_id }} .animated-header__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .section-{{ section_id }} .animated-header__text,
    .section-{{ section_id }} .animated-header__device-text {
      font-size: {{ section.settings.mobile_body_size }}px;
      max-width: 100%;
    }

    .section-{{ section_id }} .animated-header__device-card {
      right: {{ section.settings.mobile_card_right_offset }}px;
      bottom: {{ section.settings.mobile_card_bottom_offset }}px;
      width: min(calc(100% - 1.4rem), {{ section.settings.mobile_card_width }}px);
      border-width: {{ section.settings.mobile_card_border_width }}px;
      border-radius: {{ section.settings.mobile_card_radius }}px;
    }

    .section-{{ section_id }} .animated-header__device-body {
      padding: 1.8rem 1.8rem 1.8rem;
      gap: 1.2rem;
    }

    .section-{{ section_id }} .animated-header__device-heading {
      font-size: {{ section.settings.mobile_device_heading_size }}px;
    }

    .section-{{ section_id }} .animated-header__button,
    .section-{{ section_id }} .animated-header__device-button {
      min-width: 14.6rem;
      min-height: 4.4rem;
      padding: 0 2rem;
      font-size: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section_id }} .animated-header__ticker-track,
    .section-{{ section_id }} .animated-header__device-ticker-track {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Animated header",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Targeted Solutions" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Whether you struggle with dryness, sensitivity, or acne, our brand has a targeted skincare solution for you. Achieve your healthiest, most balanced complexion.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "ticker_text", "label": "Ticker text", "default": "just in" },
    { "type": "image_picker", "id": "image", "label": "Main image" },
    { "type": "image_picker", "id": "mobile_card_image", "label": "Device card image" },

    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "max_width", "label": "Section max width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1480 },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 500, "max": 900, "step": 10, "unit": "px", "default": 720 },
    { "type": "range", "id": "ticker_width", "label": "Ticker width", "min": 60, "max": 160, "step": 2, "unit": "px", "default": 82 },
    { "type": "range", "id": "card_width", "label": "Desktop device width", "min": 260, "max": 560, "step": 10, "unit": "px", "default": 430 },
    { "type": "range", "id": "card_right_offset", "label": "Desktop card right offset", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "card_bottom_offset", "label": "Desktop card bottom offset", "min": -100, "max": 80, "step": 2, "unit": "px", "default": -34 },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 40, "max": 92, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "body_size", "label": "Desktop body size", "min": 14, "max": 26, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "device_heading_size", "label": "Desktop device heading size", "min": 28, "max": 58, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "ticker_size", "label": "Ticker size", "min": 34, "max": 88, "step": 2, "unit": "px", "default": 58 },
    { "type": "range", "id": "ticker_speed", "label": "Ticker speed", "min": 8, "max": 40, "step": 1, "unit": "s", "default": 20 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },

    { "type": "header", "content": "Tablet" },
    { "type": "range", "id": "tablet_image_height", "label": "Tablet image height", "min": 320, "max": 760, "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "tablet_card_width", "label": "Tablet card width", "min": 240, "max": 420, "step": 10, "unit": "px", "default": 320 },
    { "type": "range", "id": "tablet_card_right_offset", "label": "Tablet card right offset", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "tablet_card_bottom_offset", "label": "Tablet card bottom offset", "min": -80, "max": 40, "step": 2, "unit": "px", "default": -24 },

    { "type": "header", "content": "Mobile" },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile image height", "min": 240, "max": 620, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "mobile_card_width", "label": "Mobile card width", "min": 200, "max": 360, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "mobile_card_right_offset", "label": "Mobile card right offset", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "mobile_card_bottom_offset", "label": "Mobile card bottom offset", "min": -70, "max": 30, "step": 2, "unit": "px", "default": -18 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 28, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_device_heading_size", "label": "Mobile device heading size", "min": 20, "max": 42, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_body_size", "label": "Mobile body size", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_section_radius", "label": "Mobile section radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_card_radius", "label": "Mobile card radius", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_card_border_width", "label": "Mobile card border width", "min": 1, "max": 6, "step": 1, "unit": "px", "default": 4 },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#e8e4de" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5d5a56" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text color", "default": "#7a7773" },
    { "type": "color", "id": "border_color", "label": "Button border color", "default": "#8f8b86" },
    { "type": "color", "id": "card_background_color", "label": "Card background color", "default": "#ebe7e2" },
    { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#5d5a56" },
    { "type": "range", "id": "section_radius", "label": "Section radius", "min": 0, "max": 36, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_radius", "label": "Desktop card radius", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 36, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "card_border_width", "label": "Desktop card border width", "min": 1, "max": 6, "step": 1, "unit": "px", "default": 6 }
  ],
  "presets": [
    {
      "name": "Animated header"
    }
  ]
}
{% endschema %}