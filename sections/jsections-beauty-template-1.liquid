<script>
  (() => {
    const state = window.hzBeautyTemplate1State || {
      instances: new Map(),
      listenersRegistered: false,
    };
    window.hzBeautyTemplate1State = state;

    const addListener = (cleanups, target, type, handler, options) => {
      if (!target) return;
      target.addEventListener(type, handler, options);
      cleanups.push(() => target.removeEventListener(type, handler, options));
    };

    const cleanupBeautyTemplate = (root) => {
      const cleanups = state.instances.get(root?.id);
      if (!cleanups) return;
      cleanups.forEach((cleanup) => cleanup());
      state.instances.delete(root.id);
      delete root.dataset.hzBeautyTemplateInit;
    };

    const initBeautyTemplate = (root) => {
      if (!root || root.dataset.hzBeautyTemplateInit === "true") return;
      cleanupBeautyTemplate(root);

      const cleanups = [];
      root.dataset.hzBeautyTemplateInit = "true";
      state.instances.set(root.id, cleanups);

      root.querySelectorAll("[data-hz-video-toggle]").forEach((button) => {
        const hero = button.closest(".hz-bt__hero");
        const video = hero?.querySelector("video");
        if (!video) return;

        addListener(cleanups, button, "click", () => {
          if (video.paused) {
            video.play();
            button.classList.remove("is-paused");
            button.setAttribute("aria-label", "Pause video");
          } else {
            video.pause();
            button.classList.add("is-paused");
            button.setAttribute("aria-label", "Play video");
          }
        });
      });

      root.querySelectorAll("[data-hz-open-variant]").forEach((button) => {
        addListener(cleanups, button, "click", () => {
          button.closest(".hz-bt__product-card")?.classList.add("is-variant-open");
        });
      });

      root.querySelectorAll("[data-hz-close-variant]").forEach((button) => {
        addListener(cleanups, button, "click", () => {
          button.closest(".hz-bt__product-card")?.classList.remove("is-variant-open");
        });
      });

      root.querySelectorAll("[data-hz-slider]").forEach((slider) => {
        const viewport = slider.querySelector("[data-hz-slider-viewport]");
        const track = slider.querySelector("[data-hz-slider-track]");
        const items = track ? Array.from(track.children) : [];
        const prev = slider.querySelector("[data-hz-slider-prev]");
        const next = slider.querySelector("[data-hz-slider-next]");
        const dots = slider.querySelector("[data-hz-slider-dots]");
        const bar = slider.querySelector("[data-hz-slider-bar]");
        const thumb = slider.querySelector("[data-hz-slider-bar-thumb]");
        if (!viewport || !items.length) return;

        if (dots) {
          dots.innerHTML = items
            .map((_, index) => `<span class="${index === 0 ? "is-active" : ""}"></span>`)
            .join("");
        }

        const getStep = () => {
          const first = items[0];
          const second = items[1];
          if (!first) return viewport.clientWidth;
          if (!second) return first.getBoundingClientRect().width;
          return second.getBoundingClientRect().left - first.getBoundingClientRect().left;
        };

        const update = () => {
          const step = Math.max(1, getStep());
          const index = Math.round(viewport.scrollLeft / step);
          const maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);

          dots?.querySelectorAll("span").forEach((dot, dotIndex) => {
            dot.classList.toggle("is-active", dotIndex === index);
          });

          prev?.toggleAttribute("disabled", viewport.scrollLeft <= 4);
          next?.toggleAttribute("disabled", viewport.scrollLeft >= maxScroll - 4);

          if (bar && thumb) {
            const ratio = viewport.clientWidth / viewport.scrollWidth;
            const width = Math.max(0.12, Math.min(1, ratio));
            const progress = maxScroll > 0 ? viewport.scrollLeft / maxScroll : 0;
            thumb.style.width = `${width * 100}%`;
            thumb.style.transform = `translateX(${progress * (100 / width - 100)}%)`;
          }
        };

        addListener(cleanups, prev, "click", () => {
          viewport.scrollBy({ left: -getStep(), behavior: "smooth" });
        });
        addListener(cleanups, next, "click", () => {
          viewport.scrollBy({ left: getStep(), behavior: "smooth" });
        });
        addListener(cleanups, viewport, "scroll", () => window.requestAnimationFrame(update), { passive: true });
        addListener(cleanups, window, "resize", update);
        update();
      });

      root.querySelectorAll("[data-hz-split]").forEach((split) => {
        const mediaTrack = split.querySelector("[data-hz-split-media-track]");
        const productTrack = split.querySelector("[data-hz-split-product-track]");
        const slides = mediaTrack ? Array.from(mediaTrack.children) : [];
        const next = split.querySelector("[data-hz-split-next]");
        const dots = split.querySelector("[data-hz-split-dots]");
        const counter = split.querySelector("[data-hz-split-counter]");
        let index = 0;
        if (!mediaTrack || !productTrack || !slides.length) return;

        if (dots) {
          dots.innerHTML = slides
            .map((_, dotIndex) => `<span class="${dotIndex === 0 ? "is-active" : ""}"></span>`)
            .join("");
        }

        const update = () => {
          mediaTrack.style.transform = `translateX(${-index * 100}%)`;
          productTrack.style.transform = `translateX(${-index * 100}%)`;
          if (counter) counter.textContent = `${index + 1}/${slides.length}`;
          dots?.querySelectorAll("span").forEach((dot, dotIndex) => {
            dot.classList.toggle("is-active", dotIndex === index);
          });
        };

        addListener(cleanups, next, "click", () => {
          index = (index + 1) % slides.length;
          update();
        });

        let startX = 0;
        addListener(cleanups, split, "touchstart", (event) => {
          startX = event.touches[0].clientX;
        }, { passive: true });
        addListener(cleanups, split, "touchend", (event) => {
          const delta = event.changedTouches[0].clientX - startX;
          if (Math.abs(delta) < 35) return;
          index = delta < 0
            ? (index + 1) % slides.length
            : (index - 1 + slides.length) % slides.length;
          update();
        }, { passive: true });

        update();
      });

      root.querySelectorAll("[data-hz-tabs]").forEach((tabs) => {
        const buttons = Array.from(tabs.querySelectorAll("[data-hz-tab]"));
        const panels = Array.from(tabs.querySelectorAll("[data-hz-tab-panel]"));
        const images = Array.from(tabs.querySelectorAll("[data-hz-tab-image]"));

        buttons.forEach((button) => {
          addListener(cleanups, button, "click", () => {
            const id = button.getAttribute("data-hz-tab");
            buttons.forEach((item) => {
              const active = item === button;
              item.classList.toggle("is-active", active);
              item.setAttribute("aria-selected", active ? "true" : "false");
            });
            panels.forEach((panel) => {
              panel.classList.toggle("is-active", panel.getAttribute("data-hz-tab-panel") === id);
            });
            images.forEach((image) => {
              image.classList.toggle("is-active", image.getAttribute("data-hz-tab-image") === id);
            });
          });
        });
      });
    };

    const findRoots = (container = document) => {
      const roots = Array.from(container.querySelectorAll(".jsections-beauty-template-1"));
      if (container.matches?.(".jsections-beauty-template-1")) roots.unshift(container);
      return roots;
    };

    const load = (container = document) => {
      findRoots(container).forEach((root) => initBeautyTemplate(root));
    };

    const unload = (container = document) => {
      findRoots(container).forEach((root) => cleanupBeautyTemplate(root));
    };

    if (!state.listenersRegistered) {
      document.addEventListener("DOMContentLoaded", () => load());
      document.addEventListener("shopify:section:load", (event) => load(event.target));
      document.addEventListener("shopify:section:unload", (event) => unload(event.target));
      state.listenersRegistered = true;
    }

    load();
  })();
</script>

