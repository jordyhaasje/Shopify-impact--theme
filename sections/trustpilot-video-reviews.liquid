{%- render 'section-spacing-collapsing' -%}

<!-- TRUSTPILOT FULL UPGRADE -->

<section class="tpvr">
  <div {% render 'section-properties' %}>
    <div class="container">
      <h2>{{ section.settings.heading }}</h2>
      <div class="tpvr__videos">
        {% for block in section.blocks %}
          {% if block.settings.video != blank %}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
          {% endif %}
        {% endfor %}
      </div>

      <div class="tpvr__reviews">
        {% for block in section.blocks %}
          <div class="review">
            {% if block.settings.avatar %}
              {{ block.settings.avatar | image_url: width: 80 | image_tag }}
            {% endif %}
            <p>{{ block.settings.review_text }}</p>
          </div>
        {% endfor %}
      </div>

      {% render 'button', content: section.settings.button_label, href: section.settings.button_link %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trustpilot video reviews",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Video reviews"},
    {"type":"text","id":"button_label","label":"Button label"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "blocks": [
    {
      "type":"review",
      "name":"Review",
      "settings":[
        {"type":"video","id":"video","label":"Video"},
        {"type":"image_picker","id":"avatar","label":"Avatar"},
        {"type":"textarea","id":"review_text","label":"Review"}
      ]
    }
  ],
  "presets":[{"name":"Trustpilot video reviews"}]
}
{% endschema %}