    { "type": "select", "id": "columns_desktop", "label": "Desktop columns", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "1" },
    { "type": "range", "id": "grid_gap", "label": "Desktop gap", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 20, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "media_height", "label": "Desktop video height", "min": 260, "max": 440, "step": 10, "unit": "px", "default": 440 },
    { "type": "range", "id": "mobile_media_height", "label": "Mobile video height", "min": 260, "max": 360, "step": 10, "unit": "px", "default": 360 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 12 },
