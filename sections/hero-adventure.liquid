{% comment %} Hero Adventure - Exact Replica {% endcomment %}
{% render 'section-spacing-collapsing' %}
<section id="hero-{{ section.id }}" class="hero-adventure" {% render 'section-properties' %}>

  <div class="hero-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-img', loading: 'lazy' }}
    {% else %}
      <div class="hero-placeholder"></div>
    {% endif %}
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-inner page-width">
    <div class="hero-content">

      <div class="hero-left">
        <div class="hero-badge">
          <span class="stars">★★★★★</span>
          <span class="badge-text">{{ section.settings.badge_text }}</span>
        </div>

        <h1 class="hero-heading">{{ section.settings.heading }}</h1>
        <p class="hero-sub">{{ section.settings.subtext }}</p>

        {% if section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="hero-btn">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      <div class="hero-nav">
        <button type="button" class="nav-btn prev" aria-label="Previous">←</button>
        <button type="button" class="nav-btn next" aria-label="Next">→</button>
      </div>

    </div>
  </div>

  <div class="logo-bar">
    <div class="logo-track">
      {% assign logos = "WomensHealth,VOGUE,BAZAAR,GRAZIA,ELLE" | split: "," %}
      {% for i in (1..12) %}
        {% for logo in logos %}
          <span class="logo-item">{{ logo }}</span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

</section>

<style>
#shopify-section-{{ section.id }} .hero-adventure {
  position: relative;
  color: #fff;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .hero-media {
  position: absolute;
  inset: 0;
}
#shopify-section-{{ section.id }} .hero-img,
#shopify-section-{{ section.id }} .hero-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
#shopify-section-{{ section.id }} .hero-placeholder {
  background: linear-gradient(120deg,#1a1a1a,#444);
}
#shopify-section-{{ section.id }} .hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
}
#shopify-section-{{ section.id }} .hero-inner {
  position: relative;
  min-height: 620px;
  display: flex;
  align-items: center;
}
#shopify-section-{{ section.id }} .hero-content {
  display: flex;
  justify-content: space-between;
  width: 100%;
}
#shopify-section-{{ section.id }} .hero-left {
  max-width: 520px;
}
#shopify-section-{{ section.id }} .hero-badge {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  font-size: 14px;
}
#shopify-section-{{ section.id }} .stars {
  color: #00b67a;
}
#shopify-section-{{ section.id }} .hero-heading {
  font-size: 56px;
  line-height: 1.1;
  margin-bottom: 16px;
}
#shopify-section-{{ section.id }} .hero-sub {
  font-size: 18px;
  margin-bottom: 24px;
  opacity: 0.9;
}
#shopify-section-{{ section.id }} .hero-btn {
  display: inline-block;
  background: #fff;
  color: #000;
  padding: 14px 26px;
  font-weight: 600;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .hero-nav {
  display: flex;
  align-items: center;
  gap: 10px;
}
#shopify-section-{{ section.id }} .nav-btn {
  background: rgba(255,255,255,0.2);
  border: none;
  color: #fff;
  width: 42px;
  height: 42px;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .logo-bar {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: rgba(0,0,0,0.6);
  overflow: hidden;
  padding: 14px 0;
}
#shopify-section-{{ section.id }} .logo-track {
  display: flex;
  gap: 50px;
  white-space: nowrap;
  animation: scroll 28s linear infinite;
}
#shopify-section-{{ section.id }} .logo-item {
  font-size: 18px;
  opacity: 0.8;
}
@keyframes scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@media(max-width:768px){
  #shopify-section-{{ section.id }} .hero-inner { min-height: 520px; }
  #shopify-section-{{ section.id }} .hero-heading { font-size: 36px; }
  #shopify-section-{{ section.id }} .hero-content { flex-direction: column; }
}
</style>

{% schema %}
{
  "name": "Hero Adventure",
  "settings": [
    {"type":"image_picker","id":"image","label":"Background image"},
    {"type":"text","id":"badge_text","default":"Trusted by 100,000+ customers","label":"Badge text"},
    {"type":"text","id":"heading","default":"Ready for adventure","label":"Heading"},
    {"type":"textarea","id":"subtext","default":"The world's #1 rated backpacks and bags. Join over 1M happy customers and never lose your gear.","label":"Subtext"},
    {"type":"text","id":"button_label","default":"Shop now","label":"Button label"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "presets": [
    {"name":"Hero Adventure"}
  ]
}
{% endschema %}