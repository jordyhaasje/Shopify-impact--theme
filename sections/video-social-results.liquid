{% liquid
  assign video_count = 0
  assign stat_index = 0
  for block in section.blocks
    if block.type == 'video_card'
      assign video_count = video_count | plus: 1
    endif
  endfor
%}

<style>
  #shopify-section-{{ section.id }} {
    --vsr-bg: {{ section.settings.background }};
    --vsr-heading: {{ section.settings.heading_color }};
    --vsr-text: {{ section.settings.text_color }};
    --vsr-accent: {{ section.settings.accent_color }};
    --vsr-track: {{ section.settings.progress_track }};
    --vsr-divider: {{ section.settings.divider_color }};
    --vsr-button-bg: {{ section.settings.button_background }};
    --vsr-button-text: {{ section.settings.button_text_color }};
    --vsr-video-width: {{ section.settings.card_width }}px;
    --vsr-video-height: {{ section.settings.card_height }}px;
    --vsr-gap: {{ section.settings.cards_gap }}px;
    --vsr-panel-gap: {{ section.settings.panel_gap }}px;
    --vsr-stat-size: {{ section.settings.stat_circle_size }}px;
    --vsr-stat-stroke: {{ section.settings.stat_stroke }}px;
    --vsr-card-radius: {{ section.settings.card_radius }}px;
    --vsr-section-max: {{ section.settings.section_max_width }}px;
    --vsr-progress-width: {{ section.settings.video_progress_width }}%;
    background: var(--vsr-bg);
  }

  #shopify-section-{{ section.id }} .vsr-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .vsr-shell {
    max-width: var(--vsr-section-max);
    margin: 0 auto;
    padding-inline: 32px;
  }

  #shopify-section-{{ section.id }} .vsr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(430px, 0.95fr);
    gap: var(--vsr-panel-gap);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .vsr-media-area {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 22px;
    align-items: center;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .vsr-arrow {
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    color: var(--vsr-heading);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition: transform .25s ease, opacity .25s ease;
  }

  #shopify-section-{{ section.id }} .vsr-arrow:hover:not([disabled]) {
    transform: scale(1.08);
  }

  #shopify-section-{{ section.id }} .vsr-arrow[disabled] {
    opacity: .35;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .vsr-arrow svg {
    width: 30px;
    height: 30px;
    display: block;
  }

  #shopify-section-{{ section.id }} .vsr-carousel-mask {
    overflow: hidden;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .vsr-track {
    display: flex;
    gap: var(--vsr-gap);
    will-change: transform;
    transition: transform {{ section.settings.slide_duration }}ms cubic-bezier(.22,.61,.36,1);
  }

  #shopify-section-{{ section.id }} .vsr-card {
    position: relative;
    flex: 0 0 var(--vsr-video-width);
    width: var(--vsr-video-width);
    height: var(--vsr-video-height);
    border-radius: var(--vsr-card-radius);
    overflow: hidden;
    background: #ddd;
    transform: translateY(34px);
    opacity: 0;
    transition: transform .8s cubic-bezier(.22,.61,.36,1), opacity .8s ease;
  }

  #shopify-section-{{ section.id }} .vsr-card.is-visible,
  #shopify-section-{{ section.id }} .vsr-results.is-visible,
  #shopify-section-{{ section.id }} .vsr-stat.is-visible,
  #shopify-section-{{ section.id }} .vsr-button-wrap.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .vsr-card:nth-child(2) {
    transition-delay: .08s;
  }

  #shopify-section-{{ section.id }} .vsr-card:nth-child(3) {
    transition-delay: .16s;
  }

  #shopify-section-{{ section.id }} .vsr-card:nth-child(4) {
    transition-delay: .24s;
  }

  #shopify-section-{{ section.id }} .vsr-card-media,
  #shopify-section-{{ section.id }} .vsr-card-media video,
  #shopify-section-{{ section.id }} .vsr-card-media img,
  #shopify-section-{{ section.id }} .vsr-card-media .placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .vsr-card-media {
    position: relative;
  }

  #shopify-section-{{ section.id }} .vsr-card-media img,
  #shopify-section-{{ section.id }} .vsr-card-media video {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .vsr-card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, .78) 0%, rgba(0, 0, 0, .18) 34%, rgba(0, 0, 0, 0) 62%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .vsr-card-ui {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0 18px 16px;
    z-index: 2;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .vsr-progress-bar {
    height: 4px;
    margin: 0 4px 14px;
    background: rgba(255, 255, 255, .42);
    border-radius: 999px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .vsr-progress-bar span {
    display: block;
    width: var(--vsr-progress-width);
    height: 100%;
    background: #fff;
    border-radius: inherit;
  }

  #shopify-section-{{ section.id }} .vsr-video-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .vsr-video-icons {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .vsr-icon svg {
    display: block;
  }

  #shopify-section-{{ section.id }} .vsr-results {
    transform: translateY(30px);
    opacity: 0;
    transition: transform .85s cubic-bezier(.22,.61,.36,1), opacity .85s ease;
  }

  #shopify-section-{{ section.id }} .vsr-heading {
    margin: 0 0 34px;
    color: var(--vsr-heading);
    font-size: clamp(42px, 4.3vw, 68px);
    line-height: .98;
    letter-spacing: -.03em;
  }

  #shopify-section-{{ section.id }} .vsr-stats {
    display: grid;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .vsr-stat {
    display: grid;
    grid-template-columns: var(--vsr-stat-size) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    padding-block: 18px;
    transform: translateY(22px);
    opacity: 0;
    transition: transform .75s cubic-bezier(.22,.61,.36,1), opacity .75s ease;
  }

  #shopify-section-{{ section.id }} .vsr-stat + .vsr-stat {
    border-top: 1px solid var(--vsr-divider);
  }

  #shopify-section-{{ section.id }} .vsr-circle {
    position: relative;
    width: var(--vsr-stat-size);
    height: var(--vsr-stat-size);
  }

  #shopify-section-{{ section.id }} .vsr-circle svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  #shopify-section-{{ section.id }} .vsr-circle-track,
  #shopify-section-{{ section.id }} .vsr-circle-progress {
    fill: none;
    stroke-width: var(--vsr-stat-stroke);
  }

  #shopify-section-{{ section.id }} .vsr-circle-track {
    stroke: var(--vsr-track);
  }

  #shopify-section-{{ section.id }} .vsr-circle-progress {
    stroke: var(--vsr-accent);
    stroke-dasharray: 276.46;
    stroke-dashoffset: 276.46;
    transition: stroke-dashoffset 1.4s cubic-bezier(.22,.61,.36,1);
  }

  #shopify-section-{{ section.id }} .vsr-stat.is-visible .vsr-circle-progress {
    stroke-dashoffset: calc(276.46 - (276.46 * var(--percent, 0)) / 100);
  }

  #shopify-section-{{ section.id }} .vsr-circle-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vsr-accent);
    font-size: clamp(22px, 1.8vw, 30px);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .vsr-stat-copy {
    color: var(--vsr-text);
    font-size: clamp(18px, 1.5vw, 27px);
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .vsr-footnote {
    margin-top: 16px;
    color: var(--vsr-heading);
    font-size: clamp(14px, 1vw, 18px);
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .vsr-button-wrap {
    margin-top: 34px;
    transform: translateY(22px);
    opacity: 0;
    transition: transform .75s cubic-bezier(.22,.61,.36,1), opacity .75s ease;
    transition-delay: .25s;
  }

  #shopify-section-{{ section.id }} .vsr-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 210px;
    min-height: 64px;
    padding: 16px 34px;
    background: var(--vsr-button-bg);
    color: var(--vsr-button-text);
    border-radius: 4px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-size: 17px;
    font-weight: 700;
    transition: transform .25s ease, opacity .25s ease;
  }

  #shopify-section-{{ section.id }} .vsr-button:hover {
    transform: translateY(-2px);
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .vsr-shell {
      padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .vsr-grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --vsr-video-width: {{ section.settings.mobile_card_width }}px;
      --vsr-video-height: {{ section.settings.mobile_card_height }}px;
      --vsr-gap: {{ section.settings.mobile_cards_gap }}px;
      --vsr-stat-size: 88px;
    }

    #shopify-section-{{ section.id }} .vsr-section {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .vsr-shell {
      padding-inline: 14px;
    }

    #shopify-section-{{ section.id }} .vsr-media-area {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .vsr-arrow {
      width: 34px;
      height: 34px;
    }

    #shopify-section-{{ section.id }} .vsr-arrow svg {
      width: 24px;
      height: 24px;
    }

    #shopify-section-{{ section.id }} .vsr-heading {
      margin-bottom: 24px;
      font-size: clamp(34px, 11vw, 48px);
    }

    #shopify-section-{{ section.id }} .vsr-stat {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 16px;
      align-items: start;
      padding-block: 16px;
    }

    #shopify-section-{{ section.id }} .vsr-stat-copy {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .vsr-footnote {
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .vsr-button {
      width: 100%;
      min-width: 0;
    }
  }
</style>

<section class="vsr-section" data-vsr-section>
  <div class="vsr-shell">
    <div class="vsr-grid">
      <div class="vsr-media-area">
        <button class="vsr-arrow" type="button" aria-label="Previous videos" data-vsr-prev>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
        </button>

        <div class="vsr-carousel-mask">
          <div class="vsr-track" data-vsr-track>
            {% for block in section.blocks %}
              {% if block.type == 'video_card' %}
                <article class="vsr-card" {{ block.shopify_attributes }}>
                  <div class="vsr-card-media">
                    {% if block.settings.video != blank %}
                      {{ block.settings.video | video_tag: autoplay: block.settings.autoplay, loop: block.settings.loop_video, muted: true, controls: false, playsinline: true, image_size: '900x' }}
                    {% elsif block.settings.poster != blank %}
                      {{ block.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,480,640,800,900', sizes: '(max-width: 767px) 62vw, 320px', alt: block.settings.alt_text | escape }}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>

                  <div class="vsr-card-ui">
                    <div class="vsr-progress-bar"><span></span></div>
                    <div class="vsr-video-controls">
                      <div class="vsr-video-icons">
                        <span class="vsr-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><path d="M5.1 3.4v11.2L14.1 9 5.1 3.4Z"/></svg></span>
                        <span class="vsr-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="4" x2="20" y2="20"></line><path d="M9 9v6m6-6v6"></path></svg></span>
                      </div>
                      <span class="vsr-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><circle cx="9" cy="3" r="1.6"/><circle cx="9" cy="9" r="1.6"/><circle cx="9" cy="15" r="1.6"/></svg></span>
                    </div>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <button class="vsr-arrow" type="button" aria-label="Next videos" data-vsr-next>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>

      <div class="vsr-results" data-vsr-results>
        {% if section.settings.heading != blank %}
          <h2 class="vsr-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="vsr-stats">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              {% assign stat_index = stat_index | plus: 1 %}
              <div class="vsr-stat" data-vsr-stat style="--percent: {{ block.settings.percentage }}; transition-delay: {{ stat_index | times: 90 | minus: 40 }}ms;">
                <div class="vsr-circle">
                  <svg viewBox="0 0 100 100" aria-hidden="true">
                    <circle class="vsr-circle-track" cx="50" cy="50" r="44"></circle>
                    <circle class="vsr-circle-progress" cx="50" cy="50" r="44"></circle>
                  </svg>
                  <div class="vsr-circle-label">{{ block.settings.percentage }}%</div>
                </div>
                <div class="vsr-stat-copy">{{ block.settings.text }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.footnote != blank %}
          <div class="vsr-footnote">{{ section.settings.footnote }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <div class="vsr-button-wrap" data-vsr-button>
            <a class="vsr-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    const track = sectionEl.querySelector('[data-vsr-track]');
    const prevBtn = sectionEl.querySelector('[data-vsr-prev]');
    const nextBtn = sectionEl.querySelector('[data-vsr-next]');
    const cards = Array.from(sectionEl.querySelectorAll('.vsr-card'));
    const results = sectionEl.querySelector('[data-vsr-results]');
    const stats = Array.from(sectionEl.querySelectorAll('[data-vsr-stat]'));
    const buttonWrap = sectionEl.querySelector('[data-vsr-button]');

    if (!track || !cards.length) return;

    let index = 0;
    let timer = null;
    const visibleDesktop = {{ section.settings.visible_cards }};
    const visibleMobile = {{ section.settings.visible_cards_mobile }};
    const autoRotate = {{ section.settings.enable_autoplay | json }};
    const autoDelay = {{ section.settings.autoplay_speed | times: 1000 }};

    const visibleCount = () => window.innerWidth < 768 ? visibleMobile : visibleDesktop;

    const update = () => {
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      const cardWidth = cards[0].getBoundingClientRect().width;
      const maxIndex = Math.max(0, cards.length - visibleCount());
      index = Math.max(0, Math.min(index, maxIndex));
      const offset = index * (cardWidth + gap);
      track.style.transform = 'translate3d(' + (-offset) + 'px,0,0)';
      if (prevBtn) prevBtn.disabled = index <= 0;
      if (nextBtn) nextBtn.disabled = index >= maxIndex;
    };

    const next = () => {
      const maxIndex = Math.max(0, cards.length - visibleCount());
      index = index >= maxIndex ? 0 : index + 1;
      update();
    };

    const prev = () => {
      const maxIndex = Math.max(0, cards.length - visibleCount());
      index = index <= 0 ? maxIndex : index - 1;
      update();
    };

    const stopAutoplay = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const startAutoplay = () => {
      if (!autoRotate || cards.length <= visibleCount()) return;
      stopAutoplay();
      timer = window.setInterval(next, autoDelay);
    };

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prev();
        startAutoplay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        next();
        startAutoplay();
      });
    }

    sectionEl.addEventListener('mouseenter', stopAutoplay);
    sectionEl.addEventListener('mouseleave', startAutoplay);
    window.addEventListener('resize', update);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          cards.forEach((card) => card.classList.add('is-visible'));
          if (results) results.classList.add('is-visible');
          stats.forEach((item) => item.classList.add('is-visible'));
          if (buttonWrap) buttonWrap.classList.add('is-visible');
          obs.disconnect();
        });
      }, { threshold: 0.25 });

      observer.observe(sectionEl);
    } else {
      cards.forEach((card) => card.classList.add('is-visible'));
      if (results) results.classList.add('is-visible');
      stats.forEach((item) => item.classList.add('is-visible'));
      if (buttonWrap) buttonWrap.classList.add('is-visible');
    }

    update();
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Video social results",
  "tag": "section",
  "class": "shopify-section--video-social-results",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Results" },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "* Observed in a 3-week clinical study of 96 participants ages 18-29" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "section_max_width", "min": 1200, "max": 1800, "step": 20, "unit": "px", "label": "Section max width", "default": 1680 },
    { "type": "range", "id": "panel_gap", "min": 24, "max": 140, "step": 2, "unit": "px", "label": "Column gap", "default": 72 },
    { "type": "range", "id": "card_width", "min": 180, "max": 360, "step": 2, "unit": "px", "label": "Desktop card width", "default": 262 },
    { "type": "range", "id": "card_height", "min": 320, "max": 620, "step": 4, "unit": "px", "label": "Desktop card height", "default": 472 },
    { "type": "range", "id": "cards_gap", "min": 8, "max": 48, "step": 1, "unit": "px", "label": "Desktop card gap", "default": 22 },
    { "type": "range", "id": "visible_cards", "min": 1, "max": 4, "step": 1, "label": "Visible cards on desktop", "default": 3 },
    { "type": "range", "id": "mobile_card_width", "min": 160, "max": 280, "step": 2, "unit": "px", "label": "Mobile card width", "default": 216 },
    { "type": "range", "id": "mobile_card_height", "min": 260, "max": 520, "step": 4, "unit": "px", "label": "Mobile card height", "default": 360 },
    { "type": "select", "id": "visible_cards_mobile", "label": "Visible cards on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "1" },
    { "type": "range", "id": "mobile_cards_gap", "min": 8, "max": 32, "step": 1, "unit": "px", "label": "Mobile card gap", "default": 14 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Card radius", "default": 12 },
    { "type": "range", "id": "stat_circle_size", "min": 72, "max": 160, "step": 2, "unit": "px", "label": "Stat circle size", "default": 118 },
    { "type": "range", "id": "stat_stroke", "min": 4, "max": 16, "step": 1, "unit": "px", "label": "Stat circle stroke", "default": 8 },
    { "type": "range", "id": "video_progress_width", "min": 10, "max": 100, "step": 1, "unit": "%", "label": "Video progress width", "default": 24 },
    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Auto-rotate cards", "default": false },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 10, "step": 1, "unit": "sec", "label": "Auto-rotate speed", "default": 5 },
    { "type": "range", "id": "slide_duration", "min": 150, "max": 1200, "step": 50, "unit": "ms", "label": "Slide animation duration", "default": 600 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f3f3f3" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#202020" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5a5a5a" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#f36c83" },
