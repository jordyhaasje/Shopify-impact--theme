<section class="uitgelicht-product-pro section-{{ section.id }}">
  <div class="uitgelicht-product-pro__inner">

    <div class="uitgelicht-product-pro__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="uitgelicht-product-pro__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="uitgelicht-product-pro__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <div class="uitgelicht-product-pro__slider" data-slider>
      <div class="uitgelicht-product-pro__track">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}

          {%- if product != blank -%}
            <div class="uitgelicht-product-pro__slide" {{ block.shopify_attributes }}>
              <div class="uitgelicht-product-pro__card">

                <a href="{{ product.url }}" class="uitgelicht-product-pro__media">
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                </a>

                <div class="uitgelicht-product-pro__content">
                  <h3>{{ product.title }}</h3>
                  <div class="price">
                    {%- render 'price-list', product: product -%}
                  </div>

                  <a href="{{ product.url }}" class="btn">
                    {{ section.settings.button_label }}
                  </a>
                </div>

              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>

  <style>
    .uitgelicht-product-pro__inner {
      padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    }

    .uitgelicht-product-pro__header {
      margin-bottom: 12px;
    }

    .uitgelicht-product-pro__eyebrow {
      font-size: 11px;
      text-transform: uppercase;
      opacity: .6;
    }

    .uitgelicht-product-pro__title {
      font-size: 26px;
      font-weight: 700;
      margin: 4px 0 0;
    }

    .uitgelicht-product-pro__slider {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .uitgelicht-product-pro__track {
      display: flex;
      gap: 12px;
    }

    .uitgelicht-product-pro__slide {
      min-width: 75%;
      scroll-snap-align: start;
      opacity: 0;
      transform: translateY(20px);
      animation: fadeUp .6s ease forwards;
    }

    .uitgelicht-product-pro__card {
      background: #fff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,.05);
    }

    .uitgelicht-product-pro__media {
      display:block;
      aspect-ratio:1;
      overflow:hidden;
    }

    .uitgelicht-product-pro__content {
      padding: 12px;
      display:grid;
      gap:6px;
    }

    @keyframes fadeUp {
      to {
        opacity:1;
        transform:translateY(0);
      }
    }

    @media(min-width:768px){
      .uitgelicht-product-pro__slide{
        min-width: 30%;
      }
    }
  </style>

  {% schema %}
  {
    "name": "Uitgelicht product PRO",
    "settings": [
      {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Aanbevolen"},
      {"type":"text","id":"title","label":"Titel","default":"Onze favorieten"},
      {"type":"text","id":"button_label","label":"Button","default":"Shop nu"},
      {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":60,"step":4,"default":24},
      {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":60,"step":4,"default":24}
    ],
    "blocks": [
      {"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}
    ],
    "presets":[{"name":"Uitgelicht product PRO"}]
  }
  {% endschema %}
</section>