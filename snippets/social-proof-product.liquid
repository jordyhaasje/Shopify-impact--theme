<div class="social-proof">
  <div class="social-proof__avatars">
    {% for i in (1..3) %}
      {% assign key = 'avatar_' | append: i %}
      {% if block.settings[key] != blank %}
        {{
          block.settings[key]
          | image_url: width: 120
          | image_tag: class: 'social-proof__avatar'
        }}
      {% endif %}
    {% endfor %}
  </div>

  <p class="social-proof__text">
    <strong>{{ block.settings.name }}</strong>

    {% if block.settings.show_verified %}
      <span class="verified">✔</span>
    {% endif %}

    <span>{{ block.settings.text_1 }}</span>
    <strong>{{ block.settings.text_bold }}</strong>
    <span>{{ block.settings.text_2 }}</span>
  </p>
</div>

<style>
.social-proof{
  display:flex;
  align-items:center;
  gap:16px;
  padding:16px 18px;
  border-radius:16px;
  background: {{ block.settings.bg }};
}

.social-proof__avatars{
  display:flex;
}

.social-proof__avatar{
  width:48px;
  height:48px;
  border-radius:50%;
  object-fit:cover;
  margin-left:-12px;
  border:2px solid white;
}

.social-proof__avatar:first-child{
  margin-left:0;
}

.social-proof__text{
  margin:0;
  font-size:15px;
  line-height:1.4;
  color: {{ block.settings.color }};
}

.social-proof__text strong{
  font-weight:700;
}

.verified{
  color:#3b82f6;
  margin:0 4px;
}

@media(max-width:749px){
  .social-proof__avatar{
    width:40px;
    height:40px;
  }

  .social-proof__text{
    font-size:14px;
  }
}
</style>