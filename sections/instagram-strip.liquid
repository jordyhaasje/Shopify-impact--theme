{% render 'section-spacing-collapsing' %}

<section class="ig-strip">
  <div {% render 'section-properties', tight: true %}>
    <div class="container">

      {% if section.settings.heading != blank %}
        <h2 class="ig-strip__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="ig-strip__grid">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="ig-strip__item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
            {% endif %}
            <div class="ig-strip__overlay">
              <svg viewBox="0 0 24 24"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5a5 5 0 100 10 5 5 0 000-10z" fill="white"/></svg>
            </div>
          </a>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<style>
.ig-strip__heading{text-align:center;font-size:32px;font-weight:700;margin-bottom:24px}
.ig-strip__grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
.ig-strip__item{position:relative;display:block;overflow:hidden}
.ig-strip__item img{width:100%;height:100%;object-fit:cover}
.ig-strip__overlay{position:absolute;inset:0;background:rgba(0,0,0,.4);opacity:0;display:flex;align-items:center;justify-content:center;transition:.3s}
.ig-strip__item:hover .ig-strip__overlay{opacity:1}
@media(max-width:749px){.ig-strip__grid{grid-template-columns:repeat(2,1fr)}}
</style>

{% schema %}
{
  "name": "Instagram strip",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"FOLLOW US @ICON"}
  ],
  "blocks": [
    {
      "type":"image",
      "name":"Image",
      "settings":[
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [{"name":"Instagram strip"}]
}
{% endschema %}