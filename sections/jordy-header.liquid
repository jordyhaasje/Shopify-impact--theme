    { "type": "range", "id": "scene_darkness_left", "label": "Scene darkness left", "min": 0, "max": 100, "step": 1, "default": 66 },
    { "type": "range", "id": "scene_darkness_right", "label": "Scene darkness right", "min": 0, "max": 100, "step": 1, "default": 30 },
    { "type": "range", "id": "scene_image_opacity", "label": "Scene image opacity", "min": 30, "max": 100, "step": 1, "default": 100 },
