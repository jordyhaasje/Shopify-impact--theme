{% render 'section-spacing-collapsing' %}

<style>
  #shopify-section-{{ section.id }} {
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-content-max-width: {{ section.settings.content_max_width }}px;
    --hero-media-height: {{ section.settings.hero_height }}px;
    --hero-content-left: {{ section.settings.content_left }}px;
    --hero-content-bottom: {{ section.settings.content_bottom }}px;
    --hero-logo-height: {{ section.settings.logo_height }}px;
    --hero-logo-gap: {{ section.settings.logo_gap }}px;
    --hero-logo-speed: {{ section.settings.logo_speed }}s;
    --hero-badge-stars-bg: {{ section.settings.badge_stars_background.red }}, {{ section.settings.badge_stars_background.green }}, {{ section.settings.badge_stars_background.blue }};
    --hero-badge-text: {{ section.settings.badge_text_color.red }}, {{ section.settings.badge_text_color.green }}, {{ section.settings.badge_text_color.blue }};
    --hero-heading: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --hero-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --hero-logo-bar: {{ section.settings.logo_bar_background.red }}, {{ section.settings.logo_bar_background.green }}, {{ section.settings.logo_bar_background.blue }};
    --hero-logo-opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    --section-outer-spacing-block: 0px;
  }

  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    overflow: clip;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .hero-adventure {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: 0;
    background: {{ section.settings.background }};
  }

  #shopify-section-{{ section.id }} .hero-adventure,
  #shopify-section-{{ section.id }} .hero-adventure__inner,
  #shopify-section-{{ section.id }} .hero-adventure__frame {
    min-width: 100%;
  }

  #shopify-section-{{ section.id }} .hero-adventure__inner {
    position: relative;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .hero-adventure__frame {
    position: relative;
    min-height: var(--hero-media-height);
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.background }};
  }

  #shopify-section-{{ section.id }} .hero-adventure__media {
    position: absolute;
    inset: 0;
    background: {{ section.settings.background }};
  }

  #shopify-section-{{ section.id }} .hero-adventure__image,
  #shopify-section-{{ section.id }} .hero-adventure__placeholder {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  #shopify-section-{{ section.id }} .hero-adventure__placeholder svg {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .hero-adventure__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.5) 23%, rgba(0,0,0,0.24) 47%, rgba(0,0,0,0.06) 69%, rgba(0,0,0,0) 100%),
      linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.08) 38%, rgba(0,0,0,0.42) 100%),
      rgba(0,0,0,var(--hero-overlay-opacity));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hero-adventure__content-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hero-adventure__content {
    position: absolute;
    left: max(var(--hero-content-left), env(safe-area-inset-left));
    right: max(24px, env(safe-area-inset-right));
    bottom: calc(var(--hero-content-bottom) + var(--hero-logo-height) + 34px);
    max-width: var(--hero-content-max-width);
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .hero-adventure__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: rgb(var(--hero-badge-text));
    font-size: 15px;
    line-height: 1.2;
    font-weight: 600;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hero-adventure__trustpilot {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .hero-adventure__trustpilot-label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: rgb(var(--hero-badge-text));
  }

  #shopify-section-{{ section.id }} .hero-adventure__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 5px 7px;
    border-radius: 2px;
    background: rgb(var(--hero-badge-stars-bg));
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  #shopify-section-{{ section.id }} .hero-adventure__star {
    width: 10px;
    height: 10px;
    display: block;
    color: #fff;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .hero-adventure__heading {
    margin: 0;
    color: rgb(var(--hero-heading));
    font-size: clamp(38px, 4.2vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 600;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .hero-adventure__text {
    margin-top: 16px;
    color: rgb(var(--hero-text));
    font-size: 17px;
    line-height: 1.45;
    max-width: 620px;
  }

  #shopify-section-{{ section.id }} .hero-adventure__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hero-adventure__actions {
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .hero-adventure__marquee {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    overflow: hidden;
    padding: 14px 0 16px;
    background: linear-gradient(180deg, rgba(var(--hero-logo-bar), 0.18) 0%, rgba(var(--hero-logo-bar), 0.72) 100%);
  }

  #shopify-section-{{ section.id }} .hero-adventure__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: var(--hero-logo-gap);
    animation: hero-adventure-marquee var(--hero-logo-speed) linear infinite;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .hero-adventure__logo-item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .hero-adventure__logo-image {
    height: var(--hero-logo-height);
    width: auto;
    display: block;
    opacity: var(--hero-logo-opacity);
    filter: grayscale(1) brightness(3.2);
  }

  #shopify-section-{{ section.id }} .hero-adventure__logo-text {
    font-size: clamp(30px, 2vw, 42px);
    line-height: 1;
    color: rgba(255,255,255,0.95);
    opacity: var(--hero-logo-opacity);
    white-space: nowrap;
    font-family: Georgia, 'Times New Roman', serif;
    letter-spacing: 0.03em;
  }

  @keyframes hero-adventure-marquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .hero-adventure__content {
      left: 36px;
      max-width: 460px;
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .hero-adventure {
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
    }

    #shopify-section-{{ section.id }} .hero-adventure__frame {
      min-height: 460px;
    }

    #shopify-section-{{ section.id }} .hero-adventure__content {
      left: 22px;
      right: 22px;
      bottom: calc(18px + var(--hero-logo-height) + 34px);
      max-width: 320px;
    }

    #shopify-section-{{ section.id }} .hero-adventure__badge {
      font-size: 13px;
      gap: 8px;
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .hero-adventure__trustpilot-label {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .hero-adventure__heading {
      font-size: clamp(28px, 9vw, 38px);
      line-height: 1.02;
    }

    #shopify-section-{{ section.id }} .hero-adventure__text {
      font-size: 15px;
      line-height: 1.5;
      margin-top: 14px;
    }

    #shopify-section-{{ section.id }} .hero-adventure__marquee {
      padding: 10px 0 12px;
    }

    #shopify-section-{{ section.id }} .hero-adventure__logo-text {
      font-size: 24px;
    }
  }
</style>

<section class="hero-adventure">
  <div class="hero-adventure__inner">
    <div class="hero-adventure__frame">
      <div class="hero-adventure__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 3200 | image_tag: loading: 'eager', widths: '1200,1600,2000,2400,3200', class: 'hero-adventure__image', alt: section.settings.heading }}
        {%- else -%}
          <div class="hero-adventure__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>

      <div class="hero-adventure__overlay"></div>

      <div class="hero-adventure__content-wrap">
        <div class="hero-adventure__content">
          {%- if section.settings.badge_text != blank -%}
            <p class="hero-adventure__badge">
              <span class="hero-adventure__trustpilot" aria-hidden="true">
                <span class="hero-adventure__trustpilot-label">Trustpilot</span>
                <span class="hero-adventure__stars">
                  {%- for i in (1..5) -%}
                    <svg class="hero-adventure__star" viewBox="0 0 20 20" fill="currentColor" focusable="false" aria-hidden="true">
                      <path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"></path>
                    </svg>
                  {%- endfor -%}
                </span>
              </span>
              <span>{{ section.settings.badge_text | escape }}</span>
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="hero-adventure__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="hero-adventure__text rte">
              <p>{{ section.settings.text | escape }}</p>
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="hero-adventure__actions">
              {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'lg', style: 'fill', background: section.settings.button_background, text_color: section.settings.button_text_color %}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="hero-adventure__marquee" aria-label="Featured logos">
        <div class="hero-adventure__track">
          {%- for duplicate in (1..2) -%}
            {%- for block in section.blocks -%}
              <div class="hero-adventure__logo-item" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120,200,300,400', class: 'hero-adventure__logo-image', alt: block.settings.alt_text | default: block.settings.logo_text }}
                {%- elsif block.settings.logo_text != blank -%}
                  <span class="hero-adventure__logo-text">{{ block.settings.logo_text | escape }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero adventure",
  "tag": "section",
  "class": "shopify-section--hero-adventure",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Trusted by 100,000+ customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready for adventure"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The world’s #1 rated backpacks and bags. Join over 1M happy customers and never lose your gear."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height",
      "min": 420,
      "max": 760,
      "step": 10,
      "default": 500
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 700,
      "step": 10,
      "default": 500
    },
    {
      "type": "range",
      "id": "content_left",
      "label": "Content left offset",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "content_bottom",
      "label": "Content bottom offset",
      "min": 10,
      "max": 120,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "content": "Logo marquee"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 18,
      "max": 48,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Logo gap",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_speed",
      "label": "Logo scroll duration",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 90
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_stars_background",
      "label": "Badge stars background",
      "default": "#00B67A"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "logo_bar_background",
      "label": "Logo bar background",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#EDE9E4"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#1E1E1E"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_text",
          "label": "Fallback logo text",
          "default": "VOGUE"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero adventure",
      "blocks": [
        { "type": "logo", "settings": { "logo_text": "Women’sHealth" } },
        { "type": "logo", "settings": { "logo_text": "VOGUE" } },
        { "type": "logo", "settings": { "logo_text": "BAZAAR" } },
        { "type": "logo", "settings": { "logo_text": "GRAZIA" } },
        { "type": "logo", "settings": { "logo_text": "ELLE" } }
      ]
    }
  ]
}
{% endschema %}