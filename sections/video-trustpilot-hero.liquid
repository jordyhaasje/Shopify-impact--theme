{%- render 'section-spacing-collapsing' -%}

<style>
#shopify-section-{{ section.id }} {
  --tp-green: 0, 182, 122;
  --tp-dark: 25, 25, 25;
  --tp-light: 255,255,255;
  --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
}

.video-hero {
  position: relative;
  overflow: hidden;
}

.video-hero__media {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.video-hero__media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.video-hero__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,var(--overlay-opacity));
  z-index: 2;
}

.video-hero__content {
  position: relative;
  z-index: 3;
  padding: 80px 20px;
  text-align: center;
  color: #fff;
}

.video-hero__badge {
  display:inline-flex;
  align-items:center;
  gap:8px;
  background: rgb(var(--tp-light));
  color: rgb(var(--tp-dark));
  padding:6px 12px;
  border-radius:999px;
  font-size:13px;
  font-weight:600;
}

.video-hero__stars {
  display:flex;
  gap:4px;
}

.video-hero__star {
  width:18px;
  height:18px;
  background: rgb(var(--tp-green));
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:2px;
}

.video-hero__heading {
  font-size: clamp(32px,5vw,56px);
  margin-top:20px;
  font-weight:600;
}

.video-hero__sub {
  margin-top:16px;
  font-size:18px;
  opacity:.9;
}

.video-hero__actions {
  margin-top:24px;
  display:flex;
  gap:12px;
  justify-content:center;
  flex-wrap:wrap;
}

@media(max-width:699px){
  .video-hero__content{padding:60px 16px}
  .video-hero__heading{font-size:32px}
}
</style>

<section class="video-hero">
  <div {% render 'section-properties' %}>

    <div class="video-hero__media">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
      {% endif %}
    </div>

    <div class="video-hero__overlay"></div>

    <div class="container video-hero__content">

      <div class="video-hero__badge">
        <div class="video-hero__stars">
          {% for i in (1..5) %}
            <span class="video-hero__star">★</span>
          {% endfor %}
        </div>
        <span>{{ section.settings.rating_text }}</span>
      </div>

      <h2 class="video-hero__heading">{{ section.settings.heading }}</h2>

      <div class="video-hero__sub rte">
        {{ section.settings.subheading }}
      </div>

      <div class="video-hero__actions">
        {% if section.settings.button_1_label != blank %}
          {% render 'button', content: section.settings.button_1_label, href: section.settings.button_1_link, size: 'lg' %}
        {% endif %}

        {% if section.settings.button_2_label != blank %}
          {% render 'button', content: section.settings.button_2_label, href: section.settings.button_2_link, style: 'outline', size: 'lg' %}
        {% endif %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Video Hero Trustpilot",
  "settings": [
    {"type":"video","id":"video","label":"Background video"},
    {"type":"range","id":"overlay_opacity","min":0,"max":80,"step":5,"default":30,"label":"Overlay opacity"},

    {"type":"text","id":"rating_text","label":"Rating text","default":"Rated 4.8 / 5 on Trustpilot"},

    {"type":"text","id":"heading","label":"Heading","default":"Trusted by thousands"},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Join customers who love our brand</p>"},

    {"type":"text","id":"button_1_label","label":"Primary button label","default":"Shop now"},
    {"type":"url","id":"button_1_link","label":"Primary button link"},

    {"type":"text","id":"button_2_label","label":"Secondary button label","default":"Learn more"},
    {"type":"url","id":"button_2_link","label":"Secondary button link"}
  ],
  "presets": [
    {
      "name":"Video Hero Trustpilot"
    }
  ]
}
{% endschema %}