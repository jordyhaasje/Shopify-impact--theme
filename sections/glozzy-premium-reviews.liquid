{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --gz-bg: {{ section.settings.background_color }};
    --gz-card: {{ section.settings.card_color }};
    --gz-text: {{ section.settings.text_color }};
    --gz-muted: {{ section.settings.muted_text_color }};
    --gz-accent: {{ section.settings.accent_color }};
    --gz-star: {{ section.settings.star_color }};
    --gz-surface: #f7f5f2;
    --gz-line: rgba(18, 18, 18, .10);
    --gz-line-soft: rgba(18, 18, 18, .065);
  }

  #shopify-section-{{ section.id }} .gz-douglas {
    color: var(--gz-text);
    background: linear-gradient(180deg, #fff 0%, color-mix(in srgb, var(--gz-bg) 72%, #fff) 100%);
  }

  #shopify-section-{{ section.id }} .gz-douglas__shell {
    max-width: {{ section.settings.content_width }}px;
    margin-inline: auto;
    padding: {{ section.settings.padding_y }}px 20px;
  }

  #shopify-section-{{ section.id }} .gz-douglas__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
    align-items: end;
    gap: clamp(28px, 6vw, 92px);
    padding-bottom: clamp(26px, 4vw, 44px);
    border-bottom: 1px solid var(--gz-line);
  }

  #shopify-section-{{ section.id }} .gz-douglas__eyebrow {
    margin-bottom: 14px;
    color: var(--gz-muted);
    font-size: 11px;
    font-weight: 760;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gz-douglas__title {
    margin: 0;
    max-width: 760px;
    color: var(--gz-text);
    font-family: var(--heading-font-family);
    font-size: clamp(36px, 5.6vw, 72px);
    line-height: .96;
    letter-spacing: -.055em;
  }

  #shopify-section-{{ section.id }} .gz-douglas__title span {
    color: var(--gz-text);
    font-style: italic;
    font-weight: inherit;
  }

  #shopify-section-{{ section.id }} .gz-douglas__text {
    color: var(--gz-muted);
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.75;
  }

  #shopify-section-{{ section.id }} .gz-douglas__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0 20px;
  }

  #shopify-section-{{ section.id }} .gz-douglas__rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--gz-text);
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .gz-douglas__stars {
    color: var(--gz-star);
    font-size: 13px;
    letter-spacing: .08em;
  }

  #shopify-section-{{ section.id }} .gz-douglas__note {
    color: var(--gz-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gz-douglas__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--gz-line-soft);
    border-left: 1px solid var(--gz-line-soft);
    background: #fff;
  }

  #shopify-section-{{ section.id }} .gz-review {
    min-height: 278px;
    padding: clamp(22px, 2.8vw, 34px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 30px;
    border-right: 1px solid var(--gz-line-soft);
    border-bottom: 1px solid var(--gz-line-soft);
    background: var(--gz-card);
    transition: background .22s ease, transform .22s ease;
  }

  #shopify-section-{{ section.id }} .gz-review:hover {
    background: color-mix(in srgb, var(--gz-card) 88%, var(--gz-surface));
  }

  #shopify-section-{{ section.id }} .gz-review__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--gz-star);
    font-size: {{ section.settings.star_size }}px;
    letter-spacing: .02em;
  }

  #shopify-section-{{ section.id }} .gz-review__quote {
    margin: 18px 0 0;
    max-width: 92%;
    color: var(--gz-text);
    font-family: var(--heading-font-family);
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.28;
    letter-spacing: -.035em;
  }

  #shopify-section-{{ section.id }} .gz-review__author {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--gz-line-soft);
  }

  #shopify-section-{{ section.id }} .gz-review__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    background: var(--gz-surface);
    border: 1px solid var(--gz-line-soft);
    color: var(--gz-text);
    font-size: 12px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .gz-review__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .gz-review__name {
    color: var(--gz-text);
    font-size: 13px;
    font-weight: 760;
    letter-spacing: -.01em;
  }

  #shopify-section-{{ section.id }} .gz-review__label {
    margin-top: 2px;
    color: var(--gz-muted);
    font-size: 12px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gz-douglas__top {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .gz-douglas__text {
      max-width: 680px;
    }

    #shopify-section-{{ section.id }} .gz-douglas__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .gz-douglas__shell {
      padding: {{ section.settings.mobile_padding_y }}px 16px;
    }

    #shopify-section-{{ section.id }} .gz-douglas__title {
      font-size: clamp(34px, 11vw, 50px);
      line-height: .98;
    }

    #shopify-section-{{ section.id }} .gz-douglas__meta {
      display: block;
      padding: 18px 0;
    }

    #shopify-section-{{ section.id }} .gz-douglas__note {
      display: block;
      margin-top: 8px;
    }

    #shopify-section-{{ section.id }} .gz-douglas__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      border-left: 0;
      background: transparent;
      gap: 12px;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .gz-douglas__grid::-webkit-scrollbar { display: none; }

    #shopify-section-{{ section.id }} .gz-review {
      flex: 0 0 86%;
      min-height: 252px;
      scroll-snap-align: start;
      border: 1px solid var(--gz-line-soft);
      background: #fff;
    }

    #shopify-section-{{ section.id }} .gz-review__quote {
      max-width: 100%;
      font-size: 21px;
    }
  }
</style>

<section class="gz-douglas" data-section-id="{{ section.id }}">
  <div class="gz-douglas__shell" data-section-bounded-shell>
    <div class="gz-douglas__top">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="gz-douglas__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="gz-douglas__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.text != blank -%}
        <div class="gz-douglas__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="gz-douglas__meta">
      <div class="gz-douglas__rating">
        <span class="gz-douglas__stars" aria-hidden="true">★★★★★</span>
        <span>Reviewed by the Glozzy community</span>
      </div>
      <span class="gz-douglas__note">Premium beauty proof</span>
    </div>

    <div class="gz-douglas__grid" aria-label="{{ section.settings.heading | strip_html | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="gz-review" data-section-review-item {{ block.shopify_attributes }}>
            <div>
              <div class="gz-review__stars" aria-label="{{ block.settings.rating }} van 5 sterren">
                {%- for i in (1..5) -%}<span>{% if i <= block.settings.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}
              </div>

              {%- if block.settings.quote != blank -%}
                <p class="gz-review__quote">{{ block.settings.quote | escape }}</p>
              {%- endif -%}
            </div>

            <div class="gz-review__author">
              <div class="gz-review__avatar">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: block.settings.author }}
                {%- else -%}
                  {{ block.settings.author | slice: 0 | upcase }}
                {%- endif -%}
              </div>
              <div>
                <div class="gz-review__name">{{ block.settings.author | escape }}</div>
                {%- if block.settings.label != blank -%}<div class="gz-review__label">{{ block.settings.label | escape }}</div>{%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Glozzy premium reviews",
  "class": "shopify-section--glozzy-premium-reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by beauty lovers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glozzy glow, <span>real reviews</span>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Een strakke premium reviewsectie met een rustige beauty-retail uitstraling, veel witruimte en verfijnde customer proof.</p>" },
    { "type": "text", "id": "beauty_icons", "label": "Legacy beauty products text", "default": "Lip Gloss, Blush, Serum, Mascara, Highlighter, Lip Oil, Primer, Setting Spray" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 900, "max": 1120, "step": 20, "unit": "px", "default": 1060 },
    { "type": "range", "id": "padding_y", "label": "Desktop vertical padding", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "mobile_padding_y", "label": "Mobile vertical padding", "min": 36, "max": 84, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "star_size", "label": "Star size", "min": 16, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "marquee_speed", "label": "Legacy icon speed", "min": 12, "max": 42, "step": 2, "unit": "s", "default": 24 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f7f5f2" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#6f6a66" },
    { "type": "color", "id": "accent_color", "label": "Soft accent", "default": "#a88f7b" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#121212" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "De gloss voelt luxe, blijft mooi zitten en geeft precies die soft pink shine waar ik naar zocht." },
        { "type": "text", "id": "author", "label": "Name", "default": "Sophie M." },
        { "type": "text", "id": "label", "label": "Label", "default": "Verified Glozzy customer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glozzy premium reviews",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "De kleur, shine en verpakking voelen echt high-end. Mijn everyday lip gloss.", "author": "Lina R.", "label": "Verified customer" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Super zacht op mijn lippen en de roze glow past perfect bij mijn make-up routine.", "author": "Amira K.", "label": "Beauty lover" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Glozzy ziet eruit als een premium beauty brand. De finish is glossy maar niet plakkerig.", "author": "Noor V.", "label": "Repeat customer" } },
        { "type": "review", "settings": { "rating": 4, "quote": "Prachtige zachte tinten en heel professioneel. Ik krijg er vaak complimenten over.", "author": "Eva S.", "label": "Verified customer" } }
      ]
    }
  ]
}
{% endschema %}