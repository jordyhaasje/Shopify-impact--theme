{% liquid
  assign reviews = section.blocks | where: 'type', 'review'
  assign star_color = section.settings.star_color | default: '#00b67a'
  assign bg_color = section.settings.bg_color | default: '#f9f9f9'
  assign card_bg = section.settings.card_bg | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#1a1a1a'
  assign border_radius = section.settings.border_radius | default: 12
  assign card_spacing = section.settings.card_spacing | default: 24
  assign columns = section.settings.columns | default: 3
  assign badge_text = section.settings.badge_text | default: 'Excellent'
  assign score_text = section.settings.score_text | default: '4.8'
  assign review_count = section.settings.review_count | default: '2,847'
  assign show_badge = section.settings.show_badge
  assign show_verified = section.settings.show_verified
  assign verified_label = section.settings.verified_label | default: 'Verified'
%}

<style>
  #shopify-section-{{ section.id }} {
    --tp-bg: {{ bg_color }};
    --tp-card-bg: {{ card_bg }};
    --tp-text: {{ text_color }};
    --tp-star: {{ star_color }};
    --tp-radius: {{ border_radius }}px;
    --tp-gap: {{ card_spacing }}px;
    background-color: var(--tp-bg);
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .tp-section__container {
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .tp-section__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .tp-section__title {
    font-size: {{ section.settings.title_size | default: 32 }}px;
    font-weight: 700;
    color: var(--tp-text);
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .tp-section__subtitle {
    font-size: {{ section.settings.subtitle_size | default: 16 }}px;
    color: {{ section.settings.subtitle_color | default: '#666666' }};
    margin: 0;
    line-height: 1.5;
  }

  .tp-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--tp-card-bg);
    border-radius: var(--tp-radius);
    padding: 16px 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-bottom: 36px;
  }

  .tp-badge__score {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--tp-star);
    color: #fff;
    font-weight: 800;
    font-size: 18px;
    border-radius: 8px;
  }

  .tp-badge__info {
    text-align: left;
  }

  .tp-badge__label {
    font-size: 18px;
    font-weight: 700;
    color: var(--tp-text);
    margin: 0 0 2px;
  }

  .tp-badge__meta {
    font-size: 14px;
    color: {{ section.settings.subtitle_color | default: '#666666' }};
    margin: 0;
  }

  .tp-grid {
    display: grid;
    grid-template-columns: repeat({{ columns }}, 1fr);
    gap: var(--tp-gap);
  }

  @media (max-width: 989px) {
    .tp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .tp-section__title {
      font-size: 26px;
    }
  }

  @media (max-width: 749px) {
    .tp-grid {
      grid-template-columns: 1fr;
    }
    .tp-section__title {
      font-size: 24px;
    }
  }

  .tp-card {
    background: var(--tp-card-bg);
    border-radius: var(--tp-radius);
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  {% if section.settings.card_hover %}
  .tp-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  {% endif %}

  .tp-card__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 14px;
  }

  .tp-card__star {
    width: 18px;
    height: 18px;
    color: var(--tp-star);
    flex-shrink: 0;
  }

  .tp-card__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--tp-text);
    margin: 0 0 18px;
    flex-grow: 1;
  }

  .tp-card__author {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }

  .tp-card__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    background: #e5e5e5;
    flex-shrink: 0;
  }

  .tp-card__name {
    font-size: 14px;
    font-weight: 600;
    color: var(--tp-text);
    margin: 0;
  }

  .tp-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: {{ section.settings.subtitle_color | default: '#666666' }};
    margin: 2px 0 0;
  }

  .tp-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--tp-star);
    font-weight: 600;
  }

  .tp-card__verified svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
  }
</style>

<section id="shopify-section-{{ section.id }}" class="tp-section">
  <div class="tp-section__container">
    <div class="tp-section__header">
      {% if section.settings.title != blank %}
        <h2 class="tp-section__title">{{ section.settings.title | escape }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="tp-section__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
      {% if show_badge %}
        <div class="tp-badge">
          <div class="tp-badge__score">{{ score_text }}</div>
          <div class="tp-badge__info">
            <p class="tp-badge__label">{{ badge_text }}</p>
            <p class="tp-badge__meta">Based on {{ review_count }} reviews</p>
          </div>
        </div>
      {% endif %}
    </div>

    {% if reviews.size > 0 %}
      <div class="tp-grid">
        {% for block in reviews %}
          <div class="tp-card" {{ block.shopify_attributes }}>
            <div class="tp-card__stars">
              {% assign rating = block.settings.rating | default: 5 | plus: 0 %}
              {% for i in (1..5) %}
                <svg class="tp-card__star" viewBox="0 0 24 24" fill="{% if i <= rating %}currentColor{% else %}#e0e0e0{% endif %}">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            <p class="tp-card__text">{{ block.settings.text | escape }}</p>
            <div class="tp-card__author">
              {% if block.settings.avatar != blank %}
                <img class="tp-card__avatar" src="{{ block.settings.avatar | image_url: width: 72 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="36" height="36">
              {% else %}
                <div class="tp-card__avatar" style="display:flex;align-items:center;justify-content:center;color:#999;font-size:12px;font-weight:700;">
                  {{ block.settings.name | slice: 0 | upcase }}
                </div>
              {% endif %}
              <div>
                <p class="tp-card__name">{{ block.settings.name | escape }}</p>
                <div class="tp-card__meta">
                  {% if show_verified and block.settings.verified %}
                    <span class="tp-card__verified">
                      <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                      {{ verified_label }}
                    </span>
                  {% endif %}
                  <span>{{ block.settings.date | escape }}</span>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p style="text-align:center;color:{{ section.settings.subtitle_color | default: '#666' }};">No reviews added yet. Add review blocks in the theme editor.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Trustpilot Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Trusted by thousands of happy customers"
    },
    {
      "type": "header",
      "content": "Trust Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show trust badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge label",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "score_text",
      "label": "Score text",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count text",
      "default": "2,847"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "label": "Card border radius (px)",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Card spacing (px)",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "card_hover",
      "label": "Enable card hover lift",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "label": "Top padding (px)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "label": "Bottom padding (px)",
      "default": 60
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "label": "Container max width (px)",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 18,
      "max": 64,
      "step": 2,
      "label": "Title font size (px)",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "label": "Subtitle font size (px)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle / meta color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star / accent color",
      "default": "#00b67a"
    },
    {
      "type": "header",
      "content": "Review settings"
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "Show verified badge",
      "default": true
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified label text",
      "default": "Verified"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image"
        },
        {
          "type": "text",
          "id": "name",
