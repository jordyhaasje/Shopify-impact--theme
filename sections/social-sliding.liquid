{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --ss-bg: {{ section.settings.background.rgb }};
    --ss-text: {{ section.settings.text_color.rgb }};
    --ss-muted: {{ section.settings.muted_text_color.rgb }};
    --ss-card: {{ section.settings.card_background.rgb }};
    --ss-bubble: {{ section.settings.bubble_background.rgb }};
    --ss-accent: {{ section.settings.accent_color.rgb }};
    --ss-border: {{ section.settings.border_color.rgb }};
    --ss-radius: {{ section.settings.card_radius }}px;
    --ss-avatar: {{ section.settings.avatar_size }}px;
    --ss-cards: {{ section.settings.cards_desktop }};
  }
  #shopify-section-{{ section.id }} .social-sliding{background:rgb(var(--ss-bg));color:rgb(var(--ss-text));overflow:hidden}#shopify-section-{{ section.id }} .social-sliding *{box-sizing:border-box}#shopify-section-{{ section.id }} .social-sliding__inner{width:min({{ section.settings.content_width }}px,calc(100vw - 40px));margin:0 auto;padding-block:{{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px}#shopify-section-{{ section.id }} .social-sliding__header{display:grid;gap:12px;margin-bottom:28px;max-width:720px;text-align:{{ section.settings.text_alignment }}}#shopify-section-{{ section.id }} .social-sliding__header--center{margin-inline:auto}#shopify-section-{{ section.id }} .social-sliding__eyebrow{display:inline-flex;justify-self:{% if section.settings.text_alignment == 'center' %}center{% else %}start{% endif %};align-items:center;gap:8px;padding:7px 12px;border-radius:999px;background:rgb(var(--ss-accent)/.1);color:rgb(var(--ss-accent));font:800 12px/1.1 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:.02em}#shopify-section-{{ section.id }} .social-sliding__eyebrow svg{width:15px;height:15px;flex:0 0 auto}#shopify-section-{{ section.id }} .social-sliding__heading{margin:0;color:rgb(var(--ss-text));font:850 clamp(28px,4vw,{{ section.settings.heading_size }}px)/1.04 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.045em}#shopify-section-{{ section.id }} .social-sliding__text{color:rgb(var(--ss-muted));font:500 15px/1.65 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}#shopify-section-{{ section.id }} .social-sliding__text p{margin:0}#shopify-section-{{ section.id }} .social-sliding__shell{position:relative;margin-inline:-6px;padding-inline:6px}#shopify-section-{{ section.id }} .social-sliding__track{--ss-gap:18px;--ss-card-width:calc((100% - (var(--ss-cards) - 1)*var(--ss-gap))/var(--ss-cards));display:grid;grid-auto-flow:column;grid-auto-columns:max(286px,var(--ss-card-width));gap:var(--ss-gap);overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding:4px 2px 16px;-webkit-overflow-scrolling:touch}#shopify-section-{{ section.id }} .social-sliding__track::-webkit-scrollbar{display:none}#shopify-section-{{ section.id }} .social-sliding__slide{min-width:0;scroll-snap-align:start}#shopify-section-{{ section.id }} .social-sliding__card{min-height:268px;height:100%;display:flex;flex-direction:column;gap:14px;padding:18px;border:1px solid rgb(var(--ss-border));border-radius:var(--ss-radius);background:rgb(var(--ss-card));box-shadow:0 14px 34px rgb(17 24 39/.08);color:rgb(var(--ss-text));transform:translateY(0);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}#shopify-section-{{ section.id }} .social-sliding__card:hover{transform:translateY(-3px);border-color:rgb(var(--ss-accent)/.28);box-shadow:0 20px 44px rgb(17 24 39/.13)}#shopify-section-{{ section.id }} .social-sliding__profile{display:grid;grid-template-columns:var(--ss-avatar) minmax(0,1fr);gap:11px;align-items:center}#shopify-section-{{ section.id }} .social-sliding__avatar{position:relative;width:var(--ss-avatar);height:var(--ss-avatar);border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,rgb(var(--ss-accent)/.18),rgb(var(--ss-accent)/.06));color:rgb(var(--ss-accent));font:900 18px/1 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}#shopify-section-{{ section.id }} .social-sliding__avatar img{width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block}#shopify-section-{{ section.id }} .social-sliding__verified{position:absolute;right:-1px;bottom:-1px;width:19px;height:19px;display:grid;place-items:center;border:2px solid rgb(var(--ss-card));border-radius:999px;background:rgb(var(--ss-accent));color:#fff}#shopify-section-{{ section.id }} .social-sliding__verified svg{width:10px;height:10px}#shopify-section-{{ section.id }} .social-sliding__name{max-width:100%;margin:0 0 4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:rgb(var(--ss-text));font:800 14px/1.18 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}#shopify-section-{{ section.id }} .social-sliding__meta{display:flex;flex-wrap:wrap;align-items:center;gap:5px;color:rgb(var(--ss-muted));font:650 12px/1.25 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}#shopify-section-{{ section.id }} .social-sliding__stars{color:#f5b301;letter-spacing:.04em;white-space:nowrap}#shopify-section-{{ section.id }} .social-sliding__bubble{position:relative;min-height:92px;padding:13px 14px;border-radius:18px;background:rgb(var(--ss-bubble));color:rgb(var(--ss-text));font:500 14px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}#shopify-section-{{ section.id }} .social-sliding__bubble:before{content:"";position:absolute;top:-7px;left:20px;width:14px;height:14px;background:rgb(var(--ss-bubble));transform:rotate(45deg);border-radius:3px}#shopify-section-{{ section.id }} .social-sliding__bubble p{position:relative;margin:0}#shopify-section-{{ section.id }} .social-sliding__actions{margin-top:auto;padding-top:2px;display:flex;align-items:center;justify-content:space-between;gap:12px;color:rgb(var(--ss-muted));font:800 12px/1.2 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}#shopify-section-{{ section.id }} .social-sliding__action-left,#shopify-section-{{ section.id }} .social-sliding__reaction{display:inline-flex;align-items:center;gap:10px;min-width:0}#shopify-section-{{ section.id }} .social-sliding__reaction{gap:5px;white-space:nowrap}#shopify-section-{{ section.id }} .social-sliding__reaction-icons{display:inline-flex}#shopify-section-{{ section.id }} .social-sliding__reaction-icon{width:18px;height:18px;margin-right:-4px;display:grid;place-items:center;border:1.5px solid rgb(var(--ss-card));border-radius:999px;background:rgb(var(--ss-accent));color:#fff;font-size:9px}#shopify-section-{{ section.id }} .social-sliding__reaction-icon--heart{background:#f55376}#shopify-section-{{ section.id }} .social-sliding__controls{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;margin-top:14px}#shopify-section-{{ section.id }} .social-sliding__dots,#shopify-section-{{ section.id }} .social-sliding__buttons{display:flex;align-items:center;gap:8px}#shopify-section-{{ section.id }} .social-sliding__dot{width:8px;height:8px;padding:0;border:0;border-radius:999px;background:rgb(var(--ss-muted)/.28);cursor:pointer;transition:width .2s ease,background .2s ease}#shopify-section-{{ section.id }} .social-sliding__dot[aria-current="true"]{width:26px;background:rgb(var(--ss-accent))}#shopify-section-{{ section.id }} .social-sliding__button{width:42px;height:42px;display:grid;place-items:center;border:1px solid rgb(var(--ss-border));border-radius:999px;background:rgb(var(--ss-card));color:rgb(var(--ss-text));box-shadow:0 8px 20px rgb(17 24 39/.06);cursor:pointer}#shopify-section-{{ section.id }} .social-sliding__button svg{width:18px;height:18px}#shopify-section-{{ section.id }} .social-sliding__cta{margin-top:24px;text-align:{{ section.settings.text_alignment }}}#shopify-section-{{ section.id }} .social-sliding__cta a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 20px;border-radius:999px;background:rgb(var(--ss-accent));color:#fff;font:850 14px/1 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-decoration:none}
  @media screen and (max-width:999px){#shopify-section-{{ section.id }} .social-sliding__track{grid-auto-columns:minmax(300px,calc((100% - 18px)/2))}}
  @media screen and (max-width:699px){#shopify-section-{{ section.id }} .social-sliding__inner{width:min(100%,calc(100vw - 28px));padding-block:{{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px}#shopify-section-{{ section.id }} .social-sliding__header{gap:10px;margin-bottom:22px;text-align:{{ section.settings.mobile_text_alignment }}}#shopify-section-{{ section.id }} .social-sliding__eyebrow{justify-self:{% if section.settings.mobile_text_alignment == 'center' %}center{% else %}start{% endif %}}#shopify-section-{{ section.id }} .social-sliding__heading{font-size:clamp(25px,8vw,34px);letter-spacing:-.035em}#shopify-section-{{ section.id }} .social-sliding__track{--ss-gap:12px;grid-auto-columns:calc(100vw - 44px);gap:var(--ss-gap);padding-bottom:12px}#shopify-section-{{ section.id }} .social-sliding__card{min-height:248px;padding:15px;gap:12px;border-radius:min(var(--ss-radius),20px)}#shopify-section-{{ section.id }} .social-sliding__bubble{min-height:84px;font-size:13.5px;line-height:1.5}#shopify-section-{{ section.id }} .social-sliding__actions{align-items:flex-start}#shopify-section-{{ section.id }} .social-sliding__controls{grid-template-columns:1fr;justify-items:center;margin-top:10px}#shopify-section-{{ section.id }} .social-sliding__buttons{order:-1}#shopify-section-{{ section.id }} .social-sliding__button{width:40px;height:40px}#shopify-section-{{ section.id }} .social-sliding__cta{text-align:{{ section.settings.mobile_text_alignment }}}}
</style>

<div {% render 'section-properties', class: 'social-sliding' %}>
  <div class="social-sliding__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}<div class="social-sliding__header{% if section.settings.text_alignment == 'center' %} social-sliding__header--center{% endif %}">{%- if section.settings.eyebrow != blank -%}<div class="social-sliding__eyebrow"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.1C22 6.5 17.5 2 12 2S2 6.5 2 12.1c0 5 3.7 9.1 8.4 9.9v-7H7.9v-2.9h2.5V9.9c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.5v1.9h2.8l-.4 2.9h-2.4v7c4.7-.8 8.4-4.9 8.4-9.9Z"/></svg><span>{{ section.settings.eyebrow | escape }}</span></div>{%- endif -%}{%- if section.settings.heading != blank -%}<h2 class="social-sliding__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}{%- if section.settings.text != blank -%}<div class="social-sliding__text">{{ section.settings.text }}</div>{%- endif -%}</div>{%- endif -%}
    <social-sliding-carousel class="social-sliding__shell" data-autoplay="{{ section.settings.enable_autoplay }}" data-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
      <div class="social-sliding__track" tabindex="0" aria-label="{{ section.settings.heading | default: 'Social comments slider' | escape }}">{%- for block in section.blocks -%}<article class="social-sliding__slide" {{ block.shopify_attributes }}><div class="social-sliding__card"><div class="social-sliding__profile"><div class="social-sliding__avatar">{%- if block.settings.avatar != blank -%}{{- block.settings.avatar | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,120,160', sizes: '80px', alt: block.settings.name -}}{%- else -%}{{- block.settings.name | default: 'C' | slice: 0 | upcase -}}{%- endif -%}{%- if block.settings.verified -%}<span class="social-sliding__verified" aria-label="Verified"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6.4 11.4 2.9 7.9l1.4-1.4 2.1 2.1 5.3-5.3 1.4 1.4-6.7 6.7Z"/></svg></span>{%- endif -%}</div><div>{%- if block.settings.name != blank -%}<p class="social-sliding__name">{{ block.settings.name | escape }}</p>{%- endif -%}<div class="social-sliding__meta">{%- if block.settings.time_label != blank -%}<span>{{ block.settings.time_label | escape }}</span>{%- endif -%}{%- if block.settings.location != blank -%}<span>•</span><span>{{ block.settings.location | escape }}</span>{%- endif -%}{%- if block.settings.rating > 0 -%}<span class="social-sliding__stars" aria-label="{{ block.settings.rating }} out of 5 stars">{%- for i in (1..5) -%}{%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span>{%- endif -%}</div></div></div>{%- if block.settings.comment != blank -%}<div class="social-sliding__bubble">{{ block.settings.comment }}</div>{%- endif -%}<div class="social-sliding__actions"><div class="social-sliding__action-left"><span>{{ block.settings.like_label | default: 'Like' | escape }}</span><span>{{ block.settings.reply_label | default: 'Reply' | escape }}</span></div><div class="social-sliding__reaction"><span class="social-sliding__reaction-icons" aria-hidden="true"><span class="social-sliding__reaction-icon">👍</span><span class="social-sliding__reaction-icon social-sliding__reaction-icon--heart">♥</span></span>{%- if block.settings.reaction_count != blank -%}<span>{{ block.settings.reaction_count | escape }}</span>{%- endif -%}</div></div></div></article>{%- endfor -%}</div>
      {%- if section.blocks.size > 1 -%}<div class="social-sliding__controls"><div class="social-sliding__dots" aria-label="Slider pagination"></div><div class="social-sliding__buttons"><button class="social-sliding__button" type="button" data-direction="previous" aria-label="Previous comment"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="social-sliding__button" type="button" data-direction="next" aria-label="Next comment"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></div></div>{%- endif -%}
    </social-sliding-carousel>
    {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}<div class="social-sliding__cta"><a href="{{ section.settings.button_link }}">{{ section.settings.button_text | escape }}</a></div>{%- endif -%}
  </div>
</div>

<script>(()=>{class SocialSlidingCarousel extends HTMLElement{connectedCallback(){this.initialize()}disconnectedCallback(){this.destroy()}initialize(){this.destroy();this.track=this.querySelector('.social-sliding__track');this.slides=Array.from(this.querySelectorAll('.social-sliding__slide'));this.dots=this.querySelector('.social-sliding__dots');this.buttons=Array.from(this.querySelectorAll('[data-direction]'));this.autoplay=this.dataset.autoplay==='true';this.speed=Number(this.dataset.speed||5e3);this.buttonHandlers=[];this.dotHandlers=[];this.boundScroll=()=>window.requestAnimationFrame(()=>this.updateDots());this.boundStop=()=>this.stopAutoplay();this.boundStart=()=>this.startAutoplay();if(!this.track||!this.slides.length)return;this.buildDots();this.bindEvents();this.updateDots();this.startAutoplay()}destroy(){this.stopAutoplay();if(this.track&&this.boundScroll)this.track.removeEventListener('scroll',this.boundScroll);if(this.boundStop){this.removeEventListener('mouseenter',this.boundStop);this.removeEventListener('focusin',this.boundStop)}if(this.boundStart){this.removeEventListener('mouseleave',this.boundStart);this.removeEventListener('focusout',this.boundStart)}if(this.buttonHandlers)this.buttonHandlers.forEach(e=>e.button.removeEventListener('click',e.handler));if(this.dotHandlers)this.dotHandlers.forEach(e=>e.dot.removeEventListener('click',e.handler));this.buttonHandlers=[];this.dotHandlers=[]}buildDots(){if(!this.dots)return;this.dots.innerHTML='';this.slides.forEach((slide,index)=>{const dot=document.createElement('button');dot.type='button';dot.className='social-sliding__dot';dot.setAttribute('aria-label',`Go to comment ${index+1}`);const handler=()=>this.goTo(index);dot.addEventListener('click',handler);this.dotHandlers.push({dot,handler});this.dots.appendChild(dot)})}bindEvents(){this.buttons.forEach(button=>{const handler=()=>this.goTo(this.currentIndex()+(button.dataset.direction==='previous'?-1:1));button.addEventListener('click',handler);this.buttonHandlers.push({button,handler})});this.track.addEventListener('scroll',this.boundScroll,{passive:true});this.addEventListener('mouseenter',this.boundStop);this.addEventListener('mouseleave',this.boundStart);this.addEventListener('focusin',this.boundStop);this.addEventListener('focusout',this.boundStart)}currentIndex(){const left=this.track.scrollLeft;let closest=0,distance=Infinity;this.slides.forEach((slide,index)=>{const slideDistance=Math.abs(slide.offsetLeft-left);if(slideDistance<distance){distance=slideDistance;closest=index}});return closest}goTo(index){if(!this.slides.length)return;const normalizedIndex=(index+this.slides.length)%this.slides.length;this.track.scrollTo({left:this.slides[normalizedIndex].offsetLeft,behavior:'smooth'})}updateDots(){if(!this.dots)return;const active=this.currentIndex();Array.from(this.dots.children).forEach((dot,index)=>dot.setAttribute('aria-current',index===active?'true':'false'))}startAutoplay(){this.stopAutoplay();if(!this.autoplay||this.slides.length<2)return;this.timer=window.setInterval(()=>this.goTo(this.currentIndex()+1),this.speed)}stopAutoplay(){if(this.timer){window.clearInterval(this.timer);this.timer=null}}}if(!window.customElements.get('social-sliding-carousel'))window.customElements.define('social-sliding-carousel',SocialSlidingCarousel);const initSocialSliding=(root=document)=>root.querySelectorAll('social-sliding-carousel').forEach(carousel=>carousel.initialize&&carousel.initialize());document.addEventListener('shopify:section:load',event=>initSocialSliding(event.target));document.addEventListener('shopify:section:select',event=>initSocialSliding(event.target));document.addEventListener('shopify:block:select',event=>{const carousel=event.target.closest('social-sliding-carousel');const slide=event.target.closest('.social-sliding__slide');if(carousel&&slide)carousel.goTo(Array.from(carousel.querySelectorAll('.social-sliding__slide')).indexOf(slide))})})();</script>

