{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --hero-rounded-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --hero-rounded-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --hero-rounded-button-background: {{ section.settings.button_background.red }}, {{ section.settings.button_background.green }}, {{ section.settings.button_background.blue }};
    --hero-rounded-button-text: {{ section.settings.button_text_color.red }}, {{ section.settings.button_text_color.green }}, {{ section.settings.button_text_color.blue }};
    --hero-rounded-stars: {{ section.settings.stars_color.red }}, {{ section.settings.stars_color.green }}, {{ section.settings.stars_color.blue }};
    --hero-rounded-overlay: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --hero-rounded-radius: {{ section.settings.border_radius }}px;
    --hero-rounded-section-spacing: {{ section.settings.section_spacing }}px;
    --hero-rounded-card-min-height: {{ section.settings.desktop_height }}px;
    --hero-rounded-mobile-min-height: {{ section.settings.mobile_height }}px;
    --hero-rounded-content-max: {{ section.settings.content_max_width }}px;
    --hero-rounded-content-width: {{ section.settings.content_width }}px;
    --hero-rounded-horizontal-padding: {{ section.settings.desktop_padding_horizontal }}px;
    --hero-rounded-vertical-padding: {{ section.settings.desktop_padding_vertical }}px;
    --hero-rounded-mobile-horizontal-padding: {{ section.settings.mobile_padding_horizontal }}px;
    --hero-rounded-mobile-vertical-padding: {{ section.settings.mobile_padding_vertical }}px;
    --hero-rounded-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-rounded-heading-size: {{ section.settings.heading_size }}px;
    --hero-rounded-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --hero-rounded-text-size: {{ section.settings.text_size }}px;
    --hero-rounded-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --hero-rounded-rating-size: {{ section.settings.rating_size }}px;
    --hero-rounded-rating-size-mobile: {{ section.settings.rating_size_mobile }}px;
    --hero-rounded-quote-size: {{ section.settings.quote_size }}px;
    --hero-rounded-quote-size-mobile: {{ section.settings.quote_size_mobile }}px;
    --hero-rounded-meta-size: {{ section.settings.meta_size }}px;
    --hero-rounded-meta-size-mobile: {{ section.settings.meta_size_mobile }}px;
    --hero-rounded-button-top: {{ section.settings.button_margin_top }}px;
    --hero-rounded-rating-top: {{ section.settings.rating_margin_top }}px;
    --hero-rounded-testimonial-top: {{ section.settings.testimonial_margin_top }}px;
  }

  #shopify-section-{{ section.id }} .hero-rounded {
    background: rgb(var(--hero-rounded-background));
  }

  #shopify-section-{{ section.id }} .hero-rounded__card {
    position: relative;
    overflow: hidden;
    min-height: var(--hero-rounded-card-min-height);
    border-radius: var(--hero-rounded-radius);
    color: rgb(var(--hero-rounded-text));
    background-color: rgb(var(--hero-rounded-background));
  }

  #shopify-section-{{ section.id }} .hero-rounded__media,
  #shopify-section-{{ section.id }} .hero-rounded__overlay,
  #shopify-section-{{ section.id }} .hero-rounded__shade {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .hero-rounded__media {
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  #shopify-section-{{ section.id }} .hero-rounded__overlay {
    background: linear-gradient(90deg, rgba(var(--hero-rounded-overlay), var(--hero-rounded-overlay-opacity)) 0%, rgba(var(--hero-rounded-overlay), calc(var(--hero-rounded-overlay-opacity) * 0.86)) 30%, rgba(var(--hero-rounded-overlay), calc(var(--hero-rounded-overlay-opacity) * 0.2)) 58%, rgba(var(--hero-rounded-overlay), 0) 75%);
  }

  #shopify-section-{{ section.id }} .hero-rounded__shade {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 0%, rgba(0, 0, 0, 0.08) 100%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hero-rounded__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: var(--hero-rounded-card-min-height);
    padding: var(--hero-rounded-vertical-padding) var(--hero-rounded-horizontal-padding);
  }

  #shopify-section-{{ section.id }} .hero-rounded__content {
    width: min(100%, var(--hero-rounded-content-width));
    max-width: var(--hero-rounded-content-max);
  }

  #shopify-section-{{ section.id }} .hero-rounded__heading {
    margin: 0;
    color: rgb(var(--hero-rounded-text));
    font-size: var(--hero-rounded-heading-size);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .hero-rounded__body {
    margin-top: 16px;
    max-width: 660px;
    color: rgb(var(--hero-rounded-text));
    font-size: var(--hero-rounded-text-size);
    line-height: 1.55;
    opacity: 0.96;
  }

  #shopify-section-{{ section.id }} .hero-rounded__body p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hero-rounded__actions {
    margin-top: var(--hero-rounded-button-top);
  }

  #shopify-section-{{ section.id }} .hero-rounded__rating {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: var(--hero-rounded-rating-top);
    font-size: var(--hero-rounded-rating-size);
    line-height: 1.3;
    color: rgb(var(--hero-rounded-text));
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hero-rounded__rating strong {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .hero-rounded__stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .hero-rounded__star {
    width: 18px;
    height: 18px;
    display: inline-flex;
    color: rgb(var(--hero-rounded-stars));
  }

  #shopify-section-{{ section.id }} .hero-rounded__star svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .hero-rounded__testimonial {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: center;
    margin-top: var(--hero-rounded-testimonial-top);
    max-width: 760px;
  }

  #shopify-section-{{ section.id }} .hero-rounded__avatar,
  #shopify-section-{{ section.id }} .hero-rounded__avatar-placeholder {
    width: 72px;
    height: 72px;
    border-radius: 999px;
    overflow: hidden;
    flex: 0 0 72px;
  }

  #shopify-section-{{ section.id }} .hero-rounded__avatar {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .hero-rounded__avatar-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.2);
    color: rgb(var(--hero-rounded-text));
    font-weight: 700;
    font-size: 24px;
  }

  #shopify-section-{{ section.id }} .hero-rounded__quote {
    margin: 0;
    color: rgb(var(--hero-rounded-text));
    font-size: var(--hero-rounded-quote-size);
    line-height: 1.3;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .hero-rounded__meta {
    margin-top: 8px;
    color: rgb(var(--hero-rounded-text));
    font-size: var(--hero-rounded-meta-size);
    line-height: 1.35;
    opacity: 0.95;
  }

  #shopify-section-{{ section.id }} .hero-rounded__meta p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hero-rounded__mobile-break {
    display: none;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .hero-rounded__card,
    #shopify-section-{{ section.id }} .hero-rounded__inner {
      min-height: calc(var(--hero-rounded-card-min-height) * 0.78);
    }

    #shopify-section-{{ section.id }} .hero-rounded__heading {
      font-size: clamp(40px, 6vw, var(--hero-rounded-heading-size));
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .hero-rounded__card {
      min-height: var(--hero-rounded-mobile-min-height);
      border-radius: calc(var(--hero-rounded-radius) - 6px);
    }

    #shopify-section-{{ section.id }} .hero-rounded__media {
      background-position: center center;
    }

    #shopify-section-{{ section.id }} .hero-rounded__overlay {
      background: linear-gradient(180deg, rgba(var(--hero-rounded-overlay), calc(var(--hero-rounded-overlay-opacity) * 0.62)) 0%, rgba(var(--hero-rounded-overlay), calc(var(--hero-rounded-overlay-opacity) * 0.4)) 36%, rgba(var(--hero-rounded-overlay), calc(var(--hero-rounded-overlay-opacity) * 0.18)) 62%, rgba(var(--hero-rounded-overlay), calc(var(--hero-rounded-overlay-opacity) * 0.58)) 100%);
    }

    #shopify-section-{{ section.id }} .hero-rounded__inner {
      align-items: flex-start;
      min-height: var(--hero-rounded-mobile-min-height);
      padding: var(--hero-rounded-mobile-vertical-padding) var(--hero-rounded-mobile-horizontal-padding);
    }

    #shopify-section-{{ section.id }} .hero-rounded__content {
      width: 100%;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .hero-rounded__heading {
      font-size: var(--hero-rounded-heading-size-mobile);
      line-height: 1.02;
      max-width: 320px;
      text-wrap: pretty;
    }

    #shopify-section-{{ section.id }} .hero-rounded__mobile-break {
      display: inline;
    }

    #shopify-section-{{ section.id }} .hero-rounded__body {
      margin-top: 14px;
      max-width: 100%;
      font-size: var(--hero-rounded-text-size-mobile);
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .hero-rounded__actions {
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .hero-rounded__rating {
      gap: 10px;
      margin-top: 28px;
      font-size: var(--hero-rounded-rating-size-mobile);
    }

    #shopify-section-{{ section.id }} .hero-rounded__star {
      width: 17px;
      height: 17px;
    }

    #shopify-section-{{ section.id }} .hero-rounded__testimonial {
      grid-template-columns: 56px 1fr;
      gap: 14px;
      align-items: start;
      margin-top: 34px;
    }

    #shopify-section-{{ section.id }} .hero-rounded__avatar,
    #shopify-section-{{ section.id }} .hero-rounded__avatar-placeholder {
      width: 56px;
      height: 56px;
      flex-basis: 56px;
    }

    #shopify-section-{{ section.id }} .hero-rounded__quote {
      font-size: var(--hero-rounded-quote-size-mobile);
      line-height: 1.28;
    }

    #shopify-section-{{ section.id }} .hero-rounded__meta {
      margin-top: 8px;
      font-size: var(--hero-rounded-meta-size-mobile);
    }
  }
</style>

<section class="hero-rounded">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.text_color, full_width: true %}>
    <div class="container">
      <div class="hero-rounded__card">
        {%- assign desktop_image = section.settings.desktop_image -%}
        {%- assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image -%}
        {%- assign desktop_image_url = '' -%}
        {%- assign mobile_image_url = '' -%}

        {%- if desktop_image != blank -%}
          {%- assign desktop_image_url = desktop_image | image_url: width: 2200 -%}
        {%- endif -%}

        {%- if mobile_image != blank -%}
          {%- assign mobile_image_url = mobile_image | image_url: width: 1200 -%}
        {%- endif -%}

        <div class="hero-rounded__media"
          {% if desktop_image_url != blank %}
            style="background-image: url('{{ desktop_image_url }}');"
          {% endif %}
        ></div>

        <style>
          @media screen and (max-width: 699px) {
            #shopify-section-{{ section.id }} .hero-rounded__media {
              {% if mobile_image_url != blank %}
                background-image: url('{{ mobile_image_url }}');
              {% endif %}
            }
          }
        </style>

        <div class="hero-rounded__overlay"></div>
        <div class="hero-rounded__shade"></div>

        <div class="hero-rounded__inner">
          <div class="hero-rounded__content">
            {%- if section.settings.heading != blank -%}
              <h2 class="hero-rounded__heading">{{ section.settings.heading | newline_to_br }}</h2>
            {%- endif -%}

            {%- if section.settings.body != blank -%}
              <div class="hero-rounded__body rte">
                {{ section.settings.body }}
              </div>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
              <div class="hero-rounded__actions">
                {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'lg', style: 'fill', background: section.settings.button_background, text_color: section.settings.button_text_color %}
              </div>
            {%- endif -%}

            {%- if section.settings.rating_text != blank -%}
              <div class="hero-rounded__rating">
                <span>{{ section.settings.rating_text }}</span>
                <span class="hero-rounded__stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <span class="hero-rounded__star">
                      <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
                        <path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z" fill="currentColor"></path>
                      </svg>
                    </span>
                  {%- endfor -%}
                </span>
              </div>
            {%- endif -%}

            {%- if section.settings.testimonial_text != blank or section.settings.reviewer_name != blank or section.settings.reviewer_subtitle != blank -%}
              <div class="hero-rounded__testimonial">
                <div>
                  {%- if section.settings.avatar != blank -%}
                    {{ section.settings.avatar | image_url: width: 144 | image_tag: loading: 'lazy', widths: '56,72,112,144', class: 'hero-rounded__avatar', alt: section.settings.reviewer_name }}
                  {%- else -%}
                    <span class="hero-rounded__avatar-placeholder">{{ section.settings.reviewer_name | default: 'A' | slice: 0, 1 }}</span>
                  {%- endif -%}
                </div>

                <div>
                  {%- if section.settings.testimonial_text != blank -%}
                    <blockquote class="hero-rounded__quote">{{ section.settings.testimonial_text | escape }}</blockquote>
                  {%- endif -%}

                  {%- if section.settings.reviewer_name != blank or section.settings.reviewer_subtitle != blank -%}
                    <div class="hero-rounded__meta">
                      <p>
                        {%- if section.settings.reviewer_name != blank -%}{{ section.settings.reviewer_name | escape }}{%- endif -%}
                        {%- if section.settings.reviewer_name != blank and section.settings.reviewer_subtitle != blank -%} | {% endif %}
                        {%- if section.settings.reviewer_subtitle != blank -%}{{ section.settings.reviewer_subtitle | escape }}{%- endif -%}
                      </p>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero rounded",
  "tag": "section",
  "class": "shopify-section--hero-rounded",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Buy One, Get\nOne Half Off" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Make Mother's Day twice as nice! Select skincare and bodycare is buy one, get one half off, so you can give more to the special women in your life.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Excellent <strong>4.9</strong> | 100,000+ Customers" },
    { "type": "textarea", "id": "testimonial_text", "label": "Testimonial text", "default": "\"My skin looks amazing now! This brand is truly the best I've tried.\"" },
    { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Joanne" },
    { "type": "text", "id": "reviewer_subtitle", "label": "Reviewer subtitle", "default": "Review on Rose Serum" },
    { "type": "image_picker", "id": "avatar", "label": "Avatar" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "section_spacing", "label": "Section spacing", "min": 0, "max": 80, "step": 4, "default": 48 },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 420, "max": 900, "step": 20, "default": 620 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 520, "max": 980, "step": 20, "default": 760 },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 360, "max": 900, "step": 20, "default": 760 },
    { "type": "range", "id": "content_width", "label": "Desktop content width", "min": 320, "max": 760, "step": 20, "default": 560 },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 48, "step": 2, "default": 24 },
    { "type": "range", "id": "desktop_padding_horizontal", "label": "Desktop horizontal padding", "min": 20, "max": 120, "step": 4, "default": 52 },
    { "type": "range", "id": "desktop_padding_vertical", "label": "Desktop vertical padding", "min": 20, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "mobile_padding_horizontal", "label": "Mobile horizontal padding", "min": 16, "max": 48, "step": 2, "default": 24 },
    { "type": "range", "id": "mobile_padding_vertical", "label": "Mobile vertical padding", "min": 16, "max": 72, "step": 2, "default": 28 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 32, "max": 88, "step": 2, "default": 68 },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 28, "max": 56, "step": 2, "default": 40 },
    { "type": "range", "id": "text_size", "label": "Desktop body size", "min": 14, "max": 28, "step": 1, "default": 18 },
    { "type": "range", "id": "text_size_mobile", "label": "Mobile body size", "min": 14, "max": 22, "step": 1, "default": 16 },
    { "type": "range", "id": "rating_size", "label": "Desktop rating size", "min": 12, "max": 24, "step": 1, "default": 16 },
    { "type": "range", "id": "rating_size_mobile", "label": "Mobile rating size", "min": 12, "max": 20, "step": 1, "default": 14 },
    { "type": "range", "id": "quote_size", "label": "Desktop testimonial size", "min": 18, "max": 40, "step": 1, "default": 26 },
    { "type": "range", "id": "quote_size_mobile", "label": "Mobile testimonial size", "min": 16, "max": 34, "step": 1, "default": 22 },
    { "type": "range", "id": "meta_size", "label": "Desktop meta size", "min": 12, "max": 22, "step": 1, "default": 14 },
    { "type": "range", "id": "meta_size_mobile", "label": "Mobile meta size", "min": 12, "max": 18, "step": 1, "default": 12 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "button_margin_top", "label": "Space above button", "min": 8, "max": 40, "step": 2, "default": 24 },
    { "type": "range", "id": "rating_margin_top", "label": "Space above rating", "min": 12, "max": 56, "step": 2, "default": 34 },
    { "type": "range", "id": "testimonial_margin_top", "label": "Space above testimonial", "min": 12, "max": 72, "step": 2, "default": 34 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#efefef" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#8f735f" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "default": 52 },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#2b2b2b" },
    { "type": "color", "id": "stars_color", "label": "Stars color", "default": "#f7c948" }
  ],
  "presets": [
    {
      "name": "Hero rounded"
    }
  ]
}
{% endschema %}