{{ 'jsections-beauty-story-panels.css' | asset_url | stylesheet_tag }}

<section
  id="jsections-beauty-story-panels-{{ section.id }}"
  class="jbsy{% if section.settings.full_width %} jbsy--full{% endif %}"
  style="
    --jbsy-bg: {{ section.settings.background_color }};
    --jbsy-text: {{ section.settings.text_color }};
    --jbsy-muted: {{ section.settings.muted_color }};
    --jbsy-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="jbsy__frame jbsy__frame--{{ section.settings.image_position }}">
    <div class="jbsy__copy">
      {% if section.settings.marquee_text != blank %}
        <div class="jbsy__marquee" aria-hidden="true">
          {% for index in (1..18) %}
            <span>{{ section.settings.marquee_text }}</span>
          {% endfor %}
        </div>
      {% endif %}
      <div class="jbsy__copy-inner">
        {% if section.settings.heading != blank %}
          <h2 class="jbsy__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="jbsy__text">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a class="jbsy__button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
    </div>
    <div class="jbsy__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'jbsy__image', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.heading }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'jbsy__placeholder' }}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beauty story panel",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Use full viewport width",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Vertical marquee text",
      "default": "online exclusive"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "plant-powered formulas"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover our range of cruelty-free, dermatologist-tested skincare. Formulated with clean ingredients to support your daily routine."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f1f0ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#67645e"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text color",
      "default": "#84827e"
    }
  ],
  "presets": [
    {
      "name": "Beauty story panel"
    },
    {
      "name": "Beauty story panel reversed",
      "settings": {
        "image_position": "left",
        "marquee_text": "",
        "heading": "made with you, for you",
        "text": "Last year, we asked you to vote on a few shades and pick the ones you loved most. These were your top choices, and we're thrilled for them to be yours."
      }
    }
  ]
}
{% endschema %}
