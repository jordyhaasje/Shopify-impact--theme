{%- comment -%}
  JSections - Reviews Wall
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-cloudpillo-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign total_reviews = section.blocks.size
  assign split_index = total_reviews | plus: 1 | divided_by: 2

  assign summary_rating = section.settings.summary_rating | times: 1.0
  assign full_stars = summary_rating | floor
  assign decimal_part = summary_rating | minus: full_stars
  assign has_half_star = false

  if decimal_part >= 0.25 and decimal_part < 0.75
    assign has_half_star = true
  elsif decimal_part >= 0.75
    assign full_stars = full_stars | plus: 1
  endif

  if full_stars > 5
    assign full_stars = 5
  endif

  assign next_star = full_stars | plus: 1
-%}

{%- capture cpw_quote_icon -%}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path d="M9 3C4.05 3 0 7.05 0 12V21H9V12H3C3 8.67 5.67 6 9 6V3ZM20.4 3C15.45 3 11.4 7.05 11.4 12V21H20.4V12H14.4C14.4 8.67 17.07 6 20.4 6V3Z" fill="currentColor"></path>
  </svg>
{%- endcapture -%}

{%- capture cpw_five_stars -%}
  <svg width="107" height="20" viewBox="0 0 107 20" fill="none" aria-hidden="true" focusable="false">
    <path d="M20 0H0V20H20V0Z" fill="#219653"></path>
    <path d="M41.6666 0H21.6666V20H41.6666V0Z" fill="#219653"></path>
    <path d="M63.3334 0H43.3334V20H63.3334V0Z" fill="#219653"></path>
    <path d="M85 0H65V20H85V0Z" fill="#219653"></path>
    <path d="M106.667 0H86.6666V20H106.667V0Z" fill="#219653"></path>
    <path d="M9.99976 13.4789L13.0414 12.7081L14.3123 16.6248L9.99976 13.4789ZM16.9998 8.41642H11.6456L9.99976 3.37476L8.35392 8.41642H2.99976L7.33309 11.5414L5.68726 16.5831L10.0206 13.4581L12.6873 11.5414L16.9998 8.41642Z" fill="white"></path>
    <path d="M31.6664 13.4789L34.708 12.7081L35.9789 16.6248L31.6664 13.4789ZM38.6664 8.41642H33.3122L31.6664 3.37476L30.0205 8.41642H24.6664L28.9997 11.5414L27.3539 16.5831L31.6872 13.4581L34.3539 11.5414L38.6664 8.41642Z" fill="white"></path>
    <path d="M53.333 13.4789L56.3747 12.7081L57.6455 16.6248L53.333 13.4789ZM60.333 8.41642H54.9788L53.333 3.37476L51.6872 8.41642H46.333L50.6663 11.5414L49.0205 16.5831L53.3538 13.4581L56.0205 11.5414L60.333 8.41642Z" fill="white"></path>
    <path d="M74.9998 13.4789L78.0414 12.7081L79.3123 16.6248L74.9998 13.4789ZM81.9998 8.41642H76.6456L74.9998 3.37476L73.3539 8.41642H67.9998L72.3331 11.5414L70.6873 16.5831L75.0206 13.4581L77.6873 11.5414L81.9998 8.41642Z" fill="white"></path>
    <path d="M96.6664 13.4789L99.708 12.7081L100.979 16.6248L96.6664 13.4789ZM103.666 8.41642H98.3122L96.6664 3.37476L95.0206 8.41642H89.6664L93.9997 11.5414L92.3539 16.5831L96.6872 13.4581L99.3539 11.5414L103.666 8.41642Z" fill="white"></path>
  </svg>
{%- endcapture -%}

<div
  id="cpw-reviews-{{ section.id }}"
  class="cpw-reviews"
  style="
    --cpw-section-bg: {{ section.settings.section_background }};
    --cpw-min-height: {{ section.settings.desktop_min_height }}px;
    --cpw-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --cpw-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="cpw-reviews__wrapper">
    <div class="cpw-reviews__intro">
      <a
        href="{{ section.settings.external_review_profile_url | default: '#' }}"
        target="_blank"
        rel="noopener noreferrer"
        class="cpw-reviews__summary-link"
      >
        <span class="cpw-reviews__summary-stars" aria-label="{{ summary_rating }} out of 5 stars">
          {%- for star_index in (1..5) -%}
            {%- assign star_variant = 'empty' -%}
            {%- if star_index <= full_stars -%}
              {%- assign star_variant = 'full' -%}
            {%- elsif has_half_star and star_index == next_star -%}
              {%- assign star_variant = 'half' -%}
            {%- endif -%}
            <span class="cpw-reviews__summary-star cpw-reviews__summary-star--{{ star_variant }}">
              {%- if star_variant == 'half' -%}
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path d="M10 0H0V20H10V0Z" fill="#219653"></path>
                  <path d="M20 0H10V20H20V0Z" fill="#D6D6D6"></path>
                  <path d="M9.99976 13.4789L13.0414 12.7081L14.3123 16.6248L9.99976 13.4789ZM16.9998 8.41642H11.6456L9.99976 3.37476L8.35392 8.41642H2.99976L7.33309 11.5414L5.68726 16.5831L10.0206 13.4581L12.6873 11.5414L16.9998 8.41642Z" fill="white"></path>
                </svg>
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path d="M20 0H0V20H20V0Z" fill="currentColor"></path>
                  <path d="M9.99976 13.4789L13.0414 12.7081L14.3123 16.6248L9.99976 13.4789ZM16.9998 8.41642H11.6456L9.99976 3.37476L8.35392 8.41642H2.99976L7.33309 11.5414L5.68726 16.5831L10.0206 13.4581L12.6873 11.5414L16.9998 8.41642Z" fill="white"></path>
                </svg>
              {%- endif -%}
            </span>
          {%- endfor -%}
        </span>
        <span class="cpw-reviews__summary-count">
          <strong>{{ section.settings.review_count }}</strong> {{ section.settings.summary_label }}
        </span>
        <span class="cpw-reviews__summary-brand">
          <svg width="15" height="14" viewBox="0 0 15 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M7.66675 11.0625L10.7084 10.2917L11.9792 14L7.66675 11.0625ZM14.6667 6.27083H9.31258L7.66675 1.5L6.02092 6.27083H0.666748L5.00008 9.22917L3.35425 14L7.68758 11.0417L10.3542 9.22917L14.6667 6.27083Z" fill="#219653"></path>
          </svg>
          <span>Review source</span>
        </span>
      </a>

      {%- if section.settings.heading != blank -%}
        <h2 class="cpw-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <div class="cpw-reviews__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cpw-reviews__desktop-slider">
        <div class="cpw-reviews__column cpw-reviews__column--up" data-cpw-col="up">
          {%- for block in section.blocks limit: split_index -%}
            {%- if block.type == 'review' -%}
              <a
                href="{{ block.settings.review_url | default: section.settings.external_review_profile_url | default: '#' }}"
                target="_blank"
                rel="noopener noreferrer"
                class="cpw-reviews__card"
                {{ block.shopify_attributes }}
              >
                <div class="cpw-reviews__card-content">
                  <div class="cpw-reviews__card-top">
                    <span class="cpw-reviews__quote-icon">{{ cpw_quote_icon }}</span>
                    <span class="cpw-reviews__card-stars">{{ cpw_five_stars }}</span>
                  </div>
                  {%- if block.settings.title != blank -%}
                    <div class="cpw-reviews__title">{{ block.settings.title }}</div>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="cpw-reviews__text">{{ block.settings.text }}</div>
                  {%- endif -%}
                  <div class="cpw-reviews__meta">
                    <span class="cpw-reviews__author">{{ block.settings.author }}</span>
                    <span class="cpw-reviews__date">{{ block.settings.date }}</span>
                  </div>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="cpw-reviews__column cpw-reviews__column--down" data-cpw-col="down">
          {%- for block in section.blocks offset: split_index -%}
            {%- if block.type == 'review' -%}
              <a
                href="{{ block.settings.review_url | default: section.settings.external_review_profile_url | default: '#' }}"
                target="_blank"
                rel="noopener noreferrer"
                class="cpw-reviews__card"
                {{ block.shopify_attributes }}
              >
                <div class="cpw-reviews__card-content">
                  <div class="cpw-reviews__card-top">
                    <span class="cpw-reviews__quote-icon">{{ cpw_quote_icon }}</span>
                    <span class="cpw-reviews__card-stars">{{ cpw_five_stars }}</span>
                  </div>
                  {%- if block.settings.title != blank -%}
                    <div class="cpw-reviews__title">{{ block.settings.title }}</div>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="cpw-reviews__text">{{ block.settings.text }}</div>
                  {%- endif -%}
                  <div class="cpw-reviews__meta">
                    <span class="cpw-reviews__author">{{ block.settings.author }}</span>
                    <span class="cpw-reviews__date">{{ block.settings.date }}</span>
                  </div>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="cpw-reviews__mobile">
      <div
        id="cpw-reviews-track-{{ section.id }}"
        class="cpw-reviews__mobile-track"
        data-cpw-mobile-track
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="cpw-reviews__mobile-slide" {{ block.shopify_attributes }}>
              <a
                href="{{ block.settings.review_url | default: section.settings.external_review_profile_url | default: '#' }}"
                target="_blank"
                rel="noopener noreferrer"
                class="cpw-reviews__card cpw-reviews__card--mobile"
              >
                <div class="cpw-reviews__card-content">
                  <div class="cpw-reviews__card-top">
                    <span class="cpw-reviews__quote-icon">{{ cpw_quote_icon }}</span>
                    <span class="cpw-reviews__card-stars">{{ cpw_five_stars }}</span>
                  </div>
                  {%- if block.settings.title != blank -%}
                    <div class="cpw-reviews__title">{{ block.settings.title }}</div>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="cpw-reviews__text">{{ block.settings.text }}</div>
                  {%- endif -%}
                  <div class="cpw-reviews__meta">
                    <span class="cpw-reviews__author">{{ block.settings.author }}</span>
                    <span class="cpw-reviews__date">{{ block.settings.date }}</span>
                  </div>
                </div>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="cpw-reviews__dots" data-cpw-dots>
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <button
              type="button"
              class="cpw-reviews__dot{% if forloop.first %} is-active{% endif %}"
              aria-label="Go to review {{ forloop.index }}"
              aria-controls="cpw-reviews-track-{{ section.id }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              data-cpw-dot="{{ forloop.index0 }}"
            ></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    const rootId = "cpw-reviews-{{ section.id }}";
    const root = document.getElementById(rootId);
    if (!root) return;

    window.__cpwReviewsInstances = window.__cpwReviewsInstances || {};
    if (window.__cpwReviewsInstances[rootId] && typeof window.__cpwReviewsInstances[rootId].destroy === "function") {
      window.__cpwReviewsInstances[rootId].destroy();
    }

    const sectionNode = root.closest(".shopify-section") || root;
    const upColumn = root.querySelector('[data-cpw-col="up"]');
    const downColumn = root.querySelector('[data-cpw-col="down"]');
    const mobileTrack = root.querySelector("[data-cpw-mobile-track]");
    const dots = Array.from(root.querySelectorAll("[data-cpw-dot]"));
    const reduceMotion = window.matchMedia ? window.matchMedia("(prefers-reduced-motion: reduce)") : null;

    const parallaxStrength = Number({{ section.settings.parallax_strength | default: 6 }}) / 100;
    const smoothFactor = 0.08;
    let currentUp = 0;
    let currentDown = 0;
    let parallaxRaf = null;
    let dotsRaf = null;

    function getSectionTop() {
      return sectionNode.getBoundingClientRect().top + window.scrollY;
    }

    function updateParallax() {
      if (!upColumn || !downColumn) return;

      if (window.innerWidth <= 1024 || parallaxStrength <= 0 || (reduceMotion && reduceMotion.matches)) {
        currentUp = 0;
        currentDown = 0;
        upColumn.style.transform = "translate3d(0, 0, 0)";
        downColumn.style.transform = "translate3d(0, 0, 0)";
        return;
      }

      const rect = sectionNode.getBoundingClientRect();
      let targetOffset = 0;

      if (rect.bottom > 0 && rect.top < window.innerHeight) {
        const baseOffset = Math.max(0, window.scrollY - (getSectionTop() - window.innerHeight));
        targetOffset = baseOffset * parallaxStrength;
      }

      currentUp += (targetOffset - currentUp) * smoothFactor;
      currentDown += ((-targetOffset) - currentDown) * smoothFactor;

      upColumn.style.transform = "translate3d(0, " + currentUp.toFixed(2) + "px, 0)";
      downColumn.style.transform = "translate3d(0, " + currentDown.toFixed(2) + "px, 0)";
    }

    function scheduleParallax() {
      if (parallaxRaf) return;
      parallaxRaf = window.requestAnimationFrame(function() {
        parallaxRaf = null;
        updateParallax();
      });
    }

    function getSlideStride() {
      if (!mobileTrack || !mobileTrack.children.length) return 0;
      const firstSlide = mobileTrack.children[0];
      const gap = parseFloat(window.getComputedStyle(mobileTrack).columnGap || window.getComputedStyle(mobileTrack).gap || "20") || 20;
      return firstSlide.getBoundingClientRect().width + gap;
    }

    function updateDots() {
      if (!mobileTrack || !dots.length) return;
      const stride = getSlideStride();
      if (!stride) return;
      const activeIndex = Math.max(0, Math.min(dots.length - 1, Math.round(mobileTrack.scrollLeft / stride)));

      dots.forEach(function(dot, index) {
        const isActive = index === activeIndex;
        dot.classList.toggle("is-active", isActive);
        dot.setAttribute("aria-current", isActive ? "true" : "false");
      });
    }

    function scheduleDotsUpdate() {
      if (dotsRaf) return;
      dotsRaf = window.requestAnimationFrame(function() {
        dotsRaf = null;
        updateDots();
      });
    }

    function onDotClick(event) {
      const dot = event.currentTarget;
      const targetIndex = Number(dot.getAttribute("data-cpw-dot"));
      if (!mobileTrack || Number.isNaN(targetIndex)) return;
      const stride = getSlideStride();
      if (!stride) return;
      mobileTrack.scrollTo({
        left: targetIndex * stride,
        behavior: reduceMotion && reduceMotion.matches ? "auto" : "smooth",
      });
    }

    if (mobileTrack) {
      mobileTrack.addEventListener("scroll", scheduleDotsUpdate, { passive: true });
    }

    dots.forEach(function(dot) {
      dot.addEventListener("click", onDotClick);
    });

    window.addEventListener("scroll", scheduleParallax, { passive: true });
    window.addEventListener("resize", scheduleParallax);
    window.addEventListener("resize", updateDots);
    if (reduceMotion && typeof reduceMotion.addEventListener === "function") {
      reduceMotion.addEventListener("change", scheduleParallax);
    }

    scheduleParallax();
    updateDots();

    function destroy() {
      window.removeEventListener("scroll", scheduleParallax);
      window.removeEventListener("resize", scheduleParallax);
      window.removeEventListener("resize", updateDots);
      if (reduceMotion && typeof reduceMotion.removeEventListener === "function") {
        reduceMotion.removeEventListener("change", scheduleParallax);
      }
      if (mobileTrack) {
        mobileTrack.removeEventListener("scroll", scheduleDotsUpdate);
      }
      dots.forEach(function(dot) {
        dot.removeEventListener("click", onDotClick);
      });
      if (parallaxRaf) {
        window.cancelAnimationFrame(parallaxRaf);
        parallaxRaf = null;
      }
      if (dotsRaf) {
        window.cancelAnimationFrame(dotsRaf);
        dotsRaf = null;
      }
      delete window.__cpwReviewsInstances[rootId];
    }

    const unloadHandler = function(event) {
      if (!event || !event.target) return;
      if (event.target === sectionNode || event.target.contains(root)) {
        destroy();
        document.removeEventListener("shopify:section:unload", unloadHandler);
      }
    };

    document.addEventListener("shopify:section:unload", unloadHandler);
    window.__cpwReviewsInstances[rootId] = { destroy: destroy };
  })();
</script>

