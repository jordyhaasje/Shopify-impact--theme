{%- render 'section-spacing-collapsing' -%}
<style>
#shopify-section-{{ section.id }}{--gz-bg:{{ section.settings.background_color }};--gz-card:{{ section.settings.card_color }};--gz-text:{{ section.settings.text_color }};--gz-muted:{{ section.settings.muted_text_color }};--gz-accent:{{ section.settings.accent_color }};--gz-star:{{ section.settings.star_color }}}
#shopify-section-{{ section.id }} .gz{position:relative;overflow:hidden;isolation:isolate;background:radial-gradient(circle at 8% 18%,color-mix(in srgb,var(--gz-accent) 22%,transparent),transparent 28%),radial-gradient(circle at 92% 12%,rgba(255,255,255,.95),transparent 24%),linear-gradient(135deg,var(--gz-bg),#fff 52%,#fff4f8);color:var(--gz-text)}
#shopify-section-{{ section.id }} .gz__shell{max-width:{{ section.settings.content_width }}px;margin-inline:auto;padding:{{ section.settings.padding_y }}px 20px;position:relative;z-index:1}
#shopify-section-{{ section.id }} .gz__orb{position:absolute;width:180px;aspect-ratio:1;border-radius:999px;background:linear-gradient(135deg,rgba(255,255,255,.9),color-mix(in srgb,var(--gz-accent) 42%,white));filter:blur(2px);opacity:.5;animation:gz-float-{{ section.id }} 8s ease-in-out infinite;pointer-events:none}
#shopify-section-{{ section.id }} .gz__orb--1{top:42px;left:min(4vw,52px)}#shopify-section-{{ section.id }} .gz__orb--2{right:min(5vw,74px);bottom:62px;width:130px;animation-delay:-3s}
#shopify-section-{{ section.id }} .gz__head{text-align:center;max-width:780px;margin:0 auto 32px}#shopify-section-{{ section.id }} .gz__eyebrow{display:inline-flex;gap:8px;padding:8px 14px;border:1px solid rgba(215,93,139,.24);border-radius:999px;background:rgba(255,255,255,.72);box-shadow:0 12px 34px rgba(223,101,149,.12);color:var(--gz-accent);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
#shopify-section-{{ section.id }} .gz__title{margin:16px 0 10px;font-family:var(--heading-font-family);font-size:clamp(24px,3vw,30px);line-height:1.02;letter-spacing:-.035em;color:var(--gz-text)}#shopify-section-{{ section.id }} .gz__title span{color:var(--gz-accent);font-style:italic}
#shopify-section-{{ section.id }} .gz__text{margin:0 auto;max-width:650px;color:var(--gz-muted);font-size:clamp(15px,1.8vw,18px);line-height:1.7}
#shopify-section-{{ section.id }} .gz__panel{border:1px solid rgba(215,93,139,.18);border-radius:34px;background:rgba(255,255,255,.62);box-shadow:0 30px 80px rgba(188,72,119,.15),inset 0 1px 0 rgba(255,255,255,.85);backdrop-filter:blur(16px);padding:20px}
#shopify-section-{{ section.id }} .gz__track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding:4px 4px 18px}#shopify-section-{{ section.id }} .gz__track::-webkit-scrollbar{display:none}
#shopify-section-{{ section.id }} .gz-card{scroll-snap-align:start;flex:0 0 calc((100% - 36px)/3);min-height:300px;display:flex;flex-direction:column;justify-content:space-between;gap:18px;padding:24px;border-radius:28px;background:linear-gradient(180deg,rgba(255,255,255,.95),var(--gz-card));border:1px solid rgba(215,93,139,.16);box-shadow:0 18px 50px rgba(188,72,119,.12);position:relative;overflow:hidden}
#shopify-section-{{ section.id }} .gz-card:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 18% 0%,color-mix(in srgb,var(--gz-accent) 15%,transparent),transparent 34%);pointer-events:none}#shopify-section-{{ section.id }} .gz-card>*{position:relative;z-index:1}
#shopify-section-{{ section.id }} .gz-card__stars{display:flex;gap:3px;color:var(--gz-star);font-size:{{ section.settings.star_size }}px;letter-spacing:.04em;text-shadow:0 7px 20px color-mix(in srgb,var(--gz-star) 28%,transparent)}#shopify-section-{{ section.id }} .gz-card__quote{margin:0;color:var(--gz-text);font-size:clamp(17px,1.8vw,22px);line-height:1.45;letter-spacing:-.02em}
#shopify-section-{{ section.id }} .gz-card__meta{display:flex;align-items:center;gap:12px}#shopify-section-{{ section.id }} .gz-card__avatar{width:54px;height:54px;border-radius:999px;overflow:hidden;display:grid;place-items:center;background:linear-gradient(135deg,#ffd8e6,#fff);color:var(--gz-accent);font-weight:900;border:2px solid rgba(255,255,255,.9);box-shadow:0 12px 24px rgba(188,72,119,.18);flex:0 0 auto}#shopify-section-{{ section.id }} .gz-card__avatar img{width:100%;height:100%;object-fit:cover}#shopify-section-{{ section.id }} .gz-card__name{font-weight:850;color:var(--gz-text)}#shopify-section-{{ section.id }} .gz-card__label{font-size:13px;color:var(--gz-muted)}
#shopify-section-{{ section.id }} .gz__controls{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:2px}#shopify-section-{{ section.id }} .gz__btn{width:46px;height:46px;border-radius:999px;border:1px solid rgba(215,93,139,.22);background:rgba(255,255,255,.88);color:var(--gz-accent);display:grid;place-items:center;cursor:pointer;box-shadow:0 12px 26px rgba(188,72,119,.14);transition:transform .2s ease,box-shadow .2s ease,background .2s ease}#shopify-section-{{ section.id }} .gz__btn:hover{transform:translateY(-2px);box-shadow:0 18px 32px rgba(188,72,119,.2);background:#fff}
#shopify-section-{{ section.id }} .gz__marquee{margin-top:28px;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}#shopify-section-{{ section.id }} .gz__marquee-track{display:flex;width:max-content;gap:12px;animation:gz-marquee-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite}#shopify-section-{{ section.id }} .gz__icon{display:inline-flex;align-items:center;gap:10px;min-width:max-content;padding:12px 18px;border-radius:999px;background:rgba(255,255,255,.75);border:1px solid rgba(215,93,139,.18);box-shadow:0 10px 24px rgba(188,72,119,.1);color:var(--gz-text);font-size:13px;font-weight:800;letter-spacing:.03em}#shopify-section-{{ section.id }} .gz__icon-symbol{color:var(--gz-accent);font-size:18px}
@keyframes gz-marquee-{{ section.id }}{from{transform:translateX(0)}to{transform:translateX(-50%)}}@keyframes gz-float-{{ section.id }}{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(18px,-16px,0) scale(1.06)}}
@media(max-width:989px){#shopify-section-{{ section.id }} .gz-card{flex-basis:calc((100% - 18px)/2)}}@media(max-width:699px){#shopify-section-{{ section.id }} .gz__shell{padding:{{ section.settings.mobile_padding_y }}px 16px}#shopify-section-{{ section.id }} .gz__panel{border-radius:24px;padding:12px}#shopify-section-{{ section.id }} .gz-card{flex-basis:86%;min-height:280px;padding:20px;border-radius:22px}#shopify-section-{{ section.id }} .gz__orb{width:120px}}
</style>
<section class="gz" data-glozzy-reviews data-section-id="{{ section.id }}"><div class="gz__orb gz__orb--1"></div><div class="gz__orb gz__orb--2"></div><div class="gz__shell" data-section-bounded-shell><div class="gz__head">{%- if section.settings.eyebrow != blank -%}<div class="gz__eyebrow">✦ {{ section.settings.eyebrow | escape }}</div>{%- endif -%}{%- if section.settings.heading != blank -%}<h2 class="gz__title">{{ section.settings.heading }}</h2>{%- endif -%}{%- if section.settings.text != blank -%}<div class="gz__text">{{ section.settings.text }}</div>{%- endif -%}</div><div class="gz__panel"><div class="gz__track" data-section-slider aria-label="{{ section.settings.heading | strip_html | escape }}">{%- for block in section.blocks -%}{%- if block.type == 'review' -%}<article class="gz-card" data-section-slide data-section-review-item {{ block.shopify_attributes }}><div class="gz-card__stars" aria-label="{{ block.settings.rating }} van 5 sterren">{%- for i in (1..5) -%}<span>{% if i <= block.settings.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}</div>{%- if block.settings.quote != blank -%}<p class="gz-card__quote">“{{ block.settings.quote | escape }}”</p>{%- endif -%}<div class="gz-card__meta"><div class="gz-card__avatar">{%- if block.settings.avatar != blank -%}{{ block.settings.avatar | image_url: width: 140 | image_tag: loading: 'lazy', widths: '70,100,140', alt: block.settings.author }}{%- else -%}{{ block.settings.author | slice: 0 | upcase }}{%- endif -%}</div><div><div class="gz-card__name">{{ block.settings.author | escape }}</div>{%- if block.settings.label != blank -%}<div class="gz-card__label">{{ block.settings.label | escape }}</div>{%- endif -%}</div></div></article>{%- endif -%}{%- endfor -%}</div><div class="gz__controls" aria-label="Slider navigatie"><button class="gz__btn" type="button" data-glozzy-prev aria-label="Vorige review">‹</button><button class="gz__btn" type="button" data-glozzy-next aria-label="Volgende review">›</button></div></div>{%- assign icons = section.settings.beauty_icons | split: ',' -%}<div class="gz__marquee" aria-label="Beauty product icons"><div class="gz__marquee-track">{%- for repeat in (1..2) -%}{%- for icon in icons -%}{%- assign label = icon | strip -%}{%- if label != blank -%}<span class="gz__icon"><span class="gz__icon-symbol">✧</span>{{ label | escape }}</span>{%- endif -%}{%- endfor -%}{%- endfor -%}</div></div></div></section>
<script>
(function(){var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;function init(){var section=root.querySelector('[data-glozzy-reviews]');if(!section||section.dataset.glozzyReady==='true')return;section.dataset.glozzyReady='true';var track=section.querySelector('[data-section-slider]');var prev=section.querySelector('[data-glozzy-prev]');var next=section.querySelector('[data-glozzy-next]');if(!track||!prev||!next)return;function step(){var slide=track.querySelector('[data-section-slide]');if(!slide)return track.clientWidth;var styles=window.getComputedStyle(track);var gap=parseFloat(styles.columnGap||styles.gap||0);return slide.getBoundingClientRect().width+gap}prev.addEventListener('click',function(){track.scrollBy({left:-step(),behavior:'smooth'})});next.addEventListener('click',function(){track.scrollBy({left:step(),behavior:'smooth'})})}init();document.addEventListener('shopify:section:load',function(event){if(event.detail&&event.detail.sectionId==='{{ section.id }}'){root=document.getElementById('shopify-section-{{ section.id }}');init()}})})();
</script>
{% schema %}
{"name":"Glozzy premium reviews","class":"shopify-section--glozzy-premium-reviews","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Loved by beauty lovers"},{"type":"text","id":"heading","label":"Heading","default":"Glozzy glow, <span>real reviews</span>"},{"type":"richtext","id":"text","label":"Text","default":"<p>Een premium review slider met zachte roze tinten, professionele sterren en een luxe beauty uitstraling.</p>"},{"type":"text","id":"beauty_icons","label":"Scrolling beauty producten","default":"Lip Gloss, Blush, Serum, Mascara, Highlighter, Lip Oil, Primer, Setting Spray"},{"type":"range","id":"content_width","label":"Content width","min":900,"max":1120,"step":20,"unit":"px","default":1060},{"type":"range","id":"padding_y","label":"Desktop vertical padding","min":48,"max":120,"step":4,"unit":"px","default":88},{"type":"range","id":"mobile_padding_y","label":"Mobile vertical padding","min":36,"max":84,"step":4,"unit":"px","default":56},{"type":"range","id":"star_size","label":"Star size","min":16,"max":28,"step":1,"unit":"px","default":21},{"type":"range","id":"marquee_speed","label":"Icon scroll speed","min":12,"max":42,"step":2,"unit":"s","default":24},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#fff1f7"},{"type":"color","id":"card_color","label":"Card","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#3b1424"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#8b5d6e"},{"type":"color","id":"accent_color","label":"Pink accent","default":"#d95f94"},{"type":"color","id":"star_color","label":"Stars","default":"#e45596"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"image_picker","id":"avatar","label":"Avatar"},{"type":"range","id":"rating","label":"Stars","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Review","default":"De gloss voelt luxe, blijft mooi zitten en geeft precies die soft pink shine waar ik naar zocht."},{"type":"text","id":"author","label":"Name","default":"Sophie M."},{"type":"text","id":"label","label":"Label","default":"Verified Glozzy customer"}]}],"presets":[{"name":"Glozzy premium reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"De kleur, shine en verpakking voelen echt high-end. Mijn everyday lip gloss.","author":"Lina R.","label":"Verified customer"}},{"type":"review","settings":{"rating":5,"quote":"Super zacht op mijn lippen en de roze glow past perfect bij mijn make-up routine.","author":"Amira K.","label":"Beauty lover"}},{"type":"review","settings":{"rating":5,"quote":"Glozzy ziet eruit als een premium beauty brand. De finish is glossy maar niet plakkerig.","author":"Noor V.","label":"Repeat customer"}},{"type":"review","settings":{"rating":4,"quote":"Prachtige zachte tinten en heel professioneel. Ik krijg er vaak complimenten over.","author":"Eva S.","label":"Verified customer"}}]}]}
{% endschema %}