{%- render 'section-spacing-collapsing' -%}

{%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
{%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}

<style>
  #shopify-section-{{ section.id }} {
    --jh-text: {{ section.settings.text_color.rgb }};
    --jh-overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --jh-star-bg: {{ section.settings.star_background.rgb }};
    --jh-star-color: {{ section.settings.star_color.rgb }};
    --jh-button-bg: {{ section.settings.button_background.rgb }};
    --jh-button-text: {{ section.settings.button_text_color.rgb }};
    --jh-logo-color: {{ section.settings.logo_color.rgb }};
    --jh-min-height: {{ section.settings.hero_height }}px;
    --jh-mobile-min-height: {{ section.settings.mobile_hero_height }}px;
  }
  #shopify-section-{{ section.id }} .jordy-heroo{position:relative;width:100%;min-height:var(--jh-min-height);overflow:hidden;isolation:isolate;background:#111;color:rgb(var(--jh-text))}
  #shopify-section-{{ section.id }} .jordy-heroo *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .jordy-heroo__slides{position:absolute;inset:0;z-index:-2}
  #shopify-section-{{ section.id }} .jordy-heroo__slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .65s ease,visibility .65s ease}
  #shopify-section-{{ section.id }} .jordy-heroo__slide.is-active{opacity:1;visibility:visible}
  #shopify-section-{{ section.id }} .jordy-heroo__media,#shopify-section-{{ section.id }} .jordy-heroo__media:after{position:absolute;inset:0}
  #shopify-section-{{ section.id }} .jordy-heroo__media:after{content:"";z-index:1;background:linear-gradient(90deg,rgb(0 0 0/.54) 0%,rgb(0 0 0/.34) 48%,rgb(0 0 0/.2) 100%),rgb(var(--jh-overlay))}
  #shopify-section-{{ section.id }} .jordy-heroo__media img,#shopify-section-{{ section.id }} .jordy-heroo__placeholder svg{width:100%;height:100%;display:block;object-fit:cover}
  #shopify-section-{{ section.id }} .jordy-heroo__placeholder{width:100%;height:100%;background:linear-gradient(135deg,#303936,#141414)}
  #shopify-section-{{ section.id }} .jordy-heroo__mobile-image{display:none!important}
  #shopify-section-{{ section.id }} .jordy-heroo__content-layer{position:relative;z-index:2;min-height:calc(var(--jh-min-height) - {{ section.settings.marquee_height }}px);display:flex;align-items:center}
  #shopify-section-{{ section.id }} .jordy-heroo__bounded-shell{width:min({{ section.settings.content_width }}px,calc(100vw - 48px));max-width:{{ section.settings.content_width }}px;margin-inline:auto;display:grid;grid-template-columns:minmax(0,{{ section.settings.text_max_width }}px) auto;gap:28px;align-items:center;padding-block:{{ section.settings.content_padding_top }}px {{ section.settings.content_padding_bottom }}px}
  #shopify-section-{{ section.id }} .jordy-heroo__content-panel{min-height:260px;display:grid;align-content:center}
  #shopify-section-{{ section.id }} .jordy-heroo__content-item{display:none;transform:translateY({{ section.settings.content_offset_y }}px)}
  #shopify-section-{{ section.id }} .jordy-heroo__content-item.is-active{display:block}
  #shopify-section-{{ section.id }} .jordy-heroo__badge{display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;color:rgb(var(--jh-text));font:800 13px/1.25 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-shadow:0 1px 12px rgb(0 0 0/.45)}
  #shopify-section-{{ section.id }} .jordy-heroo__stars{display:inline-flex;align-items:center;gap:2px;flex:0 0 auto}
  #shopify-section-{{ section.id }} .jordy-heroo__star{width:13px;height:13px;display:grid;place-items:center;border-radius:1px;background:rgb(var(--jh-star-bg));color:rgb(var(--jh-star-color));font-size:8px;line-height:1;box-shadow:0 0 0 1px rgb(255 255 255/.12) inset}
  #shopify-section-{{ section.id }} .jordy-heroo__heading{margin:0;max-width:700px;color:rgb(var(--jh-text));font:850 clamp(34px,5vw,{{ section.settings.heading_size }}px)/.98 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.045em;text-shadow:0 2px 18px rgb(0 0 0/.45)}
  #shopify-section-{{ section.id }} .jordy-heroo__text{margin-top:12px;max-width:660px;color:rgb(var(--jh-text));font:760 clamp(14px,1.5vw,{{ section.settings.text_size }}px)/1.38 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-shadow:0 2px 16px rgb(0 0 0/.45)}
  #shopify-section-{{ section.id }} .jordy-heroo__text p{margin:0}
  #shopify-section-{{ section.id }} .jordy-heroo__button{display:inline-flex;align-items:center;justify-content:center;margin-top:22px;min-height:42px;padding:11px 25px;border:0;border-radius:{{ section.settings.button_radius }}px;background:rgb(var(--jh-button-bg));color:rgb(var(--jh-button-text));font:850 14px/1 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-decoration:none;box-shadow:0 12px 26px rgb(0 0 0/.16)}
  #shopify-section-{{ section.id }} .jordy-heroo__nav-wrap{display:grid;gap:16px;justify-items:center;align-self:center}
  #shopify-section-{{ section.id }} .jordy-heroo__nav{display:flex;gap:10px;align-items:center}
  #shopify-section-{{ section.id }} .jordy-heroo__nav-button{width:44px;height:44px;display:grid;place-items:center;border:1px solid rgb(255 255 255/.32);border-radius:999px;background:rgb(0 0 0/.18);color:rgb(var(--jh-text));backdrop-filter:blur(8px);box-shadow:0 10px 28px rgb(0 0 0/.22);cursor:pointer;transition:background .2s ease,transform .2s ease,border-color .2s ease}
  #shopify-section-{{ section.id }} .jordy-heroo__nav-button:hover{transform:translateY(-1px);background:rgb(255 255 255/.16);border-color:rgb(255 255 255/.5)}
  #shopify-section-{{ section.id }} .jordy-heroo__nav-button svg{width:22px;height:22px}
  #shopify-section-{{ section.id }} .jordy-heroo__dots{display:flex;align-items:center;justify-content:center;gap:8px}
  #shopify-section-{{ section.id }} .jordy-heroo__dot{width:8px;height:8px;padding:0;border:0;border-radius:999px;background:rgb(255 255 255/.46);cursor:pointer;transition:width .2s ease,background .2s ease}
  #shopify-section-{{ section.id }} .jordy-heroo__dot[aria-current="true"]{width:24px;background:rgb(var(--jh-text))}
  #shopify-section-{{ section.id }} .jordy-heroo__marquee{position:absolute;z-index:3;left:0;right:0;bottom:0;height:{{ section.settings.marquee_height }}px;display:flex;align-items:center;overflow:hidden;color:rgb(var(--jh-logo-color));background:linear-gradient(180deg,rgb(0 0 0/0) 0%,rgb(0 0 0/.18) 100%);-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 7%,#000 93%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 7%,#000 93%,transparent 100%)}
  #shopify-section-{{ section.id }} .jordy-heroo__marquee-track{display:flex;align-items:center;width:max-content;min-width:100%;gap:{{ section.settings.logo_gap }}px;animation:jordy-heroo-marquee-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite;will-change:transform}
  #shopify-section-{{ section.id }} .jordy-heroo__logo-item{flex:0 0 auto;min-width:max-content;display:inline-flex;align-items:center;justify-content:center;color:rgb(var(--jh-logo-color));opacity:{{ section.settings.logo_opacity | divided_by: 100.0 }};font-family:Georgia,"Times New Roman",serif;font-weight:800;font-size:clamp(24px,3vw,{{ section.settings.logo_text_size }}px);line-height:1;letter-spacing:-.08em;text-shadow:0 2px 15px rgb(0 0 0/.45);white-space:nowrap}
  #shopify-section-{{ section.id }} .jordy-heroo__logo-item img{display:block;width:auto;max-width:{{ section.settings.logo_image_width }}px;max-height:{{ section.settings.logo_image_height }}px;object-fit:contain;filter:brightness(0) invert(1) drop-shadow(0 2px 10px rgb(0 0 0/.35))}
  @keyframes jordy-heroo-marquee-{{ section.id }}{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media screen and (max-width:749px){#shopify-section-{{ section.id }} .jordy-heroo{min-height:var(--jh-mobile-min-height)}#shopify-section-{{ section.id }} .jordy-heroo__mobile-image{display:block!important}#shopify-section-{{ section.id }} .jordy-heroo__desktop-image{display:none!important}#shopify-section-{{ section.id }} .jordy-heroo__content-layer{min-height:calc(var(--jh-mobile-min-height) - {{ section.settings.mobile_marquee_height }}px)}#shopify-section-{{ section.id }} .jordy-heroo__bounded-shell{width:min(100%,calc(100vw - 32px));grid-template-columns:1fr;gap:18px;padding-block:{{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px}#shopify-section-{{ section.id }} .jordy-heroo__content-panel{min-height:0}#shopify-section-{{ section.id }} .jordy-heroo__content-item{transform:translateY({{ section.settings.mobile_content_offset_y }}px)}#shopify-section-{{ section.id }} .jordy-heroo__badge{gap:7px;margin-bottom:12px;font-size:12px}#shopify-section-{{ section.id }} .jordy-heroo__star{width:12px;height:12px;font-size:7px}#shopify-section-{{ section.id }} .jordy-heroo__heading{font-size:clamp(31px,9vw,43px)}#shopify-section-{{ section.id }} .jordy-heroo__text{font-size:14px}#shopify-section-{{ section.id }} .jordy-heroo__button{min-height:40px;padding:10px 20px}#shopify-section-{{ section.id }} .jordy-heroo__nav-wrap{position:absolute;right:0;bottom:calc({{ section.settings.mobile_marquee_height }}px + 18px);gap:10px}#shopify-section-{{ section.id }} .jordy-heroo__nav-button{width:38px;height:38px}#shopify-section-{{ section.id }} .jordy-heroo__nav-button svg{width:19px;height:19px}#shopify-section-{{ section.id }} .jordy-heroo__marquee{height:{{ section.settings.mobile_marquee_height }}px}#shopify-section-{{ section.id }} .jordy-heroo__marquee-track{gap:{{ section.settings.mobile_logo_gap }}px}#shopify-section-{{ section.id }} .jordy-heroo__logo-item{font-size:clamp(20px,8vw,31px)}}
  @media (prefers-reduced-motion:reduce){#shopify-section-{{ section.id }} .jordy-heroo__slide,#shopify-section-{{ section.id }} .jordy-heroo__marquee-track{transition:none;animation:none}}
</style>

<jordy-hero-slider class="jordy-heroo" data-autoplay="{{ section.settings.enable_autoplay }}" data-speed="{{ section.settings.autoplay_speed | times: 1000 }}" aria-label="{{ section.settings.accessibility_label | default: section.settings.heading | escape }}">
  <div class="jordy-heroo__slides" data-jordy-slides>
    {%- if slide_blocks.size > 0 -%}
      {%- for block in slide_blocks -%}
        <div class="jordy-heroo__slide{% if forloop.first %} is-active{% endif %}" data-jordy-slide data-section-slide data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="jordy-heroo__media">
            {%- if block.settings.image != blank -%}
              {%- if block.settings.mobile_image != blank -%}
                {{- block.settings.image | image_url: width: 3200 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,800,1000,1200,1400,1600,1800,2200,2600,3200', class: 'jordy-heroo__desktop-image', alt: block.settings.image.alt | default: block.settings.heading -}}
                {{- block.settings.mobile_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '100vw', widths: '400,600,800,1000,1200,1600', class: 'jordy-heroo__mobile-image', alt: block.settings.mobile_image.alt | default: block.settings.heading -}}
              {%- else -%}
                {{- block.settings.image | image_url: width: 3200 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,800,1000,1200,1400,1600,1800,2200,2600,3200', alt: block.settings.image.alt | default: block.settings.heading -}}
              {%- endif -%}
            {%- else -%}
              <div class="jordy-heroo__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' | replace: '<svg','<svg preserveAspectRatio="xMidYMid slice"' }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="jordy-heroo__slide is-active" data-jordy-slide data-section-slide>
        <div class="jordy-heroo__media">
          {%- if section.settings.image != blank -%}
            {{- section.settings.image | image_url: width: 3200 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,800,1000,1200,1400,1600,1800,2200,2600,3200', alt: section.settings.image.alt | default: section.settings.heading -}}
          {%- else -%}
            <div class="jordy-heroo__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' | replace: '<svg','<svg preserveAspectRatio="xMidYMid slice"' }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="jordy-heroo__content-layer">
    <div class="jordy-heroo__bounded-shell" data-section-bounded-shell>
      <div class="jordy-heroo__content-panel">
        {%- if slide_blocks.size > 0 -%}
          {%- for block in slide_blocks -%}
            <div class="jordy-heroo__content-item{% if forloop.first %} is-active{% endif %}" data-jordy-content data-block-id="{{ block.id }}">
              {%- if block.settings.rating_text != blank -%}<div class="jordy-heroo__badge" data-section-rating-badge><span class="jordy-heroo__stars" aria-label="{{ block.settings.star_count }} stars">{%- for i in (1..5) -%}{%- if i <= block.settings.star_count -%}<span class="jordy-heroo__star">★</span>{%- endif -%}{%- endfor -%}</span><span>{{ block.settings.rating_text | escape }}</span></div>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h2 class="jordy-heroo__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="jordy-heroo__text">{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.button_text != blank -%}<a class="jordy-heroo__button" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_text | escape }}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="jordy-heroo__content-item is-active" data-jordy-content>
            {%- if section.settings.rating_text != blank -%}<div class="jordy-heroo__badge" data-section-rating-badge><span class="jordy-heroo__stars" aria-label="{{ section.settings.star_count }} stars">{%- for i in (1..5) -%}{%- if i <= section.settings.star_count -%}<span class="jordy-heroo__star">★</span>{%- endif -%}{%- endfor -%}</span><span>{{ section.settings.rating_text | escape }}</span></div>{%- endif -%}
            {%- if section.settings.heading != blank -%}<h2 class="jordy-heroo__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
            {%- if section.settings.text != blank -%}<div class="jordy-heroo__text">{{ section.settings.text }}</div>{%- endif -%}
            {%- if section.settings.button_text != blank -%}<a class="jordy-heroo__button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if slide_blocks.size > 1 -%}
        <div class="jordy-heroo__nav-wrap" data-section-slider>
          <div class="jordy-heroo__nav" aria-label="Hero slider controls">
            <button class="jordy-heroo__nav-button" type="button" data-jordy-prev aria-label="Previous slide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
            <button class="jordy-heroo__nav-button" type="button" data-jordy-next aria-label="Next slide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
          </div>
          <div class="jordy-heroo__dots" data-jordy-dots aria-label="Hero slide pagination"></div>
        </div>
      {%- elsif section.settings.show_arrow -%}
        <div class="jordy-heroo__nav-wrap"><div class="jordy-heroo__nav"><a class="jordy-heroo__nav-button" href="{{ section.settings.arrow_link | default: section.settings.button_link | default: '#' }}" aria-label="{{ section.settings.arrow_label | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a></div></div>
      {%- endif -%}
    </div>
  </div>

  {%- if logo_blocks.size > 0 -%}
    <div class="jordy-heroo__marquee" data-section-marquee aria-label="{{ section.settings.marquee_label | escape }}"><div class="jordy-heroo__marquee-track" data-jordy-marquee-track>{%- for block in logo_blocks -%}<div class="jordy-heroo__logo-item" data-section-logo-item {{ block.shopify_attributes }}>{%- if block.settings.logo != blank -%}{{- block.settings.logo | image_url: width: 420 | image_tag: loading: 'lazy', widths: '120,180,240,320,420', sizes: '220px', alt: block.settings.logo_text -}}{%- elsif block.settings.logo_text != blank -%}{{- block.settings.logo_text | escape -}}{%- endif -%}</div>{%- endfor -%}</div></div>
  {%- endif -%}
</jordy-hero-slider>

<script>(()=>{class JordyHeroSlider extends HTMLElement{connectedCallback(){this.initialize()}disconnectedCallback(){this.destroy()}initialize(){this.destroy();this.slides=Array.from(this.querySelectorAll('[data-jordy-slide]'));this.contents=Array.from(this.querySelectorAll('[data-jordy-content]'));this.dotsRoot=this.querySelector('[data-jordy-dots]');this.prevButton=this.querySelector('[data-jordy-prev]');this.nextButton=this.querySelector('[data-jordy-next]');this.marqueeTrack=this.querySelector('[data-jordy-marquee-track]');this.index=Math.max(0,this.slides.findIndex(slide=>slide.classList.contains('is-active')));this.autoplay=this.dataset.autoplay==='true';this.speed=Number(this.dataset.speed||5000);this.handlers=[];this.cloneMarquee();this.buildDots();this.bindEvents();this.goTo(this.index);this.startAutoplay()}destroy(){this.stopAutoplay();if(this.handlers)this.handlers.forEach(({target,event,handler})=>target.removeEventListener(event,handler));this.handlers=[]}on(target,event,handler){if(!target)return;target.addEventListener(event,handler);this.handlers.push({target,event,handler})}cloneMarquee(){if(!this.marqueeTrack||this.marqueeTrack.dataset.cloned==='true')return;Array.from(this.marqueeTrack.children).forEach(item=>this.marqueeTrack.appendChild(item.cloneNode(true)));this.marqueeTrack.dataset.cloned='true'}buildDots(){if(!this.dotsRoot)return;this.dotsRoot.innerHTML='';this.slides.forEach((slide,index)=>{const dot=document.createElement('button');dot.type='button';dot.className='jordy-heroo__dot';dot.setAttribute('aria-label',`Go to slide ${index+1}`);dot.addEventListener('click',()=>this.goTo(index));this.dotsRoot.appendChild(dot)})}bindEvents(){this.on(this.prevButton,'click',()=>this.goTo(this.index-1));this.on(this.nextButton,'click',()=>this.goTo(this.index+1));this.on(this,'mouseenter',()=>this.stopAutoplay());this.on(this,'mouseleave',()=>this.startAutoplay());this.on(this,'focusin',()=>this.stopAutoplay());this.on(this,'focusout',()=>this.startAutoplay())}goTo(index){if(!this.slides.length)return;this.index=(index+this.slides.length)%this.slides.length;this.slides.forEach((slide,slideIndex)=>{const active=slideIndex===this.index;slide.classList.toggle('is-active',active);slide.setAttribute('aria-hidden',active?'false':'true')});this.contents.forEach((content,contentIndex)=>content.classList.toggle('is-active',contentIndex===this.index));if(this.dotsRoot)Array.from(this.dotsRoot.children).forEach((dot,dotIndex)=>dot.setAttribute('aria-current',dotIndex===this.index?'true':'false'))}startAutoplay(){this.stopAutoplay();if(!this.autoplay||this.slides.length<2)return;this.timer=window.setInterval(()=>this.goTo(this.index+1),this.speed)}stopAutoplay(){if(this.timer){window.clearInterval(this.timer);this.timer=null}}}if(!window.customElements.get('jordy-hero-slider'))window.customElements.define('jordy-hero-slider',JordyHeroSlider);const initJordyHero=(root=document)=>root.querySelectorAll('jordy-hero-slider').forEach(slider=>slider.initialize&&slider.initialize());document.addEventListener('shopify:section:load',event=>initJordyHero(event.target));document.addEventListener('shopify:section:select',event=>initJordyHero(event.target));document.addEventListener('shopify:block:select',event=>{const slider=event.target.closest('jordy-hero-slider');const slide=event.target.closest('[data-jordy-slide]');if(!slider||!slide)return;const index=Array.from(slider.querySelectorAll('[data-jordy-slide]')).indexOf(slide);if(index>=0)slider.goTo(index)})})();</script>

{% schema %}
{
  "name":"Jordy-heroo",
  "class":"shopify-section--jordy-heroo",
  "tag":"section",
  "disabled_on":{"templates":["password"],"groups":["header","custom.overlay"]},
  "max_blocks":24,
  "settings":[
    {"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Hero slider"},
    {"type":"image_picker","id":"image","label":"Fallback background image"},
    {"type":"range","id":"hero_height","label":"Desktop height","min":360,"max":760,"step":20,"unit":"px","default":520},
    {"type":"range","id":"mobile_hero_height","label":"Mobile height","min":440,"max":720,"step":20,"unit":"px","default":560},
    {"type":"range","id":"content_width","label":"Content width","min":900,"max":1400,"step":20,"unit":"px","default":1180},
    {"type":"range","id":"text_max_width","label":"Text max width","min":420,"max":760,"step":20,"unit":"px","default":660},
    {"type":"range","id":"content_offset_y","label":"Desktop content vertical offset","min":-80,"max":80,"step":4,"unit":"px","default":16},
    {"type":"range","id":"mobile_content_offset_y","label":"Mobile content vertical offset","min":-80,"max":80,"step":4,"unit":"px","default":0},
    {"type":"range","id":"content_padding_top","label":"Desktop top padding","min":40,"max":180,"step":4,"unit":"px","default":92},
    {"type":"range","id":"content_padding_bottom","label":"Desktop bottom padding","min":80,"max":220,"step":4,"unit":"px","default":120},
    {"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":40,"max":160,"step":4,"unit":"px","default":88},
    {"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":80,"max":220,"step":4,"unit":"px","default":124},
    {"type":"checkbox","id":"enable_autoplay","label":"Enable autoplay","default":true},
    {"type":"range","id":"autoplay_speed","label":"Autoplay speed","min":3,"max":10,"step":1,"unit":"s","default":5},
    {"type":"header","content":"Fallback content"},
    {"type":"range","id":"star_count","label":"Fallback number of stars","min":1,"max":5,"step":1,"default":5},
    {"type":"text","id":"rating_text","label":"Fallback rating text","default":"Trusted by 100,000+ customers"},
    {"type":"text","id":"heading","label":"Fallback heading","default":"Ready for adventure"},
