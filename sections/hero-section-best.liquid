{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .hero-section-best {
    display: block;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hero-section-best__inner {
    width: min({{ section.settings.content_width }}px, calc(100% - 32px));
    margin: 0 auto;
    padding: {{ section.settings.padding_y }}px 0;
  }

  #shopify-section-{{ section.id }} .hero-section-best__viewport {
    overflow: hidden;
    border-radius: 28px;
    background: {{ section.settings.card_background }};
    box-shadow: 0 22px 70px rgba(0, 0, 0, .08);
  }

  #shopify-section-{{ section.id }} .hero-section-best__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .hero-section-best__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .hero-section-best__slide {
    flex: 0 0 100%;
    min-width: 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(18px, 3vw, 34px);
    align-items: center;
    padding: clamp(18px, 2.8vw, 28px);
  }

  #shopify-section-{{ section.id }} .hero-section-best__media {
    min-height: 350px;
    border-radius: 20px;
    overflow: hidden;
    background: #f4f1ed;
  }

  #shopify-section-{{ section.id }} .hero-section-best__media img,
  #shopify-section-{{ section.id }} .hero-section-best__media video {
    width: 100%;
    height: 100%;
    min-height: 350px;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .hero-section-best__empty {
    min-height: 350px;
    display: grid;
    place-items: center;
    color: {{ section.settings.muted_text_color }};
    text-align: center;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .hero-section-best__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .hero-section-best__review {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    max-width: 100%;
    padding: 9px 12px;
    border: 1px solid rgba(0, 0, 0, .08);
    border-radius: 999px;
    font-size: 12px;
    line-height: 1.35;
    background: {{ section.settings.card_background }};
  }

  #shopify-section-{{ section.id }} .hero-section-best__stars {
    color: {{ section.settings.accent_color }};
    letter-spacing: .08em;
  }

  #shopify-section-{{ section.id }} .hero-section-best__heading {
    margin: 0;
    font-family: var(--heading-font-family);
    font-size: clamp(38px, 5vw, 56px);
    line-height: .98;
    letter-spacing: -.05em;
  }

  #shopify-section-{{ section.id }} .hero-section-best__text {
    color: {{ section.settings.muted_text_color }};
    font-size: 17px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .hero-section-best__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.card_background }};
    font-weight: 700;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .hero-section-best__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .hero-section-best__arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, .12);
    background: {{ section.settings.card_background }};
    color: {{ section.settings.text_color }};
    cursor: pointer;
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .hero-section-best__inner {
      padding: {{ section.settings.mobile_padding_y }}px 0;
    }

    #shopify-section-{{ section.id }} .hero-section-best__slide {
      grid-template-columns: 1fr;
      padding: 14px;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .hero-section-best__media,
    #shopify-section-{{ section.id }} .hero-section-best__media img,
    #shopify-section-{{ section.id }} .hero-section-best__media video,
    #shopify-section-{{ section.id }} .hero-section-best__empty {
      min-height: 310px;
    }

    #shopify-section-{{ section.id }} .hero-section-best__heading {
      font-size: clamp(34px, 10vw, 48px);
    }
  }
</style>

<hero-section-best class="hero-section-best" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
  <div class="hero-section-best__inner" data-section-bounded-shell>
    <div class="hero-section-best__viewport">
      <div class="hero-section-best__track" data-section-slider>
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <article class="hero-section-best__slide" data-section-slide {{ block.shopify_attributes }}>
              <div class="hero-section-best__media">
                {% if section.settings.hero_video != blank %}
                  {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1400x' }}
                {% elsif block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,800,1000,1200,1400', alt: block.settings.heading }}
                {% else %}
                  <div class="hero-section-best__empty">Voeg een afbeelding toe aan de slide of een video aan de section.</div>
                {% endif %}
              </div>
              <div class="hero-section-best__content">
                <div class="hero-section-best__review"><span class="hero-section-best__stars">★★★★★</span> “Premium uitstraling”</div>
                {% if block.settings.heading != blank %}<h2 class="hero-section-best__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.text != blank %}<div class="hero-section-best__text">{{ block.settings.text }}</div>{% endif %}
                {% if block.settings.button_text != blank %}<a class="hero-section-best__button" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_text | escape }}</a>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="hero-section-best__controls">
      <button class="hero-section-best__arrow" type="button" data-prev aria-label="Vorige slide">‹</button>
      <button class="hero-section-best__arrow" type="button" data-next aria-label="Volgende slide">›</button>
    </div>
  </div>
</hero-section-best>

<script>
  if (!customElements.get('hero-section-best')) {
    customElements.define('hero-section-best', class HeroSectionBest extends HTMLElement {
      connectedCallback() {
        if (this.ready) return;
        this.ready = true;
        this.track = this.querySelector('[data-section-slider]');
        this.slides = Array.from(this.querySelectorAll('[data-section-slide]'));
        this.index = 0;
        this.timer = null;
        this.autoplay = this.dataset.autoplay === 'true';
        this.speed = Number(this.dataset.speed || 5000);
        if (!this.track || !this.slides.length) return;
        this.querySelector('[data-prev]')?.addEventListener('click', () => this.goTo(this.index - 1, true));
        this.querySelector('[data-next]')?.addEventListener('click', () => this.goTo(this.index + 1, true));
        this.addEventListener('mouseenter', () => this.stop());
        this.addEventListener('mouseleave', () => this.start());
        this.start();
      }
      disconnectedCallback() { this.stop(); }
      stop() { if (this.timer) window.clearInterval(this.timer); this.timer = null; }
      start() { this.stop(); if (this.autoplay && this.slides.length > 1) this.timer = window.setInterval(() => this.goTo(this.index + 1, false), this.speed); }
      goTo(index, restart) {
        this.index = (index + this.slides.length) % this.slides.length;
        const slide = this.slides[this.index];
        if (slide) this.track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
        if (restart) this.start();
      }
    });
  }

  document.addEventListener('shopify:section:load', (event) => {
    event.target.querySelectorAll('hero-section-best').forEach((section) => section.connectedCallback && section.connectedCallback());
  });

  document.addEventListener('shopify:block:select', (event) => {
    const section = event.target.closest('hero-section-best');
    const slide = event.target.closest('[data-section-slide]');
    if (section && slide && section.slides) section.goTo(section.slides.indexOf(slide), true);
  });
</script>

{% schema %}
{
  "name": "Hero-section-best",
  "settings": [
    { "type": "video", "id": "hero_video", "label": "Hero video" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 900, "max": 1180, "step": 20, "unit": "px", "default": 1100 },
    { "type": "range", "id": "padding_y", "label": "Desktop vertical padding", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "mobile_padding_y", "label": "Mobile vertical padding", "min": 36, "max": 84, "step": 4, "unit": "px", "default": 52 },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slider", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f3ee" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#6f675f" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#b98b73" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Een moderne hero slider voor beeld, video en reviews"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Gebruik meerdere slides met autoplay, media, reviews en call-to-actions.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop nu"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero-section-best",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}