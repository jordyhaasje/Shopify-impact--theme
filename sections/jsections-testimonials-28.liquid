{%- comment -%}
  JSections - Testimonials #28
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-testimonials-28.css' | asset_url | stylesheet_tag }}

<section
  class="jtest28 jtest28--{{ section.settings.style_preset }}"
  style="
    --jtest28-bg-start: {{ section.settings.gradient_start }};
    --jtest28-bg-mid: {{ section.settings.gradient_mid }};
    --jtest28-bg-end: {{ section.settings.gradient_end }};
    --jtest28-text: {{ section.settings.text_color }};
    --jtest28-card-bg: {{ section.settings.card_background }};
    --jtest28-card-border: {{ section.settings.card_border_color }};
    --jtest28-accent: {{ section.settings.accent_color }};
    --jtest28-badge-bg: {{ section.settings.badge_background }};
    --jtest28-badge-text: {{ section.settings.badge_text_color }};
    --jtest28-button-bg: {{ section.settings.button_background }};
    --jtest28-button-text: {{ section.settings.button_text_color }};
    --jtest28-guarantee-bg: {{ section.settings.guarantee_background }};
    --jtest28-max-width: {{ section.settings.max_width }}px;
    --jtest28-padding-top: {{ section.settings.padding_top }}px;
    --jtest28-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jtest28-columns: {{ section.settings.desktop_columns }};
    --jtest28-gap: {{ section.settings.card_gap }}px;
    --jtest28-mobile-width: {{ section.settings.mobile_card_width }}%;
  "
  data-jtest28-section="{{ section.id }}"
  data-jtest28-columns="{{ section.settings.desktop_columns }}"
  {{ section.shopify_attributes }}
>
  <div class="jtest28__inner">
    {%- if section.settings.show_summary -%}
      <div class="jtest28__summary">
        <div class="jtest28__avatars" aria-hidden="true">
          {%- for index in (1..4) -%}
            {%- liquid
              assign avatar_key = 'avatar_' | append: index
              assign avatar = section.settings[avatar_key]
            -%}
            <div class="jtest28__avatar">
              {%- if avatar != blank -%}
                {{
                  avatar
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    sizes: '44px',
                    alt: '',
                    class: 'jtest28__avatar-image'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'jtest28__avatar-placeholder' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="jtest28__summary-content">
          {%- if section.settings.summary_text != blank -%}
            <p class="jtest28__summary-text">{{ section.settings.summary_text }}</p>
          {%- endif -%}
          <div class="jtest28__summary-rating">
            <div class="jtest28__stars" aria-label="{{ section.settings.rating_text | escape }}">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <rect width="32" height="32" rx="0" />
                  <path d="M16 5 18.7 12.4H26.6L20.2 17 22.8 24.7 16 20 9.2 24.7 11.8 17 5.4 12.4H13.3L16 5Z" />
                </svg>
              {%- endfor -%}
            </div>
            {%- if section.settings.rating_text != blank -%}
              <p>{{ section.settings.rating_text }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <div class="jtest28__heading">{{ section.settings.heading }}</div>
    {%- endif -%}

    <div class="jtest28__slider" data-jtest28-slider>
      <div class="jtest28__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign poster = block.settings.poster
            assign video = block.settings.video
            assign image_alt = block.settings.author | default: 'Video testimonial'

            if poster != blank and poster.alt != blank
              assign image_alt = poster.alt
            endif
          -%}
          <article class="jtest28__card" role="listitem" {{ block.shopify_attributes }}>
            <div class="jtest28__media">
              {%- if video != blank -%}
                {{
                  video
                  | video_tag:
                    image_size: '900x',
                    autoplay: false,
                    loop: true,
                    muted: false,
                    controls: false,
                    class: 'jtest28__video'
                }}
                <button type="button" class="jtest28__play is-active" aria-label="Play testimonial video">
                  <svg viewBox="0 0 256 256" aria-hidden="true"><path d="M240 128a15.74 15.74 0 0 1-7.6 13.51L88.32 229.65a16 16 0 0 1-16.2.3A15.86 15.86 0 0 1 64 216.13V39.87a15.86 15.86 0 0 1 8.12-13.82 16 16 0 0 1 16.2.3L232.4 114.49A15.74 15.74 0 0 1 240 128Z"/></svg>
                </button>
              {%- elsif poster != blank -%}
                {{
                  poster
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 1024px) 25vw, 78vw',
                    alt: image_alt,
                    class: 'jtest28__image'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'jtest28__placeholder' }}
              {%- endif -%}
            </div>

            <div class="jtest28__content">
              {%- if block.settings.text != blank -%}
                <div class="jtest28__quote">{{ block.settings.text }}</div>
              {%- endif -%}
              <div class="jtest28__bottom">
                {%- if block.settings.show_stars -%}
                  <div class="jtest28__card-rating">
                    <div class="jtest28__stars jtest28__stars--small" aria-hidden="true">
                      {%- for i in (1..5) -%}
                        <svg viewBox="0 0 32 32">
                          <rect width="32" height="32" rx="0" />
                          <path d="M16 5 18.7 12.4H26.6L20.2 17 22.8 24.7 16 20 9.2 24.7 11.8 17 5.4 12.4H13.3L16 5Z" />
                        </svg>
                      {%- endfor -%}
                    </div>
                    {%- if block.settings.badge != blank -%}
                      <span class="jtest28__badge">{{ block.settings.badge }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <p class="jtest28__author">{{ block.settings.author }}</p>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
      <div class="jtest28__arrows">
        <button type="button" class="jtest28__arrow" aria-label="Previous testimonial" data-jtest28-prev><span aria-hidden="true"></span></button>
        <button type="button" class="jtest28__arrow" aria-label="Next testimonial" data-jtest28-next><span aria-hidden="true"></span></button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_button and section.settings.button_label != blank -%}
      <a class="jtest28__button" href="{{ section.settings.button_link | default: '#' }}">
        <span>{{ section.settings.button_label }}</span>
      </a>
    {%- endif -%}

    {%- if section.settings.show_guarantee and section.settings.guarantee_text != blank -%}
      <div class="jtest28__guarantee">{{ section.settings.guarantee_text }}</div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const selector = `[data-jtest28-section="${sectionId}"]`;
    const registryKey = "jtest28Instances";
    window[registryKey] = window[registryKey] || {};

    function cleanup() {
      const instance = window[registryKey][sectionId];
      if (!instance) return;
      instance.destroy();
      delete window[registryKey][sectionId];
    }

    function init() {
      const root = document.querySelector(selector);
      if (!root) return;
      cleanup();

      const track = root.querySelector(".jtest28__track");
      const slides = Array.from(root.querySelectorAll(".jtest28__card"));
      const prev = root.querySelector("[data-jtest28-prev]");
      const next = root.querySelector("[data-jtest28-next]");
      const playButtons = Array.from(root.querySelectorAll(".jtest28__play"));
      let index = 0;

      function visibleCount() {
        if (window.matchMedia("(min-width: 1024px)").matches) {
          return Math.max(1, Number(root.dataset.jtest28Columns || 4));
        }
        return 1;
      }

      function maxIndex() {
        return Math.max(0, slides.length - visibleCount());
      }

      function update() {
        index = Math.min(Math.max(index, 0), maxIndex());
        const gap = parseFloat(getComputedStyle(track).gap || "0");
        const width = slides[0]?.getBoundingClientRect().width || 0;
        track.style.transform = `translate3d(${-index * (width + gap)}px, 0, 0)`;
        if (prev) prev.disabled = index <= 0;
        if (next) next.disabled = index >= maxIndex();
      }

      function pauseOthers(activeVideo) {
        root.querySelectorAll("video").forEach((video) => {
          if (video === activeVideo) return;
          video.pause();
          video.controls = false;
          const media = video.closest(".jtest28__media");
          media?.querySelector(".jtest28__play")?.classList.add("is-active");
        });
      }

      const onPrev = () => {
        index -= 1;
        update();
      };
      const onNext = () => {
        index += 1;
        update();
      };
      const onResize = () => update();
      const playHandlers = [];

      playButtons.forEach((button) => {
        const handler = () => {
          const media = button.closest(".jtest28__media");
          const video = media?.querySelector("video");
          if (!video) return;
          if (video.paused) {
            pauseOthers(video);
            video.play();
            video.controls = true;
            button.classList.remove("is-active");
          } else {
            video.pause();
            video.controls = false;
            button.classList.add("is-active");
          }
        };
        button.addEventListener("click", handler);
        playHandlers.push([button, handler]);
      });

      root.querySelectorAll("video").forEach((video) => {
        video.addEventListener("pause", () => {
          const media = video.closest(".jtest28__media");
          if (!video.controls) return;
          media?.querySelector(".jtest28__play")?.classList.add("is-active");
        });
      });

      prev?.addEventListener("click", onPrev);
      next?.addEventListener("click", onNext);
      window.addEventListener("resize", onResize);
      update();

      window[registryKey][sectionId] = {
        destroy() {
          prev?.removeEventListener("click", onPrev);
          next?.removeEventListener("click", onNext);
          window.removeEventListener("resize", onResize);
          playHandlers.forEach(([button, handler]) => button.removeEventListener("click", handler));
        }
      };
    }

    init();
    document.addEventListener("shopify:section:load", init);
    document.addEventListener("shopify:section:unload", (event) => {
      if (event.detail?.sectionId === sectionId) cleanup();
    });
  })();
</script>

