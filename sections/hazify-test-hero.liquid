{% liquid
  assign hero_delay = section.settings.autoplay_speed | times: 1000
%}

<style>
  #shopify-section-{{ section.id }} .hazify-test-hero { color: {{ section.settings.text_color }}; position: relative; overflow: hidden; }
  #shopify-section-{{ section.id }} .hazify-test-hero__viewport { overflow: hidden; }
  #shopify-section-{{ section.id }} .hazify-test-hero__track { display: flex; transition: transform 450ms ease; }
  #shopify-section-{{ section.id }} .hazify-test-hero__slide { position: relative; min-width: 100%; min-height: {{ section.settings.min_height }}px; padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px; display: grid; align-items: {{ section.settings.vertical_alignment }}; overflow: hidden; }
  #shopify-section-{{ section.id }} .hazify-test-hero__media { position: absolute; inset: 0; z-index: 0; }
  #shopify-section-{{ section.id }} .hazify-test-hero__media picture,
  #shopify-section-{{ section.id }} .hazify-test-hero__media img { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .hazify-test-hero__media img { object-fit: cover; object-position: center; }
  #shopify-section-{{ section.id }} .hazify-test-hero__fallback { width: 100%; height: 100%; background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.45), rgba(255,255,255,0) 34%), linear-gradient(135deg, {{ section.settings.fallback_background }}, {{ section.settings.fallback_accent }}); }
  #shopify-section-{{ section.id }} .hazify-test-hero__overlay { position: absolute; inset: 0; z-index: 1; background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; pointer-events: none; }
  #shopify-section-{{ section.id }} .hazify-test-hero__inner { position: relative; z-index: 2; width: min(100%, {{ section.settings.max_width }}px); margin: 0 auto; display: flex; justify-content: {{ section.settings.horizontal_alignment }}; }
  #shopify-section-{{ section.id }} .hazify-test-hero__content { max-width: {{ section.settings.content_width }}px; text-align: {{ section.settings.text_alignment }}; padding: clamp(1.25rem, 4vw, 3rem); border-radius: {{ section.settings.content_radius }}px; background: rgba(255,255,255,{{ section.settings.content_background_opacity | divided_by: 100.0 }}); backdrop-filter: blur({{ section.settings.content_blur }}px); }
  #shopify-section-{{ section.id }} .hazify-test-hero__eyebrow { margin: 0 0 0.75rem; font-size: 0.8rem; line-height: 1.2; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .hazify-test-hero__heading { margin: 0; font-size: clamp(2.4rem, 6vw, {{ section.settings.heading_size }}px); line-height: 1.02; font-weight: 800; letter-spacing: 0; }
  #shopify-section-{{ section.id }} .hazify-test-hero__text { margin-top: 1rem; font-size: clamp(1rem, 2vw, {{ section.settings.text_size }}px); line-height: 1.7; }
  #shopify-section-{{ section.id }} .hazify-test-hero__text p { margin: 0; }
  #shopify-section-{{ section.id }} .hazify-test-hero__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %}; }
  #shopify-section-{{ section.id }} .hazify-test-hero__button { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0.85rem 1.2rem; border-radius: {{ section.settings.button_radius }}px; text-decoration: none; font-weight: 750; line-height: 1.2; }
  #shopify-section-{{ section.id }} .hazify-test-hero__button--primary { background: {{ section.settings.primary_button_background }}; color: {{ section.settings.primary_button_text }}; }
  #shopify-section-{{ section.id }} .hazify-test-hero__button--secondary { background: {{ section.settings.secondary_button_background }}; color: {{ section.settings.secondary_button_text }}; box-shadow: inset 0 0 0 1px currentColor; }
  #shopify-section-{{ section.id }} .hazify-test-hero__controls { position: absolute; z-index: 4; right: clamp(1rem, 5vw, 4rem); bottom: clamp(1rem, 4vw, 3rem); display: flex; align-items: center; gap: 0.75rem; }
  #shopify-section-{{ section.id }} .hazify-test-hero__counter { min-width: 4.5rem; padding: 0.7rem 0.9rem; border-radius: 999px; background: {{ section.settings.control_background }}; color: {{ section.settings.control_text_color }}; text-align: center; line-height: 1; }
  #shopify-section-{{ section.id }} .hazify-test-hero__control { width: 3rem; height: 3rem; border: 0; border-radius: 50%; background: {{ section.settings.control_background }}; color: {{ section.settings.control_text_color }}; box-shadow: 0 12px 30px rgba(0,0,0,0.14); cursor: pointer; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hazify-test-hero__slide { min-height: {{ section.settings.mobile_min_height }}px; padding-top: {{ section.settings.mobile_padding_top }}px; padding-bottom: {{ section.settings.mobile_padding_bottom }}px; }
    #shopify-section-{{ section.id }} .hazify-test-hero__inner { justify-content: center; }
    #shopify-section-{{ section.id }} .hazify-test-hero__content { width: 100%; text-align: {{ section.settings.mobile_text_alignment }}; }
    #shopify-section-{{ section.id }} .hazify-test-hero__actions { justify-content: center; }
    #shopify-section-{{ section.id }} .hazify-test-hero__controls { left: 1.5rem; right: auto; }
  }
</style>

<section class="hazify-test-hero" data-section-bounded-shell data-section-slider data-autoplay="{{ section.settings.autoplay }}" data-delay="{{ hero_delay }}">
  <div class="hazify-test-hero__viewport" data-hero-viewport>
    <div class="hazify-test-hero__track" data-hero-track>
      {% for block in section.blocks %}
        <article class="hazify-test-hero__slide" data-section-slide {{ block.shopify_attributes }}>
          <div class="hazify-test-hero__media" aria-hidden="true">
            {% if block.settings.image != blank %}
              <picture>
                {% if block.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">{% endif %}
                {{ block.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2200', sizes: '100vw', alt: block.settings.image_alt }}
              </picture>
            {% else %}
              <div class="hazify-test-hero__fallback"></div>
            {% endif %}
          </div>
          <div class="hazify-test-hero__overlay"></div>
          <div class="hazify-test-hero__inner"><div class="hazify-test-hero__content">
            {% if block.settings.eyebrow != blank %}<p class="hazify-test-hero__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
            {% if block.settings.heading != blank %}<h2 class="hazify-test-hero__heading">{{ block.settings.heading }}</h2>{% endif %}
            {% if block.settings.text != blank %}<div class="hazify-test-hero__text">{{ block.settings.text }}</div>{% endif %}
            <div class="hazify-test-hero__actions">
              {% if block.settings.button_text != blank and block.settings.button_link != blank %}<a class="hazify-test-hero__button hazify-test-hero__button--primary" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>{% endif %}
              {% if block.settings.secondary_button_text != blank and block.settings.secondary_button_link != blank %}<a class="hazify-test-hero__button hazify-test-hero__button--secondary" href="{{ block.settings.secondary_button_link }}">{{ block.settings.secondary_button_text }}</a>{% endif %}
            </div>
          </div></div>
        </article>
      {% endfor %}
    </div>
  </div>
  {% if section.blocks.size > 1 %}<div class="hazify-test-hero__controls" aria-label="Hero slider controls"><span class="hazify-test-hero__counter" data-hero-counter>1 / {{ section.blocks.size }}</span><button class="hazify-test-hero__control" type="button" data-hero-prev aria-label="Previous hero slide">‹</button><button class="hazify-test-hero__control" type="button" data-hero-next aria-label="Next hero slide">›</button></div>{% endif %}
</section>

<script>
  (function() {
    function initHazifyHero(scope) {
      scope.querySelectorAll('.hazify-test-hero[data-section-slider]').forEach(function(root) {
        if (root.dataset.heroReady === 'true') return;
        root.dataset.heroReady = 'true';
        var track = root.querySelector('[data-hero-track]');
        var slides = Array.prototype.slice.call(root.querySelectorAll('[data-section-slide]'));
        var prev = root.querySelector('[data-hero-prev]');
        var next = root.querySelector('[data-hero-next]');
        var counter = root.querySelector('[data-hero-counter]');
        var autoplay = root.dataset.autoplay === 'true';
        var delay = parseInt(root.dataset.delay || '5000', 10);
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var index = 0;
        var timer = null;
        if (!track || slides.length === 0) return;
        function render() { track.style.transform = 'translateX(' + String(index * -100) + '%)'; if (counter) counter.textContent = String(index + 1) + ' / ' + String(slides.length); }
        function go(delta) { index = (index + delta + slides.length) % slides.length; render(); }
        function stop() { if (timer) window.clearInterval(timer); timer = null; }
        function start() { stop(); if (!autoplay || reducedMotion || slides.length < 2) return; timer = window.setInterval(function() { go(1); }, delay); }
        if (prev) prev.addEventListener('click', function() { stop(); go(-1); });
        if (next) next.addEventListener('click', function() { stop(); go(1); });
        root.addEventListener('mouseenter', stop);
        root.addEventListener('focusin', stop);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusout', start);
        render();
        start();
      });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', function() { initHazifyHero(document); }); } else { initHazifyHero(document); }
    document.addEventListener('shopify:section:load', function(event) { initHazifyHero(event.target); });
  })();
</script>

{% schema %}
{
  "name": "Hazify test hero",
  "tag": "section",
  "class": "section-hazify-test-hero",
  "max_blocks": 4,
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 3, "max": 9, "step": 1, "unit": "s", "default": 5 },
    { "type": "select", "id": "horizontal_alignment", "label": "Desktop content position", "options": [ { "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" } ], "default": "flex-start" },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "options": [ { "value": "start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "end", "label": "Bottom" } ], "default": "center" },
    { "type": "select", "id": "text_alignment", "label": "Desktop text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "mobile_text_alignment", "label": "Mobile text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "range", "id": "min_height", "label": "Desktop height", "min": 360, "max": 820, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile height", "min": 360, "max": 720, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 360, "max": 760, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "heading_size", "label": "Maximum heading size", "min": 44, "max": 84, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "text_size", "label": "Maximum text size", "min": 16, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 30 },
    { "type": "range", "id": "content_background_opacity", "label": "Content background opacity", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 0 },
    { "type": "range", "id": "content_blur", "label": "Content blur", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "content_radius", "label": "Content radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "color", "id": "fallback_background", "label": "Fallback background", "default": "#f4f1eb" },
    { "type": "color", "id": "fallback_accent", "label": "Fallback accent", "default": "#d9e7ff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#000000" },
    { "type": "color", "id": "primary_button_background", "label": "Primary button background", "default": "#ffffff" },
    { "type": "color", "id": "primary_button_text", "label": "Primary button text", "default": "#111111" },
    { "type": "color", "id": "secondary_button_background", "label": "Secondary button background", "default": "#ffffff" },
    { "type": "color", "id": "secondary_button_text", "label": "Secondary button text", "default": "#111111" },
    { "type": "color", "id": "control_background", "label": "Control background", "default": "#ffffff" },
    { "type": "color", "id": "control_text_color", "label": "Control text", "default": "#111111" }
  ],
  "blocks": [ { "type": "slide", "name": "Hero slide", "settings": [ { "type": "image_picker", "id": "image", "label": "Desktop image" }, { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" }, { "type": "text", "id": "image_alt", "label": "Image alt text" }, { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New collection" }, { "type": "text", "id": "heading", "label": "Heading", "default": "Build a flexible hero banner" }, { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a clear supporting message and connect this hero to any page or campaign.</p>" }, { "type": "text", "id": "button_text", "label": "Primary button label", "default": "Shop now" }, { "type": "url", "id": "button_link", "label": "Primary button link" }, { "type": "text", "id": "secondary_button_text", "label": "Secondary button label", "default": "Learn more" }, { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" } ] } ],
  "presets": [ { "name": "Hazify test hero", "blocks": [ { "type": "slide" }, { "type": "slide", "settings": { "eyebrow": "Featured", "heading": "Second hero message", "text": "<p>Use a second block only when a rotating hero is useful.</p>" } } ] } ]
}
{% endschema %}