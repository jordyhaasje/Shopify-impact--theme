{% liquid
  assign bg_color = section.settings.background
  assign text_color = section.settings.text_color
%}

<section class="bubble-hero" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="bubble-hero__inner">

    <div class="bubble-hero__grid">

      <div class="bubble-hero__content">

        {% if section.settings.heading != blank %}
          <h1 class="bubble-hero__heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="bubble-hero__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="bubble-hero__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

      </div>

      <div class="bubble-hero__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
        {% endif %}
      </div>

    </div>

  </div>

  <div class="bubble-hero__wave">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d="M0,40 C240,120 480,0 720,40 C960,80 1200,120 1440,40 L1440,120 L0,120 Z" />
    </svg>
  </div>

  <style>
    .bubble-hero {
      background: var(--bg);
      color: var(--text);
      position: relative;
      overflow: hidden;
    }

    .bubble-hero__inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 80px 20px 120px;
    }

    .bubble-hero__grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 40px;
    }

    .bubble-hero__heading {
      font-size: 64px;
      line-height: 1.05;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .bubble-hero__text {
      font-size: 18px;
      line-height: 1.6;
      opacity: 0.8;
      margin-bottom: 30px;
      max-width: 480px;
    }

    .bubble-hero__button {
      display: inline-block;
      padding: 18px 36px;
      border-radius: 999px;
      font-weight: 700;
      text-decoration: none;
      background: currentColor;
      color: #fff;
    }

    .bubble-hero__media img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    .bubble-hero__wave {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 120px;
    }

    .bubble-hero__wave svg {
      width: 100%;
      height: 100%;
      fill: #ffffff;
    }

    @media screen and (max-width: 768px) {
      .bubble-hero__inner {
        padding: 40px 20px 100px;
      }

      .bubble-hero__grid {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .bubble-hero__heading {
        font-size: 40px;
      }

      .bubble-hero__text {
        font-size: 16px;
        margin: 0 auto 24px;
      }

      .bubble-hero__media {
        order: -1;
      }

      .bubble-hero__button {
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
      }
    }
  </style>

  {% schema %}
  {
    "name": "Bubble hero",
    "settings": [
      {"type": "text", "id": "heading", "label": "Heading", "default": "Bubble tea time yay!"},
      {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Get that bubbly feeling going with our fantastic bubble tea!</p>"},
      {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop now"},
      {"type": "url", "id": "button_link", "label": "Button link"},
      {"type": "image_picker", "id": "image", "label": "Image"},
      {"type": "color", "id": "background", "label": "Background", "default": "#EDE7F6"},
      {"type": "color", "id": "text_color", "label": "Text color", "default": "#3E2A5E"}
    ],
    "presets": [
      {"name": "Bubble hero"}
    ]
  }
  {% endschema %}
</section>