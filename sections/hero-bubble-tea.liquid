{% liquid
  assign bg_color = section.settings.background
  assign text_color = section.settings.text_color
%}

<section class="bubble-hero" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="bubble-hero__inner">

    <div class="bubble-hero__grid">

      <div class="bubble-hero__content">

        {% if section.settings.heading != blank %}
          <h1 class="bubble-hero__heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="bubble-hero__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="bubble-hero__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

      </div>

      <div class="bubble-hero__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
        {% endif %}
      </div>

    </div>

  </div>

  <div class="bubble-hero__wave">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d="M0,60 C200,140 400,20 720,80 C1040,140 1240,120 1440,60 L1440,160 L0,160 Z" />
    </svg>
  </div>

  <style>
    .bubble-hero {
      background: var(--bg);
      color: var(--text);
      position: relative;
      overflow: hidden;
    }

    .bubble-hero__inner {
      max-width: 1240px;
      margin: 0 auto;
      padding: 110px 24px 160px;
    }

    .bubble-hero__grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 80px;
    }

    .bubble-hero__heading {
      font-size: 72px;
      line-height: 1.02;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 24px;
      text-transform: uppercase;
      max-width: 520px;
    }

    .bubble-hero__text {
      font-size: 20px;
      line-height: 1.6;
      opacity: 0.75;
      margin-bottom: 40px;
      max-width: 520px;
    }

    .bubble-hero__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 20px 44px;
      border-radius: 999px;
      font-weight: 800;
      text-decoration: none;
      background: #4B2C5E;
      color: #ffffff;
      font-size: 16px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      min-width: 220px;
    }

    .bubble-hero__media {
      transform: translateX(20px);
    }

    .bubble-hero__media img {
      width: 100%;
      height: auto;
      object-fit: contain;
      transform: scale(1.05);
    }

    .bubble-hero__wave {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 160px;
    }

    .bubble-hero__wave svg {
      width: 100%;
      height: 100%;
      fill: #ffffff;
    }

    @media screen and (max-width: 768px) {
      .bubble-hero__inner {
        padding: 60px 20px 120px;
      }

      .bubble-hero__grid {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .bubble-hero__heading {
        font-size: 42px;
        line-height: 1.1;
      }

      .bubble-hero__text {
        font-size: 16px;
        margin: 0 auto 24px;
      }

      .bubble-hero__media {
        order: -1;
      }

      .bubble-hero__button {
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
      }
    }
  </style>

  {% schema %}
  {
    "name": "Bubble hero",
    "settings": [
      {"type": "text", "id": "heading", "label": "Heading", "default": "Bubble tea time yay!"},
      {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Get that bubbly feeling going with our fantastic bubble tea!</p>"},
      {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop now"},
      {"type": "url", "id": "button_link", "label": "Button link"},
      {"type": "image_picker", "id": "image", "label": "Image"},
      {"type": "color", "id": "background", "label": "Background", "default": "#EDE7F6"},
      {"type": "color", "id": "text_color", "label": "Text color", "default": "#3E2A5E"}
    ],
    "presets": [
      {"name": "Bubble hero"}
    ]
  }
  {% endschema %}
</section>