{{ 'jsections-beauty-social-gallery.css' | asset_url | stylesheet_tag }}

{% liquid
  assign sid = section.id
%}

<section
  id="jsections-beauty-social-gallery-{{ sid }}"
  class="jbsg{% if section.settings.full_width %} jbsg--full{% endif %}"
  style="
    --jbsg-bg: {{ section.settings.background_color }};
    --jbsg-text: {{ section.settings.text_color }};
    --jbsg-radius: {{ section.settings.corner_radius }}px;
  "
  data-jbsg-section
>
  <div class="jbsg__frame">
    <div class="jbsg__header">
      <h2 class="jbsg__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.button_label != blank %}
        <a class="jbsg__button jbsg__button--desktop" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>

    <div class="jbsg__slider">
      <div class="jbsg__track" data-jbsg-track>
        {% for block in section.blocks %}
          <div class="jbsg__item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'jbsg__image', sizes: '(min-width: 990px) 386px, 78vw', alt: block.settings.alt_text }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'jbsg__placeholder' }}
            {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if section.blocks.size > 3 %}
        <div class="jbsg__controls">
          <button type="button" data-jbsg-prev aria-label="Previous slide">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <button type="button" data-jbsg-next aria-label="Next slide">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank %}
      <a class="jbsg__button jbsg__button--mobile" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const init = (root) => {
      if (!root || root.dataset.jbsgReady === 'true') return;
      root.dataset.jbsgReady = 'true';
      const track = root.querySelector('[data-jbsg-track]');
      if (!track) return;
      const move = (direction) => {
        const first = track.firstElementChild;
        track.scrollBy({ left: (first ? first.offsetWidth + 24 : track.clientWidth) * direction, behavior: 'smooth' });
      };
      const prev = root.querySelector('[data-jbsg-prev]');
      const next = root.querySelector('[data-jbsg-next]');
      if (prev) prev.addEventListener('click', () => move(-1));
      if (next) next.addEventListener('click', () => move(1));
    };
    const root = document.getElementById('jsections-beauty-social-gallery-{{ sid }}');
    init(root);
    document.addEventListener('shopify:section:load', (event) => {
      init(event.target.querySelector('#jsections-beauty-social-gallery-{{ sid }}'));
    });
  })();
</script>

{% schema %}
{
  "name": "Beauty social gallery",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Use full viewport width",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hazify + you"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "FIND US ON SOCIALS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f1f0ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#67645e"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Social gallery image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty social gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
