{% render 'section-spacing-collapsing' %}

<style>
  #shopify-section-{{ section.id }} {
    --comparison-bg: {{ section.settings.background.rgb }};
    --comparison-panel: {{ section.settings.panel_background.rgb }};
    --comparison-panel-soft: {{ section.settings.panel_soft_background.rgb }};
    --comparison-heading: {{ section.settings.heading_color.rgb }};
    --comparison-text: {{ section.settings.text_color.rgb }};
    --comparison-line: {{ section.settings.line_color.rgb }};
    --comparison-icon: {{ section.settings.icon_color.rgb }};
    --comparison-other-icon: {{ section.settings.other_icon_color.rgb }};
    --comparison-rating-green: {{ section.settings.rating_green.rgb }};
    --comparison-badge: {{ section.settings.badge_color.rgb }};
    --comparison-badge-text: {{ section.settings.badge_text_color.rgb }};
    --comparison-radius: {{ section.settings.corner_radius }}px;
  }

  #shopify-section-{{ section.id }} .comparison-feature {
    padding-top: {{ section.settings.section_spacing }}px;
    padding-bottom: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__shell {
    background: rgb(var(--comparison-bg));
    border-radius: var(--comparison-radius);
    padding: 30px 22px 30px;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .comparison-feature__grid {
    display: grid;
    gap: 34px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .comparison-feature__content {
    text-align: center;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .comparison-feature__heading {
    margin: 0;
    color: rgb(var(--comparison-heading));
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-weight: 800;
    font-family: Georgia, 'Times New Roman', serif;
  }

  #shopify-section-{{ section.id }} .comparison-feature__text {
    margin: 26px auto 0;
    max-width: 620px;
    color: rgb(var(--comparison-text));
    font-size: 16px;
    line-height: 1.8;
  }

  #shopify-section-{{ section.id }} .comparison-feature__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .comparison-feature__rating {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .comparison-feature__rating-stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__star-box {
    width: 24px;
    height: 24px;
    background: rgb(var(--comparison-rating-green));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .comparison-feature__star-box svg {
    width: 13px;
    height: 13px;
    fill: #fff;
    display: block;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .comparison-feature__star-box.is-partial::after {
    content: '';
    position: absolute;
    inset: 0 0 0 72%;
    background: #d9d9d9;
  }

  #shopify-section-{{ section.id }} .comparison-feature__rating-text {
    color: rgb(var(--comparison-heading));
    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .comparison-feature__table-wrap {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .comparison-feature__panel {
    background: linear-gradient(90deg, rgb(var(--comparison-panel-soft)) 0%, rgb(var(--comparison-panel-soft)) 68%, rgba(var(--comparison-bg), 0.78) 68%, rgba(var(--comparison-bg), 0.78) 100%);
    border-radius: 26px;
    position: relative;
    padding: 26px 18px 24px;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .comparison-feature__sachet {
    position: absolute;
    top: -28px;
    left: 56%;
    transform: translateX(-50%) rotate(-8deg);
    width: 82px;
    height: 136px;
    border-radius: 8px;
    background: linear-gradient(180deg, #dc7b2c 0%, #d46316 38%, #b94e12 100%);
    box-shadow: 0 10px 18px rgba(121, 54, 17, 0.22);
    border: 2px solid rgba(255,255,255,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px;
    z-index: 4;
  }

  #shopify-section-{{ section.id }} .comparison-feature__sachet::before,
  #shopify-section-{{ section.id }} .comparison-feature__sachet::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    height: 2px;
    background: rgba(255,255,255,0.22);
  }

  #shopify-section-{{ section.id }} .comparison-feature__sachet::before {
    top: 8px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__sachet::after {
    bottom: 8px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__sachet-text {
    color: #fff4ea;
    font-size: 9px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  #shopify-section-{{ section.id }} .comparison-feature__sachet-text small {
    display: block;
    margin-top: 8px;
    font-size: 7px;
    line-height: 1.3;
    font-weight: 500;
    color: rgba(255,255,255,0.82);
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge {
    position: absolute;
    left: -34px;
    bottom: 24px;
    width: 158px;
    height: 158px;
    border-radius: 50%;
    background: rgb(var(--comparison-badge));
    border: 6px solid #fff;
    box-shadow: 0 10px 20px rgba(145, 63, 16, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-inner {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,0.95);
    color: rgb(var(--comparison-badge-text));
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-inner::before {
    content: '';
    position: absolute;
    inset: 13px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.85);
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-copy {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-copy span {
    position: absolute;
    width: 100%;
    left: 0;
    top: 18px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-copy strong {
    position: absolute;
    width: 100%;
    left: 0;
    bottom: 18px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-symbol {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid currentColor;
    position: relative;
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-symbol::before {
    content: '';
    position: absolute;
    left: 26px;
    top: -8px;
    bottom: -8px;
    width: 3px;
    background: currentColor;
    transform: rotate(34deg);
    transform-origin: center;
  }

  #shopify-section-{{ section.id }} .comparison-feature__badge-symbol::after {
    content: '';
    position: absolute;
    inset: 16px 18px 18px 16px;
    border-left: 3px solid currentColor;
    border-bottom: 3px solid currentColor;
    border-bottom-left-radius: 14px;
    transform: rotate(-24deg);
  }

  #shopify-section-{{ section.id }} .comparison-feature__table {
    display: table;
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  #shopify-section-{{ section.id }} .comparison-feature__header,
  #shopify-section-{{ section.id }} .comparison-feature__row {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) 110px 96px;
    align-items: center;
    column-gap: 16px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__header {
    padding: 0 6px 18px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__row {
    min-height: 112px;
    padding: 0 6px;
    border-top: 1px solid rgba(var(--comparison-line), 1);
  }

  #shopify-section-{{ section.id }} .comparison-feature__cell-label {
    color: rgb(var(--comparison-text));
    font-size: 20px;
    line-height: 1.35;
    font-weight: 500;
    padding-right: 12px;
  }

  #shopify-section-{{ section.id }} .comparison-feature__col-title {
    color: rgb(var(--comparison-heading));
    font-size: 21px;
    line-height: 1.1;
    font-weight: 800;
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
  }

  #shopify-section-{{ section.id }} .comparison-feature__col-title.is-muted {
    color: rgba(var(--comparison-text), 0.78);
  }

  #shopify-section-{{ section.id }} .comparison-feature__icon-cell {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .comparison-feature__check {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgb(var(--comparison-icon));
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .comparison-feature__check svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .comparison-feature__thumb {
    color: rgb(var(--comparison-other-icon));
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .comparison-feature__thumb svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .comparison-feature__shell {
      padding: 58px 54px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1.38fr);
      gap: 44px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__content {
      text-align: left;
      padding-left: 22px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__text {
      margin-left: 0;
      margin-right: 0;
      max-width: 520px;
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__rating {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .comparison-feature__panel {
      padding-top: 36px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__sachet {
      top: -18px;
      left: 58%;
      width: 68px;
      height: 114px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__badge {
      display: none;
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .comparison-feature {
      padding-top: {{ section.settings.section_spacing_mobile }}px;
      padding-bottom: {{ section.settings.section_spacing_mobile }}px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__shell {
      border-radius: 22px;
      padding: 28px 14px 18px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__grid {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__heading {
      font-size: clamp(34px, 10vw, 64px);
      max-width: 360px;
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .comparison-feature__text {
      margin-top: 18px;
      max-width: 360px;
      font-size: 16px;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .comparison-feature__rating {
      gap: 10px;
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__star-box {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__star-box svg {
      width: 12px;
      height: 12px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__panel {
      border-radius: 22px;
      padding: 24px 8px 18px;
      background: linear-gradient(90deg, rgb(var(--comparison-panel-soft)) 0%, rgb(var(--comparison-panel-soft)) 62%, rgba(var(--comparison-bg), 0.92) 62%, rgba(var(--comparison-bg), 0.92) 100%);
    }

    #shopify-section-{{ section.id }} .comparison-feature__header,
    #shopify-section-{{ section.id }} .comparison-feature__row {
      grid-template-columns: minmax(0, 1fr) 94px 82px;
      column-gap: 8px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__header {
      padding: 0 8px 12px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__row {
      min-height: 106px;
      padding: 0 8px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__cell-label {
      font-size: 18px;
      line-height: 1.28;
      max-width: 120px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__col-title {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__check {
      width: 30px;
      height: 30px;
    }

    #shopify-section-{{ section.id }} .comparison-feature__thumb {
      width: 28px;
      height: 28px;
    }
  }
</style>

<section class="comparison-feature">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.text_color %}>
    <div class="container">
      <div class="comparison-feature__shell">
        <div class="comparison-feature__grid">
          <div class="comparison-feature__content">
            {% if section.settings.heading != blank %}
              <h2 class="comparison-feature__heading">{{ section.settings.heading | escape }}</h2>
            {% endif %}

            {% if section.settings.text != blank %}
              <div class="comparison-feature__text rte">{{ section.settings.text }}</div>
            {% endif %}

            <div class="comparison-feature__rating" aria-label="{{ section.settings.rating_label | escape }}">
              <div class="comparison-feature__rating-stars" aria-hidden="true">
                {% for i in (1..4) %}
                  <span class="comparison-feature__star-box">
                    <svg viewBox="0 0 20 20"><path d="M10 1.6l2.45 5 5.52.8-4 3.9.94 5.48L10 14.2 5.09 16.78l.94-5.48-4-3.9 5.52-.8 2.45-5z"></path></svg>
                  </span>
                {% endfor %}
                <span class="comparison-feature__star-box is-partial">
                  <svg viewBox="0 0 20 20"><path d="M10 1.6l2.45 5 5.52.8-4 3.9.94 5.48L10 14.2 5.09 16.78l.94-5.48-4-3.9 5.52-.8 2.45-5z"></path></svg>
                </span>
              </div>
              <span class="comparison-feature__rating-text">{{ section.settings.rating_text | escape }}</span>
            </div>
          </div>

          <div class="comparison-feature__table-wrap">
            <div class="comparison-feature__panel">
              <div class="comparison-feature__sachet" aria-hidden="true">
                <div class="comparison-feature__sachet-text">
                  {{ section.settings.sachet_title | escape }}
                  <small>{{ section.settings.sachet_subtitle | escape }}</small>
                </div>
              </div>

              <div class="comparison-feature__badge" aria-hidden="true">
                <div class="comparison-feature__badge-inner">
                  <div class="comparison-feature__badge-copy">
                    <span>{{ section.settings.badge_top | escape }}</span>
                    <strong>{{ section.settings.badge_bottom | escape }}</strong>
                  </div>
                  <div class="comparison-feature__badge-symbol"></div>
                </div>
              </div>

              <div class="comparison-feature__table" role="table">
                <div class="comparison-feature__header" role="rowgroup">
                  <div></div>
                  <div class="comparison-feature__col-title">{{ section.settings.brand_heading | escape }}</div>
                  <div class="comparison-feature__col-title is-muted">{{ section.settings.others_heading | escape }}</div>
                </div>

                {% for block in section.blocks %}
                  <div class="comparison-feature__row" role="row" {{ block.shopify_attributes }}>
                    <div class="comparison-feature__cell-label" role="cell">{{ block.settings.label | escape }}</div>
                    <div class="comparison-feature__icon-cell" role="cell">
                      <span class="comparison-feature__check" aria-hidden="true">
                        <svg viewBox="0 0 20 20"><path d="M7.9 13.9 4.5 10.5l-1.4 1.4 4.8 4.8L17 7.6l-1.4-1.4-7.7 7.7z"></path></svg>
                      </span>
                    </div>
                    <div class="comparison-feature__icon-cell" role="cell">
                      <span class="comparison-feature__thumb" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M15 10V5.6c0-1.1-.9-2-2-2l-1.1 5.1-2.5 3.1v8.2h8.7c.9 0 1.7-.6 1.9-1.5l1.1-5.4c.2-1-.6-2.1-1.7-2.1H15Z"></path><path d="M4 11.9h3.5V20H4z"></path></svg>
                      </span>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison feature",
  "tag": "section",
  "class": "shopify-section--comparison-feature",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This is what sets us apart." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Few supplements cater to women. Ours provides clean, effective electrolyte replenishment that truly works.</p>" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "4.5 out of 5 stars" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Join 1,000,000+ Happy Women" },
    { "type": "text", "id": "brand_heading", "label": "Brand heading", "default": "Our Brand" },
    { "type": "text", "id": "others_heading", "label": "Others heading", "default": "Others" },
    { "type": "text", "id": "sachet_title", "label": "Sachet title", "default": "Sachet Packaging" },
    { "type": "text", "id": "sachet_subtitle", "label": "Sachet subtitle", "default": "Mock-up" },
    { "type": "text", "id": "badge_top", "label": "Badge top text", "default": "GLUTEN FREE" },
    { "type": "text", "id": "badge_bottom", "label": "Badge bottom text", "default": "GLUTEN FREE" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "section_spacing", "label": "Desktop section spacing", "min": 0, "max": 120, "step": 4, "default": 32 },
    { "type": "range", "id": "section_spacing_mobile", "label": "Mobile section spacing", "min": 0, "max": 120, "step": 4, "default": 20 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "default": 28 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#E8DEB8" },
    { "type": "color", "id": "panel_background", "label": "Panel background", "default": "#EFE7C9" },
    { "type": "color", "id": "panel_soft_background", "label": "Left panel background", "default": "#F5F1E8" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#3B251F" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5F5A52" },
    { "type": "color", "id": "line_color", "label": "Row divider color", "default": "#CFC3B5" },
    { "type": "color", "id": "icon_color", "label": "Check icon color", "default": "#3B251F" },
    { "type": "color", "id": "other_icon_color", "label": "Other icon color", "default": "#8B877F" },
    { "type": "color", "id": "rating_green", "label": "Rating star color", "default": "#00B67A" },
    { "type": "color", "id": "badge_color", "label": "Badge color", "default": "#F45A15" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Formulated for Women" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison feature",
      "blocks": [
        { "type": "item", "settings": { "label": "Formulated for Women" } },
        { "type": "item", "settings": { "label": "No Artificial Flavorings" } },
        { "type": "item", "settings": { "label": "600mg of Sodium" } },
        { "type": "item", "settings": { "label": "Refreshing Orange Flavor" } },
        { "type": "item", "settings": { "label": "Easy to Use on the Go" } }
      ]
    }
  ]
}
{% endschema %}