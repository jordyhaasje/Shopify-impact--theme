{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --hero-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --hero-text-color: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
  }

  .hero-32 {
    background: rgb(var(--hero-background));
    color: rgb(var(--hero-text-color));
    padding: 80px 0;
  }

  .hero-32__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 60px;
    flex-wrap: wrap;
  }

  .hero-32__media { flex: 1; min-width: 400px; }
  .hero-32__media img { width: 100%; height: auto; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }

  .hero-32__content { flex: 1; min-width: 350px; }
  .hero-32__rating { display: flex; align-items: center; gap: 8px; font-weight: 700; margin-bottom: 20px; font-size: 16px; }
  .hero-32__rating-stars { color: #00B67A; }

  .hero-32__title { font-size: clamp(40px, 6vw, 64px); line-height: 1.05; margin: 0 0 20px 0; font-weight: 700; }
  .hero-32__title span { display: block; color: #7A8193; font-weight: 400; }

  .hero-32__list { list-style: none; padding: 0; margin: 0 0 40px 0; }
  .hero-32__item { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; font-size: 18px; }
  .hero-32__icon { width: 24px; height: 24px; }

  @media (max-width: 768px) {
    .hero-32__container { gap: 30px; text-align: center; }
    .hero-32__rating, .hero-32__item { justify-content: center; }
  }
</style>

<section class="hero-32">
  <div class="hero-32__container">
    <div class="hero-32__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <div style="background: #ddd; height: 500px; border-radius: 20px;"></div>
      {%- endif -%}
    </div>

    <div class="hero-32__content">
      <div class="hero-32__rating">
        <span class="hero-32__rating-stars">★★★★★</span> 4.6 Excellent
      </div>
      <h2 class="hero-32__title">
        {{ section.settings.heading | newline_to_br }}
      </h2>
      
      <ul class="hero-32__list">
        {%- for block in section.blocks -%}
          <li class="hero-32__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="hero-32__icon">
                {{ block.settings.icon | image_url: width: 48 | image_tag: width: 24, height: 24 }}
              </div>
            {%- endif -%}
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank -%}
        {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'lg' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero 32 Replica",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "textarea", "id": "heading", "label": "Heading", "default": "Achieve visibly\n<span>radiant</span>\n<span>transformed skin</span>"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "LEARN MORE"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "color", "id": "background", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#000000"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type": "image_picker", "id": "icon", "label": "Icon"},
        {"type": "text", "id": "text", "label": "Feature text"}
      ]
    }
  ],
  "presets": [{"name": "Hero 32 Replica"}]
}
{% endschema %}
