{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --cc-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --cc-heading-color: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --cc-accent-color: {{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }};
    --cc-label-text: {{ section.settings.label_text_color.red }}, {{ section.settings.label_text_color.green }}, {{ section.settings.label_text_color.blue }};
    --cc-nav-background: {{ section.settings.nav_background.red }}, {{ section.settings.nav_background.green }}, {{ section.settings.nav_background.blue }};
    --cc-nav-color: {{ section.settings.nav_color.red }}, {{ section.settings.nav_color.green }}, {{ section.settings.nav_color.blue }};
    --cc-card-radius: {{ section.settings.card_radius }}px;
    --cc-card-gap: {{ section.settings.card_gap }}px;
    --cc-desktop-card-width: {{ section.settings.desktop_card_width }}px;
    --cc-mobile-card-width: {{ section.settings.mobile_card_width }}px;
    --cc-card-height: {{ section.settings.card_height }}px;
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .collections-carousel {
    background: rgb(var(--cc-background));
  }

  #shopify-section-{{ section.id }} .collections-carousel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .collections-carousel__heading {
    color: rgb(var(--cc-heading-color));
    font-size: clamp(28px, 3.5vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 700;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .collections-carousel__heading .accent {
    color: rgb(var(--cc-accent-color));
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .collections-carousel__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .collections-carousel__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(var(--cc-nav-color), 0.25);
    background: rgb(var(--cc-nav-background));
    color: rgb(var(--cc-nav-color));
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, opacity 0.2s;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .collections-carousel__nav-btn:hover {
    background: rgba(var(--cc-nav-color), 0.08);
    border-color: rgba(var(--cc-nav-color), 0.5);
  }

  #shopify-section-{{ section.id }} .collections-carousel__nav-btn:disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .collections-carousel__nav-btn svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  #shopify-section-{{ section.id }} .collections-carousel__track-wrapper {
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .collections-carousel__track {
    display: flex;
    gap: var(--cc-card-gap);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .collections-carousel__card {
    flex: 0 0 var(--cc-mobile-card-width);
    width: var(--cc-mobile-card-width);
    min-width: var(--cc-mobile-card-width);
    border-radius: var(--cc-card-radius);
    overflow: hidden;
    position: relative;
    display: block;
    text-decoration: none;
    height: var(--cc-card-height);
    background: #ccc;
  }

  #shopify-section-{{ section.id }} .collections-carousel__card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .collections-carousel__card:hover .collections-carousel__card-image {
    transform: scale(1.03);
  }

  #shopify-section-{{ section.id }} .collections-carousel__card-label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    color: rgb(var(--cc-label-text));
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    text-shadow: 0 1px 6px rgba(0,0,0,0.2);
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .collections-carousel__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.38) 0%, rgba(0,0,0,0.0) 50%);
    border-radius: var(--cc-card-radius);
    z-index: 1;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .collections-carousel__card {
      flex-basis: var(--cc-desktop-card-width);
      width: var(--cc-desktop-card-width);
      min-width: 0;
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .collections-carousel__header {
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .collections-carousel__heading {
      font-size: clamp(22px, 6vw, 32px);
    }

    #shopify-section-{{ section.id }} .collections-carousel__card-label {
      font-size: 15px;
      bottom: 12px;
      left: 12px;
    }
  }
</style>

<section class="collections-carousel">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">

      <div class="collections-carousel__header">
        <h2 class="collections-carousel__heading">
          {{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <span class="accent">{{ section.settings.heading_accent | escape }}</span>{% endif %}
        </h2>

        <nav class="collections-carousel__nav" aria-label="Collectie navigatie">
          <button
            class="collections-carousel__nav-btn collections-carousel__nav-btn--prev"
            data-carousel-id="{{ section.id }}"
            data-direction="prev"
            aria-label="Vorige"
            disabled
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="collections-carousel__nav-btn collections-carousel__nav-btn--next"
            data-carousel-id="{{ section.id }}"
            data-direction="next"
            aria-label="Volgende"
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </nav>
      </div>

      <div class="collections-carousel__track-wrapper">
        <div class="collections-carousel__track" id="cc-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- assign card_url = block.settings.collection.url | default: block.settings.custom_url | default: '#' -%}
            <a
              href="{{ card_url }}"
              class="collections-carousel__card"
              {{ block.shopify_attributes }}
              aria-label="{{ block.settings.label | default: block.settings.collection.title | escape }}"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800',
                    class: 'collections-carousel__card-image',
                    alt: block.settings.label | default: block.settings.collection.title
                }}
              {%- elsif block.settings.collection.featured_image != blank -%}
                {{
                  block.settings.collection.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800',
                    class: 'collections-carousel__card-image',
                    alt: block.settings.collection.title
                }}
              {%- endif -%}

              {%- assign label = block.settings.label | default: block.settings.collection.title -%}
              {%- if label != blank -%}
                <span class="collections-carousel__card-label">{{ label | escape }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    var sectionId = {{ section.id | json }};
    var cardGap = {{ section.settings.card_gap }};
    var track = document.getElementById('cc-track-' + sectionId);

    if (!track) return;

    var currentIndex = 0;

    function getCards() {
      return track.querySelectorAll('.collections-carousel__card');
    }

    function getVisibleCount() {
      var trackWrapper = track.parentElement;
      if (!trackWrapper) return 1;
      var cards = getCards();
      if (!cards.length) return 1;
      var cardW = cards[0].getBoundingClientRect().width;
      if (cardW === 0) return 1;
      var wrapperW = trackWrapper.getBoundingClientRect().width;
      return Math.max(1, Math.floor((wrapperW + cardGap) / (cardW + cardGap)));
    }

    function getMaxIndex() {
      var total = getCards().length;
      var visible = getVisibleCount();
      return Math.max(0, total - visible);
    }

    function goTo(index) {
      var maxIndex = getMaxIndex();
      currentIndex = Math.max(0, Math.min(index, maxIndex));
      var cards = getCards();
      if (!cards.length) return;
      var cardW = cards[0].getBoundingClientRect().width;
      var offset = currentIndex * (cardW + cardGap);
      track.style.transform = 'translateX(-' + offset + 'px)';
      updateNav();
    }

    function updateNav() {
      var maxIndex = getMaxIndex();
      var prevBtns = document.querySelectorAll('[data-carousel-id="' + sectionId + '"][data-direction="prev"]');
      var nextBtns = document.querySelectorAll('[data-carousel-id="' + sectionId + '"][data-direction="next"]');
      prevBtns.forEach(function(btn) {
        btn.disabled = currentIndex <= 0;
      });
      nextBtns.forEach(function(btn) {
        btn.disabled = currentIndex >= maxIndex;
      });
    }

    document.querySelectorAll('[data-carousel-id="' + sectionId + '"]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var dir = btn.getAttribute('data-direction');
        if (dir === 'next') {
          goTo(currentIndex + 1);
        } else {
          goTo(currentIndex - 1);
        }
      });
    });

    window.addEventListener('resize', function() {
      goTo(currentIndex);
    });

    updateNav();

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === sectionId) {
        currentIndex = 0;
        track.style.transform = 'translateX(0)';
        updateNav();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Collecties carousel",
  "tag": "section",
  "class": "shopify-section--collections-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Ontdek onze"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Titel accent (cursief)",
      "default": "collecties"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Sectie spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_card_width",
      "label": "Kaartbreedte desktop (px)",
      "min": 200,
      "max": 600,
      "step": 4,
      "default": 400
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Kaartbreedte mobiel (px)",
      "min": 200,
      "max": 360,
      "step": 4,
      "default": 260
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Kaarthoogte (px)",
      "min": 300,
      "max": 800,
      "step": 10,
      "default": 600
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Ruimte tussen kaarten (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Kaart afronding (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Achtergrondkleur sectie",
      "default": "#EBEBEB"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Kleur titel",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Kleur accent (cursief deel)",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Kleur labeltekst op kaart",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "nav_background",
      "label": "Achtergrond navigatieknop",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "nav_color",
      "label": "Kleur navigatiepijl",
      "default": "#1A1A1A"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collectiekaart",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collectie"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding (overschrijft collectieafbeelding)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (overschrijft collectienaam)"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Aangepaste URL (indien geen collectie geselecteerd)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collecties carousel",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "label": "Easter sale"
          }
        },
        {
          "type": "collection_card",
