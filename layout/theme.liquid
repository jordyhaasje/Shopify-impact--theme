{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
NOTE TO DEVELOPERS: welcome to Impact theme! We hope that you will enjoy editing this theme as much as we did for
  developing it. We have put a lot of work to make this theme as developer friendly as possible by offering you
  hooks to integrate into critical parts of the theme. You will find the complete technical documentation (including
  all events, dependencies...) in the "documentation.txt" file, located in the Assets folder.
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<!doctype html>

<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="{{ settings.header_background }}">

    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
    <script type="module" src="{{ 'sections.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
  </head>

  <body class="{% if settings.show_page_transition %}page-transition{% endif %} {% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
    <!-- BLACK FRIDAY SPIN TO WIN POPUP - soft pink fashion modal -->
    <style>
      .bf-fashion-popup {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(20, 14, 17, .46);
        backdrop-filter: blur(10px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .45s ease, visibility .45s ease;
      }

      .bf-fashion-popup.is-visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .bf-fashion-popup__card {
        position: relative;
        width: min(100%, 760px);
        overflow: hidden;
        border-radius: 30px;
        padding: 28px;
        color: #23161a;
        background:
          radial-gradient(circle at 10% 8%, rgba(255, 202, 221, .95), transparent 30%),
          radial-gradient(circle at 92% 8%, rgba(255, 239, 246, .95), transparent 32%),
          linear-gradient(135deg, #ffffff 0%, #fff3f7 100%);
        box-shadow: 0 30px 100px rgba(49, 18, 30, .30), 0 0 0 1px rgba(255, 255, 255, .86) inset;
        transform: translateY(26px) scale(.96);
        transition: transform .45s cubic-bezier(.2,.8,.2,1);
      }

      .bf-fashion-popup.is-visible .bf-fashion-popup__card {
        transform: translateY(0) scale(1);
      }

      .bf-fashion-popup__close {
        position: absolute;
        top: 14px;
        right: 16px;
        z-index: 4;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 999px;
        background: rgba(255, 255, 255, .78);
        color: #8a6670;
        cursor: pointer;
        font-size: 22px;
        line-height: 1;
        box-shadow: 0 8px 24px rgba(80, 36, 50, .10);
      }

      .bf-fashion-popup__layout {
        display: grid;
        grid-template-columns: minmax(230px, .86fr) minmax(0, 1fr);
        align-items: center;
        gap: 30px;
      }

      .bf-fashion-popup__wheel-wrap {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 280px;
      }

      .bf-fashion-popup__pointer {
        position: absolute;
        top: 15px;
        z-index: 3;
        width: 0;
        height: 0;
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 26px solid #ff4f8f;
        filter: drop-shadow(0 5px 12px rgba(255, 79, 143, .35));
      }

      .bf-fashion-popup__wheel {
        width: 248px;
        height: 248px;
        border-radius: 50%;
        position: relative;
        display: grid;
        place-items: center;
        background: conic-gradient(#ff8fbd 0 60deg, #ffffff 60deg 120deg, #ffd4e4 120deg 180deg, #ffffff 180deg 240deg, #ff6fa7 240deg 300deg, #ffffff 300deg 360deg);
        box-shadow: 0 18px 45px rgba(255, 79, 143, .24), 0 0 0 10px rgba(255,255,255,.72), 0 0 0 1px rgba(255, 79, 143, .20) inset;
        transition: transform 3.2s cubic-bezier(.12,.78,.18,1);
      }

      .bf-fashion-popup__wheel:before {
        content: "";
        position: absolute;
        inset: 18px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, .78);
      }

      .bf-fashion-popup__wheel-center {
        position: relative;
        z-index: 2;
        width: 92px;
        height: 92px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        text-align: center;
        color: #fff;
        background: linear-gradient(135deg, #ff8fbd, #ff4f8f);
        box-shadow: 0 10px 28px rgba(255, 79, 143, .34);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .bf-fashion-popup__slice {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 92px;
        margin-left: -46px;
        margin-top: -10px;
        color: #7d304d;
        font-size: 12px;
        font-weight: 900;
        text-align: center;
        text-transform: uppercase;
        transform-origin: 46px 10px;
      }

      .bf-fashion-popup__slice:nth-child(1) { transform: rotate(30deg) translateY(-90px); }
      .bf-fashion-popup__slice:nth-child(2) { transform: rotate(90deg) translateY(-90px); }
      .bf-fashion-popup__slice:nth-child(3) { transform: rotate(150deg) translateY(-90px); }
      .bf-fashion-popup__slice:nth-child(4) { transform: rotate(210deg) translateY(-90px); }
      .bf-fashion-popup__slice:nth-child(5) { transform: rotate(270deg) translateY(-90px); }
      .bf-fashion-popup__slice:nth-child(6) { transform: rotate(330deg) translateY(-90px); }

      .bf-fashion-popup__content {
        padding: 10px 8px 10px 0;
      }

      .bf-fashion-popup__eyebrow {
        display: inline-flex;
        margin-bottom: 12px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #ffe0eb;
        color: #d8477b;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      .bf-fashion-popup__title {
        margin: 0;
        color: #1d1518;
        font-family: var(--heading-font-family, inherit);
        font-size: clamp(30px, 5.2vw, 46px);
        line-height: .98;
        letter-spacing: -.05em;
      }

      .bf-fashion-popup__text {
        max-width: 390px;
        margin: 14px 0 0;
        color: #7b636a;
        font-size: 15px;
        line-height: 1.6;
      }

      .bf-fashion-popup__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-top: 22px;
      }

      .bf-fashion-popup__spin,
      .bf-fashion-popup__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 24px;
        border: 0;
        border-radius: 999px;
        color: #fff;
        background: linear-gradient(135deg, #ff8fbd, #ff4f8f);
        box-shadow: 0 14px 34px rgba(255, 79, 143, .35);
        cursor: pointer;
        font-size: 14px;
        font-weight: 900;
        text-decoration: none;
        transition: transform .22s ease, box-shadow .22s ease;
      }

      .bf-fashion-popup__button {
        display: none;
        background: #1e1518;
        box-shadow: 0 14px 34px rgba(30, 21, 24, .18);
      }

      .bf-fashion-popup__spin:hover,
      .bf-fashion-popup__button:hover {
        transform: translateY(-2px);
      }

      .bf-fashion-popup__result {
        min-height: 24px;
        margin-top: 16px;
        color: #ff4f8f;
        font-size: 15px;
        font-weight: 900;
      }

      .bf-fashion-popup__code {
        display: none;
        margin-top: 10px;
        padding: 11px 14px;
        border: 1px dashed rgba(255, 79, 143, .55);
        border-radius: 14px;
        background: rgba(255, 255, 255, .72);
        color: #1d1518;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: .08em;
      }

      .bf-fashion-popup.has-result .bf-fashion-popup__button,
      .bf-fashion-popup.has-result .bf-fashion-popup__code {
        display: inline-flex;
      }

      .bf-fashion-popup.has-result .bf-fashion-popup__spin {
        display: none;
      }

      .bf-fashion-popup__note {
        margin-top: 14px;
        color: #9b7f87;
        font-size: 12px;
      }

      @media screen and (max-width: 720px) {
        .bf-fashion-popup { align-items: flex-end; padding: 12px; }
        .bf-fashion-popup__card { width: 100%; max-height: calc(100vh - 24px); overflow-y: auto; border-radius: 24px; padding: 24px 18px 20px; }
        .bf-fashion-popup__layout { grid-template-columns: 1fr; gap: 16px; text-align: center; }
        .bf-fashion-popup__wheel-wrap { min-height: 230px; }
        .bf-fashion-popup__wheel { width: 205px; height: 205px; }
        .bf-fashion-popup__slice { transform-origin: 46px 10px; font-size: 10px; }
        .bf-fashion-popup__slice:nth-child(1) { transform: rotate(30deg) translateY(-74px); }
        .bf-fashion-popup__slice:nth-child(2) { transform: rotate(90deg) translateY(-74px); }
        .bf-fashion-popup__slice:nth-child(3) { transform: rotate(150deg) translateY(-74px); }
        .bf-fashion-popup__slice:nth-child(4) { transform: rotate(210deg) translateY(-74px); }
        .bf-fashion-popup__slice:nth-child(5) { transform: rotate(270deg) translateY(-74px); }
        .bf-fashion-popup__slice:nth-child(6) { transform: rotate(330deg) translateY(-74px); }
        .bf-fashion-popup__content { padding: 0; }
        .bf-fashion-popup__text { margin-left: auto; margin-right: auto; }
        .bf-fashion-popup__actions { justify-content: center; }
      }
    </style>

    <div class="bf-fashion-popup" id="bfFashionPopup" aria-hidden="true">
      <div class="bf-fashion-popup__card" role="dialog" aria-modal="true" aria-label="Black Friday Spin to Win">
        <button class="bf-fashion-popup__close" type="button" data-bf-close aria-label="Sluit popup">×</button>
        <div class="bf-fashion-popup__layout">
          <div class="bf-fashion-popup__wheel-wrap" aria-hidden="true">
            <div class="bf-fashion-popup__pointer"></div>
            <div class="bf-fashion-popup__wheel" data-bf-wheel>
              <span class="bf-fashion-popup__slice">10%</span>
              <span class="bf-fashion-popup__slice">15%</span>
              <span class="bf-fashion-popup__slice">20%</span>
              <span class="bf-fashion-popup__slice">Free ship</span>
              <span class="bf-fashion-popup__slice">25%</span>
              <span class="bf-fashion-popup__slice">Mystery</span>
              <div class="bf-fashion-popup__wheel-center">Spin<br>to win</div>
            </div>
          </div>

          <div class="bf-fashion-popup__content">
            <div class="bf-fashion-popup__eyebrow">Black Friday</div>
            <h2 class="bf-fashion-popup__title">Unlock your private Black Friday reward</h2>
            <p class="bf-fashion-popup__text">Een subtiele seasonal reward voor onze favoriete styles. Laat je e-mail achter, draai één keer en shop je persoonlijke voordeel.</p>
            <form class="bf-fashion-popup__lead" data-bf-form>
              <input class="bf-fashion-popup__input" type="email" name="email" placeholder="Vul je e-mail in" autocomplete="email" required>
              <button class="bf-fashion-popup__spin" type="submit" data-bf-spin>Unlock & spin</button>
            </form>
            <div class="bf-fashion-popup__microcopy">Ontvang je code direct na het spinnen. Geen spam, alleen Black Friday deals.</div>
            <div class="bf-fashion-popup__actions">
              <button class="bf-fashion-popup__copy" type="button" data-bf-copy>Kopieer code</button>
              <a class="bf-fashion-popup__button" href="/discount/PINK20?redirect=/collections/all" data-bf-link>Shop met korting</a>
            </div>
            <div class="bf-fashion-popup__result" data-bf-result></div>
            <div class="bf-fashion-popup__code" data-bf-code>CODE: PINK20</div>
            <div class="bf-fashion-popup__note"><span data-bf-slots>37</span> prijzen vandaag beschikbaar · Black Friday eindigt binnenkort</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      (function() {
        var popup = document.getElementById('bfFashionPopup');
        if (!popup) return;

        var closeButton = popup.querySelector('[data-bf-close]');
        var spinButton = popup.querySelector('[data-bf-spin]');
        var wheel = popup.querySelector('[data-bf-wheel]');
        var result = popup.querySelector('[data-bf-result]');
        var code = popup.querySelector('[data-bf-code]');
        var storageKey = 'bf_fashion_spin_popup_seen_v1';
        var hasSpun = false;

        function showPopup() {
          popup.classList.add('is-visible');
          popup.setAttribute('aria-hidden', 'false');
        }

        function closePopup() {
          popup.classList.remove('is-visible');
          popup.setAttribute('aria-hidden', 'true');
          try { window.localStorage.setItem(storageKey, '1'); } catch (error) {}
        }

        function spinWheel() {
          if (hasSpun) return;
          hasSpun = true;
          if (spinButton) spinButton.textContent = 'Aan het draaien...';
          if (wheel) wheel.style.transform = 'rotate(1860deg)';

          window.setTimeout(function() {
            popup.classList.add('has-result');
            if (result) result.textContent = 'Je hebt 20% korting gewonnen.';
            if (code) code.textContent = 'CODE: PINK20';
            try { window.localStorage.setItem(storageKey, '1'); } catch (error) {}
          }, 3300);
        }

        try {
          if (!window.localStorage.getItem(storageKey)) {
            window.setTimeout(showPopup, 2500);
          }
        } catch (error) {
          window.setTimeout(showPopup, 2500);
        }

        if (spinButton) spinButton.addEventListener('click', spinWheel);
        if (closeButton) closeButton.addEventListener('click', closePopup);
        popup.addEventListener('click', function(event) {
          if (event.target === popup) closePopup();
        });
        document.addEventListener('keydown', function(event) {
          if (event.key === 'Escape' && popup.classList.contains('is-visible')) closePopup();
        });
      })();
    </script>
  </body>
</html>