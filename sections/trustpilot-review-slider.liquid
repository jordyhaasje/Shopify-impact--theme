{%- render 'section-spacing-collapsing' -%}

<style>
#shopify-section-{{ section.id }}{
  --tp-green:0,182,122;
  --tp-gap:{{ section.settings.card_gap }}px;
}
.tp-header{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;margin-bottom:32px}
.tp-score{font-size:32px;font-weight:700}
.tp-based{font-size:14px;opacity:.7}
.tp-stars{display:flex;gap:4px}
.tp-star{width:22px;height:22px;background:rgb(var(--tp-green));border-radius:3px;display:flex;align-items:center;justify-content:center;color:#fff}
.tp-track{display:flex;overflow-x:auto;gap:var(--tp-gap);scroll-snap-type:x mandatory;padding-bottom:10px}
.tp-card{flex:0 0 260px;background:#fff;border-radius:18px;padding:20px;scroll-snap-align:center;box-shadow:0 10px 30px rgba(0,0,0,.06)}
.tp-author{font-weight:600;margin-top:12px}
.tp-controls{display:flex;justify-content:center;gap:12px;margin-top:20px}
.tp-btn{cursor:pointer;padding:10px 16px;border-radius:999px;background:#f1f1f1}
@media(min-width:700px){.tp-card{flex:0 0 320px}}
</style>

<script>
document.addEventListener('DOMContentLoaded',()=>{
 const s=document.getElementById('shopify-section-{{ section.id }}');
 if(!s) return;
 const track=s.querySelector('.tp-track');
 const prev=s.querySelector('[data-prev]');
 const next=s.querySelector('[data-next]');
 const amount=()=>track.querySelector('.tp-card')?.offsetWidth+16||300;
 prev.onclick=()=>track.scrollBy({left:-amount(),behavior:'smooth'});
 next.onclick=()=>track.scrollBy({left:amount(),behavior:'smooth'});
});
</script>

<section>
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.text_color %}>
    <div class="container">

      <div class="tp-header">
        <div class="tp-score">{{ section.settings.score }}</div>
        <div class="tp-stars">
          {% for i in (1..5) %}
            <div class="tp-star">★</div>
          {% endfor %}
        </div>
        <div class="tp-based">Based on {{ section.settings.review_count }} reviews</div>
      </div>

      <div class="tp-track">
        {% for block in section.blocks %}
          <div class="tp-card" {{ block.shopify_attributes }}>
            <div class="tp-stars">
              {% for i in (1..block.settings.rating) %}
                <div class="tp-star">★</div>
              {% endfor %}
            </div>
            <div class="rte">{{ block.settings.text }}</div>
            <div class="tp-author">{{ block.settings.author }}</div>
          </div>
        {% endfor %}
      </div>

      <div class="tp-controls">
        <div class="tp-btn" data-prev>←</div>
        <div class="tp-btn" data-next>→</div>
      </div>

      {% if section.settings.button_label != blank %}
        <div style="text-align:center;margin-top:24px">
          {% render 'button', content: section.settings.button_label, href: section.settings.button_link %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trustpilot slider v3",
  "settings":[
    {"type":"text","id":"score","label":"Score","default":"4.8 / 5"},
    {"type":"text","id":"review_count","label":"Review count","default":"1,247"},
    {"type":"text","id":"button_label","label":"Button label","default":"Read all reviews"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text color","default":"#111111"},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":32,"step":2,"default":16}
  ],
  "blocks":[
    {
      "type":"review",
      "name":"Review",
      "settings":[
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"default":5},
        {"type":"textarea","id":"text","label":"Review text"},
        {"type":"text","id":"author","label":"Author"}
      ]
    }
  ],
  "presets":[{"name":"Trustpilot slider v3"}]
}
{% endschema %}