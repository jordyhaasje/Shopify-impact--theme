<section class="uip section-{{ section.id }}">
  <div class="uip__inner">

    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="uip__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="uip__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="uip__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign total_slides = section.blocks | map: 'settings' | map: 'product' | compact | size -%}

    <div class="uip__slider-wrap">

      {%- if total_slides > 1 -%}
        <button class="uip__arrow uip__arrow--prev" aria-label="Vorige" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
      {%- endif -%}

      <div class="uip__viewport">
        <div class="uip__track" data-track>

          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              {%- assign slide_index = slide_index | plus: 1 -%}

              {%- assign has_sale = false -%}
              {%- if product.compare_at_price > product.price -%}
                {%- assign has_sale = true -%}
                {%- assign discount_amount = product.compare_at_price | minus: product.price -%}
                {%- assign discount_pct = discount_amount | times: 100 | divided_by: product.compare_at_price -%}
              {%- endif -%}

              <div class="uip__slide" {{ block.shopify_attributes }}>
                <div class="uip__card">

                  <a href="{{ product.url }}" class="uip__media" aria-label="{{ product.title | escape }}">
                    {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}

                    {%- if has_sale -%}
                      <span class="uip__badge uip__badge--sale">-{{ discount_pct }}%</span>
                    {%- elsif product.available == false -%}
                      <span class="uip__badge uip__badge--sold">Uitverkocht</span>
                    {%- endif -%}
                  </a>

                  <div class="uip__content">
                    <p class="uip__product-title">{{ product.title }}</p>

                    <div class="uip__price">
                      {%- if has_sale -%}
                        <span class="uip__price-compare">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                      <span class="uip__price-current {%- if has_sale %} uip__price-current--sale{%- endif -%}">{{ product.price | money }}</span>
                    </div>

                    <a href="{{ product.url }}" class="uip__btn">{{ section.settings.button_label }}</a>
                  </div>

                </div>
              </div>

            {%- endif -%}
          {%- endfor -%}

        </div>
      </div>

      {%- if total_slides > 1 -%}
        <button class="uip__arrow uip__arrow--next" aria-label="Volgende" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {%- endif -%}

    </div>

    {%- if total_slides > 1 -%}
      <div class="uip__dots" data-dots></div>
    {%- endif -%}

  </div>
</section>

<style>
  .uip {
    --uip-gap: 16px;
    --uip-radius: 18px;
    --uip-shadow: 0 8px 32px rgba(0,0,0,.08);
    --uip-accent: #e63946;
    --uip-sold: #888;
    --uip-arrow-bg: #fff;
    --uip-arrow-border: rgba(0,0,0,.10);
    --uip-arrow-size: 44px;
    --uip-transition: .38s cubic-bezier(.4,0,.2,1);
  }

  .uip__inner {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .uip__header {
    padding: 0 20px;
    margin-bottom: 20px;
  }

  .uip__eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    opacity: .55;
    margin-bottom: 4px;
  }

  .uip__title {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 700;
    margin: 0;
    line-height: 1.15;
  }

  /* ── Slider wrap + arrows ── */
  .uip__slider-wrap {
    position: relative;
  }

  .uip__viewport {
    overflow: hidden;
  }

  .uip__track {
    display: flex;
    gap: var(--uip-gap);
    will-change: transform;
    transition: transform var(--uip-transition);
    padding: 12px 20px 16px;
  }

  /* ── Slides ── */
  .uip__slide {
    flex: 0 0 calc(75% - var(--uip-gap));
    min-width: 0;
  }

  @media (min-width: 600px) {
    .uip__slide { flex: 0 0 calc(50% - var(--uip-gap)); }
  }

  @media (min-width: 900px) {
    .uip__slide { flex: 0 0 calc(33.333% - var(--uip-gap)); }
  }

  @media (min-width: 1200px) {
    .uip__slide { flex: 0 0 calc(25% - var(--uip-gap)); }
  }

  /* ── Card ── */
  .uip__card {
    background: #fff;
    border-radius: var(--uip-radius);
    overflow: hidden;
    box-shadow: var(--uip-shadow);
    transition: transform .22s ease, box-shadow .22s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .uip__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,.12);
  }

  /* ── Media + badge ── */
  .uip__media {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
  }

  .uip__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .45s ease;
  }

  .uip__card:hover .uip__media img {
    transform: scale(1.04);
  }

  .uip__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .03em;
    line-height: 1;
    pointer-events: none;
    z-index: 2;
  }

  .uip__badge--sale {
    background: var(--uip-accent);
    color: #fff;
  }

  .uip__badge--sold {
    background: #333;
    color: #fff;
  }

  /* ── Content ── */
  .uip__content {
    padding: 14px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .uip__product-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  .uip__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .uip__price-compare {
    font-size: 13px;
    text-decoration: line-through;
    opacity: .5;
  }

  .uip__price-current {
    font-size: 16px;
    font-weight: 700;
  }

  .uip__price-current--sale {
    color: var(--uip-accent);
  }

  .uip__btn {
    display: inline-block;
    margin-top: auto;
    padding: 10px 18px;
    border-radius: 8px;
    background: #111;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: background .18s, transform .18s;
  }

  .uip__btn:hover {
    background: #333;
    transform: translateY(-1px);
  }

  /* ── Arrows ── */
  .uip__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: var(--uip-arrow-size);
    height: var(--uip-arrow-size);
    border-radius: 50%;
    border: 1.5px solid var(--uip-arrow-border);
    background: var(--uip-arrow-bg);
    box-shadow: 0 4px 16px rgba(0,0,0,.12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background .18s, transform .18s, box-shadow .18s;
    color: #111;
    padding: 0;
  }

  .uip__arrow:hover {
    background: #111;
    color: #fff;
    box-shadow: 0 6px 24px rgba(0,0,0,.2);
    transform: translateY(-50%) scale(1.08);
  }

  .uip__arrow--prev { left: 4px; }
  .uip__arrow--next { right: 4px; }

  .uip__arrow:disabled {
    opacity: .3;
    pointer-events: none;
  }

  /* ── Dots ── */
  .uip__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
    padding-bottom: 4px;
  }

  .uip__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ccc;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background .2s, transform .2s;
  }

  .uip__dot--active {
    background: #111;
    transform: scale(1.3);
  }
</style>

<script>
(function() {
  var section = document.querySelector('.section-{{ section.id }}');
  if (!section) return;

  var track    = section.querySelector('[data-track]');
  var dotsWrap = section.querySelector('[data-dots]');
  var btnPrev  = section.querySelector('.uip__arrow--prev');
  var btnNext  = section.querySelector('.uip__arrow--next');
  var slides   = track ? Array.from(track.querySelectorAll('.uip__slide')) : [];
  var total    = slides.length;
  if (total === 0) return;

  var current = 0;
  var perView = 1;

  function calcPerView() {
    var w = section.offsetWidth;
    if (w >= 1200) return 4;
    if (w >= 900)  return 3;
    if (w >= 600)  return 2;
    return 1;
  }

  function getOffset(index) {
    if (total === 0 || !slides[0]) return 0;
    var slideW = slides[0].offsetWidth;
    var gap    = parseInt(getComputedStyle(track).gap) || 16;
    return index * (slideW + gap);
  }

  function goTo(index) {
    perView = calcPerView();
    var max = Math.max(0, total - perView);
    current = Math.max(0, Math.min(index, max));
    track.style.transform = 'translateX(-' + getOffset(current) + 'px)';
    updateArrows();
    updateDots();
  }

  function updateArrows() {
    if (btnPrev) btnPrev.disabled = current === 0;
    if (btnNext) {
      perView = calcPerView();
      btnNext.disabled = current >= total - perView;
    }
  }

  function updateDots() {
    if (!dotsWrap) return;
    var dots = dotsWrap.querySelectorAll('.uip__dot');
    dots.forEach(function(d, i) {
      d.classList.toggle('uip__dot--active', i === current);
    });
  }

  /* Build dots */
  if (dotsWrap) {
    for (var i = 0; i < total; i++) {
      var dot = document.createElement('button');
      dot.className = 'uip__dot';
      dot.setAttribute('aria-label', 'Slide ' + (i + 1));
      dot.setAttribute('type', 'button');
      (function(idx) {
        dot.addEventListener('click', function() { goTo(idx); });
      })(i);
      dotsWrap.appendChild(dot);
    }
  }

  if (btnPrev) btnPrev.addEventListener('click', function() { goTo(current - 1); });
  if (btnNext) btnNext.addEventListener('click', function() { goTo(current + 1); });

  /* Touch/swipe */
  var startX = 0;
  var moved  = false;
  track.addEventListener('touchstart', function(e) {
    startX = e.touches[0].clientX;
    moved  = false;
  }, {passive: true});
  track.addEventListener('touchmove', function(e) {
    moved = true;
  }, {passive: true});
  track.addEventListener('touchend', function(e) {
    if (!moved) return;
    var dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
  });

  /* Resize */
  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() { goTo(current); }, 120);
  });

  goTo(0);
})();
</script>

{% schema %}
{
  "name": "Uitgelicht product PRO",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Aanbevolen"},
    {"type":"text","id":"title","label":"Titel","default":"Onze favorieten"},
    {"type":"text","id":"button_label","label":"Button tekst","default":"Shop nu"},
    {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":80,"step":4,"default":32},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":80,"step":4,"default":32}
  ],
  "blocks": [
    {"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}
  ],
  "presets":[{"name":"Uitgelicht product PRO"}]
}
{% endschema %}
