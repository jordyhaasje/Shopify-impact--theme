{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --ft-bg: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --ft-card-bg: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
    --ft-heading: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --ft-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --ft-accent: {{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }};
    --ft-gap: {{ section.settings.card_gap }}px;
    --ft-radius: {{ section.settings.card_radius }}px;
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .ft {
    background: rgb(var(--ft-bg));
  }

  #shopify-section-{{ section.id }} .ft__inner {
    display: grid;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .ft__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .ft__heading {
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.05;
    color: rgb(var(--ft-heading));
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ft__sub {
    margin-top: 12px;
    color: rgb(var(--ft-text));
    font-size: 16px;
  }

  #shopify-section-{{ section.id }} .ft__grid {
    display: grid;
    gap: var(--ft-gap);
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .ft__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .ft__card {
    background: rgb(var(--ft-card-bg));
    border-radius: var(--ft-radius);
    padding: 20px;
  }

  #shopify-section-{{ section.id }} .ft__icon {
    font-size: 22px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .ft__title {
    font-weight: 600;
    margin-bottom: 6px;
    color: rgb(var(--ft-heading));
  }

  #shopify-section-{{ section.id }} .ft__text {
    font-size: 14px;
    color: rgb(var(--ft-text));
  }
</style>

<section class="ft">
  <div {% render 'section-properties' %}>
    <div class="container">
      <div class="ft__inner">

        <div class="ft__header">
          <h2 class="ft__heading">{{ section.settings.heading }}</h2>
          <p class="ft__sub">{{ section.settings.subheading }}</p>
        </div>

        <div class="ft__grid">
          {%- for block in section.blocks -%}
            <div class="ft__card" {{ block.shopify_attributes }}>
              <div class="ft__icon">{{ block.settings.icon }}</div>
              <div class="ft__title">{{ block.settings.title }}</div>
              <div class="ft__text">{{ block.settings.text }}</div>
            </div>
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Trust Pro",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Why customers choose us"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Built for people who value quality and speed."},

    {"type":"range","id":"section_spacing","label":"Section spacing","min":0,"max":80,"step":4,"default":48},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":32,"step":2,"default":20},
    {"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"default":20},

    {"type":"color","id":"background","label":"Background","default":"#F7F7F7"},
    {"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#1F2937"},
    {"type":"color","id":"text_color","label":"Text color","default":"#6B7280"},
    {"type":"color","id":"accent_color","label":"Accent color","default":"#FF642D"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type":"text","id":"icon","label":"Icon","default":"🔥"},
        {"type":"text","id":"title","label":"Title","default":"Fast delivery"},
        {"type":"textarea","id":"text","label":"Text","default":"Get your order within 1-3 days."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Trust Pro",
      "blocks": [
        {"type":"feature","settings":{"icon":"🚚","title":"Fast delivery","text":"Delivered within days, not weeks."}},
        {"type":"feature","settings":{"icon":"💬","title":"Real support","text":"We answer fast, no bots."}},
        {"type":"feature","settings":{"icon":"🔒","title":"Secure checkout","text":"Your data is fully protected."}}
      ]
    }
  ]
}
{% endschema %}