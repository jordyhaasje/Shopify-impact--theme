{%- comment -%}
  JSections - Feature #22
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-feature-22.css' | asset_url | stylesheet_tag }}

<section
  class="jfeature22 jfeature22--{{ section.settings.style_preset }}"
  style="
    --jfeature22-bg: {{ section.settings.background_color }};
    --jfeature22-text: {{ section.settings.text_color }};
    --jfeature22-card-bg: {{ section.settings.card_background }};
    --jfeature22-card-radius: {{ section.settings.card_radius }}px;
    --jfeature22-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --jfeature22-progress: {{ section.settings.progress_color }};
    --jfeature22-nav-bg: {{ section.settings.nav_background }};
    --jfeature22-arrow: {{ section.settings.arrow_color }};
    --jfeature22-arrow-hover: {{ section.settings.arrow_hover_color }};
    --jfeature22-button-bg: {{ section.settings.button_background }};
    --jfeature22-button-text: {{ section.settings.button_text_color }};
    --jfeature22-button-hover-bg: {{ section.settings.button_hover_background }};
    --jfeature22-button-hover-text: {{ section.settings.button_hover_text_color }};
    --jfeature22-max-width: {{ section.settings.max_width }}px;
    --jfeature22-padding-top: {{ section.settings.padding_top }}px;
    --jfeature22-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jfeature22-desktop-columns: {{ section.settings.desktop_columns }};
    --jfeature22-gap: {{ section.settings.card_gap }}px;
    --jfeature22-mobile-width: {{ section.settings.mobile_card_width }}%;
  "
  data-jfeature22-section="{{ section.id }}"
  data-jfeature22-speed="{{ section.settings.transition_speed }}"
  data-jfeature22-columns="{{ section.settings.desktop_columns }}"
  data-jfeature22-mobile-view="{{ section.settings.mobile_card_width }}"
  {{ section.shopify_attributes }}
>
  <div class="jfeature22__inner">
    {%- if section.settings.heading != blank -%}
      <div class="jfeature22__heading">{{ section.settings.heading }}</div>
    {%- endif -%}

    <div class="jfeature22__slider" data-jfeature22-slider>
      <div class="jfeature22__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_image = block.settings.image
            assign image_alt = block.settings.title | strip_html
            assign percent = block.settings.percent | at_least: 0 | at_most: 100

            if card_image != blank and card_image.alt != blank
              assign image_alt = card_image.alt
            endif
          -%}
          <article class="jfeature22__card" role="listitem" {{ block.shopify_attributes }}>
            <div class="jfeature22__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 1024px) 33vw, 84vw',
                    alt: image_alt,
                    class: 'jfeature22__image'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'jfeature22__placeholder' }}
              {%- endif -%}

              <div class="jfeature22__percent">
                {%- if section.settings.show_percent -%}
                  <div class="jfeature22__circle" data-jfeature22-percent="{{ percent }}" aria-label="{{ percent }} percent">
                    <svg viewBox="0 0 36 36" aria-hidden="true">
                      <path class="jfeature22__circle-base" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" pathLength="100" />
                      <path class="jfeature22__circle-progress" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" pathLength="100" />
                    </svg>
                    <span>0%</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.percent_text != blank -%}
                  <div class="jfeature22__percent-text">{{ block.settings.percent_text }}</div>
                {%- endif -%}
              </div>
            </div>

            <div class="jfeature22__content">
              {%- if block.settings.title != blank -%}
                <div class="jfeature22__title">{{ block.settings.title }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="jfeature22__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_navigation and section.blocks.size > 1 -%}
      {%- liquid
        assign feature_page_count = section.blocks.size | minus: section.settings.desktop_columns | plus: 1 | at_least: 1
      -%}
      <div class="jfeature22__nav" aria-label="Feature carousel navigation">
        <button class="jfeature22__arrow jfeature22__arrow--prev" type="button" aria-label="Previous feature" data-jfeature22-prev>
          <svg viewBox="0 0 100 100" aria-hidden="true"><path d="m81.115 45.133-.997 1.734 3.541 2.035-71.04-.001v2l71.491.001-3.761 2.557 1.125 1.654 7.79-5.297z"/></svg>
        </button>
        <span class="jfeature22__fraction" data-jfeature22-fraction aria-live="polite">1 <span>of</span> {{ feature_page_count }}</span>
        <button class="jfeature22__arrow jfeature22__arrow--next" type="button" aria-label="Next feature" data-jfeature22-next>
          <svg viewBox="0 0 100 100" aria-hidden="true"><path d="m81.115 45.133-.997 1.734 3.541 2.035-71.04-.001v2l71.491.001-3.761 2.557 1.125 1.654 7.79-5.297z"/></svg>
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_button and section.settings.button_label != blank -%}
      <div class="jfeature22__button-wrap">
        <a class="jfeature22__button" href="{{ section.settings.button_link | default: routes.root_url }}">
          <span>{{ section.settings.button_label }}</span>
          {%- if section.settings.show_button_icon -%}
            <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M8.2 1.2 14 7l-5.8 5.8-1.1-1.1 3.9-3.9H0V6.2h11L7.1 2.3l1.1-1.1Z"/></svg>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const selector = `[data-jfeature22-section="${sectionId}"]`;
    const registryKey = "jfeature22Instances";
    window[registryKey] = window[registryKey] || {};

    function cleanup(root) {
      const instance = window[registryKey][sectionId];
      if (!instance) return;
      instance.destroy();
      delete window[registryKey][sectionId];
    }

    function init() {
      const root = document.querySelector(selector);
      if (!root) return;
      cleanup(root);

      const track = root.querySelector(".jfeature22__track");
      const slider = root.querySelector("[data-jfeature22-slider]");
      const slides = Array.from(root.querySelectorAll(".jfeature22__card"));
      const prev = root.querySelector("[data-jfeature22-prev]");
      const next = root.querySelector("[data-jfeature22-next]");
      const fraction = root.querySelector("[data-jfeature22-fraction]");
      const circles = Array.from(root.querySelectorAll("[data-jfeature22-percent]"));
      let index = 0;
      let observer = null;
      let dragging = false;
      let startX = 0;
      let startY = 0;
      let startTranslate = 0;
      let currentTranslate = 0;
      let pointerId = null;
      let dragAxis = null;
      const supportsPointer = "PointerEvent" in window;

      function visibleCount() {
        if (window.matchMedia("(min-width: 1024px)").matches) {
          return Math.max(1, Number(root.dataset.jfeature22Columns || 3));
        }
        return 1;
      }

      function maxIndex() {
        if (window.matchMedia("(min-width: 1024px)").matches) {
          return Math.max(0, slides.length - visibleCount());
        }
        return Math.max(0, slides.length - 1);
      }

      function pageTotal() {
        return Math.max(1, maxIndex() + 1);
      }

      function slideStep() {
        const gap = parseFloat(getComputedStyle(track).gap || "0");
        const width = slides[0]?.getBoundingClientRect().width || 0;
        return width + gap;
      }

      function setTranslate(value) {
        currentTranslate = value;
        track.style.transform = `translate3d(${value}px, 0, 0)`;
      }

      function update(skipTransition = false) {
        index = Math.min(Math.max(index, 0), maxIndex());
        track.classList.toggle("is-snapping", !skipTransition);
        setTranslate(-index * slideStep());
        if (fraction) fraction.innerHTML = `${index + 1} <span>of</span> ${pageTotal()}`;
        if (prev) prev.disabled = index <= 0;
        if (next) next.disabled = index >= maxIndex();
      }

      function animateCircle(circle) {
        if (circle.dataset.jfeature22Done === "true") return;
        circle.dataset.jfeature22Done = "true";
        const target = Math.max(0, Math.min(100, Number(circle.dataset.jfeature22Percent || 0)));
        const progress = circle.querySelector(".jfeature22__circle-progress");
        const label = circle.querySelector("span");
        let value = 0;

        function tick() {
          value += Math.max(1, Math.ceil(target / 32));
          const current = Math.min(value, target);
          if (progress) progress.style.strokeDasharray = `${current} 100`;
          if (label) label.textContent = `${Math.round(current)}%`;
          if (current < target) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      }

      function setupObserver() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || typeof IntersectionObserver !== "function") {
          circles.forEach((circle) => {
            const target = Math.max(0, Math.min(100, Number(circle.dataset.jfeature22Percent || 0)));
            const progress = circle.querySelector(".jfeature22__circle-progress");
            const label = circle.querySelector("span");
            if (progress) progress.style.strokeDasharray = `${target} 100`;
            if (label) label.textContent = `${target}%`;
          });
          return;
        }

        observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            setTimeout(() => animateCircle(entry.target), 400);
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.1 });

        circles.forEach((circle) => observer.observe(circle));
      }

      const onPrev = () => {
        index -= 1;
        update();
      };
      const onNext = () => {
        index += 1;
        update();
      };
      const onResize = () => update();

      function isInteractiveTarget(target) {
        return Boolean(target?.closest?.(".jfeature22__arrow, .jfeature22__button, a, button, input, textarea, select"));
      }

      function beginDrag(clientX, target) {
        if (isInteractiveTarget(target)) return false;
        if (!slider || dragging || slides.length <= visibleCount()) return false;
        dragging = true;
        startX = clientX;
        startTranslate = currentTranslate;
        dragAxis = null;
        slider.classList.add("is-dragging");
        track.classList.remove("is-snapping");
        return true;
      }

      function moveDrag(clientX, clientY) {
        if (!dragging) return;
        const delta = clientX - startX;
        if (!dragAxis && typeof clientY === "number") {
          const verticalDelta = Math.abs((clientY || 0) - startY);
          if (Math.abs(delta) > 8 || verticalDelta > 8) {
            dragAxis = Math.abs(delta) >= verticalDelta ? "x" : "y";
          }
        }
        if (dragAxis === "y") return;
        const minTranslate = -maxIndex() * slideStep();
        let nextTranslate = startTranslate + delta;
        if (nextTranslate > 0) nextTranslate = nextTranslate / 4;
        if (nextTranslate < minTranslate) nextTranslate = minTranslate + (nextTranslate - minTranslate) / 4;
        setTranslate(nextTranslate);
      }

      function finishDrag(clientX) {
        if (!dragging) return;
        const delta = clientX - startX;
        dragging = false;
        pointerId = null;
        dragAxis = null;
        slider.classList.remove("is-dragging");
        if (Math.abs(delta) > 40) {
          index += delta < 0 ? 1 : -1;
        } else {
          index = Math.round(Math.abs(currentTranslate) / Math.max(1, slideStep()));
        }
        update();
      }

      const onPointerDown = (event) => {
        startY = event.clientY;
        if (!beginDrag(event.clientX, event.target)) return;
        pointerId = event.pointerId;
        try {
          slider.setPointerCapture?.(pointerId);
        } catch {
        }
        window.addEventListener("pointermove", onPointerMove, { passive: false });
        window.addEventListener("pointerup", onPointerUp);
        window.addEventListener("pointercancel", onPointerUp);
      };
      const onPointerMove = (event) => {
        if (!dragging || event.pointerId !== pointerId) return;
        moveDrag(event.clientX, event.clientY);
        if (dragAxis === "x" && event.cancelable) event.preventDefault();
      };
      const onPointerUp = (event) => {
        if (!dragging || event.pointerId !== pointerId) return;
        try {
          slider.releasePointerCapture?.(event.pointerId);
        } catch {
        }
        window.removeEventListener("pointermove", onPointerMove);
        window.removeEventListener("pointerup", onPointerUp);
        window.removeEventListener("pointercancel", onPointerUp);
        finishDrag(event.clientX);
      };
      const onTouchStart = (event) => {
        const touch = event.touches?.[0];
        startY = touch?.clientY || 0;
        if (!touch || !beginDrag(touch.clientX, event.target)) return;
        pointerId = `touch-${touch.identifier}`;
        window.addEventListener("touchmove", onTouchMove, { passive: false });
        window.addEventListener("touchend", onTouchEnd);
        window.addEventListener("touchcancel", onTouchEnd);
      };
      const onTouchMove = (event) => {
        if (!dragging || typeof pointerId !== "string" || !pointerId.startsWith("touch-")) return;
        const touches = Array.from(event.touches || []);
        const touch = touches.find((item) => `touch-${item.identifier}` === pointerId) || touches[0];
        if (!touch) return;
        moveDrag(touch.clientX, touch.clientY);
        if (dragAxis === "x") event.preventDefault();
      };
      const onTouchEnd = (event) => {
        if (!dragging || typeof pointerId !== "string" || !pointerId.startsWith("touch-")) return;
        const touches = Array.from(event.changedTouches || []);
        const touch = touches.find((item) => `touch-${item.identifier}` === pointerId) || touches[0];
        if (!touch) return;
        window.removeEventListener("touchmove", onTouchMove);
        window.removeEventListener("touchend", onTouchEnd);
        window.removeEventListener("touchcancel", onTouchEnd);
        finishDrag(touch.clientX);
      };
      const onMouseMove = (event) => {
        if (!dragging || pointerId !== "mouse") return;
        moveDrag(event.clientX);
      };
      const onMouseUp = (event) => {
        if (!dragging || pointerId !== "mouse") return;
        window.removeEventListener("mousemove", onMouseMove);
        window.removeEventListener("mouseup", onMouseUp);
        finishDrag(event.clientX);
      };
      const onMouseDown = (event) => {
        startY = event.clientY;
        if (supportsPointer || !beginDrag(event.clientX, event.target)) return;
        pointerId = "mouse";
        event.preventDefault();
        window.addEventListener("mousemove", onMouseMove);
        window.addEventListener("mouseup", onMouseUp);
      };

      prev?.addEventListener("click", onPrev);
      next?.addEventListener("click", onNext);
      if (supportsPointer) {
        slider?.addEventListener("pointerdown", onPointerDown);
      } else {
        slider?.addEventListener("touchstart", onTouchStart, { passive: true });
        slider?.addEventListener("mousedown", onMouseDown);
      }
      window.addEventListener("resize", onResize);

      const onBlockSelect = (event) => {
        const card = event.target.closest?.(".jfeature22__card");
        if (!card) return;
        const nextIndex = slides.indexOf(card);
        if (nextIndex >= 0) {
          index = nextIndex;
          update();
        }
      };
      root.addEventListener("shopify:block:select", onBlockSelect);

      setupObserver();
      update();

      window[registryKey][sectionId] = {
        destroy() {
          prev?.removeEventListener("click", onPrev);
          next?.removeEventListener("click", onNext);
          slider?.removeEventListener("pointerdown", onPointerDown);
          slider?.removeEventListener("touchstart", onTouchStart);
          slider?.removeEventListener("mousedown", onMouseDown);
          window.removeEventListener("pointermove", onPointerMove);
          window.removeEventListener("pointerup", onPointerUp);
          window.removeEventListener("pointercancel", onPointerUp);
          window.removeEventListener("touchmove", onTouchMove);
          window.removeEventListener("touchend", onTouchEnd);
          window.removeEventListener("touchcancel", onTouchEnd);
          window.removeEventListener("mousemove", onMouseMove);
          window.removeEventListener("mouseup", onMouseUp);
          window.removeEventListener("resize", onResize);
          root.removeEventListener("shopify:block:select", onBlockSelect);
          observer?.disconnect();
        }
      };
    }

    init();
    document.addEventListener("shopify:section:load", init);
    document.addEventListener("shopify:section:unload", (event) => {
      if (event.detail?.sectionId === sectionId) cleanup(document.querySelector(selector));
    });
  })();
</script>

