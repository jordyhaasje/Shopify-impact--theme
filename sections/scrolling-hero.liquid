{%- liquid
  assign heading        = section.settings.heading
  assign body           = section.settings.body
  assign btn_label      = section.settings.button_label
  assign btn_url        = section.settings.button_url
  assign image          = section.settings.image
  assign ticker         = section.settings.ticker_text
  assign ticker_speed   = section.settings.ticker_speed
  assign icon_speed     = section.settings.icon_speed
  assign bg_color       = section.settings.bg_color
  assign text_color     = section.settings.text_color
  assign btn_color      = section.settings.button_color
  assign section_margin = section.settings.section_margin
  assign radius         = section.settings.border_radius
-%}

{%- style -%}
  @keyframes sh-ticker-desktop {
    0%   { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  @keyframes sh-icon-rotate {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .sh-section {
    border-top: 0 solid {{ text_color }};
    border-bottom: 0 solid {{ text_color }};
    margin: {{ section_margin | times: 0.75 | round: 0 }}px 1.5rem;
    border-radius: {{ radius | times: 0.58 | round: 0 }}px;
    overflow: hidden;
    background: {{ bg_color }};
  }

  .sh-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .sh-image-col {
    order: 1;
    position: relative;
    overflow: hidden;
    aspect-ratio: 12 / 12;
  }

  .sh-image-col img,
  .sh-image-col .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sh-image-col .placeholder-svg {
    background-color: rgb(175, 175, 175);
  }

  .sh-content {
    order: 2;
    display: flex;
    flex-direction: column;
    padding: 16px;
    overflow: hidden;
    position: relative;
  }

  .sh-content-top {
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .sh-heading {
    text-align: left;
    margin-top: 0;
  }

  .sh-heading * {
    margin: 0;
    font-size: 26px;
    color: {{ text_color }};
    line-height: 130%;
    text-transform: unset;
  }

  .sh-text {
    text-align: left;
    margin-top: 16px;
  }

  .sh-text * {
    margin: 0;
    font-size: 14px;
    color: {{ text_color }};
    text-transform: unset;
  }

  .sh-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: fit-content;
    margin: 24px 0 0;
    font-size: 13px;
    color: {{ btn_color }};
    line-height: 100%;
    text-align: center;
    text-transform: unset;
    text-decoration: none;
    padding: 12px 30px;
    border-radius: 100px;
    transition: 0.25s;
    position: relative;
    font-weight: 700;
    z-index: 2;
    border: 1px solid {{ btn_color }};
    background: transparent;
    cursor: pointer;
  }

  .sh-btn:hover {
    background-color: {{ btn_color }};
    color: {{ bg_color }};
    transition: 0.25s;
  }

  .sh-ticker-wrap {
    position: relative;
    display: flex;
    overflow: hidden;
    flex-wrap: nowrap;
    margin-left: -16px;
    margin-right: -16px;
    background-attachment: scroll !important;
    margin-top: 16px;
  }

  .sh-ticker-list {
    display: flex;
    white-space: nowrap;
    animation: {{ ticker_speed }}s linear 0s infinite normal none running sh-ticker-desktop;
    flex-shrink: 0;
    background-attachment: scroll !important;
  }

  .sh-ticker-item {
    display: flex;
    align-items: center;
    margin-right: 16px;
    flex-shrink: 0;
    background-attachment: scroll !important;
  }

  .sh-ticker-text {
    display: inline-block;
    margin: 0 16px 0 0;
    font-size: 40px;
    color: {{ text_color }};
    line-height: 130%;
    text-transform: unset;
    font-weight: 700;
  }

  .sh-ticker-icon {
    display: inline-block;
    width: 26px;
    flex-shrink: 0;
  }

  .sh-ticker-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    animation: {{ icon_speed }}s linear 0s infinite normal none running sh-icon-rotate;
    margin-top: 5px;
  }

  .sh-ticker-icon svg path {
    fill: {{ text_color }};
  }

  /* ── Desktop (1024px+) ── */
  @media (min-width: 1024px) {
    .sh-section {
      margin: {{ section_margin }}px 5rem;
      border-radius: {{ radius }}px;
    }

    .sh-body {
      grid-template-columns: 1fr 1fr;
    }

    .sh-image-col {
      order: 2;
      aspect-ratio: 12 / 12;
    }

    .sh-content {
      order: 1;
      justify-content: end;
      padding: 32px;
      padding-right: calc(150px);
    }

    .sh-content-top {
      align-items: start;
    }

    .sh-heading {
      text-align: left;
      margin-top: 0;
    }

    .sh-heading * {
      font-size: 36px;
    }

    .sh-text {
      text-align: left;
      margin-top: 24px;
    }

    .sh-text * {
      font-size: 16px;
    }

    .sh-btn {
      margin-top: 24px;
      padding: 12px 30px;
      font-size: 13px;
    }

    .sh-ticker-wrap {
      margin: 0;
      pointer-events: none;
      transform: rotate(-90deg);
      position: absolute;
      top: 0;
      width: 100%;
      right: 0;
      height: 100%;
    }

    .sh-ticker-list {
      align-items: end;
      animation-duration: {{ ticker_speed | times: 0.625 | round: 0 }}s;
    }

    .sh-ticker-item {
      margin-right: 16px;
      margin-bottom: 12px;
    }

    .sh-ticker-text {
      font-size: 60px;
      margin-right: 16px;
    }

    .sh-ticker-icon {
      width: 26px;
    }

    .sh-ticker-icon svg {
      margin-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sh-ticker-list {
      animation-play-state: paused;
    }
    .sh-ticker-icon svg {
      animation-play-state: paused;
    }
  }
{%- endstyle -%}

