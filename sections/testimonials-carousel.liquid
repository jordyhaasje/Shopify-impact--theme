{% liquid assign sid = section.id %}
<section id="testimonials-{{ sid }}" class="testimonials-section" data-section-id="{{ sid }}">
  <div class="page-width">

    <div class="testimonials-header">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="testimonials-slider" data-slider>
      <div class="track">
        {% for block in section.blocks %}
          <div class="card" {{ block.shopify_attributes }}>

            {% if block.settings.image != blank %}
              <div class="media">
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', class: 'card-img' }}
              </div>
            {% endif %}

            <div class="content">
              {% if block.settings.verified %}
                <span class="badge">Verified customer ✓</span>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="review">{{ block.settings.text }}</p>
              {% endif %}

              <div class="footer">
                {% if block.settings.name != blank %}
                  <span class="name">{{ block.settings.name }}</span>
                {% endif %}

                {% if block.settings.rating > 0 %}
                  <div class="stars">
                    {% for i in (1..5) %}
                      <span class="star{% if i <= block.settings.rating %} filled{% endif %}">★</span>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="nav">
        <button class="prev" data-prev aria-label="Previous">‹</button>
        <button class="next" data-next aria-label="Next">›</button>
      </div>
    </div>
  </div>
</section>

<style>
#testimonials-{{ sid }} { padding: 48px 0; }
#testimonials-{{ sid }} .testimonials-header { text-align:center; margin-bottom:32px; }
#testimonials-{{ sid }} .eyebrow { display:inline-block; background:#eef2f1; padding:6px 12px; border-radius:999px; font-size:12px; margin-bottom:12px; }
#testimonials-{{ sid }} .heading { font-size:36px; font-weight:600; }

#testimonials-{{ sid }} .track { display:flex; gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; }
#testimonials-{{ sid }} .card { min-width:260px; max-width:320px; background:#f4f7f6; border-radius:20px; overflow:hidden; scroll-snap-align:start; }
#testimonials-{{ sid }} .media img { width:100%; height:auto; display:block; }
#testimonials-{{ sid }} .content { padding:16px; }
#testimonials-{{ sid }} .badge { font-size:12px; margin-bottom:10px; display:inline-block; }
#testimonials-{{ sid }} .review { font-size:14px; margin-bottom:12px; }
#testimonials-{{ sid }} .footer { display:flex; justify-content:space-between; align-items:center; }
#testimonials-{{ sid }} .stars .star { opacity:.3; }
#testimonials-{{ sid }} .stars .filled { opacity:1; }

#testimonials-{{ sid }} .nav { display:flex; justify-content:center; gap:10px; margin-top:16px; }
#testimonials-{{ sid }} .nav button { width:36px; height:36px; border-radius:50%; border:1px solid #ccc; background:#fff; }

@media(min-width:768px){
  #testimonials-{{ sid }} .heading { font-size:42px; }
  #testimonials-{{ sid }} .card { min-width:300px; }
}
</style>

<script>
(function(){
  function init(section){
    const track = section.querySelector('.track');
    const prev = section.querySelector('[data-prev]');
    const next = section.querySelector('[data-next]');
    if(!track || !prev || !next) return;

    prev.onclick = () => track.scrollBy({left:-300, behavior:'smooth'});
    next.onclick = () => track.scrollBy({left:300, behavior:'smooth'});
  }

  function load(){
    document.querySelectorAll('[data-section-id="{{ sid }}"]').forEach(init);
  }

  document.addEventListener('DOMContentLoaded', load);
  document.addEventListener('shopify:section:load', function(e){
    if(e.target.querySelector('[data-section-id="{{ sid }}"]')) init(e.target);
  });
})();
</script>

{% schema %}
{
  "name": "Testimonials carousel",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Testimonials"},
    {"type":"text","id":"heading","label":"Heading","default":"Our customers tell it better than we do!"},
    {"type":"color","id":"bg_color","label":"Background color","default":"#ffffff"}
  ],
  "blocks": [
    {
      "type":"testimonial",
      "name":"Testimonial",
      "settings":[
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"textarea","id":"text","label":"Review"},
        {"type":"text","id":"name","label":"Name"},
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"checkbox","id":"verified","label":"Verified","default":true}
      ]
    }
  ],
  "presets":[{"name":"Testimonials carousel"}]
}
{% endschema %}