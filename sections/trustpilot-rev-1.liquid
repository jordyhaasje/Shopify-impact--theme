          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Michael B.",
            "text": "Great customer service and the product works perfectly. Will definitely order again.",
            "rating": 5,
            "date": "1 week ago",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Emma W.",
            "text": "Good value for money. Packaging was eco-friendly which I really appreciate.",
            "rating": 4,
