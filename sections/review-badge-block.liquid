<div class="section-spacing">
  <div class="page-width">
    <div class="review-badge-block review-badge-block--{{ section.settings.alignment }}" aria-label="{{ section.settings.aria_label | escape }}">
      {%- if section.settings.label_text != blank -%}
        <span class="review-badge-block__text">{{ section.settings.label_text }}</span>
      {%- endif -%}

      <span class="review-badge-block__stars" aria-hidden="true">
        {%- assign full_stars = section.settings.rating | floor -%}
        {%- assign rating_decimal = section.settings.rating | modulo: 1 -%}
        {%- assign has_half_star = false -%}
        {%- if rating_decimal >= 0.5 -%}
          {%- assign has_half_star = true -%}
        {%- endif -%}
        {%- assign empty_stars = 5 | minus: full_stars -%}
        {%- if has_half_star -%}
          {%- assign empty_stars = empty_stars | minus: 1 -%}
        {%- endif -%}

        {%- for i in (1..full_stars) -%}
          <span class="star">★</span>
        {%- endfor -%}

        {%- if has_half_star -%}
          <span class="star star--half">★</span>
        {%- endif -%}

        {%- if empty_stars > 0 -%}
          {%- for i in (1..empty_stars) -%}
            <span class="star star--empty">★</span>
          {%- endfor -%}
        {%- endif -%}
      </span>

      {%- if section.settings.review_count_text != blank -%}
        <span class="review-badge-block__count">{{ section.settings.review_count_text }}</span>
      {%- endif -%}

      {%- if section.settings.brand_text != blank -%}
        <span class="review-badge-block__brand">{{ section.settings.brand_text }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    --review-badge-gap: {{ section.settings.gap }}px;
    --review-badge-padding-y: {{ section.settings.padding_y }}px;
    --review-badge-padding-x: {{ section.settings.padding_x }}px;
    --review-badge-radius: {{ section.settings.border_radius }}px;
    --review-badge-margin-bottom: {{ section.settings.margin_bottom }}px;
    --review-badge-text-size: {{ section.settings.text_size }}px;
    --review-badge-star-size: {{ section.settings.star_box_size }}px;
    --review-badge-star-font-size: {{ section.settings.star_icon_size }}px;
    --review-badge-bg: {{ section.settings.background_color }};
    --review-badge-text: {{ section.settings.text_color }};
    --review-badge-star-bg: {{ section.settings.star_color }};
    --review-badge-star-empty: {{ section.settings.empty_star_color }};
    --review-badge-star-icon: {{ section.settings.star_text_color }};
  }

  #shopify-section-{{ section.id }} .review-badge-block {
    display: inline-flex;
    align-items: center;
    gap: var(--review-badge-gap);
    padding: var(--review-badge-padding-y) var(--review-badge-padding-x);
    border-radius: var(--review-badge-radius);
    background: var(--review-badge-bg);
    margin-bottom: var(--review-badge-margin-bottom);
    flex-wrap: wrap;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .review-badge-block--start {
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .review-badge-block--center {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .review-badge-block--end {
    justify-content: flex-end;
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .review-badge-block__text,
  #shopify-section-{{ section.id }} .review-badge-block__count,
  #shopify-section-{{ section.id }} .review-badge-block__brand {
    font-size: var(--review-badge-text-size);
    color: var(--review-badge-text);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .review-badge-block__stars {
    display: inline-flex;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .review-badge-block__stars .star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--review-badge-star-size);
    height: var(--review-badge-star-size);
    background: var(--review-badge-star-bg);
    color: var(--review-badge-star-icon);
    font-size: var(--review-badge-star-font-size);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .review-badge-block__stars .star--half {
    background: linear-gradient(to right, var(--review-badge-star-bg) 50%, var(--review-badge-star-empty) 50%);
  }

  #shopify-section-{{ section.id }} .review-badge-block__stars .star--empty {
    background: var(--review-badge-star-empty);
  }

  #shopify-section-{{ section.id }} .review-badge-block__brand {
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --review-badge-gap: {{ section.settings.mobile_gap }}px;
      --review-badge-padding-y: {{ section.settings.mobile_padding_y }}px;
      --review-badge-padding-x: {{ section.settings.mobile_padding_x }}px;
      --review-badge-text-size: {{ section.settings.mobile_text_size }}px;
      --review-badge-star-size: {{ section.settings.mobile_star_box_size }}px;
      --review-badge-star-font-size: {{ section.settings.mobile_star_icon_size }}px;
    }
  }
</style>

