{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

{%- capture review_avatars_markup -%}
  {%- assign review_1_name = review_block.settings.review_1_name | strip -%}
  {%- assign review_1_text = review_block.settings.review_1_text | strip -%}
  {%- assign review_2_name = review_block.settings.review_2_name | strip -%}
  {%- assign review_2_text = review_block.settings.review_2_text | strip -%}
  {%- assign review_3_name = review_block.settings.review_3_name | strip -%}
  {%- assign review_3_text = review_block.settings.review_3_text | strip -%}

  {%- if review_1_name != blank or review_1_text != blank or review_2_name != blank or review_2_text != blank or review_3_name != blank or review_3_text != blank -%}
    <div class="product-info__review-avatars product-info__review-avatars--after-buy-buttons" {{ review_block.shopify_attributes }}>
      <style>
        .review-avatars-{{ review_block.id }} {
          background: {{ review_block.settings.background_color }};
          color: {{ review_block.settings.text_color }};
          border-radius: {{ review_block.settings.border_radius }}px;
          padding: 18px;
          display: grid;
          gap: 14px;
          margin-top: 12px;
        }

        .review-avatars-{{ review_block.id }}__title {
          margin: 0;
          font-size: 18px;
          line-height: 1.2;
          font-weight: 700;
        }

        .review-avatars-{{ review_block.id }}__list {
          display: grid;
          gap: 12px;
        }

        .review-avatars-{{ review_block.id }}__item {
          display: grid;
          grid-template-columns: auto 1fr;
          gap: 10px;
          align-items: start;
        }

        .review-avatars-{{ review_block.id }}__avatar {
          width: 40px;
          height: 40px;
          border-radius: 999px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 15px;
          font-weight: 700;
          background: {{ review_block.settings.avatar_background }};
          color: {{ review_block.settings.avatar_text_color }};
          overflow: hidden;
        }

        .review-avatars-{{ review_block.id }}__avatar-image {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }

        .review-avatars-{{ review_block.id }}__meta {
          display: flex;
          align-items: center;
          gap: 8px;
          flex-wrap: wrap;
          margin-bottom: 4px;
        }

        .review-avatars-{{ review_block.id }}__name {
          font-weight: 700;
          line-height: 1.2;
        }

        .review-avatars-{{ review_block.id }}__stars {
          color: {{ review_block.settings.star_color }};
          letter-spacing: 0.08em;
          line-height: 1;
          font-size: 14px;
        }

        .review-avatars-{{ review_block.id }}__text {
          margin: 0;
          color: {{ review_block.settings.text_color }};
          opacity: 0.82;
          line-height: 1.45;
          font-size: 14px;
        }

        @media screen and (max-width: 749px) {
          .review-avatars-{{ review_block.id }} {
            padding: 14px;
            gap: 12px;
          }

          .review-avatars-{{ review_block.id }}__item {
            gap: 8px;
          }

          .review-avatars-{{ review_block.id }}__avatar {
            width: 36px;
            height: 36px;
            font-size: 14px;
          }
        }
      </style>

      <div class="review-avatars-{{ review_block.id }}">
        {%- if review_block.settings.title != blank -%}
          <h3 class="review-avatars-{{ review_block.id }}__title">{{ review_block.settings.title | escape }}</h3>
        {%- endif -%}

        <div class="review-avatars-{{ review_block.id }}__list">
          {%- for index in (1..3) -%}
            {%- liquid
              assign name_key = 'review_' | append: index | append: '_name'
              assign text_key = 'review_' | append: index | append: '_text'
              assign rating_key = 'review_' | append: index | append: '_rating'
              assign image_key = 'review_' | append: index | append: '_avatar'
              assign review_name = review_block.settings[name_key] | strip
              assign review_text = review_block.settings[text_key] | strip
              assign review_rating = review_block.settings[rating_key] | default: 5 | plus: 0
              assign review_image = review_block.settings[image_key]
            -%}

            {%- if review_name != blank or review_text != blank -%}
              <div class="review-avatars-{{ review_block.id }}__item">
                <div class="review-avatars-{{ review_block.id }}__avatar">
                  {%- if review_image != blank -%}
                    {%- assign review_avatar_class = 'review-avatars-' | append: review_block.id | append: '__avatar-image' -%}
                    {{- review_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,80', class: review_avatar_class, alt: review_name -}}
                  {%- elsif review_name != blank -%}
                    {{- review_name | slice: 0, 1 | upcase -}}
                  {%- else -%}
                    ★
                  {%- endif -%}
                </div>

                <div>
                  <div class="review-avatars-{{ review_block.id }}__meta">
                    {%- if review_name != blank -%}
                      <span class="review-avatars-{{ review_block.id }}__name">{{ review_name | escape }}</span>
                    {%- endif -%}

                    <span class="review-avatars-{{ review_block.id }}__stars" aria-label="{{ review_rating }} van 5 sterren">
                      {%- for i in (1..5) -%}
                        {%- if i <= review_rating -%}★{%- else -%}☆{%- endif -%}
                      {%- endfor -%}
                    </span>
                  </div>

                  {%- if review_text != blank -%}
                    <p class="review-avatars-{{ review_block.id }}__text">{{ review_text | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

<safe-sticky class="product-info">
  {%- assign deferred_review_avatars_block = blank -%}

  {%- for block in section.blocks -%}
    {%- assign previous_block_index = forloop.index0 | minus: 1 -%}
    {%- assign previous_block = section.blocks[previous_block_index] -%}
    {%- assign next_block = section.blocks[forloop.index] -%}

    {%- case block.type -%}
      {%- when '@app' -%}
        {%- render block -%}

      {%- when 'vendor' -%}
        {%- if product.vendor != blank -%}
          <div class="product-info__vendor" {{ block.shopify_attributes }}>
            {%- render 'vendor' with product.vendor -%}
          </div>
        {%- endif -%}

      {%- when 'title' -%}
        {%- if request.page_type == 'product' -%}
          <h1 class="product-info__title {{ block.settings.heading_tag }}" {{ block.shopify_attributes }}>{{ product.title }}</h1>
        {%- else -%}
          <h2 class="product-info__title {{ block.settings.heading_tag }}" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h2>
        {%- endif -%}

      {%- when 'badges' -%}
        {%- render 'product-badges', product: product, types: 'custom', form_id: product_form_id, class: 'product-info__badge-list', block: block -%}

      {%- when 'stock_status_pill' -%}
        <div class="product-info__stock-status-pill" {{ block.shopify_attributes }}>
          <style>
            .stock-status-pill-{{ block.id }} {
              display: inline-flex;
              align-items: center;
              gap: 16px;
              padding: 14px 22px;
              border-radius: 999px;
              background: {{ block.settings.background_color }};
              color: {{ block.settings.text_color }};
              line-height: 1;
            }

            .stock-status-pill-{{ block.id }}__dot {
              width: 28px;
              height: 28px;
              border-radius: 50%;
              background: {{ block.settings.dot_color }};
              flex-shrink: 0;
            }

            .stock-status-pill-{{ block.id }}__text {
              font-size: 20px;
              font-weight: 500;
              letter-spacing: -0.02em;
            }

            @media screen and (max-width: 749px) {
              .stock-status-pill-{{ block.id }} {
                gap: 12px;
                padding: 10px 14px;
              }

              .stock-status-pill-{{ block.id }}__dot {
                width: 22px;
                height: 22px;
              }

              .stock-status-pill-{{ block.id }}__text {
                font-size: 16px;
              }
            }
          </style>
          <div class="stock-status-pill-{{ block.id }}">
            <span class="stock-status-pill-{{ block.id }}__dot"></span>
            <span class="stock-status-pill-{{ block.id }}__text">{{ block.settings.text }}</span>
          </div>
        </div>

      {%- when 'sku' -%}
        <variant-sku form="{{ product_form_id }}" class="product-info__sku text-xs text-subdued" {% if product.selected_or_first_available_variant.sku == blank %}hidden{% endif %} {{ block.shopify_attributes }}>
          {{- 'product.general.sku' | t }} {{ product.selected_or_first_available_variant.sku -}}
        </variant-sku>

      {%- when 'price' -%}
        <div class="product-info__price">
          <div class="rating-with-text">
            {%- render 'price-list', variant: product.selected_or_first_available_variant, form_id: product_form_id, size: 'lg', block: block -%}
            {%- render 'product-badges', types: 'sold_out, discount', product: product, form_id: product_form_id, class: 'product-info__badge-list' -%}

            {%- if next_block.type == 'rating' -%}
              {%- render 'product-rating', product: product, show_empty: next_block.settings.show_empty, block: next_block -%}
            {%- endif -%}
          </div>

          {%- if block.settings.show_taxes_notice -%}
            <p class="text-sm text-subdued">
              {%- if cart.taxes_included -%}
                {{ 'product.general.taxes_included' | t }}
              {%- else -%}
                {{ 'product.general.taxes_excluded' | t }}
              {%- endif -%}

              {%- if shop.shipping_policy.body != blank -%}
                {{ 'product.general.shipping_policy_html' | t: link: shop.shipping_policy.url }}
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>

      {%- when 'rating' -%}
        {%- if previous_block.type != 'price' -%}
          <div class="product-info__rating">
            {%- render 'product-rating', product: product, show_empty: block.settings.show_empty, block: block -%}
          </div>
        {%- endif -%}

      {%- when 'payment_terms' -%}
        <payment-terms class="product-info__payment-terms" form="{{ product_form_id }}" {{ block.shopify_attributes }}>
          {%- capture product_installment_form_id -%}product-installment-form-{{ section.id }}-{{ product.id }}{%- endcapture -%}

          {%- form 'product', product, id: product_installment_form_id -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {{- form | payment_terms -}}
          {%- endform -%}
        </payment-terms>

      {%- when 'separator' -%}
        <hr class="product-info__separator" {{ block.shopify_attributes }}>

      {%- when 'description' -%}
        {%- if block.settings.collapse_content -%}
          {%- if product.description != blank -%}
            {%- capture accordion_title -%}{{ 'product.general.description' | t }}{%- endcapture -%}
            {%- capture accordion_content -%}<div class="prose">{{ product.description }}</div>{%- endcapture -%}

            {%- render 'accordion', title: accordion_title, content: accordion_content, class: 'product-info__accordion', block: block -%}
          {%- endif -%}
        {%- else -%}
          {%- if product.description != blank -%}
            <div class="product-info__description" {{ block.shopify_attributes }}>
              <div class="prose">
                {{- product.description -}}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}

      {%- when 'variant_picker' -%}
        <div class="product-info__variant-picker" {{ block.shopify_attributes }}>
          {%- render 'variant-picker', product: product, form_id: product_form_id, update_url: update_url, hide_sold_out_variants: block.settings.hide_sold_out_variants, block: block -%}
        </div>

      {%- when 'product_variations' -%}
        {%- assign contains_product = false -%}

        {%- for product_variation in block.settings.products -%}
          {%- if product_variation == product -%}
            {%- assign contains_product = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if contains_product -%}
          <div class="product-info__product-picker" {{ block.shopify_attributes }}>
            <div class="variant-picker">
              <fieldset class="variant-picker__option">
                {%- assign metafield_parts = block.settings.option_value_metafield | split: '.' -%}
                {%- assign metafield_namespace = metafield_parts | first -%}
                {%- assign metafield_key = metafield_parts | last -%}

                {%- if block.settings.option_name != blank -%}
                  <div class="variant-picker__option-info">
                    <div class="h-stack gap-2">
                      <legend class="text-subdued">{{ block.settings.option_name | escape }}:</legend>
                      <span>{{ product.metafields[metafield_namespace][metafield_key].value | escape }}</span>
                    </div>
                  </div>
                {%- endif -%}

                <div class="variant-picker__option-values wrap gap-2">
                  {%- for product_variation in block.settings.products -%}
                    {%- assign value = product_variation.metafields[metafield_namespace][metafield_key].value -%}

                    {%- if product_variation == product -%}
                      {%- assign selected = true -%}
                    {%- else -%}
                      {%- assign selected = false -%}
                    {%- endif -%}

                    {%- case block.settings.color_mode -%}
                      {%- when 'color' -%}
                        {%- render 'swatch' with 'color', href: product_variation.url, value: value, selected: selected -%}

                      {%- when 'variant' -%}
                        {%- render 'swatch' with 'media', href: product_variation.url, value: value, media: product_variation.featured_media, selected: selected, bordered: true -%}

                      {%- when 'block' -%}
                        {%- render 'swatch' with 'block', href: product_variation.url, value: value, selected: selected -%}

                      {%- when 'block_swatch' -%}
                        {%- render 'swatch' with 'block', href: product_variation.url, value: value, selected: selected, show_color: true -%}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            </div>
          </div>
        {%- endif -%}

      {%- when 'line_item_property' -%}
        {%- if block.settings.label != blank -%}
          {%- capture name -%}properties[{{ block.settings.label | escape }}]{%- endcapture -%}

          <div class="product-info__property" {{ block.shopify_attributes }}>
            {%- if block.settings.type == 'text' -%}
              {%- if block.settings.allow_long_text -%}
                {%- render 'input', label: block.settings.label, name: name, form: product_form_id, multiline: 4, required: block.settings.required, maxlength: block.settings.max_length -%}
              {%- else -%}
                {%- render 'input', type: 'text', label: block.settings.label, name: name, form: product_form_id, required: block.settings.required, maxlength: block.settings.max_length -%}
              {%- endif -%}
            {%- else -%}
              {%- render 'checkbox', label: block.settings.label, name: name, required: block.settings.required, form: product_form_id -%}
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- when 'quantity_selector' -%}
        {%- if product.available -%}
          <div class="product-info__quantity-selector {{ block.shopify_attributes }}">
            <div class="form-control">
              <label for="{{ product_form_id }}-quantity" class="block-label text-subdued">{{- 'product.quantity.label' | t -}}:</label>

              <quantity-selector class="quantity-selector">
                <button type="button" class="quantity-selector__button" aria-label="{{ 'product.quantity.decrease_quantity' | t }}">{% render 'icon' with 'minus', width: 10, height: 2 %}</button>
                <input id="{{ product_form_id }}-quantity" type="text" is="quantity-input" inputmode="numeric" class="quantity-selector__input" name="quantity" form="{{ product_form_id }}" size="2" value="1" autocomplete="off">
                <button type="button" class="quantity-selector__button" aria-label="{{ 'product.quantity.increase_quantity' | t }}">{% render 'icon' with 'plus', width: 10, height: 10 %}</button>
              </quantity-selector>
            </div>
          </div>
        {%- endif -%}

      {%- when 'inventory' -%}
        <div class="product-info__inventory {{ block.shopify_attributes }}">
          {%- render 'inventory', product: product, low_threshold: block.settings.low_inventory_threshold, form_id: product_form_id -%}
        </div>

      {%- when 'buy_buttons' -%}
        {%- assign main_form_exists = true -%}

        {%- if request.page_type != 'password' -%}
          <div class="product-info__buy-buttons" {{ block.shopify_attributes }}>
            {%- render 'buy-buttons', product: product, form_id: product_form_id, show_payment_button: block.settings.show_payment_button, show_gift_card_recipient: block.settings.show_gift_card_recipient, atc_button_background: block.settings.atc_button_background, atc_button_text_color: block.settings.atc_button_text_color, payment_button_background: block.settings.payment_button_background, payment_button_text_color: block.settings.payment_button_text_color -%}
          </div>

          {%- if next_block.type == 'review_avatars' -%}
            {%- assign review_block = next_block -%}
            {{- review_avatars_markup -}}
          {%- endif -%}
        {%- endif -%}

      {%- when 'review_avatars' -%}
        {%- if previous_block.type != 'buy_buttons' -%}
          {%- assign deferred_review_avatars_block = block -%}
        {%- endif -%}

      {%- when 'pickup_availability' -%}
        <div class="product-info__pickup-availability" {{ block.shopify_attributes }}>
          {%- render 'pickup-availability', product_variant: product.selected_or_first_available_variant, form_id: product_form_id -%}
        </div>

      {%- when 'text' -%}
        {%- if block.settings.text != blank -%}
          <div class="product-info__text" {{ block.shopify_attributes }}>
            <div class="prose">
              {{- block.settings.text -}}
            </div>
          </div>
        {%- endif -%}

      {%- when 'collapsible_text' -%}
        {%- if block.settings.title != blank and block.settings.content != blank -%}
          {%- capture accordion_content -%}<div class="prose">{{ block.settings.content }}</div>{%- endcapture -%}
          {%- render 'accordion', title: block.settings.title, content: accordion_content, class: 'product-info__accordion', block: block -%}
        {%- endif -%}

      {%- when 'image' -%}
        {%- if block.settings.image != blank -%}
          <div class="product-info__image" {{ block.shopify_attributes }}>
            {%- capture sizes -%}{{ block.settings.max_width }}px{%- endcapture -%}
            {%- capture widths -%}{{ block.settings.max_width }}, {{ block.settings.max_width | times: 2 | at_most: block.settings.image.width }}{%- endcapture -%}
            {%- capture style -%}width: {{ block.settings.max_width }}px; {% if block.settings.alignment == 'center' %}margin-inline: auto{% elsif block.settings.alignment == 'end' %}margin-inline-start: auto;{% endif %}{%- endcapture -%}
            {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', style: style, sizes: sizes, widths: widths -}}
          </div>
        {%- endif -%}

      {%- when 'button' -%}
        {%- if block.settings.text != blank -%}
          <div class="product-info__button" {{ block.shopify_attributes }}>
            {%- render 'button', content: block.settings.text, href: block.settings.link, size: block.settings.size, style: block.settings.style, stretch: block.settings.stretch, background: block.settings.background, text_color: block.settings.text_color -%}
          </div>
        {%- endif -%}

      {%- when 'liquid' -%}
        {%- if block.settings.liquid != blank -%}
          <div class="product-info__liquid" {{ block.shopify_attributes }}>
            {{ block.settings.liquid }}
          </div>
        {%- endif -%}

      {%- when 'pair_with' -%}
        {%- assign pair_product = block.settings.product -%}

        {%- if pair_product == blank and block.settings.product != blank -%}
          {%- assign pair_product = all_products[block.settings.product] -%}
        {%- endif -%}

        {%- if pair_product != blank -%}
          <div class="product-info__pair-with" {{ block.shopify_attributes }}>
            <style>
              .pair-with-{{ block.id }} {
                display: grid;
                gap: 14px;
                padding: 16px;
                border-radius: 18px;
                border: 1px solid rgba(0, 0, 0, 0.08);
                background: {{ block.settings.card_background | default: '#ffffff' }};
                color: {{ block.settings.text_color | default: '#111111' }};
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
              }

              .pair-with-{{ block.id }}__label {
                margin: 0;
                font-size: 11px;
                line-height: 1;
                letter-spacing: 0.18em;
                font-weight: 800;
                text-transform: uppercase;
                color: {{ block.settings.label_color | default: '#6b7280' }};
              }

              .pair-with-{{ block.id }}__card {
                display: grid;
                grid-template-columns: auto minmax(0, 1fr);
                gap: 12px;
                align-items: center;
              }

              .pair-with-{{ block.id }}__media {
                width: 84px;
                min-width: 84px;
              }

              .pair-with-{{ block.id }}__image {
                display: block;
                aspect-ratio: 1;
                border-radius: 14px;
                overflow: hidden;
                background: rgba(0, 0, 0, 0.04);
              }

              .pair-with-{{ block.id }}__image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
              }

              .pair-with-{{ block.id }}__content {
                min-width: 0;
                display: grid;
                gap: 6px;
              }

              .pair-with-{{ block.id }}__title {
                margin: 0;
                font-size: 15px;
                line-height: 1.3;
                font-weight: 700;
                color: inherit;
              }

              .pair-with-{{ block.id }}__title a {
                color: inherit;
                text-decoration: none;
              }

              .pair-with-{{ block.id }}__text {
                margin: 0;
                font-size: 13px;
                line-height: 1.45;
                color: inherit;
                opacity: 0.78;
              }

              .pair-with-{{ block.id }}__footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                flex-wrap: wrap;
              }

              .pair-with-{{ block.id }}__price {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
              }

              .pair-with-{{ block.id }}__button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 44px;
                padding: 10px 16px;
                border-radius: 999px;
                background: {{ block.settings.button_background | default: '#111111' }};
                color: {{ block.settings.button_text_color | default: '#ffffff' }};
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
                line-height: 1;
                white-space: nowrap;
              }

              @media screen and (max-width: 749px) {
                .pair-with-{{ block.id }} {
                  padding: 14px;
                  gap: 12px;
                }

                .pair-with-{{ block.id }}__card {
                  grid-template-columns: 72px minmax(0, 1fr);
                  gap: 10px;
                  align-items: start;
                }

                .pair-with-{{ block.id }}__media {
                  width: 72px;
                  min-width: 72px;
                }

                .pair-with-{{ block.id }}__title {
                  font-size: 14px;
                }

                .pair-with-{{ block.id }}__text {
                  font-size: 12px;
                }

                .pair-with-{{ block.id }}__footer {
                  align-items: stretch;
                }

                .pair-with-{{ block.id }}__button {
                  width: 100%;
                }
              }
            </style>

            <div class="pair-with-{{ block.id }}">
              {%- if block.settings.heading != blank -%}
                <p class="pair-with-{{ block.id }}__label">{{ block.settings.heading | escape }}</p>
              {%- endif -%}

              <div class="pair-with-{{ block.id }}__card">
                <div class="pair-with-{{ block.id }}__media">
                  <a href="{{ pair_product.url }}" class="pair-with-{{ block.id }}__image" aria-label="{{ pair_product.title | escape }}">
                    {%- if pair_product.featured_media != blank -%}
                      {{- pair_product.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', widths: '72,84,144,168,200', alt: pair_product.title -}}
                    {%- else -%}
                      <div style="width: 100%; aspect-ratio: 1; background: rgba(0, 0, 0, 0.04);"></div>
                    {%- endif -%}
                  </a>
                </div>

                <div class="pair-with-{{ block.id }}__content">
                  <h3 class="pair-with-{{ block.id }}__title">
                    <a href="{{ pair_product.url }}">{{ pair_product.title }}</a>
                  </h3>

                  {%- if block.settings.subtext != blank -%}
                    <p class="pair-with-{{ block.id }}__text">{{ block.settings.subtext | escape }}</p>
                  {%- endif -%}

                  <div class="pair-with-{{ block.id }}__footer">
                    <div class="pair-with-{{ block.id }}__price">
                      {%- render 'price-list', product: pair_product -%}
                    </div>

                    <a href="{{ pair_product.url }}" class="pair-with-{{ block.id }}__button">
                      {{ block.settings.button_label | default: 'Shop now' | escape }}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- elsif request.design_mode -%}
          <div class="product-info__pair-with" {{ block.shopify_attributes }}>
            <div style="padding: 16px; border: 1px dashed rgba(0,0,0,0.2); border-radius: 16px;">
              <p style="margin: 0; font-weight: 700;">Pair with block</p>
              <p style="margin: 6px 0 0; opacity: 0.7;">Selecteer een upsell product om dit block zichtbaar te maken.</p>
            </div>
          </div>
        {%- endif -%}

      {%- when 'associated_products' -%}
        <product-recommendations class="block" product="{{ product.id }}" limit="{{ block.settings.products_count }}" intent="complementary" {{ block.shopify_attributes }}>
          {%- if recommendations.performed and recommendations.products_count > 0 -%}
            <div class="product-info__complementary-products v-stack gap-3 sm:gap-4">
              {%- assign carousel_id = 'carousel-' | append: block.id -%}

              {%- if block.settings.title != blank or block.settings.stack_products == false and recommendations.products_count > 1 -%}
                <div class="h-stack justify-between gap-4">
                  {%- if block.settings.title != blank -%}
                    <p>{{ block.settings.title | escape }}</p>
                  {%- endif -%}

                  {%- if block.settings.stack_products == false and recommendations.products_count > 1 -%}
                    <div class="h-stack gap-2 hidden sm:flex">
                      <button is="prev-button" class="circle-chevron hover:colors" aria-controls="{{ carousel_id }}" aria-label="{{ 'general.accessibility.previous' | t | escape }}" disabled>{%- render 'icon' with 'chevron-left-small', direction_aware: true -%}</button>
                      <button is="next-button" class="circle-chevron hover:colors" aria-controls="{{ carousel_id }}" aria-label="{{ 'general.accessibility.next' | t | escape }}">{%- render 'icon' with 'chevron-right-small', direction_aware: true -%}</button>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- capture horizontal_products -%}
                {%- for associated_product in recommendations.products -%}
                  {%- render 'horizontal-product', product: associated_product, show_add_to_cart: true, background: block.settings.background, text_color: block.settings.text_color -%}
                {%- endfor -%}
              {%- endcapture -%}

              {%- assign horizontal_products_blends = true -%}
              {%- assign section_background = section.settings.background_gradient | default: section.settings.background | default: settings.background -%}

              {%- if block.settings.background != 'rgba(0,0,0,0)' and block.settings.background != blank and block.settings.background != section_background -%}
                {%- assign horizontal_products_blends = false -%}
              {%- endif -%}

              {%- if block.settings.stack_products -%}
                <div class="horizontal-product-list {% if horizontal_products_blends %}border divide-y rounded-xs{% else %}separate{% endif %}">
                  {{- horizontal_products -}}
                </div>
              {%- else -%}
                <scroll-carousel selector=".horizontal-product" id="{{ carousel_id }}" class="horizontal-product-list-carousel {% unless horizontal_products_blends %}separate{% endunless %} scroll-area bleed sm:unbleed">
                  <div class="horizontal-product-list {% if horizontal_products_blends %}divide-x{% else %}separate{% endif %}">
                    {{- horizontal_products -}}
                  </div>
                </scroll-carousel>
              {%- endif -%}
            </div>
          {%- endif -%}
        </product-recommendations>

      {%- when 'offer' -%}
        {%- if previous_block.type != 'offer' and next_block.type == 'offer' -%}
          <div class="product-info__offer-list">
        {%- endif -%}

        {%- if block.settings.title != blank or block.settings.content != blank -%}
          {%- render 'offer', block: block -%}
        {%- endif -%}

        {%- if forloop.last or previous_block.type == 'offer' and next_block.type != 'offer' -%}
          </div>
        {%- endif -%}

      {%- when 'shipping_countdown' -%}
        {%- assign sc_today_num = 'now' | date: '%w' | plus: 0 -%}
        {%- if sc_today_num == 6 -%}
          {%- assign sc_days_add = 2 -%}
        {%- elsif sc_today_num == 0 -%}
          {%- assign sc_days_add = 1 -%}
        {%- else -%}
          {%- assign sc_days_add = 0 -%}
        {%- endif -%}
        {%- assign sc_ship_wday = sc_today_num | plus: sc_days_add | modulo: 7 -%}
        {%- assign sc_ship_mday = 'now' | date: '%-d' | plus: sc_days_add -%}
        {%- assign sc_ship_month_idx = 'now' | date: '%-m' | minus: 1 -%}
        {%- assign sc_nl_days = 'zo,ma,di,wo,do,vr,za' | split: ',' -%}
        {%- assign sc_nl_months = 'jan,feb,mrt,apr,mei,jun,jul,aug,sep,okt,nov,dec' | split: ',' -%}
        {%- assign sc_day_label = sc_nl_days[sc_ship_wday] | capitalize -%}
        {%- assign sc_month_label = sc_nl_months[sc_ship_month_idx] -%}
        <div class="product-info__shipping-countdown" {{ block.shopify_attributes }}>
          <style>
            .sc-bar-{{ block.id }} {
              display: flex;
              align-items: center;
              gap: 10px;
              background: {{ block.settings.background_color }};
              border-radius: {{ block.settings.border_radius }}px;
              padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
              font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            }
            .sc-bar-{{ block.id }} .sc-dot {
              width: 9px;
              height: 9px;
              border-radius: 50%;
              background: {{ block.settings.dot_color }};
              flex-shrink: 0;
            }
            .sc-bar-{{ block.id }} .sc-text {
              font-size: {{ block.settings.font_size }}px;
              color: {{ block.settings.text_color }};
              font-weight: 500;
              line-height: 1.3;
              flex: 1;
            }
            .sc-bar-{{ block.id }} .sc-text strong {
              font-weight: 700;
            }
            .sc-bar-{{ block.id }} .sc-badge {
              display: inline-flex;
              align-items: center;
              gap: 5px;
              background: {{ block.settings.badge_bg_color }};
              color: {{ block.settings.badge_text_color }};
              font-size: {{ block.settings.badge_font_size }}px;
              font-weight: 600;
              padding: 4px 12px;
              border-radius: 20px;
              white-space: nowrap;
              flex-shrink: 0;
            }
            .sc-bar-{{ block.id }} .sc-flag {
              display: inline-flex;
              border-radius: 2px;
              overflow: hidden;
              flex-shrink: 0;
              width: {{ block.settings.flag_size }}px;
            }
            .sc-bar-{{ block.id }} .sc-flag svg {
              display: block;
              width: 100%;
              height: auto;
            }
          </style>
          <div class="sc-bar-{{ block.id }}">
            <span class="sc-dot"></span>
            <span class="sc-text">{{ block.settings.label_prefix }} <strong>{{ sc_day_label }}. {{ sc_ship_mday }} {{ sc_month_label }}</strong></span>
            <span class="sc-badge">
              <span class="sc-flag">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 6">
                  <rect width="9" height="6" fill="#AE1C28"/>
                  <rect y="2" width="9" height="2" fill="white"/>
                  <rect y="4" width="9" height="2" fill="#21468B"/>
                </svg>
              </span>
              {{ block.settings.badge_text }}
            </span>
          </div>
        </div>

      {%- when 'conversion_highlight' -%}
        {%- if block.settings.title != blank or block.settings.content != blank or block.settings.eyebrow != blank -%}
          <div class="product-info__conversion-highlight" {{ block.shopify_attributes }}>
            <style>
              .conversion-highlight-{{ block.id }} {
                position: relative;
                display: grid;
                gap: 14px;
                padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
                border-radius: {{ block.settings.border_radius }}px;
                background: {{ block.settings.background }};
                color: {{ block.settings.text_color }};
                border: 1px solid {% if block.settings.highlight_border %}{{ block.settings.border_color }}{% else %}rgba(0, 0, 0, 0.08){% endif %};
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
                overflow: hidden;
                isolation: isolate;
              }

              .conversion-highlight-{{ block.id }}::before {
                content: '';
                position: absolute;
                inset-block: 0;
                inset-inline-start: 0;
                width: 4px;
                background: {{ block.settings.accent_color }};
                opacity: {% if block.settings.highlight_border %}1{% else %}0.45{% endif %};
                z-index: -1;
              }

              .conversion-highlight-{{ block.id }}__top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                flex-wrap: wrap;
              }

              .conversion-highlight-{{ block.id }}__eyebrow {
                display: inline-flex;
                align-items: center;
                min-height: 28px;
                padding: 6px 10px;
                border-radius: 999px;
                background: {{ block.settings.accent_color }};
                color: {{ block.settings.badge_text_color }};
                font-size: 11px;
                line-height: 1;
                letter-spacing: 0.14em;
                font-weight: 800;
                text-transform: uppercase;
                white-space: nowrap;
              }

              .conversion-highlight-{{ block.id }}__main {
                display: grid;
                grid-template-columns: auto minmax(0, 1fr);
                gap: 14px;
                align-items: start;
              }

              .conversion-highlight-{{ block.id }}__icon-wrap {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.52);
                border: 1px solid rgba(0, 0, 0, 0.06);
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
                flex-shrink: 0;
              }

              .conversion-highlight-{{ block.id }}__content-wrap {
                min-width: 0;
                display: grid;
                gap: 6px;
              }

              .conversion-highlight-{{ block.id }}__title {
                margin: 0;
                font-size: 18px;
                line-height: 1.15;
                font-weight: 700;
                letter-spacing: -0.02em;
                color: inherit;
              }

              .conversion-highlight-{{ block.id }}__content {
                margin: 0;
                font-size: 14px;
                line-height: 1.6;
                color: inherit;
                opacity: 0.82;
              }

              .conversion-highlight-{{ block.id }}__content > * {
                margin-top: 0;
              }

              .conversion-highlight-{{ block.id }}__content > *:last-child {
                margin-bottom: 0;
              }

              .conversion-highlight-{{ block.id }}__meta {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
              }

              .conversion-highlight-{{ block.id }}__point {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: 12px;
                line-height: 1.3;
                font-weight: 600;
                opacity: 0.78;
              }

              .conversion-highlight-{{ block.id }}__point::before {
                content: '';
                width: 6px;
                height: 6px;
                border-radius: 999px;
                background: {{ block.settings.accent_color }};
                flex-shrink: 0;
              }

              @media screen and (max-width: 749px) {
                .conversion-highlight-{{ block.id }} {
                  gap: 12px;
                  padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
                  border-radius: {{ block.settings.border_radius_mobile }}px;
                }

                .conversion-highlight-{{ block.id }}__main {
                  gap: 12px;
                }

                .conversion-highlight-{{ block.id }}__icon-wrap {
                  width: 40px;
                  height: 40px;
                  border-radius: 12px;
                }

                .conversion-highlight-{{ block.id }}__title {
                  font-size: 16px;
                }

                .conversion-highlight-{{ block.id }}__content {
                  font-size: 13px;
                  line-height: 1.55;
                }

                .conversion-highlight-{{ block.id }}__eyebrow {
                  min-height: 26px;
                  padding: 5px 9px;
                  font-size: 10px;
                }
              }
            </style>

            <div class="conversion-highlight-{{ block.id }}">
              {%- if block.settings.eyebrow != blank -%}
                <div class="conversion-highlight-{{ block.id }}__top">
                  <span class="conversion-highlight-{{ block.id }}__eyebrow">{{ block.settings.eyebrow | escape }}</span>
                </div>
              {%- endif -%}

              <div class="conversion-highlight-{{ block.id }}__main">
                {%- if block.settings.icon != 'none' -%}
                  <div class="conversion-highlight-{{ block.id }}__icon-wrap">
                    {%- render 'icon' with block.settings.icon, width: 20, height: 20 -%}
                  </div>
                {%- endif -%}

                <div class="conversion-highlight-{{ block.id }}__content-wrap">
                  {%- if block.settings.title != blank -%}
                    <h3 class="conversion-highlight-{{ block.id }}__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}

                  {%- if block.settings.content != blank -%}
                    <div class="conversion-highlight-{{ block.id }}__content">
                      {{ block.settings.content }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.meta_text != blank -%}
                    <div class="conversion-highlight-{{ block.id }}__meta">
                      <span class="conversion-highlight-{{ block.id }}__point">{{ block.settings.meta_text | escape }}</span>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}

      {%- when 'share_buttons' -%}
        <div class="product-form__share {% if block.settings.alignment == 'center' %}justify-self-center{% elsif block.settings.alignment == 'end' %}justify-self-end{% endif %}" {{ block.shopify_attributes }}>
          <div class="product-info__share-buttons">
            <div class="share-buttons">
              <span class="text-subdued">{{- 'general.social.share' | t -}}</span>

              <ul class="h-stack" role="list">
                <li><a href="{% render 'share-link', host: 'facebook', title: product.title, description: product.description, url: product.url %}" class="share-buttons__item" aria-label="{{ 'general.social.share_on' | t: social_media: 'Facebook' }}">{%- render 'icon' with 'facebook', width: 20, height: 20 -%}</a></li>
                <li><a href="{% render 'share-link', host: 'twitter', title: product.title, description: product.description, url: product.url %}" class="share-buttons__item" aria-label="{{ 'general.social.share_on' | t: social_media: 'Twitter' }}">{%- render 'icon' with 'twitter', width: 20, height: 20 -%}</a></li>
                <li><a href="{% render 'share-link', host: 'pinterest', title: product.title, description: product.description, url: product.url %}" class="share-buttons__item" aria-label="{{ 'general.social.share_on' | t: social_media: 'Pinterest' }}">{%- render 'icon' with 'pinterest', width: 20, height: 20 -%}</a></li>
                <li><a href="{% render 'share-link', host: 'email', title: product.title, description: product.description, url: product.url %}" class="share-buttons__item" aria-label="{{ 'general.social.share_email' | t }}">{%- render 'icon' with 'email' -%}</a></li>
              </ul>
            </div>
          </div>

          <button is="share-button" class="product-info__native-share">
            {%- render 'icon' with 'share' -%} {{- 'general.social.share' | t -}}
          </button>
        </div>
    {%- endcase -%}
  {%- endfor -%}

  {%- if deferred_review_avatars_block != blank and main_form_exists == blank -%}
    {%- assign review_block = deferred_review_avatars_block -%}
    {{- review_avatars_markup -}}
  {%- endif -%}

  {%- unless main_form_exists -%}
    {%- form 'product', product, id: product_form_id, hidden: true -%}
      <input type="hidden" disabled name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {%- endform -%}
  {%- endunless -%}
</safe-sticky>