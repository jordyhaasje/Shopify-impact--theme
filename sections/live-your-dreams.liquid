{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --lyd-btn-bg: {{ section.settings.button_background.red }}, {{ section.settings.button_background.green }}, {{ section.settings.button_background.blue }};
    --lyd-btn-text: {{ section.settings.button_text_color.red }}, {{ section.settings.button_text_color.green }}, {{ section.settings.button_text_color.blue }};
    --lyd-video-btn-bg: {{ section.settings.video_button_background.red }}, {{ section.settings.video_button_background.green }}, {{ section.settings.video_button_background.blue }};
    --lyd-video-btn-text: {{ section.settings.video_button_text_color.red }}, {{ section.settings.video_button_text_color.green }}, {{ section.settings.video_button_text_color.blue }};
    --lyd-image-radius: {{ section.settings.image_radius }}px;
    --lyd-content-max: {{ section.settings.content_max_width }}px;
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .lyd-inner {
    max-width: var(--lyd-content-max);
    margin-inline: auto;
    text-align: center;
    display: grid;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .lyd-media {
    position: relative;
    border-radius: var(--lyd-image-radius);
    overflow: hidden;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  #shopify-section-{{ section.id }} .lyd-media__thumbnail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .lyd-media__thumbnail.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .lyd-media__placeholder {
    position: absolute;
    inset: 0;
    background: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .lyd-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .lyd-media__video.is-playing {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .lyd-media__play-btn {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgb(var(--lyd-video-btn-bg));
    color: rgb(var(--lyd-video-btn-text));
    font-size: 15px;
    font-weight: 500;
    border-radius: 999px;
    padding: 12px 22px;
    cursor: pointer;
    border: none;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .lyd-media__play-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .lyd-media__play-btn svg {
    width: 14px;
    height: 14px;
    display: block;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .lyd-content {
    display: grid;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .lyd-heading {
    font-size: clamp(36px, 7vw, 56px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    font-weight: 700;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lyd-heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .lyd-body {
    font-size: clamp(17px, 2.5vw, 20px);
    line-height: 1.5;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lyd-body p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lyd-actions {
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .lyd-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--lyd-btn-bg));
    color: rgb(var(--lyd-btn-text));
    font-size: 17px;
    font-weight: 500;
    border-radius: 999px;
    padding: 18px 40px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    letter-spacing: 0;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .lyd-inner {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .lyd-media__play-btn {
      font-size: 14px;
      padding: 10px 18px;
    }

    #shopify-section-{{ section.id }} .lyd-body {
      font-size: 17px;
    }
  }
</style>

<section class="lyd-section">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">
      <div class="lyd-inner">

        {%- assign has_video = false -%}
        {%- if section.settings.video != blank -%}
          {%- assign has_video = true -%}
        {%- endif -%}

        {%- if has_video or section.settings.image != blank -%}
          <div class="lyd-media" data-lyd-media>

            {%- if has_video -%}
              {%- for source in section.settings.video.sources -%}
                {%- if source.format == 'mp4' -%}
                  <video
                    class="lyd-media__video"
                    data-lyd-video
                    src="{{ source.url }}"
                    playsinline
                    muted
                    loop
                    preload="metadata"
                  ></video>
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if section.settings.image != blank -%}
              {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', class: 'lyd-media__thumbnail', alt: section.settings.image.alt, data-lyd-thumbnail: '' }}
            {%- elsif has_video -%}
              <div class="lyd-media__placeholder"></div>
            {%- endif -%}

            {%- if has_video -%}
              <button type="button" class="lyd-media__play-btn" data-lyd-play-btn aria-label="{{ section.settings.video_button_label | default: 'Bekijk video' | escape }}">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3.5 2.5L13.5 8L3.5 13.5V2.5Z" fill="currentColor"/>
                </svg>
                {{ section.settings.video_button_label | default: 'Bekijk video' | escape }}
              </button>
            {%- endif -%}

          </div>
        {%- endif -%}

        <div class="lyd-content">
          {%- if section.settings.heading != blank or section.settings.heading_italic != blank -%}
            <h2 class="lyd-heading">
              {%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }} {%- endif -%}
              {%- if section.settings.heading_italic != blank -%}<em>{{ section.settings.heading_italic | escape }}</em>{%- endif -%}
              {%- if section.settings.heading_suffix != blank -%}{{ section.settings.heading_suffix | escape }}{%- endif -%}
            </h2>
          {%- endif -%}

          {%- if section.settings.body_text != blank -%}
            <div class="lyd-body rte">
              {{ section.settings.body_text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="lyd-actions">
              {%- if section.settings.button_link != blank -%}
                <a href="{{ section.settings.button_link }}" class="lyd-cta-btn">{{ section.settings.button_label | escape }}</a>
              {%- else -%}
                <button type="button" class="lyd-cta-btn">{{ section.settings.button_label | escape }}</button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
  if (!sectionEl) return;

  var playBtn = sectionEl.querySelector('[data-lyd-play-btn]');
  var video = sectionEl.querySelector('[data-lyd-video]');
  var thumbnail = sectionEl.querySelector('[data-lyd-thumbnail]');

  if (!playBtn || !video) return;

  playBtn.addEventListener('click', function () {
    video.play();
    video.classList.add('is-playing');
    playBtn.classList.add('is-hidden');
    if (thumbnail) thumbnail.classList.add('is-hidden');
  });
})();
</script>

