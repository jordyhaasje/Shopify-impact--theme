ep":2,"unit":"px","default":42},{"type":"range","id":"logo_opacity","label":"Logo opacity","min":40,"max":100,"step":5,"unit":"%","default":90},{"type":"header","content":"Colors"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"button_background","label":"Button background","default":"#e7e7e7"},{"type":"color","id":"button_text_color","label":"Button text","default":"#333333"},{"type":"color","id":"logo_color","label":"Logo color","default":"#ffffff"},{"type":"color","id":"overlay_color","label":"Overlay color","default":"#000000"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":30}],"blocks":[{"type":"logo","name":"Logo / publication","settings":[{"type":"image_picker","id":"logo","label":"Logo image"},{"type":"text","id":"logo_text","label":"Logo text","default":"VOGUE"},{"type":"text","id":"author","label":"Reference author/name","default":"Publication"},{"type":"range","id":"rating","label":"Reference rating","min":1,"max":5,"step":1,"default":5}]}],"presets":[{"name":"Jordy-heroo","blocks":[{"type":"logo","settings":{"logo_text":"WomensHealth","author":"WomensHealth","rating":5}},{"type":"logo","settings":{"logo_text":"VOGUE","author":"VOGUE","rating":5}},{"type":"logo","settings":{"logo_text":"BAZAAR","author":"BAZAAR","rating":5}},{"type":"logo","settings":{"logo_text":"GRAZIA","author":"GRAZIA","rating":5}},{"type":"logo","settings":{"logo_text":"ELLE","author":"ELLE","rating":5}}]}]}
