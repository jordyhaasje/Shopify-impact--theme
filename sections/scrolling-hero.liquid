<div class="sh-section">
  <div class="sh-body">
    <div class="sh-content">
      <div class="sh-content-top">
        {%- if heading != blank -%}
          <div class="sh-heading">
            <h2>{{ heading | escape }}</h2>
          </div>
        {%- endif -%}
        {%- if body != blank -%}
          <div class="sh-text">
            <p>{{ body | escape }}</p>
          </div>
        {%- endif -%}
        {%- if btn_label != blank -%}
          <a href="{{ btn_url | default: '#' }}" class="sh-btn">
            {{ btn_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="sh-ticker-wrap" aria-hidden="true">
        <div class="sh-ticker-list">
          {%- for i in (1..12) -%}
            <div class="sh-ticker-item">
              <span class="sh-ticker-text">{{ ticker | escape }}</span>
              <span class="sh-ticker-icon">{{ star_svg }}</span>
            </div>
          {%- endfor -%}
          {%- for i in (1..12) -%}
            <div class="sh-ticker-item">
              <span class="sh-ticker-text">{{ ticker | escape }}</span>
              <span class="sh-ticker-icon">{{ star_svg }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="sh-image-col">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400,600,800,1000,1200',
            sizes: '(max-width: 1023px) 100vw, 50vw'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Targeted Solutions"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Whether you struggle with dryness, sensitivity, or acne, our brand has a targeted skincare solution for you. Achieve your healthiest, most balanced complexion."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "just in"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Ticker animation duration",
      "default": 32
    },
    {
      "type": "range",
      "id": "icon_speed",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Icon rotation duration",
      "default": 10
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f1f0ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#67645e"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#67645e"
    },
    {
      "type": "range",
      "id": "section_margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section margin (top/bottom)",
      "default": 60
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Scrolling Hero"
    }
  ],
  "enabled_on": {
    "templates": ["*"]
  }
}
{% endschema %}
