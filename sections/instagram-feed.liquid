<section
  class="ig-feed-v2 color-{{ section.id }}"
  style="
    --ig-bg: {{ section.settings.bg_color }};
    --ig-card-bg: {{ section.settings.card_bg_color }};
    --ig-heading: {{ section.settings.heading_color }};
    --ig-text: {{ section.settings.text_color }};
    --ig-muted: {{ section.settings.meta_color }};
    --ig-button: {{ section.settings.handle_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ig-feed-v2__inner page-width">
    <div class="ig-feed-v2__intro">
      <div class="ig-feed-v2__eyebrow">
        <span class="ig-feed-v2__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="igGradient-{{ section.id }}" x1="3" y1="21" x2="21" y2="3" gradientUnits="userSpaceOnUse">
                <stop stop-color="#F58529"/>
                <stop offset="0.35" stop-color="#FEDA77"/>
                <stop offset="0.6" stop-color="#DD2A7B"/>
                <stop offset="0.82" stop-color="#8134AF"/>
                <stop offset="1" stop-color="#515BD4"/>
              </linearGradient>
            </defs>
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="url(#igGradient-{{ section.id }})" stroke-width="2"/>
            <circle cx="12" cy="12" r="4.2" stroke="url(#igGradient-{{ section.id }})" stroke-width="2"/>
            <circle cx="17.2" cy="6.8" r="1.2" fill="url(#igGradient-{{ section.id }})"/>
          </svg>
        </span>
        <span>{{ section.settings.eyebrow }}</span>
      </div>

      <h2 class="ig-feed-v2__heading">
        {{ section.settings.heading | split: 'Instagram' | first -}}
        <em>Instagram</em>
        {%- assign after_heading = section.settings.heading | split: 'Instagram' | last -%}
        {%- if after_heading != blank %}{{ after_heading }}{% endif %}
      </h2>

      {%- if section.settings.subtext != blank -%}
        <div class="ig-feed-v2__subtext rte">
          <p>{{ section.settings.subtext }}</p>
        </div>
      {%- endif -%}

      <div class="ig-feed-v2__actions">
        {%- if section.settings.instagram_handle != blank -%}
          <a
            class="ig-feed-v2__button"
            href="{{ section.settings.instagram_url | default: '#' }}"
            {% if section.settings.instagram_url != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <span class="ig-feed-v2__button-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="17" cy="7" r="1.1" fill="currentColor"/>
              </svg>
            </span>
            <span>@{{ section.settings.instagram_handle }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="ig-feed-v2__cards-wrap">
      <div class="ig-feed-v2__cards" role="list">
        {%- for block in section.blocks -%}
          <article class="ig-post-card" {{ block.shopify_attributes }} role="listitem">
            <div class="ig-post-card__top">
              <div class="ig-post-card__profile">
                <span class="ig-post-card__avatar">
                  {%- if section.settings.brand_avatar != blank -%}
                    <img
                      src="{{ section.settings.brand_avatar | image_url: width: 72 }}"
                      alt="{{ section.settings.instagram_handle | default: shop.name | escape }}"
                      width="36"
                      height="36"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="ig-post-card__avatar-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
                        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
                        <circle cx="17" cy="7" r="1.1" fill="currentColor"/>
                      </svg>
                    </span>
                  {%- endif -%}
                </span>
                <div class="ig-post-card__account">
                  <strong>{{ section.settings.instagram_handle | prepend: '@' }}</strong>
                  {%- if block.settings.location != blank -%}
                    <span>{{ block.settings.location }}</span>
                  {%- endif -%}
                </div>
              </div>
              <span class="ig-post-card__menu" aria-hidden="true">•••</span>
            </div>

            <div class="ig-post-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.alt | default: block.settings.caption | escape }}"
                  width="450"
                  height="450"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'ig-post-card__placeholder' }}
              {%- endif -%}
            </div>

            <div class="ig-post-card__body">
              <div class="ig-post-card__meta-row">
                <div class="ig-post-card__icons" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.62 20.55 12 21.13l-.62-.58C5.4 15.05 2 11.96 2 8.16 2 5.07 4.42 3 7.3 3c1.63 0 3.2.76 4.2 1.95C12.5 3.76 14.07 3 15.7 3 18.58 3 21 5.07 21 8.16c0 3.8-3.4 6.89-9.38 12.39Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22 3 11 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 3 15 21l-4-7-7-4 18-7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <span class="ig-post-card__save" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>

              {%- if block.settings.caption != blank -%}
                <p class="ig-post-card__caption">
                  <strong>@{{ section.settings.instagram_handle }}</strong>
                  <span>{{ block.settings.caption }}</span>
                </p>
              {%- endif -%}

              <div class="ig-post-card__details">
                {%- if block.settings.date != blank -%}
                  <span>{{ block.settings.date }}</span>
                {%- endif -%}
                {%- if block.settings.location != blank and block.settings.date != blank -%}
                  <span>•</span>
                {%- endif -%}
                {%- if block.settings.location != blank -%}
                  <span>{{ block.settings.location }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .ig-feed-v2 {
    background: var(--ig-bg);
    overflow: hidden;
  }

  .ig-feed-v2 .page-width {
    max-width: 1320px;
    margin: 0 auto;
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    padding-right: clamp(1.25rem, 3vw, 2.5rem);
  }

  .ig-feed-v2__inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.6fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .ig-feed-v2__intro {
    position: sticky;
    top: 2rem;
  }

  .ig-feed-v2__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--ig-muted);
    margin-bottom: 0.9rem;
    letter-spacing: 0.01em;
  }

  .ig-feed-v2__icon,
  .ig-feed-v2__button-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ig-feed-v2__icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .ig-feed-v2__heading {
    margin: 0;
    color: var(--ig-heading);
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 600;
    max-width: 12ch;
  }

  .ig-feed-v2__heading em {
    font-style: italic;
    font-weight: 700;
  }

  .ig-feed-v2__subtext {
    margin-top: 1rem;
    max-width: 35ch;
    color: var(--ig-text);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .ig-feed-v2__actions {
    margin-top: 1.35rem;
  }

  .ig-feed-v2__button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 46px;
    padding: 0.7rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--ig-button) 28%, transparent);
    border-radius: 999px;
    background: #fff;
    color: var(--ig-button);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(17, 24, 39, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ig-feed-v2__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 35px rgba(17, 24, 39, 0.1);
  }

  .ig-feed-v2__button-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .ig-feed-v2__cards-wrap {
    min-width: 0;
  }

  .ig-feed-v2__cards {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  .ig-post-card {
    min-width: 0;
    background: var(--ig-card-bg);
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 1.45rem;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(17, 24, 39, 0.08);
  }

  .ig-post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.85rem;
  }

  .ig-post-card__profile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .ig-post-card__avatar {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f58529 0%, #dd2a7b 55%, #8134af 100%);
    color: #fff;
    flex: 0 0 auto;
    padding: 2px;
  }

  .ig-post-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px;
    background: #fff;
  }

  .ig-post-card__avatar-icon {
    width: 100%;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 999px;
    color: #c13584;
  }

  .ig-post-card__avatar-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .ig-post-card__account {
    min-width: 0;
    display: grid;
    gap: 0.1rem;
  }

  .ig-post-card__account strong,
  .ig-post-card__caption strong {
    color: var(--ig-heading);
    font-size: 0.92rem;
    line-height: 1.25;
  }

  .ig-post-card__account span,
  .ig-post-card__details,
  .ig-post-card__menu {
    color: var(--ig-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .ig-post-card__media {
    aspect-ratio: 1 / 1;
    background: #ececec;
    overflow: hidden;
  }

  .ig-post-card__media img,
  .ig-post-card__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ig-post-card__body {
    padding: 0.95rem 1rem 1.05rem;
  }

  .ig-post-card__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ig-heading);
  }

  .ig-post-card__icons {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .ig-post-card__icons svg,
  .ig-post-card__save svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .ig-post-card__caption {
    margin: 0.75rem 0 0;
    color: var(--ig-text);
    font-size: 0.9rem;
    line-height: 1.55;
    display: grid;
    gap: 0.25rem;
  }

  .ig-post-card__caption span {
    display: inline;
  }

  .ig-post-card__details {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media screen and (max-width: 989px) {
    .ig-feed-v2__inner {
      grid-template-columns: 1fr;
    }

    .ig-feed-v2__intro {
      position: static;
      max-width: 100%;
    }

    .ig-feed-v2__heading {
      max-width: 100%;
    }

    .ig-feed-v2__cards {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: 0.4rem;
      margin-right: -1rem;
      padding-right: 1rem;
      scrollbar-width: none;
    }

    .ig-feed-v2__cards::-webkit-scrollbar {
      display: none;
    }

    .ig-post-card {
      flex: 0 0 min(82vw, 360px);
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    .ig-feed-v2__heading {
      font-size: clamp(1.6rem, 8vw, 2.2rem);
    }

    .ig-feed-v2__subtext {
      font-size: 0.92rem;
    }

    .ig-post-card {
      flex-basis: min(86vw, 320px);
      border-radius: 1.2rem;
    }

    .ig-post-card__top,
    .ig-post-card__body {
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }
  }
</style>

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section-instagram-feed",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Instagram updates"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow us on Instagram"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Dagelijkse design inspiratie. Volg ons op Instagram en mis niets."
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram handle (zonder @)",
      "default": "namingthislater"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profiel URL"
    },
    {
      "type": "image_picker",
      "id": "brand_avatar",
      "label": "Profielafbeelding"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Aantal columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur sectie",
      "default": "#eef0f8"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card achtergrond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading kleur",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta kleur (datum, locatie)",
      "default": "#7a7a7a"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Button kleur",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding boven",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding onder",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt tekst"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Bericht (caption)",
          "default": "Nieuwe post caption hier."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Datum",
          "default": "12 APR 2026"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Locatie",
          "default": "Amsterdam, NL"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}