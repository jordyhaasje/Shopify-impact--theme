{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --hero-bg: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --hero-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --accent: #00B67A;
  }

  .hero-32-wrapper {
    background: rgb(var(--hero-bg));
    color: rgb(var(--hero-text));
    padding: 80px 0;
    overflow: hidden;
  }

  .hero-32-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 80px;
  }

  .hero-32-image img {
    width: 100%;
    height: auto;
    border-radius: 24px;
    display: block;
  }

  .hero-32-content {
    max-width: 600px;
  }

  .hero-32-rating {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 24px;
  }

  .hero-32-rating-stars {
    color: var(--accent);
    letter-spacing: 2px;
  }

  .hero-32-title {
    font-size: 64px;
    line-height: 1;
    font-weight: 700;
    margin-bottom: 32px;
  }

  .hero-32-features {
    list-style: none;
    padding: 0;
    margin-bottom: 40px;
  }

  .hero-32-feature {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 20px;
    margin-bottom: 16px;
  }

  .hero-32-icon {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 990px) {
    .hero-32-container { grid-template-columns: 1fr; gap: 40px; }
    .hero-32-title { font-size: 40px; }
  }
</style>

<section class="hero-32-wrapper">
  <div class="hero-32-container">
    <div class="hero-32-image">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="hero-32-content">
      <div class="hero-32-rating">
        <span class="hero-32-rating-stars">★★★★★</span> 4.6 Excellent
      </div>
      <h1 class="hero-32-title">
        Achieve visibly<br>
        radiant<br>
        transformed skin
      </h1>
      
      <ul class="hero-32-features">
        {%- for block in section.blocks -%}
          <li class="hero-32-feature" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="hero-32-icon">
                {{ block.settings.icon | image_url: width: 48 | image_tag: width: 24, height: 24 }}
              </div>
            {%- endif -%}
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank -%}
        {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'xl' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero 32 Replica",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "LEARN MORE"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "color", "id": "background", "label": "Background", "default": "#E8E8E8"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#121212"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type": "image_picker", "id": "icon", "label": "Icon"},
        {"type": "text", "id": "text", "label": "Feature text"}
      ]
    }
  ],
  "presets": [{"name": "Hero 32 Replica"}]
}
{% endschema %}
