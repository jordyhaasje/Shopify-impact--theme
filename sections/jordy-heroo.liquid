{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }}{--jh-overlay:{{ section.settings.overlay_color.rgb }}/{{ section.settings.overlay_opacity | divided_by: 100.0 }};--jh-text:{{ section.settings.text_color.rgb }};--jh-star-bg:{{ section.settings.star_background.rgb }};--jh-star-color:{{ section.settings.star_color.rgb }};--jh-button-bg:{{ section.settings.button_background.rgb }};--jh-button-text:{{ section.settings.button_text_color.rgb }};--jh-logo-color:{{ section.settings.logo_color.rgb }};--jh-min-height:{{ section.settings.hero_height }}px;--jh-mobile-min-height:{{ section.settings.mobile_hero_height }}px}
  #shopify-section-{{ section.id }} .jordy-heroo{position:relative;width:100%;min-height:var(--jh-min-height);overflow:hidden;isolation:isolate;background:#111;color:rgb(var(--jh-text))}
  #shopify-section-{{ section.id }} .jordy-heroo__media,#shopify-section-{{ section.id }} .jordy-heroo__media:after{position:absolute;inset:0}#shopify-section-{{ section.id }} .jordy-heroo__media{z-index:-2}#shopify-section-{{ section.id }} .jordy-heroo__media:after{content:"";z-index:1;background:linear-gradient(90deg,rgb(0 0 0/.52) 0%,rgb(0 0 0/.34) 48%,rgb(0 0 0/.22) 100%),rgb(var(--jh-overlay))}
  #shopify-section-{{ section.id }} .jordy-heroo__media img,#shopify-section-{{ section.id }} .jordy-heroo__placeholder svg{width:100%;height:100%;display:block;object-fit:cover}#shopify-section-{{ section.id }} .jordy-heroo__placeholder{width:100%;height:100%;background:linear-gradient(135deg,#303936,#141414)}
  #shopify-section-{{ section.id }} .jordy-heroo__bounded-shell{position:relative;z-index:2;width:min({{ section.settings.content_width }}px,calc(100vw - 48px));max-width:{{ section.settings.content_width }}px;min-height:calc(var(--jh-min-height) - {{ section.settings.marquee_height }}px);margin-inline:auto;display:flex;align-items:center;justify-content:space-between;gap:32px;padding-block:{{ section.settings.content_padding_top }}px {{ section.settings.content_padding_bottom }}px;padding-inline:0}
  #shopify-section-{{ section.id }} .jordy-heroo__content{width:min(100%,{{ section.settings.text_max_width }}px);transform:translateY({{ section.settings.content_offset_y }}px)}
  #shopify-section-{{ section.id }} .jordy-heroo__badge{display:flex;align-items:center;gap:8px;margin-bottom:14px;color:rgb(var(--jh-text));font:800 13px/1.25 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-shadow:0 1px 12px rgb(0 0 0/.45)}
  #shopify-section-{{ section.id }} .jordy-heroo__stars{display:inline-flex;align-items:center;gap:2px;flex:0 0 auto}#shopify-section-{{ section.id }} .jordy-heroo__star{width:13px;height:13px;display:grid;place-items:center;border-radius:1px;background:rgb(var(--jh-star-bg));color:rgb(var(--jh-star-color));font-size:8px;line-height:1;box-shadow:0 0 0 1px rgb(255 255 255/.12) inset}
  #shopify-section-{{ section.id }} .jordy-heroo__heading{margin:0;max-width:680px;color:rgb(var(--jh-text));font:850 clamp(34px,5vw,{{ section.settings.heading_size }}px)/.98 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.045em;text-shadow:0 2px 18px rgb(0 0 0/.45)}
  #shopify-section-{{ section.id }} .jordy-heroo__text{margin-top:12px;max-width:660px;color:rgb(var(--jh-text));font:760 clamp(14px,1.5vw,{{ section.settings.text_size }}px)/1.38 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-shadow:0 2px 16px rgb(0 0 0/.45)}#shopify-section-{{ section.id }} .jordy-heroo__text p{margin:0}
  #shopify-section-{{ section.id }} .jordy-heroo__button{display:inline-flex;align-items:center;justify-content:center;margin-top:22px;min-height:42px;padding:11px 25px;border:0;border-radius:{{ section.settings.button_radius }}px;background:rgb(var(--jh-button-bg));color:rgb(var(--jh-button-text));font:850 14px/1 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-decoration:none;box-shadow:0 12px 26px rgb(0 0 0/.16)}
  #shopify-section-{{ section.id }} .jordy-heroo__nav{display:flex;gap:8px;align-items:center}.jordy-heroo__nav-button{width:42px;height:42px;display:grid;place-items:center;border:0;background:transparent;color:rgb(var(--jh-text));opacity:.9;filter:drop-shadow(0 2px 8px rgb(0 0 0/.45));cursor:pointer}.jordy-heroo__nav-button svg{width:27px;height:27px}
  #shopify-section-{{ section.id }} .jordy-heroo__marquee{position:absolute;z-index:3;left:0;right:0;bottom:0;height:{{ section.settings.marquee_height }}px;display:flex;align-items:center;overflow:hidden;color:rgb(var(--jh-logo-color));background:linear-gradient(180deg,rgb(0 0 0/0) 0%,rgb(0 0 0/.18) 100%);-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 7%,#000 93%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 7%,#000 93%,transparent 100%)}
  #shopify-section-{{ section.id }} .jordy-heroo__marquee-track{display:flex;align-items:center;width:max-content;min-width:100%;gap:{{ section.settings.logo_gap }}px;animation:jordy-heroo-marquee-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite;will-change:transform}
  #shopify-section-{{ section.id }} .jordy-heroo__logo-item{flex:0 0 auto;min-width:max-content;display:inline-flex;align-items:center;justify-content:center;color:rgb(var(--jh-logo-color));opacity:{{ section.settings.logo_opacity | divided_by: 100.0 }};font-family:Georgia,"Times New Roman",serif;font-weight:800;font-size:clamp(24px,3vw,{{ section.settings.logo_text_size }}px);line-height:1;letter-spacing:-.08em;text-shadow:0 2px 15px rgb(0 0 0/.45);white-space:nowrap}
  #shopify-section-{{ section.id }} .jordy-heroo__logo-item img{display:block;width:auto;max-width:{{ section.settings.logo_image_width }}px;max-height:{{ section.settings.logo_image_height }}px;object-fit:contain;filter:brightness(0) invert(1) drop-shadow(0 2px 10px rgb(0 0 0/.35))}
  @keyframes jordy-heroo-marquee-{{ section.id }}{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media screen and (max-width:749px){#shopify-section-{{ section.id }} .jordy-heroo{min-height:var(--jh-mobile-min-height)}#shopify-section-{{ section.id }} .jordy-heroo__bounded-shell{width:min(100%,calc(100vw - 32px));min-height:calc(var(--jh-mobile-min-height) - {{ section.settings.mobile_marquee_height }}px);padding-block:{{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px}#shopify-section-{{ section.id }} .jordy-heroo__content{width:min(100%,430px);transform:translateY({{ section.settings.mobile_content_offset_y }}px)}#shopify-section-{{ section.id }} .jordy-heroo__badge{gap:7px;margin-bottom:12px;font-size:12px}#shopify-section-{{ section.id }} .jordy-heroo__star{width:12px;height:12px;font-size:7px}#shopify-section-{{ section.id }} .jordy-heroo__heading{font-size:clamp(31px,9vw,43px)}#shopify-section-{{ section.id }} .jordy-heroo__text{font-size:14px}#shopify-section-{{ section.id }} .jordy-heroo__button{min-height:40px;padding:10px 20px}#shopify-section-{{ section.id }} .jordy-heroo__nav{position:absolute;right:6px;top:50%;transform:translateY(-50%)}#shopify-section-{{ section.id }} .jordy-heroo__nav-button{width:34px;height:34px}#shopify-section-{{ section.id }} .jordy-heroo__marquee{height:{{ section.settings.mobile_marquee_height }}px}#shopify-section-{{ section.id }} .jordy-heroo__marquee-track{gap:{{ section.settings.mobile_logo_gap }}px}#shopify-section-{{ section.id }} .jordy-heroo__logo-item{font-size:clamp(20px,8vw,31px)}}
  @media (prefers-reduced-motion:reduce){#shopify-section-{{ section.id }} .jordy-heroo__marquee-track{animation:none;transform:none}}
</style>

<section class="jordy-heroo" aria-label="{{ section.settings.heading | escape }}">
  <div class="jordy-heroo__media">{%- if section.settings.image != blank -%}{{- section.settings.image | image_url: width: 3200 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,800,1000,1200,1400,1600,1800,2200,2600,3200', alt: section.settings.image.alt | default: section.settings.heading -}}{%- else -%}<div class="jordy-heroo__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' | replace: '<svg','<svg preserveAspectRatio="xMidYMid slice"' }}</div>{%- endif -%}</div>
  <div class="page-width container jordy-heroo__bounded-shell">
    <div class="jordy-heroo__content">
      {%- if section.settings.rating_text != blank -%}<div class="jordy-heroo__badge"><span class="jordy-heroo__stars" aria-label="{{ section.settings.star_count }} stars">{%- for i in (1..5) -%}{%- if i <= section.settings.star_count -%}<span class="jordy-heroo__star">★</span>{%- endif -%}{%- endfor -%}</span><span>{{ section.settings.rating_text | escape }}</span></div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="jordy-heroo__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="jordy-heroo__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_text != blank -%}<a class="jordy-heroo__button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text | escape }}</a>{%- endif -%}
    </div>
    {%- if section.settings.show_arrow -%}<div class="jordy-heroo__nav" aria-label="Hero controls"><button class="jordy-heroo__nav-button" type="button" data-jordy-hero-next data-url="{{ section.settings.arrow_link | default: section.settings.button_link | default: '#' }}" aria-label="{{ section.settings.arrow_label | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div>{%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}<div class="jordy-heroo__marquee" aria-label="{{ section.settings.marquee_label | escape }}"><div class="jordy-heroo__marquee-track" data-jordy-marquee-track>{%- for block in section.blocks -%}<div class="jordy-heroo__logo-item" {{ block.shopify_attributes }}>{%- if block.settings.logo != blank -%}{{- block.settings.logo | image_url: width: 420 | image_tag: loading: 'lazy', widths: '120,180,240,320,420', sizes: '220px', alt: block.settings.logo_text -}}{%- elsif block.settings.logo_text != blank -%}{{- block.settings.logo_text | escape -}}{%- endif -%}</div>{%- endfor -%}</div></div>{%- endif -%}
</section>

<script>(()=>{const initJordyHero=(root=document)=>{root.querySelectorAll('#shopify-section-{{ section.id }} [data-jordy-marquee-track]').forEach(track=>{if(track.dataset.cloned==='true')return;Array.from(track.children).forEach(item=>track.appendChild(item.cloneNode(true)));track.dataset.cloned='true'});root.querySelectorAll('#shopify-section-{{ section.id }} [data-jordy-hero-next]').forEach(button=>{if(button.dataset.bound==='true')return;button.addEventListener('click',()=>{const url=button.dataset.url;if(url&&url!=='#')window.location.href=url});button.dataset.bound='true'})};initJordyHero();document.addEventListener('shopify:section:load',event=>initJordyHero(event.target));document.addEventListener('shopify:section:select',event=>initJordyHero(event.target))})();</script>

