{%- comment -%}
  JSections - Footer #3
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-footer-3.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo_alt = section.settings.logo_alt | default: section.settings.brand_text
  assign logo_image = section.settings.logo_image
  assign logo_image_mobile = section.settings.logo_image_mobile
  assign preset = section.settings.style_preset

  if logo_image_mobile == blank
    assign logo_image_mobile = logo_image
  endif
-%}

<footer
  class="jfooter3 jfooter3--{{ preset }}{% if section.settings.use_preset_colors %} jfooter3--preset-colors{% endif %}"
  style="
    --jfooter3-bg: {{ section.settings.background_color }};
    --jfooter3-text: {{ section.settings.text_color }};
    --jfooter3-muted: {{ section.settings.muted_color }};
    --jfooter3-border: {{ section.settings.border_color }};
    --jfooter3-input-bg: {{ section.settings.input_background }};
    --jfooter3-button-bg: {{ section.settings.button_background }};
    --jfooter3-button-text: {{ section.settings.button_text_color }};
    --jfooter3-button-hover-bg: {{ section.settings.button_hover_background }};
    --jfooter3-button-hover-text: {{ section.settings.button_hover_text_color }};
    --jfooter3-max-width: {{ section.settings.max_width }}px;
    --jfooter3-padding-top: {{ section.settings.padding_top }}px;
    --jfooter3-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jfooter3-logo-width: {{ section.settings.logo_width }}px;
    --jfooter3-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
  "
  data-jfooter3-section="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="jfooter3__inner">
    <div class="jfooter3__top">
      <div class="jfooter3__column jfooter3__column--logo">
        <a class="jfooter3__logo" href="{{ section.settings.logo_link | default: routes.root_url }}" aria-label="{{ logo_alt | escape }}">
          {%- if logo_image != blank -%}
            <picture class="jfooter3__logo-picture">
              {%- if section.settings.logo_image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ logo_image_mobile | image_url: width: 520 }}">
              {%- endif -%}
              {{
                logo_image
                | image_url: width: 520
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 160px, 130px',
                  alt: logo_alt,
                  class: 'jfooter3__logo-image'
              }}
            </picture>
          {%- else -%}
            <span class="jfooter3__mark" aria-hidden="true">{{ section.settings.logo_mark }}</span>
          {%- endif -%}
        </a>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu_column' -%}
            <nav class="jfooter3__column jfooter3__column--menu" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="jfooter3__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="jfooter3__list" role="list">
                {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- for index in (1..8) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: index
                      assign link_key = 'link_' | append: index
                      assign label = block.settings[label_key]
                      assign link = block.settings[link_key]
                    -%}
                    {%- if label != blank -%}
                      {%- if link != blank -%}
                        <li><a href="{{ link }}">{{ label }}</a></li>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </nav>

          {%- when 'social_column' -%}
            <div class="jfooter3__column jfooter3__column--social" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="jfooter3__social-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="jfooter3__socials" role="list">
                {%- for index in (1..5) -%}
                  {%- liquid
                    assign label_key = 'label_' | append: index
                    assign link_key = 'link_' | append: index
                    assign label = block.settings[label_key]
                    assign link = block.settings[link_key]
                    assign short_label = label | slice: 0, 2
                    assign normalized_label = label | downcase
                  -%}
                  {%- if label != blank and link != blank -%}
                    <li>
                      <a href="{{ link }}" aria-label="{{ label | escape }}">
                        <span class="jfooter3__social-icon" aria-hidden="true">
                          {%- case normalized_label -%}
                            {%- when 'x', 'twitter' -%}
                              <svg viewBox="0 0 24 24" focusable="false"><path d="M13.9 10.5 21.3 2h-1.8l-6.4 7.4L8 2H2l7.8 11.3L2 22h1.8l6.8-7.8L16 22h6l-8.1-11.5Zm-2.4 2.8-.8-1.1L4.4 3.3h2.8l5 7.1.8 1.1 6.6 9.4h-2.8l-5.3-7.6Z"/></svg>
                            {%- when 'linkedin', 'linked in' -%}
                              <svg viewBox="0 0 24 24" focusable="false"><path d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.34 8h4.32v14H.34V8Zm7.12 0h4.14v1.92h.06c.58-1.1 1.98-2.26 4.08-2.26 4.36 0 5.16 2.86 5.16 6.58V22h-4.32v-6.88c0-1.64-.02-3.76-2.28-3.76-2.3 0-2.64 1.8-2.64 3.66V22H7.46V8Z"/></svg>
                            {%- when 'instagram' -%}
                              <svg viewBox="0 0 24 24" focusable="false"><path d="M12 0C8.74 0 8.33.02 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.39C1.35 2.68.94 3.35.63 4.14.33 4.9.13 5.78.07 7.05.02 8.33 0 8.74 0 12s.02 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13.66.66 1.34 1.08 2.13 1.38.76.3 1.63.5 2.91.56 1.28.05 1.69.07 4.95.07s3.67-.02 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.08-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.05-1.28.07-1.69.07-4.95s-.02-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.63-.5-2.91-.56C15.67.02 15.26 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.81.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.81-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.81-.25-2.23-.41a3.71 3.71 0 0 1-1.38-.9 3.71 3.71 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.81.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"/></svg>
                            {%- when 'youtube', 'you tube' -%}
                              <svg viewBox="0 0 24 24" focusable="false"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5v-7l6.2 3.5-6.2 3.5Z"/></svg>
                            {%- when 'pinterest' -%}
                              <svg viewBox="0 0 24 24" focusable="false"><path d="M12 0C5.38 0 0 5.38 0 12c0 5.08 3.16 9.42 7.62 11.16-.1-.94-.2-2.4.04-3.44.22-.94 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.66.96-2.9 2.16-2.9 1.02 0 1.52.76 1.52 1.68 0 1.02-.66 2.56-1 3.98-.28 1.18.6 2.14 1.76 2.14 2.1 0 3.72-2.22 3.72-5.42 0-2.84-2.04-4.82-4.96-4.82-3.38 0-5.36 2.54-5.36 5.16 0 1.02.4 2.12.9 2.72.1.12.12.22.08.36-.1.4-.3 1.18-.34 1.34-.06.22-.18.26-.42.16-1.56-.72-2.54-3-2.54-4.84 0-3.94 2.86-7.56 8.26-7.56 4.34 0 7.72 3.1 7.72 7.24 0 4.32-2.72 7.8-6.5 7.8-1.26 0-2.46-.66-2.86-1.44l-.78 2.96c-.28 1.08-1.04 2.44-1.56 3.26 1.18.36 2.44.56 3.76.56 6.62 0 12-5.38 12-12S18.62 0 12 0Z"/></svg>
                            {%- else -%}
                              <span>{{ short_label }}</span>
                          {%- endcase -%}
                        </span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="jfooter3__bottom">
      <div class="jfooter3__legal">
        {%- if section.settings.legal_text != blank -%}
          <div class="jfooter3__legal-links">{{ section.settings.legal_text }}</div>
        {%- endif -%}
        {%- if section.settings.copyright_text != blank -%}
          <div class="jfooter3__copyright">{{ section.settings.copyright_text }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_newsletter -%}
        <div class="jfooter3__newsletter">
          {%- form 'customer', class: 'jfooter3__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="jfooter3__visually-hidden" for="JFooter3Email-{{ section.id }}">
              {{ section.settings.newsletter_label }}
            </label>
            <div class="jfooter3__newsletter-row">
              <input
                id="JFooter3Email-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="jfooter3__input"
                value="{{ form.email }}"
                aria-required="true"
                aria-label="{{ section.settings.newsletter_label | escape }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                required
              >
              <button type="submit" class="jfooter3__button" name="commit">
                {{ section.settings.newsletter_button }}
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="jfooter3__success">{{ section.settings.newsletter_success }}</p>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="jfooter3__errors">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

