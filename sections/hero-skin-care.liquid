{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --hero-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --hero-text-color: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
  }

  .hero-skin {
    background: rgb(var(--hero-background));
    color: rgb(var(--hero-text-color));
    padding: 60px 0;
  }

  .hero-skin__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .hero-skin__image { flex: 1; min-width: 300px; }
  .hero-skin__image img { width: 100%; height: auto; border-radius: 20px; }
  .hero-skin__content { flex: 1; min-width: 300px; }

  .hero-skin__rating { font-weight: 600; margin-bottom: 16px; }
  .hero-skin__heading { font-size: 48px; line-height: 1.1; margin: 0 0 24px; }
  .hero-skin__features { list-style: none; padding: 0; margin: 0 0 32px; }
  .hero-skin__feature { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; font-size: 18px; }
</style>

<section class="hero-skin">
  <div class="hero-skin__container">
    <div class="hero-skin__image">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
      {%- endif -%}
    </div>

    <div class="hero-skin__content">
      <div class="hero-skin__rating">★★★★★ 4.6 Excellent</div>
      <h2 class="hero-skin__heading">{{ section.settings.heading }}</h2>
      
      <ul class="hero-skin__features">
        {%- for block in section.blocks -%}
          <li class="hero-skin__feature" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 24 | image_tag: width: 24, height: 24 }}
            {%- endif -%}
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank -%}
        {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'lg' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Skin Care",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Achieve visibly radiant transformed skin"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "LEARN MORE"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "color", "id": "background", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#000000"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type": "image_picker", "id": "icon", "label": "Icon"},
        {"type": "text", "id": "text", "label": "Feature text"}
      ]
    }
  ],
  "presets": [{"name": "Hero Skin Care"}]
}
{% endschema %}
