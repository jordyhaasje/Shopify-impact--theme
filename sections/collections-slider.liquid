{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --collections-slider-bg: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --collections-slider-heading-color: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --collections-slider-card-radius: {{ section.settings.card_radius }}px;
    --collections-slider-card-gap: {{ section.settings.card_gap }}px;
    --collections-slider-label-color: {{ section.settings.label_color.red }}, {{ section.settings.label_color.green }}, {{ section.settings.label_color.blue }};
    --collections-slider-card-min-height: {{ section.settings.card_min_height }}px;
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .collections-slider {
    background: rgb(var(--collections-slider-bg));
  }

  #shopify-section-{{ section.id }} .collections-slider__inner {
    display: grid;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .collections-slider__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .collections-slider__heading {
    color: rgb(var(--collections-slider-heading-color));
    font-size: clamp(26px, 3.5vw, 40px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .collections-slider__heading .accent {
    font-style: italic;
    font-weight: 400;
    font-family: Georgia, 'Times New Roman', serif;
  }

  #shopify-section-{{ section.id }} .collections-slider__nav {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .collections-slider__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(var(--collections-slider-heading-color), 0.2);
    background: transparent;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    color: rgb(var(--collections-slider-heading-color));
  }

  #shopify-section-{{ section.id }} .collections-slider__nav-btn:hover {
    background: rgba(var(--collections-slider-heading-color), 0.07);
    border-color: rgba(var(--collections-slider-heading-color), 0.35);
  }

  #shopify-section-{{ section.id }} .collections-slider__nav-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .collections-slider__nav-btn svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  #shopify-section-{{ section.id }} .collections-slider__track-wrapper {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .collections-slider__track {
    display: flex;
    gap: var(--collections-slider-card-gap);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .collections-slider__card {
    flex: 0 0 calc((100% - var(--collections-slider-card-gap) * ({{ section.settings.cards_visible }} - 1)) / {{ section.settings.cards_visible }});
    min-width: 0;
    border-radius: var(--collections-slider-card-radius);
    overflow: hidden;
    position: relative;
    text-decoration: none;
    display: block;
    min-height: var(--collections-slider-card-min-height);
    background: #ccc;
  }

  #shopify-section-{{ section.id }} .collections-slider__card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .collections-slider__card:hover .collections-slider__card-image {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .collections-slider__card-label {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    font-size: 16px;
    font-weight: 700;
    color: rgb(var(--collections-slider-label-color));
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-shadow: 0 1px 4px rgba(0,0,0,0.18);
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .collections-slider__card {
      flex-basis: calc((100% - var(--collections-slider-card-gap) * ({{ section.settings.cards_visible_mobile }} - 1)) / {{ section.settings.cards_visible_mobile }});
      min-height: calc(var(--collections-slider-card-min-height) * 0.85);
    }

    #shopify-section-{{ section.id }} .collections-slider__heading {
      font-size: clamp(22px, 6.5vw, 32px);
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .collections-slider__card {
      flex-basis: calc((100% - var(--collections-slider-card-gap) * ({{ section.settings.cards_visible }} - 1)) / {{ section.settings.cards_visible }});
    }
  }
</style>

<section class="collections-slider">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">
      <div class="collections-slider__inner">

        <div class="collections-slider__header">
          <h2 class="collections-slider__heading">
            {{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <span class="accent">{{ section.settings.heading_accent | escape }}</span>{% endif %}
          </h2>

          <nav class="collections-slider__nav" aria-label="Collections navigation">
            <button
              class="collections-slider__nav-btn"
              data-collections-prev="{{ section.id }}"
              aria-label="Previous"
              disabled
            >
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              class="collections-slider__nav-btn"
              data-collections-next="{{ section.id }}"
              aria-label="Next"
            >
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </nav>
        </div>

        <div class="collections-slider__track-wrapper" data-collections-slider="{{ section.id }}">
          <div class="collections-slider__track" data-collections-track="{{ section.id }}">
            {%- for block in section.blocks -%}
              {%- assign collection = collections[block.settings.collection] -%}
              {%- assign card_href = '#' -%}
              {%- if collection != blank -%}
                {%- assign card_href = collection.url -%}
              {%- endif -%}
              {%- if block.settings.custom_link != blank -%}
                {%- assign card_href = block.settings.custom_link -%}
              {%- endif -%}

              <a
                href="{{ card_href }}"
                class="collections-slider__card"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    class: 'collections-slider__card-image',
                    alt: block.settings.label
                  }}
                {%- elsif collection != blank and collection.featured_image != blank -%}
                  {{ collection.featured_image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    class: 'collections-slider__card-image',
                    alt: block.settings.label | default: collection.title
                  }}
                {%- endif -%}

                <span class="collections-slider__card-label">
                  {{- block.settings.label | default: collection.title | escape -}}
                </span>
              </a>
            {%- endfor -%}
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var sectionId = {{ section.id | json }};
  var cardsVisible = {{ section.settings.cards_visible }};
  var cardsVisibleMobile = {{ section.settings.cards_visible_mobile }};

  function initCollectionsSlider() {
    var wrapper = document.querySelector('[data-collections-slider="' + sectionId + '"]');
    if (!wrapper) return;

    var track = document.querySelector('[data-collections-track="' + sectionId + '"]');
    var prevBtn = document.querySelector('[data-collections-prev="' + sectionId + '"]');
    var nextBtn = document.querySelector('[data-collections-next="' + sectionId + '"]');
    var cards = track ? track.querySelectorAll('.collections-slider__card') : [];
    var totalCards = cards.length;
    var currentIndex = 0;

    function getVisible() {
      return window.innerWidth < 700 ? cardsVisibleMobile : cardsVisible;
    }

    function getMaxIndex() {
      return Math.max(0, totalCards - getVisible());
    }

    function updateSlider() {
      if (!track || !cards.length) return;
      var gap = parseInt(getComputedStyle(track).gap) || 12;
      var cardWidth = cards[0].offsetWidth;
      var offset = currentIndex * (cardWidth + gap);
      track.style.transform = 'translateX(-' + offset + 'px)';
      if (prevBtn) prevBtn.disabled = currentIndex === 0;
      if (nextBtn) nextBtn.disabled = currentIndex >= getMaxIndex();
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        if (currentIndex > 0) { currentIndex--; updateSlider(); }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        if (currentIndex < getMaxIndex()) { currentIndex++; updateSlider(); }
      });
    }

    window.addEventListener('resize', updateSlider);
    updateSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCollectionsSlider);
  } else {
    initCollectionsSlider();
  }

  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      initCollectionsSlider();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Collections slider",
  "tag": "section",
  "class": "shopify-section--collections-slider",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Ontdek onze"},
    {"type":"text","id":"heading_accent","label":"Heading accent (italic)","default":"collecties"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"section_spacing","label":"Section spacing","min":0,"max":80,"step":4,"default":48},
    {"type":"range","id":"cards_visible","label":"Cards visible (desktop)","min":2,"max":6,"step":1,"default":4},
    {"type":"range","id":"cards_visible_mobile","label":"Cards visible (mobile)","min":1,"max":3,"step":1,"default":2},
    {"type":"range","id":"card_gap","label":"Gap between cards","min":4,"max":32,"step":2,"default":12},
    {"type":"range","id":"card_radius","label":"Card border radius","min":0,"max":32,"step":2,"default":16},
    {"type":"range","id":"card_min_height","label":"Card min height (px)","min":200,"max":700,"step":10,"default":540},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background","label":"Section background","default":"#EBEBEB"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#1A1A1A"},
    {"type":"color","id":"label_color","label":"Label text color","default":"#FFFFFF"}
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"image_picker","id":"image","label":"Custom image (overrides collection image)"},
        {"type":"text","id":"label","label":"Card label (overrides collection title)"},
        {"type":"url","id":"custom_link","label":"Custom link (overrides collection link)"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections slider",
      "blocks": [
        {"type":"collection_card","settings":{"label":"Easter sale"}},
        {"type":"collection_card","settings":{"label":"Toppers"}},
        {"type":"collection_card","settings":{"label":"Hoofdkussens"}},
        {"type":"collection_card","settings":{"label":"Matrassen"}}
      ]
    }
  ]
}
{% endschema %}
