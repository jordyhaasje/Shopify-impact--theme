{%- comment -%}
  JSections - Featured Collection #22
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-featured-collection-22.css' | asset_url | stylesheet_tag }}
{{ 'jsections-featured-collection-22-swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_dom_id = 'jfc22-' | append: section.id
-%}

<div
  id="{{ section_dom_id }}"
  class="jfc22{% if section.settings.enable_hover_reveal %} jfc22--hover-reveal{% endif %}{% if section.settings.enable_zoom_on_hover %} jfc22--zoom-hover{% endif %}{% if section.settings.enable_overlay %} jfc22--overlay-enabled{% endif %}{% if section.settings.enable_entrance_animation %} jfc22--animate-in{% endif %}"
  data-jfc22-section-id="{{ section.id }}"
  style="
    --jfc22-section-bg: {{ section.settings.section_background }};
    --jfc22-card-bg: {{ section.settings.slide_background }};
    --jfc22-content-bg: {{ section.settings.content_background }};
    --jfc22-text-color: {{ section.settings.text_color }};
    --jfc22-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --jfc22-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --jfc22-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --jfc22-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --jfc22-side-padding-mobile: {{ section.settings.side_padding_mobile }}px;
    --jfc22-side-padding-desktop: {{ section.settings.side_padding_desktop }}px;
    --jfc22-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --jfc22-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --jfc22-button-size-mobile: {{ section.settings.button_size_mobile }}px;
    --jfc22-button-size-desktop: {{ section.settings.button_size_desktop }}px;
    --jfc22-aspect-ratio: {{ section.settings.aspect_ratio_width }} / {{ section.settings.aspect_ratio_height }};
    --jfc22-overlay-opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
  "
  {{ section.shopify_attributes }}
>
  <div class="jfc22__inner">
    <div class="jfc22__top">
      {%- if section.settings.heading != blank -%}
        <div class="jfc22__heading">
          <h2>{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      {%- if section.settings.show_button and section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="jfc22__cta"
          aria-label="{{ section.settings.button_label | escape }}"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="jfc22__slider-wrapper">
      <div
        class="jfc22__slider preview swiper"
        data-jfc22-slider
        data-view-mobile="{{ section.settings.slides_per_view_mobile }}"
        data-view-tablet="{{ section.settings.slides_per_view_tablet }}"
        data-view-small-desktop="{{ section.settings.slides_per_view_small_desktop }}"
        data-view-desktop="{{ section.settings.slides_per_view_desktop }}"
      >
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_card' -%}
              {%- liquid
                assign product = block.settings.product
                assign product_link = '#'
                if product != blank
                  assign product_link = product.url
                endif

                assign product_image_1 = blank
                assign product_image_2 = blank
                assign product_image_3 = blank
                if product != blank
                  if product.selected_or_first_available_variant != blank and product.selected_or_first_available_variant.featured_image != blank
                    assign product_image_1 = product.selected_or_first_available_variant.featured_image
                  elsif product.featured_image != blank
                    assign product_image_1 = product.featured_image
                  endif

                  for image in product.images
                    if product_image_1 == blank
                      assign product_image_1 = image
                    elsif image.id != product_image_1.id
                      if product_image_2 == blank
                        assign product_image_2 = image
                      elsif image.id != product_image_2.id and product_image_3 == blank
                        assign product_image_3 = image
                      endif
                    endif

                    if product_image_1 != blank and product_image_2 != blank and product_image_3 != blank
                      break
                    endif
                  endfor
                endif

                assign image_1 = product_image_1
                assign image_2 = product_image_2
                assign image_3 = product_image_3
                assign loading_strategy = 'lazy'
                if forloop.index <= 2
                  assign loading_strategy = 'eager'
                endif

                assign has_gallery = false
                if image_2 != blank or image_3 != blank
                  assign has_gallery = true
                endif

                assign title_text = 'Select a product'
                if product != blank and product.title != blank
                  assign title_text = product.title
                endif

                assign details_text = blank
                if section.settings.show_product_type and product != blank and product.type != blank
                  assign details_text = product.type
                endif

                assign price_text = blank
                assign compare_price_text = blank
                if product != blank
                  assign selected_variant = product.selected_or_first_available_variant
                  if selected_variant != blank
                    assign price_text = selected_variant.price | money
                    if selected_variant.compare_at_price > selected_variant.price
                      assign compare_price_text = selected_variant.compare_at_price | money
                    endif
                  else
                    assign price_text = product.price | money
                    if product.compare_at_price_max > product.price
                      assign compare_price_text = product.compare_at_price_max | money
                    endif
                  endif
                endif
                assign alt_text = title_text
              -%}

              <div class="jfc22__slide swiper-slide" {{ block.shopify_attributes }}>
                <a href="{{ product_link }}" class="jfc22__image">
                  {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
                    <p class="jfc22__badge is-visible">{{ section.settings.badge_text }}</p>
                  {%- endif -%}
                  {%- if section.settings.enable_overlay -%}
                    <span class="jfc22__image-overlay" aria-hidden="true"></span>
                  {%- endif -%}

                  {%- if has_gallery -%}
                    <div class="jfc22__gallery swiper" data-jfc22-product-gallery>
                      <div class="swiper-wrapper">
                        {%- if image_1 != blank -%}
                          <div class="swiper-slide">
                            {{ image_1 | image_url: width: 960 | image_tag: loading: loading_strategy, alt: alt_text, width: 960, height: 1300 }}
                          </div>
                        {%- else -%}
                          <div class="swiper-slide">{{ 'product-1' | placeholder_svg_tag }}</div>
                        {%- endif -%}

                        {%- if image_2 != blank -%}
                          <div class="swiper-slide">
                            {{ image_2 | image_url: width: 960 | image_tag: loading: 'lazy', alt: alt_text, width: 960, height: 1300 }}
                          </div>
                        {%- endif -%}

                        {%- if image_3 != blank -%}
                          <div class="swiper-slide">
                            {{ image_3 | image_url: width: 960 | image_tag: loading: 'lazy', alt: alt_text, width: 960, height: 1300 }}
                          </div>
                        {%- endif -%}
                      </div>

                      <button class="jfc22__gallery-btn jfc22__gallery-btn--prev" aria-label="Previous image" type="button">
                        <span class="animate-icon"></span>
                      </button>
                      <button class="jfc22__gallery-btn jfc22__gallery-btn--next" aria-label="Next image" type="button">
                        <span class="animate-icon"></span>
                      </button>
                    </div>
                  {%- else -%}
                    {%- if image_1 != blank -%}
                      {{ image_1 | image_url: width: 960 | image_tag: loading: loading_strategy, alt: alt_text, width: 960, height: 1300 }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  {%- endif -%}
                </a>

                <div class="jfc22__content">
                  <div class="jfc22__left">
                    {%- if title_text != blank -%}
                      <h3 class="jfc22__title">{{ title_text }}</h3>
                    {%- endif -%}

                    {%- if details_text != blank -%}
                      <div class="jfc22__details">
                        <p>{{ details_text }}</p>
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="jfc22__price">
                    {%- if price_text != blank -%}
                      <p class="jfc22__price-main">{{ price_text }}</p>
                    {%- endif -%}
                    {%- if compare_price_text != blank -%}
                      <p class="jfc22__compare">{{ compare_price_text }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.show_navigation -%}
      <div class="jfc22__controls">
        <button class="jfc22__btn jfc22__btn--prev" aria-label="Previous slide" type="button">
          <span class="animate-icon"></span>
        </button>
        <button class="jfc22__btn jfc22__btn--next" aria-label="Next slide" type="button">
          <span class="animate-icon"></span>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'jsections-featured-collection-22-swiper-bundle.min.js' | asset_url }}" defer></script>

<script>
  (function() {
    const sectionId = "{{ section.id }}";
    const rootSelector = '[data-jfc22-section-id="' + sectionId + '"]';

    function destroy(root) {
      if (!root || !root.__jfc22Instance) return;

      const state = root.__jfc22Instance;
      if (state.main && typeof state.main.destroy === "function") {
        state.main.destroy(true, true);
      }

      if (Array.isArray(state.galleries)) {
        state.galleries.forEach(function(gallery) {
          if (gallery && typeof gallery.destroy === "function") {
            gallery.destroy(true, true);
          }
        });
      }

      if (state.entranceObserver && typeof state.entranceObserver.disconnect === "function") {
        state.entranceObserver.disconnect();
      }

      root.__jfc22Instance = null;
    }

    function setupEntranceAnimation(root) {
      const slides = root.querySelectorAll(".jfc22__slide");
      slides.forEach(function(slide, index) {
        slide.classList.remove("is-visible");
        slide.style.setProperty("--jfc22-enter-delay", Math.min(index, 10) * 0.06 + "s");
      });

      if (!root.classList.contains("jfc22--animate-in")) {
        slides.forEach(function(slide) {
          slide.classList.add("is-visible");
        });
        return null;
      }

      const revealSlides = function() {
        slides.forEach(function(slide) {
          slide.classList.add("is-visible");
        });
      };

      if (!("IntersectionObserver" in window)) {
        revealSlides();
        return null;
      }

      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          revealSlides();
          observer.disconnect();
        });
      }, { threshold: 0.2 });

      observer.observe(root);
      return observer;
    }

    function init() {
      const root = document.querySelector(rootSelector);
      if (!root || typeof Swiper === "undefined") return;

      destroy(root);

      const sliderEl = root.querySelector("[data-jfc22-slider]");
      if (!sliderEl) return;

      sliderEl.classList.remove("preview");

      const slidesMobile = Number(sliderEl.getAttribute("data-view-mobile") || 2);
      const slidesTablet = Number(sliderEl.getAttribute("data-view-tablet") || 3);
      const slidesSmallDesktop = Number(sliderEl.getAttribute("data-view-small-desktop") || 4);
      const slidesDesktop = Number(sliderEl.getAttribute("data-view-desktop") || 5);

      const main = new Swiper(sliderEl, {
        speed: 300,
        loop: true,
        navigation: {
          nextEl: root.querySelector(".jfc22__btn--next"),
          prevEl: root.querySelector(".jfc22__btn--prev")
        },
        breakpoints: {
          320: {
            spaceBetween: 0,
            slidesPerView: slidesMobile
          },
          768: {
            spaceBetween: 0,
            slidesPerView: slidesTablet
          },
          1024: {
            spaceBetween: 0,
            slidesPerView: slidesSmallDesktop
          },
          1200: {
            spaceBetween: 0,
            slidesPerView: slidesDesktop
          }
        },
        on: {
          init: function() {
            this.el.style.opacity = "1";
          }
        }
      });

      const galleries = [];
      root.querySelectorAll("[data-jfc22-product-gallery]").forEach(function(galleryEl) {
        if (galleryEl.querySelectorAll(".swiper-slide").length <= 1) return;

        const gallery = new Swiper(galleryEl, {
          allowTouchMove: false,
          mousewheel: false,
          keyboard: false,
          simulateTouch: false,
          speed: 300,
          slidesPerView: 1,
          loop: false,
          navigation: {
            nextEl: galleryEl.querySelector(".jfc22__gallery-btn--next"),
            prevEl: galleryEl.querySelector(".jfc22__gallery-btn--prev")
          }
        });

        galleries.push(gallery);
      });

      const entranceObserver = setupEntranceAnimation(root);
      root.__jfc22Instance = { main: main, galleries: galleries, entranceObserver: entranceObserver };
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    if (typeof Shopify !== "undefined" && Shopify.designMode) {
      document.addEventListener("shopify:section:load", function(event) {
        if (!event || !event.detail || event.detail.sectionId !== sectionId) return;
        init();
      });

      document.addEventListener("shopify:section:unload", function(event) {
        if (!event || !event.detail || event.detail.sectionId !== sectionId) return;
        const root = document.querySelector(rootSelector);
        destroy(root);
      });
    }
  })();
</script>

