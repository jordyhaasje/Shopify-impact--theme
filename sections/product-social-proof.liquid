<section id="product-social-proof-{{ section.id }}" class="product-social-proof-section">
  <div class="product-social-proof__wrap">
    <div class="product-social-proof__avatars">
      {% if section.settings.avatar_1 != blank %}
        {{ section.settings.avatar_1 | image_url: width: 160 | image_tag: class: 'product-social-proof__avatar', loading: 'lazy', widths: '48,72,96,160', sizes: '(max-width: 749px) 40px, 52px' }}
      {% endif %}
      {% if section.settings.avatar_2 != blank %}
        {{ section.settings.avatar_2 | image_url: width: 160 | image_tag: class: 'product-social-proof__avatar', loading: 'lazy', widths: '48,72,96,160', sizes: '(max-width: 749px) 40px, 52px' }}
      {% endif %}
      {% if section.settings.avatar_3 != blank %}
        {{ section.settings.avatar_3 | image_url: width: 160 | image_tag: class: 'product-social-proof__avatar', loading: 'lazy', widths: '48,72,96,160', sizes: '(max-width: 749px) 40px, 52px' }}
      {% endif %}
    </div>

    <div class="product-social-proof__content">
      <p class="product-social-proof__text">
        {% if section.settings.name_text != blank %}
          <strong>{{ section.settings.name_text }}</strong>
        {% endif %}

        {% if section.settings.show_verified_badge %}
          <span class="product-social-proof__verified" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 1.75L12.2786 3.26795L15.0063 2.99784L15.8301 5.61172L18.25 7.25L17.4261 9.86387L18.25 12.4777L15.8301 14.116L15.0063 16.7299L12.2786 16.4598L10 17.9777L7.72143 16.4598L4.99372 16.7299L4.16987 14.116L1.75 12.4777L2.57386 9.86387L1.75 7.25L4.16987 5.61172L4.99372 2.99784L7.72143 3.26795L10 1.75Z" fill="#4EA3FF"/>
              <path d="M8.55 12.45L5.95 9.85L7 8.8L8.55 10.35L13 5.9L14.05 6.95L8.55 12.45Z" fill="white"/>
            </svg>
          </span>
        {% endif %}

        {% if section.settings.text_before_bold != blank %}
          <span>{{ section.settings.text_before_bold }}</span>
        {% endif %}

        {% if section.settings.bold_text != blank %}
          <strong> {{ section.settings.bold_text }}</strong>
        {% endif %}

        {% if section.settings.text_after_bold != blank %}
          <span> {{ section.settings.text_after_bold }}</span>
        {% endif %}
      </p>
    </div>
  </div>

  <style>
    #product-social-proof-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
      --section-padding-side-desktop: {{ section.settings.padding_side_desktop }}px;
      --section-padding-side-mobile: {{ section.settings.padding_side_mobile }}px;
      --section-radius: {{ section.settings.border_radius }}px;
      --avatar-size-desktop: {{ section.settings.avatar_size_desktop }}px;
      --avatar-size-mobile: {{ section.settings.avatar_size_mobile }}px;
      --avatar-overlap-desktop: {{ section.settings.avatar_overlap_desktop }}px;
      --avatar-overlap-mobile: {{ section.settings.avatar_overlap_mobile }}px;
      --text-size-desktop: {{ section.settings.text_size_desktop }}px;
      --text-size-mobile: {{ section.settings.text_size_mobile }}px;
      --background-color: {{ section.settings.background_color }};
      --text-color: {{ section.settings.text_color }};
      --avatar-border-color: {{ section.settings.avatar_border_color }};
      --content-max-width: {{ section.settings.content_max_width }}px;
    }

    #product-social-proof-{{ section.id }} {
      width: 100%;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__wrap {
      max-width: var(--content-max-width);
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 18px;
      padding: var(--section-padding-top) var(--section-padding-side-desktop) var(--section-padding-bottom);
      border-radius: var(--section-radius);
      background: var(--background-color);
      box-sizing: border-box;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__avatars {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__avatar {
      width: var(--avatar-size-desktop);
      height: var(--avatar-size-desktop);
      border-radius: 999px;
      object-fit: cover;
      display: block;
      border: 2px solid var(--avatar-border-color);
      margin-left: calc(var(--avatar-overlap-desktop) * -1);
      background: #d9d9d9;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__avatar:first-child {
      margin-left: 0;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__content {
      flex: 1 1 auto;
      min-width: 0;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__text {
      margin: 0;
      color: var(--text-color);
      font-size: var(--text-size-desktop);
      line-height: 1.35;
      letter-spacing: 0;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__text strong {
      font-weight: 700;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__verified {
      display: inline-flex;
      width: 18px;
      height: 18px;
      margin: 0 4px;
      vertical-align: -2px;
    }

    #product-social-proof-{{ section.id }} .product-social-proof__verified svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    @media screen and (max-width: 749px) {
      #product-social-proof-{{ section.id }} .product-social-proof__wrap {
        gap: 14px;
        padding-left: var(--section-padding-side-mobile);
        padding-right: var(--section-padding-side-mobile);
      }

      #product-social-proof-{{ section.id }} .product-social-proof__avatar {
        width: var(--avatar-size-mobile);
        height: var(--avatar-size-mobile);
        margin-left: calc(var(--avatar-overlap-mobile) * -1);
      }

      #product-social-proof-{{ section.id }} .product-social-proof__text {
        font-size: var(--text-size-mobile);
        line-height: 1.4;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Product social proof",
  "tag": "section",
  "class": "section section-product-social-proof",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "text",
      "id": "name_text",
      "label": "Name",
      "default": "Davie"
    },
    {
      "type": "checkbox",
      "id": "show_verified_badge",
      "label": "Show verified badge",
      "default": true
    },
    {
      "type": "text",
      "id": "text_before_bold",
      "label": "Text before bold",
      "default": "and"
    },
    {
      "type": "text",
      "id": "bold_text",
      "label": "Bold text",
      "default": "1500+ others"
    },
    {
      "type": "text",
      "id": "text_after_bold",
      "label": "Text after bold",
      "default": "love our products and purchased more than ones!"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 300,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_side_desktop",
      "label": "Side padding desktop",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_side_mobile",
      "label": "Side padding mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "avatar_size_desktop",
      "label": "Avatar size desktop",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "avatar_size_mobile",
      "label": "Avatar size mobile",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "avatar_overlap_desktop",
      "label": "Avatar overlap desktop",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "avatar_overlap_mobile",
      "label": "Avatar overlap mobile",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "avatar_border_color",
      "label": "Avatar border color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Product social proof"
    }
  ]
}
{% endschema %}