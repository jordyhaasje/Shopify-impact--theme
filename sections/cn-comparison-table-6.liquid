{% liquid
  assign heading_parts = section.settings.heading | split: ' '
  assign first_word = heading_parts | first
  assign remaining_heading = section.settings.heading | remove_first: first_word
%}

<section class="cn-comparison-table color-{{ section.settings.color_scheme }}" id="section-{{ section.id }}">
  <div class="page-width">
    <div class="cn-comparison-table__inner">
      <div class="cn-comparison-table__content">
        {% if section.settings.heading != blank %}
          <h2 class="cn-comparison-table__heading {{ section.settings.heading_size }}">
            {% if first_word != blank %}
              <span class="cn-comparison-table__heading-italic">{{ first_word }}</span>{{ remaining_heading }}
            {% else %}
              {{ section.settings.heading }}
            {% endif %}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="cn-comparison-table__description rte">{{ section.settings.description }}</div>
        {% endif %}

        {% assign bullet_blocks = section.blocks | where: 'type', 'bullet' %}
        {% if bullet_blocks.size > 0 %}
          <ul class="cn-comparison-table__benefits" role="list">
            {% for block in bullet_blocks %}
              <li class="cn-comparison-table__benefit" {{ block.shopify_attributes }}>
                <span class="cn-comparison-table__benefit-icon" aria-hidden="true">
                  {% if block.settings.icon == 'check' %}
                    <svg viewBox="0 0 24 24" fill="none" focusable="false"><circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/><path d="M7 12.5l3.1 3.1L17.5 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% elsif block.settings.icon == 'leaf' %}
                    <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M19.5 4.5c-7.5.3-12 4.8-12.3 12.3 4.6-.1 8-1.3 10.3-3.6 2.3-2.3 3.5-5.7 3.6-10.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M7 17c2.2-3.4 5.1-6.3 8.5-8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" focusable="false"><circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/><path d="M8 8l8 8M16 8l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {% endif %}
                </span>
                <span class="cn-comparison-table__benefit-text">{{ block.settings.text }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <div class="cn-comparison-table__button-wrap">
            <a
              class="cn-comparison-table__button button"
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>

      <div class="cn-comparison-table__table-wrap">
        <div class="cn-comparison-table__table-shell">
          <div class="cn-comparison-table__table-header-spacer"></div>
          <div class="cn-comparison-table__table-header cn-comparison-table__table-header--brand">
            {% if section.settings.brand_logo != blank %}
              <img
                src="{{ section.settings.brand_logo | image_url: width: 240 }}"
                alt="{{ section.settings.brand_header | escape }}"
                loading="lazy"
                width="120"
                height="56"
                class="cn-comparison-table__brand-logo"
              >
            {% else %}
              <span>{{ section.settings.brand_header }}</span>
            {% endif %}
          </div>
          <div class="cn-comparison-table__table-header cn-comparison-table__table-header--other">
            <span>{{ section.settings.other_header }}</span>
          </div>

          {% assign row_blocks = section.blocks | where: 'type', 'row' %}
          {% for block in row_blocks %}
            <div class="cn-comparison-table__cell cn-comparison-table__cell--label" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </div>
            <div class="cn-comparison-table__cell cn-comparison-table__cell--brand">
              <span class="cn-comparison-table__status cn-comparison-table__status--{{ block.settings.brand_status }}" aria-label="{{ block.settings.brand_status }}">
                {% if block.settings.brand_status == 'check' %}
                  <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M4.5 12.5 9.5 17.5 19.5 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                {% endif %}
              </span>
            </div>
            <div class="cn-comparison-table__cell cn-comparison-table__cell--other">
              <span class="cn-comparison-table__status cn-comparison-table__status--{{ block.settings.other_status }}" aria-label="{{ block.settings.other_status }}">
                {% if block.settings.other_status == 'check' %}
                  <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M4.5 12.5 9.5 17.5 19.5 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                {% endif %}
              </span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <style>
    #section-{{ section.id }} {
      --comparison-bg: {{ section.settings.background_color }};
      --comparison-text: {{ section.settings.text_color }};
      --comparison-muted: {{ section.settings.muted_text_color }};
      --comparison-card: {{ section.settings.table_bg_color }};
      --comparison-border: {{ section.settings.border_color }};
      --comparison-brand-bg: {{ section.settings.brand_column_bg }};
      --comparison-brand-text: {{ section.settings.brand_column_text }};
      --comparison-check: {{ section.settings.check_color }};
      --comparison-cross: {{ section.settings.cross_color }};
      --comparison-button-bg: {{ section.settings.button_bg }};
      --comparison-button-text: {{ section.settings.button_text }};
      --comparison-radius: {{ section.settings.corner_radius }}px;
      --comparison-section-py: {{ section.settings.padding_top }}px;
      --comparison-section-pb: {{ section.settings.padding_bottom }}px;
      --comparison-gap: {{ section.settings.desktop_gap }}px;
      background: var(--comparison-bg);
    }

    #section-{{ section.id }} .page-width {
      max-width: {{ section.settings.page_width }}px;
    }

    #section-{{ section.id }} .cn-comparison-table__inner {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
      gap: var(--comparison-gap);
      align-items: center;
      padding-top: var(--comparison-section-py);
      padding-bottom: var(--comparison-section-pb);
    }

    #section-{{ section.id }} .cn-comparison-table__content {
      max-width: 63rem;
      color: var(--comparison-text);
    }

    #section-{{ section.id }} .cn-comparison-table__heading {
      margin: 0;
      color: var(--comparison-text);
      line-height: 0.95;
      letter-spacing: -0.03em;
    }

    #section-{{ section.id }} .cn-comparison-table__heading.h0,
    #section-{{ section.id }} .cn-comparison-table__heading.h1 {
      font-size: clamp(4.2rem, 7vw, {{ section.settings.heading_size_desktop }}px);
    }

    #section-{{ section.id }} .cn-comparison-table__heading.h2 {
      font-size: clamp(3.6rem, 5.2vw, {{ section.settings.heading_size_desktop }}px);
    }

    #section-{{ section.id }} .cn-comparison-table__heading-italic {
      font-style: italic;
      font-weight: 400;
      margin-right: 0.16em;
    }

    #section-{{ section.id }} .cn-comparison-table__description {
      max-width: 54rem;
      margin-top: 2.4rem;
      color: var(--comparison-text);
      font-size: {{ section.settings.body_size_desktop }}px;
      line-height: 1.45;
    }

    #section-{{ section.id }} .cn-comparison-table__description p { margin: 0; }

    #section-{{ section.id }} .cn-comparison-table__benefits {
      list-style: none;
      margin: 4rem 0 0;
      padding: 0;
      display: grid;
      gap: 2.4rem;
    }

    #section-{{ section.id }} .cn-comparison-table__benefit {
      display: flex;
      align-items: center;
      gap: 1.6rem;
      color: var(--comparison-text);
      font-size: {{ section.settings.bullet_size_desktop }}px;
      line-height: 1.25;
    }

    #section-{{ section.id }} .cn-comparison-table__benefit-icon {
      width: 3.8rem;
      height: 3.8rem;
      min-width: 3.8rem;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--comparison-text);
    }

    #section-{{ section.id }} .cn-comparison-table__benefit-icon svg {
      width: 100%;
      height: 100%;
    }

    #section-{{ section.id }} .cn-comparison-table__button-wrap {
      margin-top: 4.2rem;
    }

    #section-{{ section.id }} .cn-comparison-table__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: {{ section.settings.button_width_desktop }}px;
      min-height: 6.8rem;
      padding: 1.6rem 3.2rem;
      border-radius: 999px;
      background: var(--comparison-button-bg);
      color: var(--comparison-button-text);
      text-decoration: none;
      font-size: {{ section.settings.button_size_desktop }}px;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    #section-{{ section.id }} .cn-comparison-table__table-wrap {
      min-width: 0;
    }

    #section-{{ section.id }} .cn-comparison-table__table-shell {
      display: grid;
      grid-template-columns: minmax(17rem, 1.05fr) minmax(12rem, 1fr) minmax(12rem, 1fr);
      border: 1px solid var(--comparison-border);
      border-radius: var(--comparison-radius);
      overflow: hidden;
      background: var(--comparison-card);
    }

    #section-{{ section.id }} .cn-comparison-table__table-header,
    #section-{{ section.id }} .cn-comparison-table__cell,
    #section-{{ section.id }} .cn-comparison-table__table-header-spacer {
      min-height: 8.8rem;
      padding: 2rem 2.2rem;
      display: flex;
      align-items: center;
      border-right: 1px solid var(--comparison-border);
      border-bottom: 1px solid var(--comparison-border);
      color: var(--comparison-text);
      font-size: {{ section.settings.table_text_size_desktop }}px;
      line-height: 1.2;
    }

    #section-{{ section.id }} .cn-comparison-table__table-header-spacer {
      background: var(--comparison-card);
    }

    #section-{{ section.id }} .cn-comparison-table__table-header--brand,
    #section-{{ section.id }} .cn-comparison-table__cell--brand {
      justify-content: center;
      text-align: center;
      background: var(--comparison-brand-bg);
      color: var(--comparison-brand-text);
    }

    #section-{{ section.id }} .cn-comparison-table__table-header--other {
      justify-content: center;
      text-align: center;
      font-weight: 700;
    }

    #section-{{ section.id }} .cn-comparison-table__cell--label {
      font-weight: 500;
    }

    #section-{{ section.id }} .cn-comparison-table__brand-logo {
      max-width: 12rem;
      height: auto;
      object-fit: contain;
    }

    #section-{{ section.id }} .cn-comparison-table__status {
      width: 3.8rem;
      height: 3.8rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #section-{{ section.id }} .cn-comparison-table__status svg {
      width: 100%;
      height: 100%;
    }

    #section-{{ section.id }} .cn-comparison-table__status--check { color: var(--comparison-check); }
    #section-{{ section.id }} .cn-comparison-table__status--cross { color: var(--comparison-cross); }

    #section-{{ section.id }} .cn-comparison-table__table-shell > :nth-child(3n) {
      border-right: 0;
    }

    #section-{{ section.id }} .cn-comparison-table__table-shell > :nth-last-child(-n + 3) {
      border-bottom: 0;
    }

    @media screen and (max-width: 989px) {
      #section-{{ section.id }} .cn-comparison-table__inner {
        grid-template-columns: 1fr;
        gap: {{ section.settings.mobile_gap }}px;
      }

      #section-{{ section.id }} .cn-comparison-table__content {
        max-width: 100%;
      }

      #section-{{ section.id }} .cn-comparison-table__heading {
        font-size: {{ section.settings.heading_size_mobile }}px !important;
        line-height: 0.98;
      }

      #section-{{ section.id }} .cn-comparison-table__description {
        margin-top: 1.8rem;
        font-size: {{ section.settings.body_size_mobile }}px;
      }

      #section-{{ section.id }} .cn-comparison-table__benefits {
        margin-top: 2.8rem;
        gap: 1.8rem;
      }

      #section-{{ section.id }} .cn-comparison-table__benefit {
        gap: 1.2rem;
        font-size: {{ section.settings.bullet_size_mobile }}px;
      }

      #section-{{ section.id }} .cn-comparison-table__benefit-icon {
        width: 3.2rem;
        height: 3.2rem;
        min-width: 3.2rem;
      }

      #section-{{ section.id }} .cn-comparison-table__button-wrap {
        margin-top: 3rem;
      }

      #section-{{ section.id }} .cn-comparison-table__button {
        width: 100%;
        min-width: 0;
        min-height: 5.8rem;
        font-size: {{ section.settings.button_size_mobile }}px;
      }

      #section-{{ section.id }} .cn-comparison-table__table-shell {
        grid-template-columns: minmax(13rem, 1.2fr) minmax(10rem, 1fr) minmax(10rem, 1fr);
      }

      #section-{{ section.id }} .cn-comparison-table__table-header,
      #section-{{ section.id }} .cn-comparison-table__cell,
      #section-{{ section.id }} .cn-comparison-table__table-header-spacer {
        min-height: 6.6rem;
        padding: 1.4rem 1.2rem;
        font-size: {{ section.settings.table_text_size_mobile }}px;
      }

      #section-{{ section.id }} .cn-comparison-table__status {
        width: 3rem;
        height: 3rem;
      }
    }

    @media screen and (max-width: 749px) {
      #section-{{ section.id }} {
        --comparison-section-py: {{ section.settings.padding_top_mobile }}px;
        --comparison-section-pb: {{ section.settings.padding_bottom_mobile }}px;
      }

      #section-{{ section.id }} .page-width {
        padding-left: {{ section.settings.mobile_side_padding }}px;
        padding-right: {{ section.settings.mobile_side_padding }}px;
      }

      #section-{{ section.id }} .cn-comparison-table__table-wrap {
        overflow-x: auto;
        margin-right: -{{ section.settings.mobile_side_padding }}px;
        padding-right: {{ section.settings.mobile_side_padding }}px;
      }

      #section-{{ section.id }} .cn-comparison-table__table-shell {
        min-width: {{ section.settings.mobile_table_min_width }}px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "CN comparison table",
  "tag": "section",
  "class": "section section-cn-comparison-table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "US vs Other Brands" },
    { "type": "select", "id": "heading_size", "label": "Heading style class", "default": "h1", "options": [
      { "value": "h0", "label": "H0" },
      { "value": "h1", "label": "H1" },
      { "value": "h2", "label": "H2" }
    ]},
    { "type": "range", "id": "heading_size_desktop", "min": 56, "max": 120, "step": 2, "unit": "px", "label": "Heading size desktop", "default": 78 },
    { "type": "range", "id": "heading_size_mobile", "min": 30, "max": 64, "step": 1, "unit": "px", "label": "Heading size mobile", "default": 48 },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>We pride ourselves in our quality and focus on sleep, we cannot say the same for others.</p>" },
    { "type": "range", "id": "body_size_desktop", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Body size desktop", "default": 18 },
    { "type": "range", "id": "body_size_mobile", "min": 13, "max": 22, "step": 1, "unit": "px", "label": "Body size mobile", "default": 16 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "TRY DEEP DREAMS" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "button_width_desktop", "min": 180, "max": 420, "step": 10, "unit": "px", "label": "Button width desktop", "default": 300 },
    { "type": "range", "id": "button_size_desktop", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Button text size desktop", "default": 16 },
    { "type": "range", "id": "button_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button text size mobile", "default": 15 },
    { "type": "header", "content": "Table headers" },
    { "type": "image_picker", "id": "brand_logo", "label": "Brand logo" },
    { "type": "text", "id": "brand_header", "label": "Brand header fallback", "default": "DeepSleep" },
    { "type": "text", "id": "other_header", "label": "Other brands header", "default": "Other Brands" },
    { "type": "range", "id": "table_text_size_desktop", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Table text size desktop", "default": 18 },
    { "type": "range", "id": "table_text_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Table text size mobile", "default": 14 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "page_width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "label": "Page width", "default": 1600 },
    { "type": "range", "id": "desktop_gap", "min": 24, "max": 120, "step": 4, "unit": "px", "label": "Desktop column gap", "default": 60 },
    { "type": "range", "id": "mobile_gap", "min": 16, "max": 60, "step": 2, "unit": "px", "label": "Mobile gap", "default": 28 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Table corner radius", "default": 24 },
    { "type": "range", "id": "mobile_table_min_width", "min": 280, "max": 720, "step": 10, "unit": "px", "label": "Mobile table minimum width", "default": 520 },
    { "type": "range", "id": "mobile_side_padding", "min": 12, "max": 40, "step": 1, "unit": "px", "label": "Mobile side padding", "default": 20 },
    { "type": "header", "content": "Spacing desktop" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Padding top desktop", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Padding bottom desktop", "default": 80 },
    { "type": "header", "content": "Spacing mobile" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top mobile", "default": 44 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom mobile", "default": 44 },
    { "type": "range", "id": "bullet_size_desktop", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Bullet text size desktop", "default": 18 },
    { "type": "range", "id": "bullet_size_mobile", "min": 13, "max": 22, "step": 1, "unit": "px", "label": "Bullet text size mobile", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#eeebf1" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#12121d" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#525061" },
    { "type": "color", "id": "table_bg_color", "label": "Table background", "default": "#eeebf1" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#4b4a5a" },
    { "type": "color", "id": "brand_column_bg", "label": "Brand column background", "default": "#2c2946" },
    { "type": "color", "id": "brand_column_text", "label": "Brand column text", "default": "#ffffff" },
    { "type": "color", "id": "check_color", "label": "Check color", "default": "#a7d9ae" },
    { "type": "color", "id": "cross_color", "label": "Cross color", "default": "#ef8398" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#131038" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Benefit item",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            { "value": "check", "label": "Check circle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "cross", "label": "Cross circle" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Fall asleep quicker" }
      ]
    },
    {
      "type": "row",
      "name": "Comparison row",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Optimized Dosing" },
        {
          "type": "select",
          "id": "brand_status",
          "label": "Brand status",
          "default": "check",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" }
          ]
        },
        {
          "type": "select",
          "id": "other_status",
          "label": "Other brands status",
          "default": "cross",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CN comparison table",
      "blocks": [
        { "type": "bullet", "settings": { "icon": "check", "text": "Fall asleep quicker" } },
        { "type": "bullet", "settings": { "icon": "check", "text": "Relax & Restorative sleep" } },
        { "type": "bullet", "settings": { "icon": "check", "text": "Wake up refreshed" } },
        { "type": "bullet", "settings": { "icon": "check", "text": "Plant based" } },
        { "type": "row", "settings": { "label": "Optimized Dosing", "brand_status": "check", "other_status": "cross" } },
        { "type": "row", "settings": { "label": "Plant Based", "brand_status": "check", "other_status": "cross" } },
        { "type": "row", "settings": { "label": "Low Sugar", "brand_status": "check", "other_status": "cross" } },
        { "type": "row", "settings": { "label": "Simple Ingredients", "brand_status": "check", "other_status": "cross" } },
        { "type": "row", "settings": { "label": "3rd Party Tested", "brand_status": "check", "other_status": "cross" } },
        { "type": "row", "settings": { "label": "Delicious Taste", "brand_status": "check", "other_status": "cross" } }
      ]
    }
  ]
}
{% endschema %}