{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --usp-section-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --usp-card-background: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
    --usp-heading-color: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --usp-text-color: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --usp-muted-color: {{ section.settings.muted_color.red }}, {{ section.settings.muted_color.green }}, {{ section.settings.muted_color.blue }};
    --usp-accent-color: {{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }};
    --usp-icon-background: {{ section.settings.icon_background.red }}, {{ section.settings.icon_background.green }}, {{ section.settings.icon_background.blue }};
    --usp-icon-color: {{ section.settings.icon_color.red }}, {{ section.settings.icon_color.green }}, {{ section.settings.icon_color.blue }};
    --usp-border-color: {{ section.settings.border_color.red }}, {{ section.settings.border_color.green }}, {{ section.settings.border_color.blue }};
    --usp-card-radius: {{ section.settings.card_radius }}px;
    --usp-card-gap: {{ section.settings.card_gap }}px;
    --usp-section-spacing: {{ section.settings.section_spacing }}px;
    --usp-icon-size: {{ section.settings.icon_size }}px;
    --usp-icon-wrapper-size: {{ section.settings.icon_wrapper_size }}px;
    --usp-shadow-opacity: {{ section.settings.card_shadow_opacity | divided_by: 100.0 }};
    --usp-shadow-y: {{ section.settings.card_shadow_y }}px;
    --usp-shadow-blur: {{ section.settings.card_shadow_blur }}px;
    --usp-animation-distance: 18px;
    --usp-animation-duration: 0.6s;
  }

  #shopify-section-{{ section.id }} .jordy-usp {
    background: rgb(var(--usp-section-background));
  }

  #shopify-section-{{ section.id }} .jordy-usp__inner {
    display: grid;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .jordy-usp__header {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .jordy-usp__eyebrow {
    margin: 0 0 10px;
    color: rgb(var(--usp-accent-color));
    font-size: 13px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .jordy-usp__heading {
    margin: 0;
    color: rgb(var(--usp-heading-color));
    font-size: clamp(28px, 3.8vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .jordy-usp__subheading {
    margin-top: 12px;
    color: rgb(var(--usp-muted-color));
    font-size: 16px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .jordy-usp__subheading p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .jordy-usp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--usp-card-gap);
  }

  #shopify-section-{{ section.id }} .jordy-usp__card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 16px;
    padding: 24px;
    border: 1px solid rgba(var(--usp-border-color), 1);
    border-radius: var(--usp-card-radius);
    background: rgb(var(--usp-card-background));
    box-shadow: 0 var(--usp-shadow-y) var(--usp-shadow-blur) rgba(18, 18, 18, var(--usp-shadow-opacity));
    overflow: hidden;
    opacity: 0;
    transform: translateY(var(--usp-animation-distance));
    animation: jordyUspReveal var(--usp-animation-duration) ease forwards;
  }

  #shopify-section-{{ section.id }} .jordy-usp__card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: linear-gradient(90deg, rgba(var(--usp-accent-color), 0.85), rgba(var(--usp-accent-color), 0));
    transform: scaleX(0.35);
    transform-origin: left center;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .jordy-usp__card:nth-child(2) {
    animation-delay: 0.12s;
  }

  #shopify-section-{{ section.id }} .jordy-usp__card:nth-child(3) {
    animation-delay: 0.24s;
  }

  #shopify-section-{{ section.id }} .jordy-usp__card:hover,
  #shopify-section-{{ section.id }} .jordy-usp__card:focus-within {
    transform: translateY(-4px);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    box-shadow: 0 calc(var(--usp-shadow-y) + 6px) calc(var(--usp-shadow-blur) + 12px) rgba(18, 18, 18, calc(var(--usp-shadow-opacity) + 0.03));
    border-color: rgba(var(--usp-accent-color), 0.35);
  }

  #shopify-section-{{ section.id }} .jordy-usp__card:hover::after,
  #shopify-section-{{ section.id }} .jordy-usp__card:focus-within::after {
    transform: scaleX(1);
  }

  #shopify-section-{{ section.id }} .jordy-usp__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--usp-icon-wrapper-size);
    height: var(--usp-icon-wrapper-size);
    border-radius: 999px;
    background: rgb(var(--usp-icon-background));
    color: rgb(var(--usp-icon-color));
    flex-shrink: 0;
    transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .jordy-usp__card:hover .jordy-usp__icon,
  #shopify-section-{{ section.id }} .jordy-usp__card:focus-within .jordy-usp__icon {
    transform: scale(1.06);
    background: rgba(var(--usp-accent-color), 0.12);
    color: rgb(var(--usp-accent-color));
  }

  #shopify-section-{{ section.id }} .jordy-usp__icon svg {
    width: var(--usp-icon-size);
    height: var(--usp-icon-size);
    display: block;
  }

  #shopify-section-{{ section.id }} .jordy-usp__title {
    margin: 0 0 6px;
    color: rgb(var(--usp-heading-color));
    font-size: 20px;
    line-height: 1.2;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .jordy-usp__text {
    color: rgb(var(--usp-text-color));
    font-size: 15px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .jordy-usp__text p {
    margin: 0;
  }

  @keyframes jordyUspReveal {
    from {
      opacity: 0;
      transform: translateY(var(--usp-animation-distance));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .jordy-usp__inner {
      gap: 36px;
    }

    #shopify-section-{{ section.id }} .jordy-usp__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .jordy-usp__card {
      height: 100%;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .jordy-usp__card,
    #shopify-section-{{ section.id }} .jordy-usp__icon {
      animation: none;
      transition: none;
      transform: none;
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .jordy-usp__card::after {
      transition: none;
    }
  }
</style>

<section class="jordy-usp">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">
      <div class="jordy-usp__inner" style="padding-block: {{ section.settings.section_spacing }}px;">
        <div class="jordy-usp__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="jordy-usp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="jordy-usp__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <div class="jordy-usp__subheading rte">
              {{ section.settings.subheading }}
            </div>
          {%- endif -%}
        </div>

        <div class="jordy-usp__grid" role="list">
          {%- for block in section.blocks -%}
            <article class="jordy-usp__card" role="listitem" {{ block.shopify_attributes }}>
              <div class="jordy-usp__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1.5 5.5h12v9h-12z"></path>
                      <path d="M13.5 8.5h4.2l3 3v3h-7.2z"></path>
                      <circle cx="6" cy="17.5" r="2"></circle>
                      <circle cx="18" cy="17.5" r="2"></circle>
                    </svg>
                  {%- when 'return' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M8 7H4v4"></path>
                      <path d="M4 11a8 8 0 1 0 2.3-5.7L4 7"></path>
                    </svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3l7 3v5c0 5-3.2 8.6-7 10-3.8-1.4-7-5-7-10V6l7-3z"></path>
                      <path d="M9.5 12.5l1.8 1.8 3.7-4.3"></path>
                    </svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.7l5.9-.9L12 3.5z"></path>
                    </svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18.5 5.5C13 5 8.5 8 6.5 12.5c-1.3 2.9-.9 5.7-.4 7 1.3.5 4.1.9 7-.4 4.5-2 7.5-6.5 7-12.1-.5-.4-.9-.8-1.6-1.5z"></path>
                      <path d="M7 17c2-2 5.2-4.8 10-7"></path>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2.5l8 4.5v6c0 5-3.5 8.2-8 9.5-4.5-1.3-8-4.5-8-9.5V7l8-4.5z"></path>
                    </svg>
                {%- endcase -%}
              </div>

              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="jordy-usp__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="jordy-usp__text rte">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Jordy USP",
  "tag": "section",
  "class": "shopify-section--jordy-usp",
  "max_blocks": 3,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Waarom klanten voor ons kiezen"},
    {"type":"text","id":"heading","label":"Heading","default":"Snel geleverd, makkelijk retour en gemaakt voor langdurige kwaliteit"},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Gebruik deze USP sectie om je belangrijkste voordelen in één oogopslag duidelijk te maken.</p>"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"section_spacing","label":"Section spacing","min":0,"max":80,"step":4,"default":48},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":32,"step":2,"default":20},
    {"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"default":20},
    {"type":"range","id":"icon_size","label":"Icon size","min":16,"max":36,"step":2,"default":22},
    {"type":"range","id":"icon_wrapper_size","label":"Icon wrapper size","min":40,"max":72,"step":2,"default":52},
    {"type":"range","id":"card_shadow_y","label":"Card shadow Y offset","min":0,"max":32,"step":1,"default":12},
    {"type":"range","id":"card_shadow_blur","label":"Card shadow blur","min":0,"max":80,"step":2,"default":36},
    {"type":"range","id":"card_shadow_opacity","label":"Card shadow opacity","min":0,"max":20,"step":1,"default":6},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background","label":"Section background","default":"#F8F6F2"},
    {"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#1F2937"},
    {"type":"color","id":"text_color","label":"Text color","default":"#4B5563"},
    {"type":"color","id":"muted_color","label":"Muted text color","default":"#6B7280"},
    {"type":"color","id":"accent_color","label":"Accent color","default":"#C58A37"},
    {"type":"color","id":"icon_background","label":"Icon background","default":"#F3E9D7"},
    {"type":"color","id":"icon_color","label":"Icon color","default":"#8B5E1A"},
    {"type":"color","id":"border_color","label":"Border color","default":"#E8E1D5"}
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {"value": "truck", "label": "Truck"},
            {"value": "return", "label": "Return"},
            {"value": "shield", "label": "Shield"},
            {"value": "star", "label": "Star"},
            {"value": "leaf", "label": "Leaf"}
          ]
        },
        {"type":"text","id":"title","label":"Title","default":"Binnen 1-2 werkdagen in huis"},
        {"type":"richtext","id":"text","label":"Text","default":"<p>Bestel vandaag en ontvang je order snel thuis, met duidelijke tracking van verzending tot bezorging.</p>"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Jordy USP",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon": "truck",
            "title": "Snelle levertijd",
            "text": "<p>Op werkdagen besteld? Dan heb je jouw bestelling meestal binnen 1-2 werkdagen in huis.</p>"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "return",
            "title": "Eenvoudig retourneren",
            "text": "<p>Toch niet helemaal tevreden? Retourneren doe je snel en zonder gedoe binnen de retourtermijn.</p>"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "shield",
            "title": "Kwaliteit die blijft",
            "text": "<p>Geselecteerde materialen en zorgvuldige afwerking zorgen voor een product waar je lang plezier van hebt.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}