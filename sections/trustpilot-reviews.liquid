{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --tp-bg: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --tp-card-bg: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
    --tp-heading-c: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --tp-text-c: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --tp-muted-c: {{ section.settings.muted_color.red }}, {{ section.settings.muted_color.green }}, {{ section.settings.muted_color.blue }};
    --tp-star-c: {{ section.settings.stars_color.red }}, {{ section.settings.stars_color.green }}, {{ section.settings.stars_color.blue }};
    --tp-radius: {{ section.settings.card_radius }}px;
    --tp-gap: {{ section.settings.card_gap }}px;
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .tp-wrap {
    background: rgb(var(--tp-bg));
  }

  /* ===== DESKTOP: left header + right 2-col masonry ===== */
  #shopify-section-{{ section.id }} .tp-layout {
    display: flex;
    align-items: flex-start;
    gap: 56px;
  }

  #shopify-section-{{ section.id }} .tp-left {
    flex: 0 0 280px;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 4px;
    position: sticky;
    top: 40px;
  }

  #shopify-section-{{ section.id }} .tp-right {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--tp-gap);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .tp-col {
    display: flex;
    flex-direction: column;
    gap: var(--tp-gap);
  }

  #shopify-section-{{ section.id }} .tp-col:nth-child(2) {
    margin-top: 36px;
  }

  /* ===== Badge (Trustpilot sterren + label) ===== */
  #shopify-section-{{ section.id }} .tp-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .tp-badge__stars {
    display: inline-flex;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .tp-badge__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: rgb(var(--tp-star-c));
  }

  #shopify-section-{{ section.id }} .tp-badge__star--half {
    background: linear-gradient(to right, rgb(var(--tp-star-c)) 60%, #dcdce6 60%);
  }

  #shopify-section-{{ section.id }} .tp-badge__star svg {
    width: 14px;
    height: 14px;
    fill: #fff;
    display: block;
  }

  #shopify-section-{{ section.id }} .tp-badge__label {
    font-size: 13px;
    font-weight: 500;
    color: rgb(var(--tp-text-c));
  }

  #shopify-section-{{ section.id }} .tp-badge__logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-weight: 700;
    color: rgb(var(--tp-text-c));
  }

  #shopify-section-{{ section.id }} .tp-badge__logo svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  /* ===== Heading + sub ===== */
  #shopify-section-{{ section.id }} .tp-heading {
    margin: 0;
    color: rgb(var(--tp-heading-c));
    font-size: clamp(36px, 4.5vw, 58px);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .tp-sub {
    margin: 0;
    color: rgb(var(--tp-muted-c));
    font-size: 15px;
    line-height: 1.55;
  }

  /* ===== Cards ===== */
  #shopify-section-{{ section.id }} .tp-card {
    background: rgb(var(--tp-card-bg));
    border-radius: var(--tp-radius);
    padding: 22px 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .tp-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .tp-card__quote {
    font-size: 28px;
    line-height: 1;
    color: rgba(var(--tp-muted-c), 0.45);
    font-family: Georgia, serif;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tp-card__stars {
    display: inline-flex;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .tp-card__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: rgb(var(--tp-star-c));
  }

  #shopify-section-{{ section.id }} .tp-card__star svg {
    width: 12px;
    height: 12px;
    fill: #fff;
    display: block;
  }

  #shopify-section-{{ section.id }} .tp-card__title {
    font-size: 15px;
    font-weight: 700;
    color: rgb(var(--tp-heading-c));
    margin: 0;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .tp-card__text {
    font-size: 14px;
    line-height: 1.6;
    color: rgb(var(--tp-text-c));
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tp-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 10px;
    border-top: 1px solid rgba(var(--tp-heading-c), 0.08);
  }

  #shopify-section-{{ section.id }} .tp-card__author {
    font-size: 13px;
    font-weight: 700;
    color: rgb(var(--tp-heading-c));
  }

  #shopify-section-{{ section.id }} .tp-card__date {
    font-size: 12px;
    color: rgb(var(--tp-muted-c));
  }

  /* ===== MOBILE: hide desktop, show carousel ===== */
  #shopify-section-{{ section.id }} .tp-mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .tp-layout {
      display: none;
    }

    #shopify-section-{{ section.id }} .tp-mobile {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    #shopify-section-{{ section.id }} .tp-mobile-header {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    #shopify-section-{{ section.id }} .tp-heading {
      font-size: clamp(28px, 8vw, 42px);
    }

    #shopify-section-{{ section.id }} .tp-carousel {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .tp-carousel::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .tp-carousel .tp-card {
      flex: 0 0 calc(100% - 8px);
      width: calc(100% - 8px);
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .tp-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .tp-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: rgba(var(--tp-heading-c), 0.2);
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s, width 0.25s;
    }

    #shopify-section-{{ section.id }} .tp-dot.is-active {
      background: rgb(var(--tp-heading-c));
      width: 26px;
    }
  }
</style>

{%- comment -%} SVG star path reused inline {%- endcomment -%}

<section class="tp-wrap">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">

      {%- comment -%} ── DESKTOP ── {%- endcomment -%}
      <div class="tp-layout">
        <div class="tp-left">
          <div class="tp-badge">
            <span class="tp-badge__stars" aria-label="4.5 van 5 sterren op Trustpilot">
              {%- for i in (1..4) -%}<span class="tp-badge__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>{%- endfor -%}
              <span class="tp-badge__star tp-badge__star--half"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>
            </span>
            <span class="tp-badge__label">{{ section.settings.review_count | escape }} beoordelingen op</span>
            <span class="tp-badge__logo">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="rgb(var(--tp-star-c))" d="M12 0l2.95 9.07H24l-7.7 5.59 2.94 9.07L12 18.14l-7.24 5.59 2.94-9.07L0 9.07h9.05z"/></svg>
              Trustpilot
            </span>
          </div>
          {%- if section.settings.heading != blank -%}<h2 class="tp-heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="tp-sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        </div>

        <div class="tp-right">
          <div class="tp-col">
            {%- for block in section.blocks -%}
              {%- assign rem = forloop.index | modulo: 2 -%}
              {%- if rem == 1 -%}
                <article class="tp-card" {{ block.shopify_attributes }}>
                  <div class="tp-card__top">
                    <span class="tp-card__quote" aria-hidden="true">"</span>
                    <div class="tp-card__stars">
                      {%- for i in (1..block.settings.rating) -%}<span class="tp-card__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z" fill="currentColor"/></svg></span>{%- endfor -%}
                    </div>
                  </div>
                  {%- if block.settings.review_title != blank -%}<p class="tp-card__title">{{ block.settings.review_title | escape }}</p>{%- endif -%}
                  <p class="tp-card__text">{{ block.settings.review_text | escape }}</p>
                  <div class="tp-card__footer">
                    <span class="tp-card__author">{{ block.settings.author | escape }}</span>
                    <span class="tp-card__date">{{ block.settings.date | escape }}</span>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="tp-col">
            {%- for block in section.blocks -%}
              {%- assign rem = forloop.index | modulo: 2 -%}
              {%- if rem == 0 -%}
                <article class="tp-card" {{ block.shopify_attributes }}>
                  <div class="tp-card__top">
                    <span class="tp-card__quote" aria-hidden="true">"</span>
                    <div class="tp-card__stars">
                      {%- for i in (1..block.settings.rating) -%}<span class="tp-card__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z" fill="currentColor"/></svg></span>{%- endfor -%}
                    </div>
                  </div>
                  {%- if block.settings.review_title != blank -%}<p class="tp-card__title">{{ block.settings.review_title | escape }}</p>{%- endif -%}
                  <p class="tp-card__text">{{ block.settings.review_text | escape }}</p>
                  <div class="tp-card__footer">
                    <span class="tp-card__author">{{ block.settings.author | escape }}</span>
                    <span class="tp-card__date">{{ block.settings.date | escape }}</span>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- comment -%} ── MOBILE ── {%- endcomment -%}
      <div class="tp-mobile">
        <div class="tp-mobile-header">
          <div class="tp-badge">
            <span class="tp-badge__stars" aria-label="4.5 van 5 sterren op Trustpilot">
              {%- for i in (1..4) -%}<span class="tp-badge__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>{%- endfor -%}
              <span class="tp-badge__star tp-badge__star--half"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>
            </span>
            <span class="tp-badge__label">{{ section.settings.review_count | escape }} beoordelingen op</span>
            <span class="tp-badge__logo">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="rgb(var(--tp-star-c))" d="M12 0l2.95 9.07H24l-7.7 5.59 2.94 9.07L12 18.14l-7.24 5.59 2.94-9.07L0 9.07h9.05z"/></svg>
              Trustpilot
            </span>
          </div>
          {%- if section.settings.heading != blank -%}<h2 class="tp-heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="tp-sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        </div>

        <div class="tp-carousel" id="tp-carousel-{{ section.id }}">
          {%- for block in section.blocks -%}
            <article class="tp-card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="tp-card__top">
                <span class="tp-card__quote" aria-hidden="true">"</span>
                <div class="tp-card__stars">
                  {%- for i in (1..block.settings.rating) -%}<span class="tp-card__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z" fill="currentColor"/></svg></span>{%- endfor -%}
                </div>
              </div>
              {%- if block.settings.review_title != blank -%}<p class="tp-card__title">{{ block.settings.review_title | escape }}</p>{%- endif -%}
              <p class="tp-card__text">{{ block.settings.review_text | escape }}</p>
              <div class="tp-card__footer">
                <span class="tp-card__author">{{ block.settings.author | escape }}</span>
                <span class="tp-card__date">{{ block.settings.date | escape }}</span>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <div class="tp-dots" id="tp-dots-{{ section.id }}" role="tablist">
          {%- for block in section.blocks -%}
            <button class="tp-dot{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Review {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    var sId = '{{ section.id }}';
    var carousel = document.getElementById('tp-carousel-' + sId);
    var dotsWrap = document.getElementById('tp-dots-' + sId);
    if (!carousel || !dotsWrap) return;
    var dots = dotsWrap.querySelectorAll('.tp-dot');
    var cards = carousel.querySelectorAll('.tp-card');
    function activate(idx) {
      dots.forEach(function(d) { d.classList.remove('is-active'); d.setAttribute('aria-selected','false'); });
      if (dots[idx]) { dots[idx].classList.add('is-active'); dots[idx].setAttribute('aria-selected','true'); }
    }
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(dot.dataset.index, 10);
        if (cards[idx]) carousel.scrollTo({ left: cards[idx].offsetLeft, behavior: 'smooth' });
        activate(idx);
      });
    });
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) activate(parseInt(e.target.dataset.index, 10)); });
    }, { root: carousel, threshold: 0.55 });
    cards.forEach(function(c) { obs.observe(c); });
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === sId) activate(0);
    });
  })();
</script>

