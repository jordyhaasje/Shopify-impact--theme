{% liquid
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
%}

<section class="reviews-showcase" style="padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;">
  <div class="page-width">

    {% if section.settings.eyebrow != blank %}
      <div class="reviews-showcase__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    <h2 class="reviews-showcase__heading">
      {{ section.settings.heading }} <span class="accent">{{ section.settings.heading_accent }}</span>
    </h2>

    {% if section.settings.subheading != blank %}
      <p class="reviews-showcase__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="button reviews-showcase__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}

    <div class="reviews-showcase__cards">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__header">
            {% if block.settings.avatar != blank %}
              {{ block.settings.avatar | image_url: width: 80 | image_tag: class: 'review-card__avatar', alt: block.settings.name }}
            {% endif %}
            <div>
              <div class="review-card__name">{{ block.settings.name }}</div>
              <div class="review-card__role">{{ block.settings.role }}</div>
            </div>
          </div>

          <div class="review-card__stars">
            {% for i in (1..5) %}
              <span class="star {% if i <= block.settings.rating %}filled{% endif %}">★</span>
            {% endfor %}
          </div>

          <div class="review-card__text">
            {{ block.settings.text }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.reviews-showcase { text-align:center; }
.reviews-showcase__eyebrow {
  display:inline-block;
  background:#ffe9e0;
  color:#ff5a1f;
  padding:6px 14px;
  border-radius:999px;
  font-size:12px;
  margin-bottom:16px;
}
.reviews-showcase__heading { font-size:40px; font-weight:600; }
.reviews-showcase__heading .accent { color:#ff5a1f; font-style:italic; }
.reviews-showcase__subheading { color:#777; margin-top:10px; }
.reviews-showcase__button { margin-top:20px; }

.reviews-showcase__cards {
  margin-top:40px;
  display:flex;
  gap:20px;
  overflow-x:auto;
}

.review-card {
  min-width:280px;
  background:#fff;
  border-radius:12px;
  padding:20px;
  text-align:left;
  box-shadow:0 4px 20px rgba(0,0,0,0.05);
}

.review-card__header { display:flex; gap:10px; align-items:center; }
.review-card__avatar { width:40px; height:40px; border-radius:50%; }
.review-card__name { font-weight:600; }
.review-card__role { font-size:12px; color:#888; }

.review-card__stars { color:#00b67a; margin:10px 0; }
.review-card__text { font-size:14px; color:#444; }

@media(min-width: 768px) {
  .reviews-showcase__cards {
    overflow:visible;
    justify-content:center;
  }
  .review-card { min-width:320px; }
}
</style>

{% schema %}
{
  "name": "Reviews Showcase",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Half if the stock is already sold!"},
    {"type":"text","id":"heading","label":"Heading","default":"Why people love"},
    {"type":"text","id":"heading_accent","label":"Accent heading","default":"our brand."},
    {"type":"text","id":"subheading","label":"Subheading","default":"Here's what they have to say"},
    {"type":"text","id":"button_label","label":"Button label","default":"View All Reviews"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":100,"step":4,"default":40},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":100,"step":4,"default":40}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"image_picker","id":"avatar","label":"Avatar"},
        {"type":"text","id":"name","label":"Name","default":"John Doe"},
        {"type":"text","id":"role","label":"Role","default":"Position"},
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"richtext","id":"text","label":"Review text","default":"<p>Great product!</p>"}
      ]
    }
  ],
  "presets": [
    {"name":"Reviews Showcase"}
  ]
}
{% endschema %}