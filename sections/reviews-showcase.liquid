{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --reviews-section-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --reviews-card-background: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
    --reviews-heading-color: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --reviews-text-color: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --reviews-muted-color: {{ section.settings.muted_color.red }}, {{ section.settings.muted_color.green }}, {{ section.settings.muted_color.blue }};
    --reviews-accent-color: {{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }};
    --reviews-badge-background: {{ section.settings.badge_background.red }}, {{ section.settings.badge_background.green }}, {{ section.settings.badge_background.blue }};
    --reviews-badge-text: {{ section.settings.badge_text_color.red }}, {{ section.settings.badge_text_color.green }}, {{ section.settings.badge_text_color.blue }};
    --reviews-button-background: {{ section.settings.button_background.red }}, {{ section.settings.button_background.green }}, {{ section.settings.button_background.blue }};
    --reviews-button-text: {{ section.settings.button_text_color.red }}, {{ section.settings.button_text_color.green }}, {{ section.settings.button_text_color.blue }};
    --reviews-highlight: {{ section.settings.highlight_color.red }}, {{ section.settings.highlight_color.green }}, {{ section.settings.highlight_color.blue }};
    --reviews-stars: {{ section.settings.stars_color.red }}, {{ section.settings.stars_color.green }}, {{ section.settings.stars_color.blue }};
    --reviews-star-empty: {{ section.settings.stars_empty_color.red }}, {{ section.settings.stars_empty_color.green }}, {{ section.settings.stars_empty_color.blue }};
    --reviews-card-radius: {{ section.settings.card_radius }}px;
    --reviews-card-shadow-y: {{ section.settings.card_shadow_y }}px;
    --reviews-card-shadow-blur: {{ section.settings.card_shadow_blur }}px;
    --reviews-card-shadow-opacity: {{ section.settings.card_shadow_opacity | divided_by: 100.0 }};
    --reviews-card-gap: {{ section.settings.card_gap }}px;
    --reviews-desktop-card-width: {{ section.settings.desktop_card_width }}px;
    --reviews-mobile-card-width: {{ section.settings.mobile_card_width }}px;
    --reviews-heading-max: {{ section.settings.heading_max_width }}px;
    --reviews-content-max: {{ section.settings.content_max_width }}px;
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .reviews-showcase {
    background: rgb(var(--reviews-section-background));
  }

  #shopify-section-{{ section.id }} .reviews-showcase__inner {
    display: grid;
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__content {
    max-width: var(--reviews-content-max);
    margin-inline: auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgb(var(--reviews-badge-background));
    color: rgb(var(--reviews-badge-text));
    font-size: 12px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__heading {
    max-width: var(--reviews-heading-max);
    margin: 0 auto;
    color: rgb(var(--reviews-heading-color));
    font-size: clamp(32px, 4vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__heading .accent {
    color: rgb(var(--reviews-accent-color));
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__subheading {
    margin-top: 16px;
    color: rgb(var(--reviews-muted-color));
    font-size: 18px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__subheading p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__actions {
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__cards {
    display: flex;
    gap: var(--reviews-card-gap);
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 0 10px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__cards::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__card {
    flex: 0 0 var(--reviews-mobile-card-width);
    width: var(--reviews-mobile-card-width);
    min-width: var(--reviews-mobile-card-width);
    padding: 24px;
    border-radius: var(--reviews-card-radius);
    background: rgb(var(--reviews-card-background));
    box-shadow: 0 var(--reviews-card-shadow-y) var(--reviews-card-shadow-blur) rgba(18, 18, 18, var(--reviews-card-shadow-opacity));
    text-align: left;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__avatar,
  #shopify-section-{{ section.id }} .reviews-showcase__avatar-placeholder {
    width: 46px;
    height: 46px;
    min-width: 46px;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__avatar {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__avatar-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--reviews-heading-color), 0.08);
    color: rgb(var(--reviews-heading-color));
    font-size: 18px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__name {
    color: rgb(var(--reviews-heading-color));
    font-size: 17px;
    line-height: 1.2;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__role {
    margin-top: 4px;
    color: rgb(var(--reviews-muted-color));
    font-size: 12px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__stars {
    display: flex;
    gap: 4px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 2px;
    background: rgb(var(--reviews-stars));
    color: #fff;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__star.is-empty {
    background: rgb(var(--reviews-star-empty));
  }

  #shopify-section-{{ section.id }} .reviews-showcase__star svg {
    width: 11px;
    height: 11px;
    display: block;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__text {
    color: rgb(var(--reviews-text-color));
    font-size: 14px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .reviews-showcase__text mark {
    background: linear-gradient(transparent 30%, rgba(var(--reviews-highlight), 0.9) 30%, rgba(var(--reviews-highlight), 0.9) 85%, transparent 85%);
    color: inherit;
    padding: 0;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .reviews-showcase__inner {
      gap: 28px;
    }

    #shopify-section-{{ section.id }} .reviews-showcase__heading {
      font-size: clamp(28px, 8.5vw, 40px);
    }

    #shopify-section-{{ section.id }} .reviews-showcase__subheading {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .reviews-showcase__cards {
      padding-inline: 20px;
      margin-inline: -20px;
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .reviews-showcase__cards {
      justify-content: center;
      flex-wrap: nowrap;
    }

    #shopify-section-{{ section.id }} .reviews-showcase__card {
      flex-basis: var(--reviews-desktop-card-width);
      width: var(--reviews-desktop-card-width);
      min-width: 0;
    }
  }
</style>

<section class="reviews-showcase">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">
      <div class="reviews-showcase__inner">
        <div class="reviews-showcase__content">
          {%- if section.settings.badge != blank -%}
            <p class="reviews-showcase__badge">{{ section.settings.badge | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
            <h2 class="reviews-showcase__heading">
              {{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <span class="accent">{{ section.settings.heading_accent | escape }}</span>{% endif %}
            </h2>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <div class="reviews-showcase__subheading rte">
              {{ section.settings.subheading }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="reviews-showcase__actions">
              {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'lg', style: 'fill', background: section.settings.button_background, text_color: section.settings.button_text_color %}
            </div>
          {%- endif -%}
        </div>

        <div class="reviews-showcase__cards" role="list">
          {%- for block in section.blocks -%}
            {%- assign review_text = block.settings.review_text | newline_to_br -%}
            {%- assign highlight_1 = block.settings.highlight_1 | strip -%}
            {%- assign highlight_2 = block.settings.highlight_2 | strip -%}
            {%- assign highlight_3 = block.settings.highlight_3 | strip -%}

            {%- if highlight_1 != blank -%}
              {%- capture replacement_1 -%}<mark>{{ highlight_1 }}</mark>{%- endcapture -%}
              {%- assign review_text = review_text | replace: highlight_1, replacement_1 -%}
            {%- endif -%}
            {%- if highlight_2 != blank -%}
              {%- capture replacement_2 -%}<mark>{{ highlight_2 }}</mark>{%- endcapture -%}
              {%- assign review_text = review_text | replace: highlight_2, replacement_2 -%}
            {%- endif -%}
            {%- if highlight_3 != blank -%}
              {%- capture replacement_3 -%}<mark>{{ highlight_3 }}</mark>{%- endcapture -%}
              {%- assign review_text = review_text | replace: highlight_3, replacement_3 -%}
            {%- endif -%}

            <article class="reviews-showcase__card" role="listitem" {{ block.shopify_attributes }}>
              <div class="reviews-showcase__card-header">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 92 | image_tag: loading: 'lazy', widths: '46,92', class: 'reviews-showcase__avatar', alt: block.settings.name }}
                {%- else -%}
                  <span class="reviews-showcase__avatar-placeholder">{{ block.settings.name | strip | slice: 0, 1 }}</span>
                {%- endif -%}

                <div>
                  <div class="reviews-showcase__name">{{ block.settings.name | escape }}</div>
                  <div class="reviews-showcase__role">{{ block.settings.role | escape }}</div>
                </div>
              </div>

              <div class="reviews-showcase__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <span class="reviews-showcase__star {% if i > block.settings.rating %}is-empty{% endif %}">
                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                      <path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z" fill="currentColor"></path>
                    </svg>
                  </span>
                {%- endfor -%}
              </div>

              <div class="reviews-showcase__text rte">
                <p>{{ review_text }}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews showcase",
  "tag": "section",
  "class": "shopify-section--reviews-showcase",
  "settings": [
    {"type":"text","id":"badge","label":"Badge text","default":"Halvdelen af lageret er allerede udsolgt!"},
    {"type":"text","id":"heading","label":"Heading","default":"Derfor elsker folk"},
    {"type":"text","id":"heading_accent","label":"Heading accent","default":"vores brand."},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Her er, hvad de har at sige</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Se alle anmeldelser"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"section_spacing","label":"Section spacing","min":0,"max":80,"step":4,"default":48},
    {"type":"range","id":"content_max_width","label":"Content max width","min":600,"max":1200,"step":20,"default":840},
    {"type":"range","id":"heading_max_width","label":"Heading max width","min":400,"max":1000,"step":20,"default":760},
    {"type":"range","id":"desktop_card_width","label":"Desktop card width","min":220,"max":360,"step":4,"default":284},
    {"type":"range","id":"mobile_card_width","label":"Mobile card width","min":220,"max":320,"step":4,"default":252},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":32,"step":2,"default":20},
    {"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"default":22},
    {"type":"range","id":"card_shadow_y","label":"Card shadow Y offset","min":0,"max":32,"step":1,"default":18},
    {"type":"range","id":"card_shadow_blur","label":"Card shadow blur","min":0,"max":80,"step":2,"default":50},
    {"type":"range","id":"card_shadow_opacity","label":"Card shadow opacity","min":0,"max":20,"step":1,"default":6},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background","label":"Section background","default":"#F7F7F7"},
    {"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#222738"},
    {"type":"color","id":"text_color","label":"Review text color","default":"#4E5566"},
    {"type":"color","id":"muted_color","label":"Muted text color","default":"#7A8193"},
    {"type":"color","id":"accent_color","label":"Accent color","default":"#FF642D"},
    {"type":"color","id":"badge_background","label":"Badge background","default":"#FFE8DE"},
    {"type":"color","id":"badge_text_color","label":"Badge text color","default":"#FF642D"},
    {"type":"color","id":"button_background","label":"Button background","default":"#FF642D"},
    {"type":"color","id":"button_text_color","label":"Button text color","default":"#FFFFFF"},
    {"type":"color","id":"highlight_color","label":"Highlight color","default":"#F4E49F"},
    {"type":"color","id":"stars_color","label":"Filled star color","default":"#00B67A"},
    {"type":"color","id":"stars_empty_color","label":"Empty star color","default":"#D9DDE3"}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"image_picker","id":"avatar","label":"Avatar"},
        {"type":"text","id":"name","label":"Reviewer name","default":"Sofie Jensen"},
        {"type":"text","id":"role","label":"Reviewer role","default":"Driftschef hos..."},
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"textarea","id":"review_text","label":"Review text","default":"Jeg var skeptisk i starten, men efter den 14-dages prøveperiode kunne jeg slet ikke forestille mig at gå tilbage til regneark. Brugerfladen er utrolig intuitiv, og integrationen med Slack gør kommunikationen helt problemfri."},
        {"type":"text","id":"highlight_1","label":"Highlight phrase 1","default":"utrolig intuitiv"},
        {"type":"text","id":"highlight_2","label":"Highlight phrase 2"},
        {"type":"text","id":"highlight_3","label":"Highlight phrase 3"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews showcase",
      "blocks": [
        {"type":"review","settings":{"name":"Sofie Jensen","role":"Driftschef hos...","rating":4,"review_text":"Jeg var skeptisk i starten, men efter den 14-dages prøveperiode kunne jeg slet ikke forestille mig at gå tilbage til regneark. Brugerfladen er utrolig intuitiv, og integrationen med Slack gør kommunikationen helt problemfri. De avancerede funktioner har virkelig revolutioneret min arbejdsdag, sparet mig værdifuld tid og reduceret fejl.","highlight_1":"utrolig intuitiv"}},
        {"type":"review","settings":{"name":"Mikkel Thorne","role":"Founder & CEO, Thorne...","rating":5,"review_text":"Vi prøvede omkring fem forskellige platforme, før vi landede på denne. Den rammer den perfekte balance mellem avancerede funktioner og at være så enkel, at nye medarbejdere kan lære den på én dag.","highlight_1":"perfekte balance mellem avancerede funktioner og at være så enkel"}},
        {"type":"review","settings":{"name":"David Chen","role":"Freelance webudvikler","rating":5,"review_text":"Jeg skriver sjældent anmeldelser, men jeg var nødt til at rose supportteamet. Jeg havde et synkroniseringsproblem en søndag, og Mark løste det inden for 20 minutter. Fantastisk produkt, endnu bedre mennesker.","highlight_1":"Fantastisk produkt, endnu bedre mennesker"}},
        {"type":"review","settings":{"name":"Jessica Park","role":"Kreativ leder","rating":5,"review_text":"Jeg var virkelig nervøs for at flytte vores data fra det gamle system. Onboarding-teamet klarede det hele, og vi var oppe at køre uden nogen nedetid. Fantastisk service.","highlight_1":"uden nogen nedetid"}}
      ]
    }
  ]
}
{% endschema %}