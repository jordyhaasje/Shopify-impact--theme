{{ 'jsections-beauty-product-carousel.css' | asset_url | stylesheet_tag }}

{% liquid
  assign sid = section.id
%}

<section
  id="jsections-beauty-product-carousel-{{ sid }}"
  class="jbpc{% if section.settings.full_width %} jbpc--full{% endif %}"
  style="
    --jbpc-text: {{ section.settings.text_color }};
    --jbpc-muted: {{ section.settings.muted_color }};
    --jbpc-card-bg: {{ section.settings.card_background }};
    --jbpc-badge-bg: {{ section.settings.badge_background }};
    --jbpc-radius: {{ section.settings.corner_radius }}px;
  "
  data-jbpc-section
>
  <div class="jbpc__slider" data-jbpc-slider>
    <div class="jbpc__track" data-jbpc-track>
      {% for block in section.blocks %}
        {% liquid
          assign card_product = block.settings.product
          assign title = block.settings.title
          assign price = block.settings.price
          assign image = block.settings.image
          assign hover_image = block.settings.hover_image
          assign selected_variant = blank
          if card_product != blank
            assign selected_variant = card_product.selected_or_first_available_variant
            if title == blank
              assign title = card_product.title
            endif
            if price == blank
              assign price = card_product.price | money
            endif
            if image == blank
              assign image = card_product.featured_image
            endif
            if hover_image == blank
              for product_image in card_product.images
                if image == blank or product_image.id != image.id
                  assign hover_image = product_image
                  break
                endif
              endfor
            endif
          endif
          if title == blank
            assign title = block.settings.heading
          endif
        %}
        <article class="jbpc-card" data-jbpc-card {{ block.shopify_attributes }}>
          <a class="jbpc-card__image-link" href="{{ card_product.url | default: block.settings.link | default: routes.root_url }}" aria-label="{{ title | escape }}">
            {% if image != blank %}
              {{ image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'jbpc-card__image jbpc-card__image--main', sizes: '(min-width: 990px) 440px, 84vw', alt: title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'jbpc-card__placeholder' }}
            {% endif %}
            {% if hover_image != blank %}
              {{ hover_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'jbpc-card__image jbpc-card__image--hover', sizes: '(min-width: 990px) 440px, 84vw', alt: title }}
            {% endif %}
          </a>

          <div class="jbpc-card__top">
            {% if block.settings.heading != blank %}
              <p class="jbpc-card__heading">{{ block.settings.heading }}</p>
            {% endif %}
            {% if block.settings.badge != blank %}
              <span class="jbpc-card__badge">{{ block.settings.badge }}</span>
            {% endif %}
          </div>

          <div class="jbpc-card__bottom">
            <div class="jbpc-card__title-row">
              <p class="jbpc-card__title">{{ title }}</p>
              <p class="jbpc-card__price">{{ price }}</p>
            </div>
            {% if block.settings.details != blank %}
              <p class="jbpc-card__details">{{ block.settings.details }}</p>
            {% endif %}
            {% if card_product != blank and selected_variant != blank %}
              {% form 'product', card_product, class: 'jbpc-card__form' %}
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                <button class="jbpc-card__quick" type="submit">{{ section.settings.quick_add_label }}</button>
              {% endform %}
            {% else %}
              <a class="jbpc-card__quick" href="{{ block.settings.link | default: routes.root_url }}">{{ section.settings.quick_add_label }}</a>
            {% endif %}
          </div>

          <div class="jbpc-card__drawer" data-jbpc-drawer>
            <div class="jbpc-card__drawer-head">
              <p>{{ section.settings.option_label }}</p>
              <button type="button" data-jbpc-close aria-label="Close">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
              </button>
            </div>
            {% if card_product != blank and selected_variant != blank %}
              {% form 'product', card_product, class: 'jbpc-card__drawer-form' %}
                <label class="jbpc-card__select-label" for="jbpc-variant-{{ section.id }}-{{ block.id }}">{{ section.settings.option_label }}</label>
                <select class="jbpc-card__select" id="jbpc-variant-{{ section.id }}-{{ block.id }}" name="id">
                  {% for variant in card_product.variants %}
                    <option value="{{ variant.id }}"{% if variant.id == selected_variant.id %} selected{% endif %}>{{ variant.title }}</option>
                  {% endfor %}
                </select>
                <button class="jbpc-card__quick" type="submit">{{ section.settings.quick_add_label }}</button>
              {% endform %}
            {% else %}
              <select class="jbpc-card__select" aria-label="{{ section.settings.option_label }}">
                <option>Single pack</option>
                <option>2 pack</option>
                <option>3 pack</option>
              </select>
              <a class="jbpc-card__quick" href="{{ block.settings.link | default: routes.root_url }}">{{ section.settings.quick_add_label }}</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 3 %}
      <button class="jbpc__next" type="button" data-jbpc-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const init = (root) => {
      if (!root || root.dataset.jbpcReady === 'true') return;
      root.dataset.jbpcReady = 'true';
      const track = root.querySelector('[data-jbpc-track]');
      const next = root.querySelector('[data-jbpc-next]');
      if (track && next) {
        next.addEventListener('click', () => {
          const first = track.querySelector('.jbpc-card');
          track.scrollBy({ left: first ? first.offsetWidth + 40 : track.clientWidth, behavior: 'smooth' });
        });
      }
      root.querySelectorAll('[data-jbpc-card]').forEach((card) => {
        const quick = card.querySelector('.jbpc-card__bottom .jbpc-card__quick');
        const close = card.querySelector('[data-jbpc-close]');
        const drawer = card.querySelector('[data-jbpc-drawer]');
        if (!quick || !drawer) return;
        quick.addEventListener('click', (event) => {
          if (quick.tagName === 'BUTTON') event.preventDefault();
          card.classList.add('is-open');
        });
        if (close) close.addEventListener('click', () => card.classList.remove('is-open'));
      });
    };
    const root = document.getElementById('jsections-beauty-product-carousel-{{ sid }}');
    init(root);
    document.addEventListener('shopify:section:load', (event) => {
      init(event.target.querySelector('#jsections-beauty-product-carousel-{{ sid }}'));
    });
  })();
</script>

{% schema %}
{
  "name": "Beauty product carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Use full viewport width",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_add_label",
      "label": "Quick add label",
      "default": "QUICK ADD"
    },
    {
      "type": "text",
      "id": "option_label",
      "label": "Option label",
      "default": "Select option"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f1f0ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#67645e"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text color",
      "default": "#84827e"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#67645e"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Shopify product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "New"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Large label",
          "default": "mood"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product title",
          "default": "Mood Patches"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price fallback",
          "default": "$24.99"
        },
        {
          "type": "text",
          "id": "details",
          "label": "Details",
          "default": "30 patches in each pack"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty product carousel",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "heading": "mood",
            "title": "Mood Patches"
          }
        },
        {
          "type": "product",
          "settings": {
            "heading": "recover",
            "title": "Recovery Patches"
          }
        },
        {
          "type": "product",
          "settings": {
            "heading": "boost",
            "title": "Boost Patches"
          }
        },
        {
          "type": "product",
          "settings": {
            "heading": "sleep",
            "title": "Sleep Patches"
          }
        }
      ]
    }
  ]
}
{% endschema %}
