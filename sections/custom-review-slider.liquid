{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --crs-bg: {{ section.settings.background_color }};
    --crs-card: {{ section.settings.card_color }};
    --crs-text: {{ section.settings.text_color }};
    --crs-muted: {{ section.settings.muted_text_color }};
    --crs-accent: {{ section.settings.accent_color }};
    --crs-border: color-mix(in srgb, var(--crs-text) 12%, transparent);
    --crs-shadow: 0 24px 70px rgba(16, 16, 16, .10);
  }

  #shopify-section-{{ section.id }} .crs {
    position: relative;
    overflow: hidden;
    color: var(--crs-text);
    background:
      radial-gradient(circle at 12% 12%, color-mix(in srgb, var(--crs-accent) 22%, transparent) 0, transparent 28%),
      radial-gradient(circle at 88% 16%, color-mix(in srgb, var(--crs-accent) 16%, transparent) 0, transparent 26%),
      linear-gradient(180deg, color-mix(in srgb, var(--crs-bg) 86%, #ffffff) 0%, var(--crs-bg) 100%);
  }

  #shopify-section-{{ section.id }} .crs__shell {
    max-width: {{ section.settings.content_width }}px;
    margin-inline: auto;
    padding: {{ section.settings.padding_y }}px 20px;
  }

  #shopify-section-{{ section.id }} .crs__header {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 14px;
    margin: 0 auto clamp(28px, 4vw, 44px);
    max-width: 820px;
  }

  #shopify-section-{{ section.id }} .crs__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid var(--crs-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--crs-card) 78%, transparent);
    backdrop-filter: blur(10px);
    color: var(--crs-muted);
    font-size: 11px;
    font-weight: 760;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .crs__title {
    position: relative;
    margin: 0;
    color: var(--crs-text);
    font-family: var(--heading-font-family);
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  #shopify-section-{{ section.id }} .crs__title::before,
  #shopify-section-{{ section.id }} .crs__title::after {
    position: absolute;
    color: var(--crs-accent);
    font-size: 1.08em;
    line-height: 1;
    opacity: .9;
    animation: crsQuoteFloat 3.4s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .crs__title::before {
    content: '“';
    left: clamp(-30px, -4vw, -18px);
    top: -.20em;
  }

  #shopify-section-{{ section.id }} .crs__title::after {
    content: '”';
    right: clamp(-30px, -4vw, -18px);
    bottom: -.34em;
    animation-delay: .6s;
  }

  #shopify-section-{{ section.id }} .crs__title span {
    display: inline-block;
    background: linear-gradient(90deg, var(--crs-text), color-mix(in srgb, var(--crs-accent) 82%, var(--crs-text)), var(--crs-text));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: crsHeadlineShine 5.5s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .crs__intro {
    max-width: 620px;
    margin: 0;
    color: var(--crs-muted);
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .crs__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 40px) / 3);
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 6px 2px 18px;
  }

  #shopify-section-{{ section.id }} .crs__track::-webkit-scrollbar { display: none; }

  #shopify-section-{{ section.id }} .crs__slide {
    scroll-snap-align: start;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .crs-card {
    height: 100%;
    min-height: 318px;
    padding: clamp(20px, 2.4vw, 26px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    border: 1px solid var(--crs-border);
    border-radius: 28px;
    background: color-mix(in srgb, var(--crs-card) 92%, transparent);
    box-shadow: var(--crs-shadow);
    backdrop-filter: blur(14px);
    transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
  }

  #shopify-section-{{ section.id }} .crs-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--crs-accent) 44%, var(--crs-border));
    box-shadow: 0 28px 88px rgba(16, 16, 16, .14);
  }

  #shopify-section-{{ section.id }} .crs-card__top {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .crs-card__avatar {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    overflow: hidden;
    border: 2px solid color-mix(in srgb, var(--crs-accent) 35%, #fff);
    background: linear-gradient(135deg, color-mix(in srgb, var(--crs-accent) 28%, #fff), #fff);
    color: var(--crs-text);
    font-size: 17px;
    font-weight: 800;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .crs-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .crs-card__name {
    margin: 0;
    color: var(--crs-text);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .crs-card__date {
    margin-top: 4px;
    color: var(--crs-muted);
    font-size: 12px;
    font-weight: 650;
  }

  #shopify-section-{{ section.id }} .crs-card__quote-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    margin-left: auto;
    background: color-mix(in srgb, var(--crs-accent) 14%, #fff);
    color: var(--crs-accent);
    font-family: Georgia, serif;
    font-size: 30px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .crs-card__rating {
    display: inline-flex;
    gap: 3px;
    margin-bottom: 12px;
    color: var(--crs-accent);
    font-size: 14px;
    letter-spacing: .04em;
  }

  #shopify-section-{{ section.id }} .crs-card__title {
    margin: 0 0 12px;
    color: var(--crs-text);
    font-family: var(--heading-font-family);
    font-size: clamp(21px, 2vw, 28px);
    line-height: 1.12;
    letter-spacing: -.035em;
  }

  #shopify-section-{{ section.id }} .crs-card__text {
    margin: 0;
    color: var(--crs-muted);
    font-size: 14px;
    line-height: 1.72;
  }

  #shopify-section-{{ section.id }} .crs__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .crs__button {
    width: 46px;
    height: 46px;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--crs-border);
    background: var(--crs-card);
    color: var(--crs-text);
    cursor: pointer;
    transition: transform .2s ease, background .2s ease, color .2s ease;
  }

  #shopify-section-{{ section.id }} .crs__button:hover {
    transform: translateY(-2px);
    background: var(--crs-text);
    color: var(--crs-card);
  }

  #shopify-section-{{ section.id }} .crs__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 56px;
  }

  #shopify-section-{{ section.id }} .crs__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--crs-text) 22%, transparent);
    cursor: pointer;
    transition: width .24s ease, background .24s ease;
  }

  #shopify-section-{{ section.id }} .crs__dot[aria-current="true"] {
    width: 24px;
    background: var(--crs-accent);
  }

  @keyframes crsHeadlineShine {
    0%, 100% { background-position: 0% 50%; transform: translateY(0); }
    50% { background-position: 100% 50%; transform: translateY(-2px); }
  }

  @keyframes crsQuoteFloat {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-8px) rotate(4deg); }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .crs__track {
      grid-auto-columns: calc((100% - 20px) / 2);
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .crs__shell {
      padding: {{ section.settings.mobile_padding_y }}px 16px;
    }

    #shopify-section-{{ section.id }} .crs__header {
      margin-bottom: 24px;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .crs__title {
      max-width: 310px;
      font-size: clamp(23px, 8vw, 30px);
      line-height: 1.08;
    }

    #shopify-section-{{ section.id }} .crs__title::before { left: -18px; }
    #shopify-section-{{ section.id }} .crs__title::after { right: -18px; }

    #shopify-section-{{ section.id }} .crs__track {
      grid-auto-columns: 86%;
      gap: 14px;
      padding-inline: 1px;
    }

    #shopify-section-{{ section.id }} .crs-card {
      min-height: 292px;
      border-radius: 24px;
      padding: 22px;
    }

    #shopify-section-{{ section.id }} .crs-card__avatar {
      width: 52px;
      height: 52px;
    }

    #shopify-section-{{ section.id }} .crs-card__quote-mark {
      width: 36px;
      height: 36px;
      font-size: 28px;
    }
  }
</style>

<section class="crs" data-custom-review-slider data-section-id="{{ section.id }}">
  <div class="crs__shell" data-section-bounded-shell>
    <div class="crs__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="crs__eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}

      <h2 class="crs__title"><span>{{ section.settings.heading | escape }}</span></h2>

      {%- if section.settings.intro != blank -%}
        <div class="crs__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <div class="crs__viewport">
      <div class="crs__track" data-section-slider aria-label="Customer reviews">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <article class="crs__slide" data-section-slide {{ block.shopify_attributes }}>
              <div class="crs-card" data-section-review-item>
                <div class="crs-card__top">
                  <div class="crs-card__avatar">
                    {%- if block.settings.avatar != blank -%}
                      {{ block.settings.avatar | image_url: width: 140 | image_tag: loading: 'lazy', widths: '70,100,140', alt: block.settings.reviewer_name }}
                    {%- else -%}
                      {{ block.settings.reviewer_name | default: 'C' | slice: 0 | upcase }}
                    {%- endif -%}
                  </div>

                  <div>
                    <p class="crs-card__name">{{ block.settings.reviewer_name | escape }}</p>
                    {%- if block.settings.review_date != blank -%}
                      <div class="crs-card__date">{{ block.settings.review_date | escape }}</div>
                    {%- endif -%}
                  </div>

                  <div class="crs-card__quote-mark" aria-hidden="true">“</div>
                </div>

                <div class="crs-card__body">
                  <div class="crs-card__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {%- for i in (1..5) -%}<span>{%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}</span>{%- endfor -%}
                  </div>

                  {%- if block.settings.review_title != blank -%}
                    <h3 class="crs-card__title">{{ block.settings.review_title | escape }}</h3>
                  {%- endif -%}

                  {%- if block.settings.review_text != blank -%}
                    <p class="crs-card__text">{{ block.settings.review_text | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="crs__controls" aria-label="Review slider controls">
        <button class="crs__button" type="button" data-crs-prev aria-label="Previous review">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="crs__dots" data-crs-dots aria-hidden="false"></div>
        <button class="crs__button" type="button" data-crs-next aria-label="Next review">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const script = document.currentScript;
    const root = script ? script.previousElementSibling : null;

    const initReviewSlider = (section) => {
      if (!section || section.dataset.crsReady === 'true') return;
      section.dataset.crsReady = 'true';

      const track = section.querySelector('[data-section-slider]');
      const slides = Array.from(section.querySelectorAll('[data-section-slide]'));
      const prev = section.querySelector('[data-crs-prev]');
      const next = section.querySelector('[data-crs-next]');
      const dotsWrap = section.querySelector('[data-crs-dots]');

      if (!track || slides.length === 0 || !dotsWrap) return;

      const getStep = () => {
        const first = slides[0];
        const styles = window.getComputedStyle(track);
        const gap = parseFloat(styles.columnGap || styles.gap || '0');
        return first.getBoundingClientRect().width + gap;
      };

      const getIndex = () => Math.round(track.scrollLeft / Math.max(getStep(), 1));

      const goTo = (index) => {
        const max = slides.length - 1;
        const target = Math.max(0, Math.min(index, max));
        track.scrollTo({ left: target * getStep(), behavior: 'smooth' });
      };

      const updateDots = () => {
        const index = getIndex();
        Array.from(dotsWrap.children).forEach((dot, dotIndex) => {
          dot.setAttribute('aria-current', dotIndex === index ? 'true' : 'false');
        });
      };

      dotsWrap.innerHTML = '';
      slides.forEach((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'crs__dot';
        dot.setAttribute('aria-label', 'Go to review ' + (index + 1));
        dot.setAttribute('aria-current', index === 0 ? 'true' : 'false');
        dot.addEventListener('click', () => goTo(index));
        dotsWrap.appendChild(dot);
      });

      if (prev) prev.addEventListener('click', () => goTo(getIndex() - 1));
      if (next) next.addEventListener('click', () => goTo(getIndex() + 1));

      track.addEventListener('scroll', () => window.requestAnimationFrame(updateDots), { passive: true });
      window.addEventListener('resize', updateDots, { passive: true });
      updateDots();
    };

    initReviewSlider(root);

    document.addEventListener('shopify:section:load', (event) => {
      const loadedRoot = event.target && event.target.querySelector ? event.target.querySelector('[data-custom-review-slider]') : null;
      initReviewSlider(loadedRoot);
    });
  })();
</script>

{% schema %}
{
  "name": "Custom review slider",
  "class": "shopify-section--custom-review-slider",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer stories" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "What customers says about us" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Real feedback from customers who love the experience, quality and service.</p>" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 900, "max": 1120, "step": 20, "unit": "px", "default": 1060 },
    { "type": "range", "id": "padding_y", "label": "Desktop vertical padding", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "mobile_padding_y", "label": "Mobile vertical padding", "min": 36, "max": 84, "step": 4, "unit": "px", "default": 52 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f7f5f2" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#68625d" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#a88f7b" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Reviewer avatar" },
        { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Sophie M." },
        { "type": "text", "id": "review_date", "label": "Date", "default": "12 April 2026" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "review_title", "label": "Review title", "default": "Absolutely love it" },
        { "type": "textarea", "id": "review_text", "label": "Review text", "default": "The product feels premium, the delivery was smooth and the overall experience was better than expected." }
      ]
    }
  ],
  "presets": [
