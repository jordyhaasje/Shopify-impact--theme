{{ 'jsections-beauty-template-1.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign product_cards = section.blocks | where: 'type', 'product_card'
  assign split_slides = section.blocks | where: 'type', 'split_slide'
  assign gallery_images = section.blocks | where: 'type', 'gallery_image'
  assign ingredient_tabs = section.blocks | where: 'type', 'ingredient_tab'
  assign reviews = section.blocks | where: 'type', 'review'
  assign product_section_block = blank
  assign split_section_block = blank
  assign gallery_section_block = blank
  assign tabs_section_block = blank
  assign reviews_section_block = blank
  assign product_order = 999
  assign split_order = 999
  assign gallery_order = 999
  assign tabs_order = 999
  assign reviews_order = 999

  for order_block in section.blocks
    if order_block.type == 'product_carousel_section' and product_order == 999
      assign product_order = forloop.index
      assign product_section_block = order_block
    elsif order_block.type == 'split_showcase_section' and split_order == 999
      assign split_order = forloop.index
      assign split_section_block = order_block
    elsif order_block.type == 'gallery_section' and gallery_order == 999
      assign gallery_order = forloop.index
      assign gallery_section_block = order_block
    elsif order_block.type == 'ingredient_tabs_section' and tabs_order == 999
      assign tabs_order = forloop.index
      assign tabs_section_block = order_block
    elsif order_block.type == 'reviews_section' and reviews_order == 999
      assign reviews_order = forloop.index
      assign reviews_section_block = order_block
    endif
  endfor

  for order_block in section.blocks
    if order_block.type == 'product_card' and product_order == 999
      assign product_order = forloop.index
    elsif order_block.type == 'split_slide' and split_order == 999
      assign split_order = forloop.index
    elsif order_block.type == 'gallery_image' and gallery_order == 999
      assign gallery_order = forloop.index
    elsif order_block.type == 'ingredient_tab' and tabs_order == 999
      assign tabs_order = forloop.index
    elsif order_block.type == 'review' and reviews_order == 999
      assign reviews_order = forloop.index
    endif
  endfor

  assign gallery_heading = section.settings.gallery_heading
  assign gallery_button_label = section.settings.gallery_button_label
  assign gallery_button_link = section.settings.gallery_button_link
  if gallery_section_block != blank
    assign gallery_heading = gallery_section_block.settings.heading
    assign gallery_button_label = gallery_section_block.settings.button_label
    assign gallery_button_link = gallery_section_block.settings.button_link
  endif

  assign reviews_heading = section.settings.reviews_heading
  assign reviews_text = section.settings.reviews_text
  if reviews_section_block != blank
    assign reviews_heading = reviews_section_block.settings.heading
    assign reviews_text = reviews_section_block.settings.text
  endif

  assign quick_add_label = section.settings.quick_add_label
  assign option_label = section.settings.option_label
  if product_section_block != blank
    assign quick_add_label = product_section_block.settings.quick_add_label
    assign option_label = product_section_block.settings.option_label
  endif

  assign view_product_label = section.settings.view_product_label
  if split_section_block != blank
    assign view_product_label = split_section_block.settings.button_label
  endif
-%}

<section
  id="jsections-beauty-template-1-{{ sid }}"
  class="jsections-beauty-template-1{% if section.settings.full_width %} jsections-beauty-template-1--full{% endif %}"
  style="
    --hz-bt-gap: {{ section.settings.block_gap }}px;
    --hz-bt-radius: {{ section.settings.corner_radius }}px;
    --hz-bt-page-width: {{ section.settings.page_width }}px;
    --hz-bt-margin-top: {{ section.settings.margin_top }}px;
    --hz-bt-padding-top: {{ section.settings.padding_top }}px;
    --hz-bt-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hz-bt-side-padding-desktop: {{ section.settings.side_padding_desktop }}px;
    --hz-bt-side-padding-mobile: {{ section.settings.side_padding_mobile }}px;
    --hz-bt-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --hz-bt-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --hz-bt-body-size-desktop: {{ section.settings.body_size_desktop }}px;
    --hz-bt-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --hz-bt-button-size: {{ section.settings.button_font_size }}px;
    --hz-bt-product-card-desktop-width: {{ section.settings.product_card_width_desktop }}%;
    --hz-bt-product-card-mobile-width: {{ section.settings.product_card_width_mobile }}%;
    --hz-bt-product-card-desktop-height: {{ section.settings.product_card_height_desktop }}px;
    --hz-bt-product-card-mobile-height: {{ section.settings.product_card_height_mobile }}px;
    --hz-bt-split-desktop-height: {{ section.settings.split_desktop_height }}px;
    --hz-bt-split-mobile-media-height: {{ section.settings.split_mobile_media_height }}px;
    --hz-bt-gallery-card-desktop-width: {{ section.settings.gallery_card_width_desktop }}%;
    --hz-bt-gallery-card-mobile-width: {{ section.settings.gallery_card_width_mobile }}%;
    --hz-bt-gallery-card-height: {{ section.settings.gallery_card_height }}px;
    --hz-bt-tabs-height: {{ section.settings.tabs_desktop_height }}px;
    --hz-bt-review-card-desktop-width: {{ section.settings.review_card_width_desktop }}%;
    --hz-bt-review-card-mobile-width: {{ section.settings.review_card_width_mobile }}%;
    --hz-bt-review-image-height: {{ section.settings.review_image_height }}px;
    --hz-bt-marquee-width: {{ section.settings.marquee_width_desktop }}px;
    --hz-bt-marquee-size-desktop: {{ section.settings.marquee_font_size_desktop }}px;
    --hz-bt-marquee-size-mobile: {{ section.settings.marquee_font_size_mobile }}px;
    --hz-bt-marquee-speed: {{ section.settings.marquee_speed }}s;
    --hz-bt-bg: {{ section.settings.background_color }};
    --hz-bt-panel: {{ section.settings.panel_background }};
    --hz-bt-text: {{ section.settings.text_color }};
    --hz-bt-muted: {{ section.settings.muted_text_color }};
    --hz-bt-button-bg: {{ section.settings.button_background }};
    --hz-bt-button-text: {{ section.settings.button_text_color }};
    --hz-bt-star: {{ section.settings.star_color }};
  "
>
  <div class="hz-bt__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'video_hero' -%}
        <div
          class="hz-bt__hero hz-bt__module"
          style="
            order: {{ forloop.index }};
            --hz-bt-hero-desktop: {{ block.settings.desktop_height }}px;
            --hz-bt-hero-mobile: {{ block.settings.mobile_height }}px;
            --hz-bt-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
            --hz-bt-hero-x: {{ block.settings.text_horizontal_position }};
            --hz-bt-hero-y: {{ block.settings.text_vertical_position }};
            --hz-bt-hero-align: {{ block.settings.text_alignment }};
            --hz-bt-hero-heading-size: {{ block.settings.heading_size }}px;
            --hz-bt-hero-text-size: {{ block.settings.text_size }}px;
            --hz-bt-hero-media-position: {{ block.settings.media_position }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="hz-bt__hero-media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                  class: 'hz-bt__hero-video',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  preload: 'metadata'
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  class: 'hz-bt__media-img',
                  loading: 'eager',
                  sizes: '100vw',
                  alt: block.settings.heading
              }}
            {%- else -%}
              <div class="hz-bt__placeholder hz-bt__placeholder--hero">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'hz-bt__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="hz-bt__hero-shade" aria-hidden="true"></div>
          <div class="hz-bt__hero-content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="hz-bt__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="hz-bt__hero-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="hz-bt__hero-text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="hz-bt__pill hz-bt__pill--light" href="{{ block.settings.button_link | default: '#' }}">
                {{ block.settings.button_label }}
              </a>
            {%- endif -%}
          </div>
          {%- if block.settings.show_play_control -%}
            <button class="hz-bt__video-toggle" type="button" data-hz-video-toggle aria-label="Pause video">
              <span class="hz-bt__video-icon" aria-hidden="true"></span>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if product_cards.size > 0 -%}
      <div
        class="hz-bt__module hz-bt__product-carousel"
        data-hz-slider="products"
        style="
          order: {{ product_order }};
          {% if product_section_block != blank %}
            --hz-bt-product-card-desktop-width: {{ product_section_block.settings.card_width_desktop }}%;
            --hz-bt-product-card-mobile-width: {{ product_section_block.settings.card_width_mobile }}%;
            --hz-bt-product-card-desktop-height: {{ product_section_block.settings.card_height_desktop }}px;
            --hz-bt-product-card-mobile-height: {{ product_section_block.settings.card_height_mobile }}px;
            --hz-bt-product-card-gap: {{ product_section_block.settings.card_gap }}px;
          {% endif %}
        "
        {% if product_section_block != blank %}{{ product_section_block.shopify_attributes }}{% endif %}
      >
        <div class="hz-bt__slider-viewport" data-hz-slider-viewport>
          <div class="hz-bt__product-track" data-hz-slider-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'product_card' -%}
                {%- liquid
                  assign product = block.settings.product
                  assign primary_image = block.settings.image
                  assign secondary_image = block.settings.hover_image
                  assign uses_product_image = false
                  assign use_product_image_fallback = block.settings.use_product_image_fallback
                  assign image_mode = block.settings.image_mode | default: 'auto'
                  assign title = block.settings.title
                  assign price_text = block.settings.price_fallback
                  assign product_url = block.settings.link
                  if product != blank
                    if title == blank
                      assign title = product.title
                    endif
                    if price_text == blank
                      assign price_text = product.price | money
                    endif
                    if product_url == blank
                      assign product_url = product.url
                    endif
                    if use_product_image_fallback
                      if primary_image == blank and product.featured_image != blank
                        assign primary_image = product.featured_image
                        assign uses_product_image = true
                      endif
                      if secondary_image == blank
                        assign product_image_index = 0
                        for media in product.media
                          if media.media_type == 'image'
                            assign product_image_index = product_image_index | plus: 1
                            if product_image_index == 2
                              assign secondary_image = media
                              break
                            endif
                          endif
                        endfor
                      endif
                    endif
                  endif
                  assign resolved_image_mode = image_mode
                  if image_mode == 'auto'
                    assign resolved_image_mode = 'contain'
                    if product == blank and primary_image != blank and uses_product_image == false
                      assign resolved_image_mode = 'cover'
                    endif
                  endif
                -%}
                <article
                  class="hz-bt__product-card hz-bt__product-card--{{ resolved_image_mode }}"
                  style="
                    --hz-bt-product-card-bg: {{ block.settings.product_background }};
                    --hz-bt-product-image-scale: {{ block.settings.product_image_scale | divided_by: 100.0 }};
                    --hz-bt-product-image-offset-y: {{ block.settings.product_image_offset_y }}px;
                    --hz-bt-product-image-position: {{ block.settings.image_position }};
                  "
                  {{ block.shopify_attributes }}
                >
                  <a class="hz-bt__product-media" href="{{ product_url | default: '#' }}">
                    {%- if primary_image != blank -%}
                      {{
                        primary_image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'hz-bt__product-img hz-bt__product-img--primary',
                          loading: 'lazy',
                          sizes: '(min-width: 990px) 31vw, 82vw',
                          alt: title
                      }}
                    {%- else -%}
                      <span class="hz-bt__product-placeholder" aria-hidden="true">
                        <span class="hz-bt__product-pack">
                          <span class="hz-bt__product-pack-title">{{ title | default: 'Product' }}</span>
                          <span class="hz-bt__product-pack-flower"></span>
                        </span>
                      </span>
                    {%- endif -%}
                    {%- if secondary_image != blank -%}
                      {{
                        secondary_image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'hz-bt__product-img hz-bt__product-img--hover',
                          loading: 'lazy',
                          sizes: '(min-width: 990px) 31vw, 82vw',
                          alt: title
                      }}
                    {%- endif -%}
                  </a>
                  {%- if block.settings.badge != blank -%}
                    <span class="hz-bt__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                  {%- if block.settings.large_label != blank -%}
                    <h3 class="hz-bt__product-large">{{ block.settings.large_label }}</h3>
                  {%- endif -%}
                  <div class="hz-bt__product-bottom">
                    <div class="hz-bt__product-title-row">
                      <h4 class="hz-bt__product-title">{{ title }}</h4>
                      <span class="hz-bt__product-price">{{ price_text }}</span>
                    </div>
                    {%- if block.settings.details != blank -%}
                      <p class="hz-bt__product-details">{{ block.settings.details }}</p>
                    {%- endif -%}
                  </div>
                  <div class="hz-bt__quick-add">
                    {%- if product != blank -%}
                      {%- form 'product', product, class: 'hz-bt__product-form' -%}
                        <button class="hz-bt__quick-add-trigger" type="button" data-hz-open-variant>
                          {{ quick_add_label }}
                        </button>
                        <div class="hz-bt__variant-drawer" data-hz-variant-drawer>
                          <div class="hz-bt__variant-header">
                            <span>{{ option_label }}</span>
                            <button type="button" data-hz-close-variant aria-label="Close">
                              <span aria-hidden="true"></span>
                            </button>
                          </div>
                          <select class="hz-bt__variant-select" name="id" aria-label="Product variants">
                            {%- for variant in product.variants -%}
                              <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>
                                {{ variant.title }}
                              </option>
                            {%- endfor -%}
                          </select>
                          <button class="hz-bt__quick-add-confirm" type="submit">
                            {{ quick_add_label }}
                          </button>
                        </div>
                      {%- endform -%}
                    {%- else -%}
                      <button class="hz-bt__quick-add-trigger" type="button" disabled>
                        {{ quick_add_label }}
                      </button>
                    {%- endif -%}
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <div class="hz-bt__dots" data-hz-slider-dots aria-hidden="true"></div>
        <button class="hz-bt__arrow hz-bt__arrow--prev" type="button" data-hz-slider-prev aria-label="Previous slide">
          <span aria-hidden="true"></span>
        </button>
        <button class="hz-bt__arrow hz-bt__arrow--next" type="button" data-hz-slider-next aria-label="Next slide">
          <span aria-hidden="true"></span>
        </button>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'image_banner' -%}
        <div
          class="hz-bt__module hz-bt__banner"
          style="
            order: {{ forloop.index }};
            --hz-bt-banner-desktop: {{ block.settings.desktop_height }}px;
            --hz-bt-banner-mobile: {{ block.settings.mobile_height }}px;
            --hz-bt-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
            --hz-bt-banner-x: {{ block.settings.text_horizontal_position }};
            --hz-bt-banner-y: {{ block.settings.text_vertical_position }};
            --hz-bt-banner-align: {{ block.settings.text_alignment }};
            --hz-bt-banner-heading-size: {{ block.settings.heading_size }}px;
            --hz-bt-banner-text-size: {{ block.settings.text_size }}px;
            --hz-bt-banner-media-position: {{ block.settings.media_position }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="hz-bt__banner-media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  class: 'hz-bt__media-img',
                  loading: 'lazy',
                  sizes: '100vw',
                  alt: block.settings.heading
              }}
            {%- else -%}
              <div class="hz-bt__placeholder hz-bt__placeholder--banner">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'hz-bt__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="hz-bt__banner-shade" aria-hidden="true"></div>
          <div class="hz-bt__banner-content">
            <h2>{{ block.settings.heading }}</h2>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.button_label != blank -%}
              <a class="hz-bt__pill hz-bt__pill--light" href="{{ block.settings.button_link | default: '#' }}">
                {{ block.settings.button_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if split_slides.size > 0 -%}
      <div
        class="hz-bt__module hz-bt__split"
        data-hz-split
        style="
          order: {{ split_order }};
          {% if split_section_block != blank %}
            --hz-bt-split-desktop-height: {{ split_section_block.settings.desktop_height }}px;
            --hz-bt-split-mobile-media-height: {{ split_section_block.settings.mobile_media_height }}px;
          {% endif %}
        "
        {% if split_section_block != blank %}{{ split_section_block.shopify_attributes }}{% endif %}
      >
        <div class="hz-bt__split-panel hz-bt__split-panel--media">
          <div class="hz-bt__split-track" data-hz-split-media-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'split_slide' -%}
                <div class="hz-bt__split-slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.left_image != blank -%}
                    {{
                      block.settings.left_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'hz-bt__media-img',
                        loading: 'lazy',
                        alt: block.settings.title
                    }}
                  {%- else -%}
                    <div class="hz-bt__placeholder hz-bt__placeholder--split">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'hz-bt__placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="hz-bt__split-dots" data-hz-split-dots aria-hidden="true"></div>
        </div>
        <div class="hz-bt__split-panel hz-bt__split-panel--product">
          <div class="hz-bt__split-track" data-hz-split-product-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'split_slide' -%}
                {%- liquid
                  assign product = block.settings.product
                  assign product_image = block.settings.product_image
                  assign split_title = block.settings.title
                  assign split_link = block.settings.link
                  if product != blank
                    if split_title == blank
                      assign split_title = product.title
                    endif
                    if split_link == blank
                      assign split_link = product.url
                    endif
                  endif
                -%}
                <div
                  class="hz-bt__split-product-slide"
                  style="
                    --hz-bt-split-product-scale: {{ block.settings.product_image_scale | divided_by: 100.0 }};
                    --hz-bt-split-product-bg: {{ block.settings.product_background }};
                  "
                >
                  <div class="hz-bt__split-product-image">
                    {%- if product_image != blank -%}
                      {{
                        product_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'hz-bt__product-img',
                          loading: 'lazy',
                          alt: split_title
                      }}
                    {%- elsif product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'hz-bt__product-img',
                          loading: 'lazy',
                          alt: split_title
                      }}
                    {%- else -%}
                      <span class="hz-bt__product-placeholder">
                        {{ 'product-2' | placeholder_svg_tag: 'hz-bt__placeholder-svg' }}
                      </span>
                    {%- endif -%}
                  </div>
                  <div class="hz-bt__split-product-copy">
                    <h3>{{ split_title }}</h3>
                    <p>{{ block.settings.details }}</p>
                    {%- if view_product_label != blank -%}
                      <a class="hz-bt__pill hz-bt__pill--dark" href="{{ split_link | default: '#' }}">
                        {{ view_product_label }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="hz-bt__split-counter" data-hz-split-counter>1/{{ split_slides.size }}</span>
          <button class="hz-bt__arrow hz-bt__arrow--next hz-bt__split-next" type="button" data-hz-split-next aria-label="Next slide">
            <span aria-hidden="true"></span>
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'story_panel' -%}
        <article
          class="hz-bt__module hz-bt__story hz-bt__story--{{ block.settings.image_position }}{% if block.settings.marquee_text != blank %} hz-bt__story--marquee{% endif %}"
          style="
            order: {{ forloop.index }};
            --hz-bt-story-height: {{ block.settings.desktop_height }}px;
            --hz-bt-story-mobile-media-height: {{ block.settings.mobile_media_height }}px;
            --hz-bt-story-media-width: {{ block.settings.media_width }}%;
            --hz-bt-story-media-fit: {{ block.settings.image_fit | default: 'cover' }};
            --hz-bt-story-y: {{ block.settings.text_vertical_position }};
            --hz-bt-story-align: {{ block.settings.text_alignment }};
            --hz-bt-story-heading-size: {{ block.settings.heading_size }}px;
            --hz-bt-story-text-size: {{ block.settings.text_size }}px;
            --hz-bt-story-media-position: {{ block.settings.media_position }};
            --hz-bt-story-marquee-speed: {{ block.settings.marquee_speed }}s;
            --hz-bt-story-marquee-width: {{ block.settings.marquee_width | default: section.settings.marquee_width_desktop }}px;
            --hz-bt-story-marquee-height-mobile: {{ block.settings.marquee_mobile_height | default: 48 }}px;
            --hz-bt-story-marquee-size-desktop: {{ block.settings.marquee_font_size_desktop | default: section.settings.marquee_font_size_desktop }}px;
            --hz-bt-story-marquee-size-mobile: {{ block.settings.marquee_font_size_mobile | default: section.settings.marquee_font_size_mobile }}px;
          "
          {{ block.shopify_attributes }}
        >
          <div class="hz-bt__story-copy">
