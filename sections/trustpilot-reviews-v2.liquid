{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --reviews-section-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --reviews-card-background: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
    --reviews-heading-color: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --reviews-text-color: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  .trustpilot-section { background: rgb(var(--reviews-section-background)); padding: var(--section-outer-spacing-block) 0; }
  .trustpilot-container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .tp-header { text-align: center; margin-bottom: 40px; }
  .tp-badge { display: inline-flex; align-items: center; gap: 8px; background: #004631; color: #fff; padding: 8px 16px; border-radius: 4px; font-weight: 700; margin-bottom: 16px; }
  .tp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .tp-card { background: rgb(var(--reviews-card-background)); padding: 24px; border-radius: {{ section.settings.card_radius }}px; border: 1px solid #e9e9e9; display: flex; flex-direction: column; gap: 12px; }
  .tp-stars { color: #00B67A; display: flex; gap: 2px; }
  .tp-name { font-weight: 700; color: rgb(var(--reviews-heading-color)); margin-top: auto; }
  .tp-text { color: rgb(var(--reviews-text-color)); line-height: 1.6; }
</style>

<section class="trustpilot-section">
  <div class="trustpilot-container">
    <div class="tp-header">
      <div class="tp-badge">Trustpilot <span style="color: #00b67a">★★★★★</span></div>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="tp-grid">
      {%- for block in section.blocks -%}
        <div class="tp-card" {{ block.shopify_attributes }}>
          <div class="tp-stars">★★★★★</div>
          <div class="tp-text">{{ block.settings.review_text }}</div>
          <div class="tp-name">{{ block.settings.name }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trustpilot Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wat onze klanten zeggen" },
    { "type": "range", "id": "section_spacing", "label": "Section spacing", "min": 0, "max": 100, "step": 4, "default": 48 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f8f9fa" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#333333" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 20, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Klantnaam" },
        { "type": "textarea", "id": "review_text", "label": "Review", "default": "Geweldige service en snelle levering!" }
      ]
    }
  ],
  "presets": [{ "name": "Trustpilot Reviews" }]
}
{% endschema %}