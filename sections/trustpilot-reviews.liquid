{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --tp-bg: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --tp-card-bg: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
    --tp-heading: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --tp-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --tp-muted: {{ section.settings.muted_color.red }}, {{ section.settings.muted_color.green }}, {{ section.settings.muted_color.blue }};
    --tp-star: {{ section.settings.stars_color.red }}, {{ section.settings.stars_color.green }}, {{ section.settings.stars_color.blue }};
    --tp-radius: {{ section.settings.card_radius }}px;
    --tp-gap: {{ section.settings.card_gap }}px;
    --tp-card-w-desktop: {{ section.settings.desktop_card_width }}px;
    --tp-card-w-mobile: {{ section.settings.mobile_card_width }}px;
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .tp-section {
    background: rgb(var(--tp-bg));
  }

  #shopify-section-{{ section.id }} .tp-inner {
    display: grid;
    gap: 36px;
  }

  #shopify-section-{{ section.id }} .tp-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .tp-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: rgb(var(--tp-text));
  }

  #shopify-section-{{ section.id }} .tp-badge__stars {
    display: inline-flex;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .tp-badge__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: rgb(var(--tp-star));
  }

  #shopify-section-{{ section.id }} .tp-badge__star--half {
    background: linear-gradient(to right, rgb(var(--tp-star)) 50%, #dcdce6 50%);
  }

  #shopify-section-{{ section.id }} .tp-badge__star svg {
    width: 13px;
    height: 13px;
    display: block;
    fill: #fff;
  }

  #shopify-section-{{ section.id }} .tp-badge__logo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    font-size: 14px;
    color: rgb(var(--tp-text));
  }

  #shopify-section-{{ section.id }} .tp-badge__logo svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .tp-heading {
    color: rgb(var(--tp-heading));
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tp-subheading {
    color: rgb(var(--tp-muted));
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tp-grid {
    display: none;
  }

  #shopify-section-{{ section.id }} .tp-carousel-wrap {
    display: block;
  }

  #shopify-section-{{ section.id }} .tp-carousel {
    display: flex;
    gap: var(--tp-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }

  #shopify-section-{{ section.id }} .tp-carousel::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .tp-carousel .tp-card {
    flex: 0 0 var(--tp-card-w-mobile);
    width: var(--tp-card-w-mobile);
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .tp-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  #shopify-section-{{ section.id }} .tp-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(var(--tp-text), 0.2);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, width 0.2s;
  }

  #shopify-section-{{ section.id }} .tp-dot.is-active {
    background: rgb(var(--tp-heading));
    width: 26px;
  }

  #shopify-section-{{ section.id }} .tp-card {
    padding: 24px;
    border-radius: var(--tp-radius);
    background: rgb(var(--tp-card-bg));
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .tp-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .tp-card__quote {
    color: rgba(var(--tp-muted), 0.5);
    font-size: 32px;
    line-height: 1;
    font-family: Georgia, serif;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tp-card__stars {
    display: inline-flex;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .tp-card__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: rgb(var(--tp-star));
  }

  #shopify-section-{{ section.id }} .tp-card__star svg {
    width: 12px;
    height: 12px;
    fill: #fff;
    display: block;
  }

  #shopify-section-{{ section.id }} .tp-card__title {
    font-size: 15px;
    font-weight: 700;
    color: rgb(var(--tp-heading));
    margin: 0;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .tp-card__text {
    font-size: 14px;
    line-height: 1.6;
    color: rgb(var(--tp-text));
    flex: 1;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tp-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 4px;
  }

  #shopify-section-{{ section.id }} .tp-card__author {
    font-size: 13px;
    font-weight: 700;
    color: rgb(var(--tp-heading));
  }

  #shopify-section-{{ section.id }} .tp-card__date {
    font-size: 12px;
    color: rgb(var(--tp-muted));
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .tp-inner {
      gap: 44px;
    }

    #shopify-section-{{ section.id }} .tp-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--tp-gap);
      align-items: start;
    }

    #shopify-section-{{ section.id }} .tp-grid .tp-card {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .tp-grid .tp-card:nth-child(even) {
      margin-top: 28px;
    }

    #shopify-section-{{ section.id }} .tp-carousel-wrap {
      display: none;
    }

    #shopify-section-{{ section.id }} .tp-heading {
      font-size: clamp(36px, 4.5vw, 52px);
    }
  }
</style>

<section class="tp-section">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">
      <div class="tp-inner">

        <header class="tp-header">
          <div class="tp-badge">
            <span class="tp-badge__stars" aria-label="4.5 van 5 sterren op Trustpilot">
              <span class="tp-badge__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>
              <span class="tp-badge__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>
              <span class="tp-badge__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>
              <span class="tp-badge__star"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>
              <span class="tp-badge__star tp-badge__star--half"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z"/></svg></span>
            </span>
            <span>{{ section.settings.review_count | escape }} beoordelingen op</span>
            <span class="tp-badge__logo">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="rgb(var(--tp-star))" d="M12 0l2.95 9.07H24l-7.7 5.59 2.94 9.07L12 18.14l-7.24 5.59 2.94-9.07L0 9.07h9.05z"/></svg>
              Trustpilot
            </span>
          </div>

          {%- if section.settings.heading != blank -%}
            <h2 class="tp-heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <p class="tp-subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </header>

        <div class="tp-grid" aria-label="Klantbeoordelingen">
          {%- for block in section.blocks -%}
            <article class="tp-card" {{ block.shopify_attributes }}>
              <div class="tp-card__top">
                <span class="tp-card__quote" aria-hidden="true">"</span>
                <div class="tp-card__stars" aria-label="{{ block.settings.rating }} van 5 sterren">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}
                      <span class="tp-card__star"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z" fill="currentColor"/></svg></span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
              {%- if block.settings.review_title != blank -%}
                <p class="tp-card__title">{{ block.settings.review_title | escape }}</p>
              {%- endif -%}
              <p class="tp-card__text">{{ block.settings.review_text | escape }}</p>
              <div class="tp-card__footer">
                <span class="tp-card__author">{{ block.settings.author | escape }}</span>
                <span class="tp-card__date">{{ block.settings.date | escape }}</span>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <div class="tp-carousel-wrap">
          <div class="tp-carousel" id="tp-carousel-{{ section.id }}" aria-label="Klantbeoordelingen">
            {%- for block in section.blocks -%}
              <article class="tp-card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <div class="tp-card__top">
                  <span class="tp-card__quote" aria-hidden="true">"</span>
                  <div class="tp-card__stars" aria-label="{{ block.settings.rating }} van 5 sterren">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.rating -%}
                        <span class="tp-card__star"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M9.999 1.667l2.575 5.217 5.758.837-4.166 4.061.983 5.734-5.15-2.707-5.149 2.707.983-5.734-4.166-4.061 5.758-.837L9.999 1.667z" fill="currentColor"/></svg></span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
                {%- if block.settings.review_title != blank -%}
                  <p class="tp-card__title">{{ block.settings.review_title | escape }}</p>
                {%- endif -%}
                <p class="tp-card__text">{{ block.settings.review_text | escape }}</p>
                <div class="tp-card__footer">
                  <span class="tp-card__author">{{ block.settings.author | escape }}</span>
                  <span class="tp-card__date">{{ block.settings.date | escape }}</span>
                </div>
              </article>
            {%- endfor -%}
          </div>

          <div class="tp-dots" id="tp-dots-{{ section.id }}" role="tablist" aria-label="Navigeer naar review">
            {%- for block in section.blocks -%}
              <button
                class="tp-dot{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                data-index="{{ forloop.index0 }}"
                aria-label="Review {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var carousel = document.getElementById('tp-carousel-' + sectionId);
    var dotsWrap = document.getElementById('tp-dots-' + sectionId);

    if (!carousel || !dotsWrap) return;

    var dots = dotsWrap.querySelectorAll('.tp-dot');
    var cards = carousel.querySelectorAll('.tp-card');

    function setActive(idx) {
      dots.forEach(function(d) {
        d.classList.remove('is-active');
        d.setAttribute('aria-selected', 'false');
      });
      if (dots[idx]) {
        dots[idx].classList.add('is-active');
        dots[idx].setAttribute('aria-selected', 'true');
      }
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(dot.getAttribute('data-index'), 10);
        var card = cards[idx];
        if (card) {
          carousel.scrollTo({ left: card.offsetLeft - carousel.offsetLeft, behavior: 'smooth' });
        }
        setActive(idx);
      });
    });

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var idx = parseInt(entry.target.getAttribute('data-index'), 10);
          setActive(idx);
        }
      });
    }, { root: carousel, threshold: 0.6 });

    cards.forEach(function(card) { observer.observe(card); });

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === sectionId) {
        setActive(0);
      }
    });
  })();
</script>

