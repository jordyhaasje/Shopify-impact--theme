{%- render 'section-spacing-collapsing' -%}

<style>
#shopify-section-{{ section.id }} {
  --bg: {{ section.settings.background.rgb }};
  --card: {{ section.settings.card_background.rgb }};
  --text: {{ section.settings.text_color.rgb }};
  --heading: {{ section.settings.heading_color.rgb }};
}

#shopify-section-{{ section.id }} .why {
  background: rgb(var(--bg));
}

#shopify-section-{{ section.id }} .why__grid {
  display: grid;
  gap: 40px;
}

#shopify-section-{{ section.id }} .why__left {
  max-width: 520px;
}

#shopify-section-{{ section.id }} h2 {
  font-size: clamp(34px,4vw,54px);
  line-height:1.05;
  font-weight:700;
  color: rgb(var(--heading));
}

#shopify-section-{{ section.id }} .why__text {
  margin-top:16px;
  font-size:18px;
  line-height:1.6;
}

#shopify-section-{{ section.id }} .why__rating {
  margin-top:20px;
  display:flex;
  align-items:center;
  gap:10px;
  font-size:14px;
}

#shopify-section-{{ section.id }} .stars span {
  background:#00B67A;
  color:#fff;
  padding:4px 6px;
  border-radius:3px;
}

#shopify-section-{{ section.id }} .why__table {
  background: rgb(var(--card));
  border-radius:20px;
  overflow:hidden;
}

#shopify-section-{{ section.id }} .why__row {
  display:grid;
  grid-template-columns:1fr 120px 120px;
  padding:18px 20px;
  border-top:1px solid rgba(0,0,0,0.1);
  align-items:center;
}

#shopify-section-{{ section.id }} .why__row:first-child {
  border-top:0;
}

#shopify-section-{{ section.id }} .why__head {
  font-weight:700;
}

#shopify-section-{{ section.id }} .check {
  text-align:center;
}

#shopify-section-{{ section.id }} .check.ok {
  color:#3b2a24;
}

#shopify-section-{{ section.id }} .check.no {
  color:#999;
}

@media(min-width:900px){
  #shopify-section-{{ section.id }} .why__grid {
    grid-template-columns:1fr 1fr;
    align-items:center;
  }
}
</style>

<section class="why">
  <div {% render 'section-properties', background: section.settings.background %}>
    <div class="container why__grid">
      <div class="why__left">
        <h2>{{ section.settings.heading }}</h2>
        <div class="why__text rte">{{ section.settings.text }}</div>

        <div class="why__rating">
          <div class="stars">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <div>{{ section.settings.rating_text }}</div>
        </div>
      </div>

      <div class="why__table">
        <div class="why__row why__head">
          <div></div>
          <div>{{ section.settings.col_1 }}</div>
          <div>{{ section.settings.col_2 }}</div>
        </div>

        {% for block in section.blocks %}
        <div class="why__row" {{ block.shopify_attributes }}>
          <div>{{ block.settings.label }}</div>
          <div class="check ok">✔</div>
          <div class="check no">✖</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why us comparison",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"This is what sets us apart."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Few supplements cater to women. Ours provides clean, effective electrolyte replenishment that truly works.</p>"},
    {"type":"text","id":"rating_text","label":"Rating text","default":"Join 1,000,000+ Happy Women"},
    {"type":"text","id":"col_1","label":"Column 1","default":"Our Brand"},
    {"type":"text","id":"col_2","label":"Column 2","default":"Others"},
    {"type":"color","id":"background","label":"Background","default":"#E6D8AA"},
    {"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#2B1E18"},
    {"type":"color","id":"text_color","label":"Text color","default":"#333333"}
  ],
  "blocks": [
    {
      "type":"row",
      "name":"Row",
      "settings":[
        {"type":"text","id":"label","label":"Label","default":"Formulated for Women"}
      ]
    }
  ],
  "presets":[
    {
      "name":"Why us comparison",
      "blocks":[
        {"type":"row","settings":{"label":"Formulated for Women"}},
        {"type":"row","settings":{"label":"No Artificial Flavorings"}},
        {"type":"row","settings":{"label":"600mg of Sodium"}},
        {"type":"row","settings":{"label":"Refreshing Orange Flavor"}},
        {"type":"row","settings":{"label":"Easy to Use on the Go"}}
      ]
    }
  ]
}
{% endschema %}