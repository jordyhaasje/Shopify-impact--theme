{% render 'section-spacing-collapsing' %}

<style>
#shopify-section-{{ section.id }} .hero-v7 {
  position: relative;
  overflow: hidden;
}

#shopify-section-{{ section.id }} .hero-v7__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

#shopify-section-{{ section.id }} .hero-v7__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#shopify-section-{{ section.id }} .hero-v7__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});
  z-index: 1;
}

#shopify-section-{{ section.id }} .hero-v7__inner {
  position: relative;
  z-index: 2;
  padding: 80px 20px;
  text-align: center;
}

#shopify-section-{{ section.id }} .hero-v7__heading {
  font-size: 48px;
  color: #fff;
  margin-bottom: 16px;
}

#shopify-section-{{ section.id }} .hero-v7__subheading {
  font-size: 20px;
  color: #fff;
  margin-bottom: 12px;
}

#shopify-section-{{ section.id }} .hero-v7__text {
  color: #fff;
  margin-bottom: 24px;
}

#shopify-section-{{ section.id }} .hero-v7__buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

/* Trustpilot style review */
#shopify-section-{{ section.id }} .hero-v7__review {
  margin-top: 40px;
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  max-width: 420px;
  margin-inline: auto;
  text-align: left;
}

#shopify-section-{{ section.id }} .hero-v7__stars {
  display: flex;
  gap: 4px;
  margin-bottom: 10px;
}

#shopify-section-{{ section.id }} .hero-v7__star {
  width: 18px;
  height: 18px;
  background: #00B67A;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  border-radius: 2px;
}

#shopify-section-{{ section.id }} .hero-v7__quote {
  font-size: 14px;
  margin-bottom: 16px;
}

#shopify-section-{{ section.id }} .hero-v7__reviewer {
  display: flex;
  align-items: center;
  gap: 10px;
}

#shopify-section-{{ section.id }} .hero-v7__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}
</style>

<section class="hero-v7">
  <div {% render 'section-properties' %}>

    <div class="hero-v7__bg">
      {% if section.settings.bg_image != blank %}
        {{ section.settings.bg_image | image_url: width: 2000 | image_tag }}
      {% endif %}
    </div>

    <div class="hero-v7__overlay"></div>

    <div class="container hero-v7__inner">

      {% if section.settings.heading != blank %}
        <h1 class="hero-v7__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="hero-v7__subheading">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hero-v7__text rte">{{ section.settings.text }}</div>
      {% endif %}

      <div class="hero-v7__buttons">
        {% if section.settings.button_1_label != blank %}
          {% render 'button', content: section.settings.button_1_label, href: section.settings.button_1_link %}
        {% endif %}
        {% if section.settings.button_2_label != blank %}
          {% render 'button', content: section.settings.button_2_label, href: section.settings.button_2_link, style: 'outline' %}
        {% endif %}
      </div>

      <div class="hero-v7__review">

        <div class="hero-v7__stars">
          {% for i in (1..5) %}
            <span class="hero-v7__star">★</span>
          {% endfor %}
        </div>

        <div class="hero-v7__quote">
          {{ section.settings.review_text }}
        </div>

        <div class="hero-v7__reviewer">
          {% if section.settings.avatar != blank %}
            {{ section.settings.avatar | image_url: width: 80 | image_tag: class: 'hero-v7__avatar' }}
          {% endif %}
          <div>
            <strong>{{ section.settings.reviewer_name }}</strong><br>
            <span>{{ section.settings.reviewer_meta }}</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero v7",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background image"},
    {"type":"range","id":"overlay_opacity","min":0,"max":90,"step":5,"default":30,"label":"Overlay opacity"},

    {"type":"text","id":"heading","label":"Heading"},
    {"type":"text","id":"subheading","label":"Subheading"},
    {"type":"richtext","id":"text","label":"Text"},

    {"type":"text","id":"button_1_label","label":"Button 1 label"},
    {"type":"url","id":"button_1_link","label":"Button 1 link"},

    {"type":"text","id":"button_2_label","label":"Button 2 label"},
    {"type":"url","id":"button_2_link","label":"Button 2 link"},

    {"type":"header","content":"Review"},
    {"type":"image_picker","id":"avatar","label":"Avatar"},
    {"type":"text","id":"reviewer_name","label":"Reviewer name"},
    {"type":"text","id":"reviewer_meta","label":"Reviewer meta"},
    {"type":"textarea","id":"review_text","label":"Review text"}
  ],
  "presets": [
    {
      "name": "Hero v7"
    }
  ]
}
{% endschema %}