{%- comment -%}
  JSections - Cloudpillo Collections
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-cloudpillo-collections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_title = section.settings.heading_prefix | append: ' ' | append: section.settings.heading_emphasis | strip
-%}

<section
  id="jcp-collections-{{ section.id }}"
  class="jcp-collections"
  style="
    --jcp-section-bg: {{ section.settings.section_background }};
    --jcp-text-color: {{ section.settings.text_color }};
    --jcp-card-title-color: {{ section.settings.card_title_color }};
    --jcp-max-width: {{ section.settings.max_width }}px;
    --jcp-card-width: {{ section.settings.card_width }}px;
    --jcp-card-gap: {{ section.settings.card_gap }}px;
    --jcp-card-radius: {{ section.settings.card_radius }}px;
    --jcp-padding-top: {{ section.settings.padding_top }}px;
    --jcp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jcp-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --jcp-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
  data-jcp-section="{{ section.id }}"
  data-jcp-animate="{{ section.settings.enable_entrance_animation }}"
  data-jcp-hover-zoom="{{ section.settings.enable_hover_zoom }}"
  {% if section_title != blank %}
    aria-labelledby="jcp-collections-heading-{{ section.id }}"
  {% else %}
    aria-label="Collections"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="jcp-collections__wrapper">
    <div class="jcp-collections__container">
      <div class="jcp-collections__header">
        {%- if section_title != blank -%}
          <h2
            id="jcp-collections-heading-{{ section.id }}"
            class="jcp-collections__heading"
            data-jcp-reveal
          >
            {{ section.settings.heading_prefix | escape }}
            {%- if section.settings.heading_emphasis != blank -%}
              <em>{{ section.settings.heading_emphasis | escape }}</em>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
          <div class="jcp-collections__controls" data-jcp-reveal style="--jcp-delay: 200ms;">
            <button
              class="jcp-collections__button"
              type="button"
              data-jcp-prev
              aria-label="{{ section.settings.previous_label | escape }}"
            >
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
                <rect x="0.5" y="0.5" width="47" height="47" rx="23.5" stroke="currentColor" stroke-opacity="0.1"></rect>
                <path d="M24.8333 19.6667L20.4999 24L24.8333 28.3333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button
              class="jcp-collections__button"
              type="button"
              data-jcp-next
              aria-label="{{ section.settings.next_label | escape }}"
            >
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
                <rect x="0.5" y="0.5" width="47" height="47" rx="23.5" stroke="currentColor" stroke-opacity="0.1"></rect>
                <path d="M22.1667 28.3333L26.5001 24L22.1667 19.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <div class="jcp-collections__slider" data-jcp-slider>
        <div class="jcp-collections__track" data-jcp-track role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_image = block.settings.image
              assign fallback_image_url = block.settings.fallback_image_url
              assign card_title = block.settings.title
              assign card_link = block.settings.link
              assign image_alt = block.settings.image_alt

              if image_alt == blank and card_image != blank and card_image.alt != blank
                assign image_alt = card_image.alt
              endif
            -%}

            <div
              class="jcp-collections__slide"
              role="listitem"
              data-jcp-reveal
              style="--jcp-delay: {{ forloop.index | times: 100 }}ms;"
              {{ block.shopify_attributes }}
            >
              {%- if card_link != blank -%}
                <a class="jcp-collections__card" href="{{ card_link }}" aria-label="{{ card_title | escape }}">
              {%- else -%}
                <div class="jcp-collections__card" role="group" aria-label="{{ card_title | escape }}">
              {%- endif -%}

                {%- if card_title != blank -%}
                  <h3 class="jcp-collections__card-title">{{ card_title | escape }}</h3>
                {%- endif -%}

                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 668
                    | image_tag:
                      loading: 'lazy',
                      widths: '334, 668',
                      sizes: '(min-width: 768px) 334px, calc((100vw - 40px) / 2)',
                      alt: image_alt,
                      class: 'jcp-collections__image'
                  }}
                {%- elsif fallback_image_url != blank -%}
                  <img
                    src="{{ fallback_image_url | escape }}"
                    alt="{{ image_alt | escape }}"
                    width="334"
                    height="500"
                    loading="lazy"
                    class="jcp-collections__image"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'jcp-collections__placeholder' }}
                {%- endif -%}

              {%- if card_link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const selector = `[data-jcp-section="${sectionId}"]`;
    const registryKey = "jcpCollectionInstances";

    window[registryKey] = window[registryKey] || {};

    function cleanup(root) {
      if (!root) return;

      if (root._jcpObserver) {
        root._jcpObserver.disconnect();
        root._jcpObserver = null;
      }

      if (root._jcpHandlers) {
        root._jcpHandlers.forEach(({ element, eventName, handler }) => {
          element.removeEventListener(eventName, handler);
        });
        root._jcpHandlers = [];
      }
    }

    function bind(root, element, eventName, handler) {
      element.addEventListener(eventName, handler);
      root._jcpHandlers = root._jcpHandlers || [];
      root._jcpHandlers.push({ element, eventName, handler });
    }

    function initCarousel(root) {
      const track = root.querySelector("[data-jcp-track]");
      const previousButton = root.querySelector("[data-jcp-prev]");
      const nextButton = root.querySelector("[data-jcp-next]");

      if (!track || !previousButton || !nextButton) return;

      const scrollToSibling = (direction) => {
        const firstSlide = track.querySelector(".jcp-collections__slide");
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || "0");
        const slideWidth = firstSlide ? firstSlide.getBoundingClientRect().width : 334;
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        track.scrollBy({
          left: direction * (slideWidth + gap),
          behavior: prefersReducedMotion ? "auto" : "smooth",
        });
      };

      bind(root, previousButton, "click", () => scrollToSibling(-1));
      bind(root, nextButton, "click", () => scrollToSibling(1));
    }

    function initReveal(root) {
      const revealItems = root.querySelectorAll("[data-jcp-reveal]");
      if (!revealItems.length) return;

      if (root.dataset.jcpAnimate !== "true" || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
        return;
      }

      if (typeof IntersectionObserver !== "function") {
        revealItems.forEach((item) => item.classList.add("is-visible"));
        return;
      }

      root._jcpObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            root._jcpObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      revealItems.forEach((item) => root._jcpObserver.observe(item));
    }

    function init() {
      const root = document.querySelector(selector);
      if (!root) return;

      cleanup(root);
      initCarousel(root);
      initReveal(root);
      window[registryKey][sectionId] = root;
    }

    init();

    document.addEventListener("shopify:section:load", (event) => {
      if (event.detail.sectionId === sectionId) init();
    });

    document.addEventListener("shopify:section:unload", (event) => {
      if (event.detail.sectionId === sectionId) {
        cleanup(window[registryKey][sectionId]);
        delete window[registryKey][sectionId];
      }
    });
  })();
</script>

