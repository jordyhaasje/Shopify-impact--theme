    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#242428" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#96969b" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#eeeeee" },
    { "type": "color", "id": "facebook_bubble_background", "label": "Facebook bubble background", "default": "#f0f1f6" },
    { "type": "range", "id": "shadow_opacity", "label": "Card shadow opacity", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 8 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "select", "id": "style", "label": "Card style", "options": [ { "value": "instagram", "label": "Instagram post" }, { "value": "comment", "label": "Instagram comment" }, { "value": "facebook", "label": "Facebook comment" } ], "default": "instagram" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "username", "label": "Username", "default": "megan_rose" },
        { "type": "text", "id": "display_name", "label": "Facebook display name", "default": "Amanda Emerson" },
        { "type": "textarea", "id": "review", "label": "Review text", "default": "Absolutely love the quality and attention to detail. This product has become part of my daily routine." },
        { "type": "checkbox", "id": "show_verified", "label": "Show verified badge", "default": true },
        { "type": "checkbox", "id": "show_time_inline", "label": "Show time inline", "default": false },
        { "type": "text", "id": "time_ago", "label": "Time ago", "default": "5d ago" },
        { "type": "checkbox", "id": "show_author_like", "label": "Show author like", "default": false },
        { "type": "text", "id": "author_text", "label": "Author text", "default": "by author" },
        { "type": "checkbox", "id": "show_side_heart", "label": "Show side heart", "default": true },
        { "type": "text", "id": "likes", "label": "Likes", "default": "2.8K" },
        { "type": "text", "id": "meta_left", "label": "Meta left", "default": "5d ago" },
        { "type": "text", "id": "meta_right", "label": "Meta right", "default": "Reply" },
        { "type": "text", "id": "facebook_action_one", "label": "Facebook action 1", "default": "Like" },
        { "type": "text", "id": "facebook_action_two", "label": "Facebook action 2", "default": "Reply" },
        { "type": "checkbox", "id": "show_reactions", "label": "Show Facebook reactions", "default": true },
        { "type": "text", "id": "reaction_count", "label": "Reaction count", "default": "47" }
      ]
    }
  ],
  "presets": [
    {
      "name": "What customers say",
      "blocks": [
