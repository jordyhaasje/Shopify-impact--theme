{%- comment -%}
  JSections - Footer #7
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-footer-7.css' | asset_url | stylesheet_tag }}

<footer
  class="jfooter7 jfooter7--{{ section.settings.style_preset }}"
  style="
    --jfooter7-bg: {{ section.settings.background_color }};
    --jfooter7-text: {{ section.settings.text_color }};
    --jfooter7-muted: {{ section.settings.muted_color }};
    --jfooter7-logo: {{ section.settings.logo_color }};
    --jfooter7-divider: {{ section.settings.divider_color }};
    --jfooter7-input-bg: {{ section.settings.input_background }};
    --jfooter7-button-bg: {{ section.settings.button_background }};
    --jfooter7-button-text: {{ section.settings.button_text_color }};
    --jfooter7-button-hover-bg: {{ section.settings.button_hover_background }};
    --jfooter7-button-hover-text: {{ section.settings.button_hover_text_color }};
    --jfooter7-radius: {{ section.settings.card_radius }}px;
    --jfooter7-margin-x: {{ section.settings.margin_x }}rem;
    --jfooter7-logo-size: {{ section.settings.logo_size }}px;
    --jfooter7-logo-size-mobile: {{ section.settings.logo_size_mobile }}px;
  "
  data-jfooter7-section="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="jfooter7__inner">
    <div class="jfooter7__brand">
      <a href="{{ section.settings.brand_link | default: routes.root_url }}" class="jfooter7__brand-link">
        {%- if section.settings.logo_image != blank -%}
          {{
            section.settings.logo_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 1024px) 80vw, 92vw',
              alt: section.settings.brand_text,
              class: 'jfooter7__brand-image'
          }}
        {%- else -%}
          <span>{{ section.settings.brand_text }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="jfooter7__body">
      <div class="jfooter7__left">
        {%- if section.settings.newsletter_text != blank -%}
          <div class="jfooter7__intro">{{ section.settings.newsletter_text }}</div>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', class: 'jfooter7__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="jfooter7__row">
              <input
                type="email"
                name="contact[email]"
                class="jfooter7__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                required
              >
              <button type="submit" class="jfooter7__button" name="commit">
                {{ section.settings.newsletter_button }}
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="jfooter7__success">{{ section.settings.newsletter_success }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.privacy_text != blank -%}
          <div class="jfooter7__privacy">{{ section.settings.privacy_text }}</div>
        {%- endif -%}
      </div>

      <div class="jfooter7__right">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_column' -%}
              <nav class="jfooter7__column" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="jfooter7__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="jfooter7__list" role="list">
                  {%- for index in (1..8) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: index
                      assign link_key = 'link_' | append: index
                      assign label = block.settings[label_key]
                      assign link = block.settings[link_key]
                    -%}
                    {%- if label != blank -%}
                      <li><a href="{{ link | default: '#' }}">{{ label }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </nav>

            {%- when 'social_column' -%}
              <div class="jfooter7__column" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="jfooter7__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="jfooter7__social-list" role="list">
                  {%- for index in (1..6) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: index
                      assign link_key = 'link_' | append: index
                      assign label = block.settings[label_key]
                      assign link = block.settings[link_key]
                      assign short_label = label | slice: 0, 1
                    -%}
                    {%- if label != blank -%}
                      <li>
                        <a href="{{ link | default: '#' }}">
                          <span class="jfooter7__social-icon" aria-hidden="true">{{ short_label }}</span>
                          <span>{{ label }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'text_column' -%}
              <div class="jfooter7__column jfooter7__column--text" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="jfooter7__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="jfooter7__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

