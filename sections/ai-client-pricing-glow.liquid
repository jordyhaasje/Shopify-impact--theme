{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --ai-bg: {{ section.settings.background_color }};
    --ai-card: {{ section.settings.card_color }};
    --ai-text: {{ section.settings.text_color }};
    --ai-muted: {{ section.settings.muted_text_color }};
    --ai-accent: {{ section.settings.accent_color }};
    --ai-accent-2: {{ section.settings.secondary_accent_color }};
  }

  #shopify-section-{{ section.id }} .ai-cyber {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--ai-text);
    background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--ai-accent) 28%, transparent), transparent 34%), radial-gradient(circle at 15% 75%, color-mix(in srgb, var(--ai-accent-2) 24%, transparent), transparent 28%), linear-gradient(180deg, #02040b, var(--ai-bg));
  }

  #shopify-section-{{ section.id }} .ai-cyber:before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .36;
    background-image: linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, transparent, black 14%, black 84%, transparent);
  }

  #shopify-section-{{ section.id }} .ai-cyber:after {
    content: "";
    position: absolute;
    left: -15%;
    right: -15%;
    bottom: -32%;
    height: 55%;
    z-index: -1;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--ai-accent) 30%, transparent), transparent 66%);
    filter: blur(18px);
  }

  #shopify-section-{{ section.id }} .ai-cyber__shell {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_y }}px 20px;
  }

  #shopify-section-{{ section.id }} .ai-cyber__header {
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ai-cyber__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 8px 13px;
    border: 1px solid color-mix(in srgb, var(--ai-accent) 38%, transparent);
    border-radius: 999px;
    color: var(--ai-accent);
    background: rgba(255,255,255,.045);
    box-shadow: 0 0 30px color-mix(in srgb, var(--ai-accent) 22%, transparent);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ai-cyber__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ai-accent);
    box-shadow: 0 0 14px var(--ai-accent), 0 0 30px var(--ai-accent);
    animation: aiCyberPulse-{{ section.id }} 1.7s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .ai-cyber__title {
    margin: 0;
    color: var(--ai-text);
    font-family: var(--heading-font-family), Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 32px;
    line-height: 1.03;
    letter-spacing: -.045em;
  }

  #shopify-section-{{ section.id }} .ai-cyber__title span {
    color: transparent;
    background: linear-gradient(100deg, var(--ai-accent), #fff 45%, var(--ai-accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    text-shadow: 0 0 34px color-mix(in srgb, var(--ai-accent) 42%, transparent);
  }

  #shopify-section-{{ section.id }} .ai-cyber__text {
    max-width: 620px;
    margin: 14px auto 0;
    color: var(--ai-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .ai-cyber__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  #shopify-section-{{ section.id }} .ai-plan {
    position: relative;
    min-height: 348px;
    padding: 1px;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(255,255,255,.22), rgba(255,255,255,.04), color-mix(in srgb, var(--ai-accent) 46%, transparent));
    box-shadow: 0 22px 70px rgba(0,0,0,.42), 0 0 44px color-mix(in srgb, var(--ai-accent) 18%, transparent);
    transition: transform .35s ease, box-shadow .35s ease;
  }

  #shopify-section-{{ section.id }} .ai-plan:before {
    content: "";
    position: absolute;
    inset: -55%;
    background: conic-gradient(from 120deg, transparent, color-mix(in srgb, var(--ai-accent) 72%, transparent), transparent 32%, color-mix(in srgb, var(--ai-accent-2) 62%, transparent), transparent 70%);
    opacity: .72;
    animation: aiCyberOrbit-{{ section.id }} 7s linear infinite;
  }

  #shopify-section-{{ section.id }} .ai-plan:hover {
    transform: translateY(-8px);
    box-shadow: 0 28px 90px rgba(0,0,0,.52), 0 0 82px color-mix(in srgb, var(--ai-accent) 34%, transparent);
  }

  #shopify-section-{{ section.id }} .ai-plan--featured {
    transform: translateY(-10px);
    box-shadow: 0 32px 100px rgba(0,0,0,.56), 0 0 100px color-mix(in srgb, var(--ai-accent) 40%, transparent);
  }

  #shopify-section-{{ section.id }} .ai-plan__inner {
    position: relative;
    z-index: 1;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 26px;
    border-radius: 23px;
    background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.035)), color-mix(in srgb, var(--ai-card) 94%, #000 6%);
    backdrop-filter: blur(18px);
  }

  #shopify-section-{{ section.id }} .ai-plan__inner:after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(115deg, transparent, rgba(255,255,255,.16), transparent);
    transform: translateX(-120%);
    animation: aiCyberScan-{{ section.id }} 5.2s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .ai-plan__badge {
    align-self: flex-start;
    margin-bottom: 14px;
    padding: 7px 10px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ai-accent) 46%, transparent);
    color: var(--ai-accent);
    background: color-mix(in srgb, var(--ai-accent) 12%, transparent);
    box-shadow: 0 0 22px color-mix(in srgb, var(--ai-accent) 20%, transparent);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ai-plan h3 {
    margin: 0;
    font-family: var(--heading-font-family), Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 22px;
    letter-spacing: -.03em;
  }

  #shopify-section-{{ section.id }} .ai-plan__desc {
    min-height: 44px;
    margin: 10px 0 18px;
    color: var(--ai-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .ai-plan__price {
    margin: 0 0 18px;
    font-size: 32px;
    font-weight: 900;
    letter-spacing: -.05em;
  }

  #shopify-section-{{ section.id }} .ai-plan__price span {
    color: var(--ai-muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ai-plan ul {
    display: grid;
    gap: 10px;
    margin: 0 0 22px;
    padding: 16px 0 0;
    border-top: 1px solid rgba(255,255,255,.13);
    list-style: none;
  }

  #shopify-section-{{ section.id }} .ai-plan li {
    position: relative;
    padding-left: 22px;
    color: color-mix(in srgb, var(--ai-text) 82%, var(--ai-muted));
    font-size: 13px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .ai-plan li:before {
    content: "";
    position: absolute;
    left: 0;
    top: .48em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ai-accent);
    box-shadow: 0 0 16px var(--ai-accent);
  }

  #shopify-section-{{ section.id }} .ai-plan__btn {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: auto;
    border-radius: 999px;
    color: #ffffff;
    background: linear-gradient(90deg, var(--ai-accent), var(--ai-accent-2));
    box-shadow: 0 0 26px color-mix(in srgb, var(--ai-accent) 35%, transparent), inset 0 0 18px rgba(255,255,255,.16);
    font-size: 13px;
    font-weight: 850;
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  #shopify-section-{{ section.id }} .ai-plan__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 48px color-mix(in srgb, var(--ai-accent) 55%, transparent), inset 0 0 22px rgba(255,255,255,.2);
  }

  @keyframes aiCyberPulse-{{ section.id }} { 0%,100%{transform:scale(1);opacity:.7} 50%{transform:scale(1.45);opacity:1} }
  @keyframes aiCyberOrbit-{{ section.id }} { to { transform: rotate(360deg); } }
  @keyframes aiCyberScan-{{ section.id }} { 0%,42%{transform:translateX(-125%);opacity:0} 52%{opacity:.8} 70%,100%{transform:translateX(125%);opacity:0} }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ai-cyber__grid { grid-template-columns: 1fr; max-width: 620px; margin: 0 auto; }
    #shopify-section-{{ section.id }} .ai-plan,
    #shopify-section-{{ section.id }} .ai-plan--featured { min-height: auto; transform: none; }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .ai-cyber__shell { padding: {{ section.settings.mobile_padding_y }}px 16px; }
    #shopify-section-{{ section.id }} .ai-plan__inner { padding: 22px; }
  }
</style>

<section class="ai-cyber">
  <div class="ai-cyber__shell" data-section-bounded-shell>
    <div class="ai-cyber__header">
      <div class="ai-cyber__eyebrow"><span class="ai-cyber__dot"></span>{{ section.settings.eyebrow | escape }}</div>
      <h2 class="ai-cyber__title">{{ section.settings.heading }}</h2>
      <div class="ai-cyber__text">{{ section.settings.text }}</div>
    </div>

    <div class="ai-cyber__grid">
      <article class="ai-plan">
        <div class="ai-plan__inner">
          <div class="ai-plan__badge">{{ section.settings.plan_1_badge | escape }}</div>
          <h3>{{ section.settings.plan_1_name | escape }}</h3>
          <p class="ai-plan__desc">{{ section.settings.plan_1_description | escape }}</p>
          <div class="ai-plan__price">{{ section.settings.plan_1_price | escape }} <span>{{ section.settings.period | escape }}</span></div>
          <ul><li>{{ section.settings.plan_1_feature_1 | escape }}</li><li>{{ section.settings.plan_1_feature_2 | escape }}</li><li>{{ section.settings.plan_1_feature_3 | escape }}</li></ul>
          <a class="ai-plan__btn" href="{{ section.settings.plan_1_link | default: '#' }}">{{ section.settings.plan_1_button | escape }}</a>
        </div>
      </article>

      <article class="ai-plan ai-plan--featured">
        <div class="ai-plan__inner">
          <div class="ai-plan__badge">{{ section.settings.plan_2_badge | escape }}</div>
          <h3>{{ section.settings.plan_2_name | escape }}</h3>
          <p class="ai-plan__desc">{{ section.settings.plan_2_description | escape }}</p>
          <div class="ai-plan__price">{{ section.settings.plan_2_price | escape }} <span>{{ section.settings.period | escape }}</span></div>
          <ul><li>{{ section.settings.plan_2_feature_1 | escape }}</li><li>{{ section.settings.plan_2_feature_2 | escape }}</li><li>{{ section.settings.plan_2_feature_3 | escape }}</li></ul>
          <a class="ai-plan__btn" href="{{ section.settings.plan_2_link | default: '#' }}">{{ section.settings.plan_2_button | escape }}</a>
        </div>
      </article>

      <article class="ai-plan">
        <div class="ai-plan__inner">
          <div class="ai-plan__badge">{{ section.settings.plan_3_badge | escape }}</div>
          <h3>{{ section.settings.plan_3_name | escape }}</h3>
          <p class="ai-plan__desc">{{ section.settings.plan_3_description | escape }}</p>
          <div class="ai-plan__price">{{ section.settings.plan_3_price | escape }} <span>{{ section.settings.period | escape }}</span></div>
          <ul><li>{{ section.settings.plan_3_feature_1 | escape }}</li><li>{{ section.settings.plan_3_feature_2 | escape }}</li><li>{{ section.settings.plan_3_feature_3 | escape }}</li></ul>
          <a class="ai-plan__btn" href="{{ section.settings.plan_3_link | default: '#' }}">{{ section.settings.plan_3_button | escape }}</a>
        </div>
      </article>
    </div>
  </div>
</section>

