{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --h272-bg: {{ section.settings.background_color }};
    --h272-text: {{ section.settings.text_color }};
    --h272-muted: {{ section.settings.muted_color }};
    --h272-accent: {{ section.settings.accent_color }};
    --h272-btn-bg: {{ section.settings.button_bg }};
    --h272-btn-text: {{ section.settings.button_text_color }};
    --h272-btn2-text: {{ section.settings.button2_text_color }};
    --h272-tp-green: #00b67a;
    --h272-radius: {{ section.settings.border_radius }}px;
  }

  #shopify-section-{{ section.id }} .h272-wrap {
    background: var(--h272-bg);
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .h272-shell {
    max-width: {{ section.settings.content_width }}px;
    margin-inline: auto;
    padding: {{ section.settings.padding_y }}px 24px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* Background image layer */
  #shopify-section-{{ section.id }} .h272-bg-img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .h272-bg-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  #shopify-section-{{ section.id }} .h272-bg-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  /* Content side */
  #shopify-section-{{ section.id }} .h272-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Eyebrow */
  #shopify-section-{{ section.id }} .h272-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--h272-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    animation: h272FadeUp .6s ease both;
  }
  #shopify-section-{{ section.id }} .h272-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--h272-accent);
    display: inline-block;
    animation: h272Pulse 2s ease infinite;
  }

  /* Headline with animated quote marks */
  #shopify-section-{{ section.id }} .h272-headline-wrap {
    position: relative;
    padding-left: 16px;
    animation: h272FadeUp .7s .1s ease both;
  }
  #shopify-section-{{ section.id }} .h272-quote-open,
  #shopify-section-{{ section.id }} .h272-quote-close {
    position: absolute;
    color: var(--h272-accent);
    font-size: clamp(28px, 3.5vw, 40px);
    font-family: var(--heading-font-family, Georgia, serif);
    line-height: 1;
    opacity: 0;
    animation: h272QuoteFade .8s .3s ease forwards;
  }
  #shopify-section-{{ section.id }} .h272-quote-open {
    top: -8px;
    left: -4px;
  }
  #shopify-section-{{ section.id }} .h272-quote-close {
    bottom: -20px;
    right: 0;
    animation-delay: .5s;
  }
  #shopify-section-{{ section.id }} .h272-headline {
    margin: 0;
    color: var(--h272-text);
    font-family: var(--heading-font-family, Georgia, serif);
    font-size: clamp(28px, 3.8vw, 52px);
    line-height: 1.08;
    letter-spacing: -.035em;
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .h272-headline em {
    font-style: italic;
    color: var(--h272-accent);
  }

  /* Subtext */
  #shopify-section-{{ section.id }} .h272-subtext {
    color: var(--h272-muted);
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.7;
    max-width: 520px;
    animation: h272FadeUp .7s .2s ease both;
  }

  /* Buttons */
  #shopify-section-{{ section.id }} .h272-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: h272FadeUp .7s .3s ease both;
  }
  #shopify-section-{{ section.id }} .h272-btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 26px;
    border-radius: var(--h272-radius);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .02em;
    text-decoration: none;
    transition: transform .18s ease, box-shadow .18s ease;
    cursor: pointer;
    border: none;
  }
  #shopify-section-{{ section.id }} .h272-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,.12);
  }
  #shopify-section-{{ section.id }} .h272-btn--primary {
    background: var(--h272-btn-bg);
    color: var(--h272-btn-text);
  }
  #shopify-section-{{ section.id }} .h272-btn--secondary {
    background: transparent;
    color: var(--h272-btn2-text);
    border: 1.5px solid currentColor;
  }

  /* Trustpilot badge */
  #shopify-section-{{ section.id }} .h272-trust {
    display: flex;
    align-items: center;
    gap: 12px;
    animation: h272FadeUp .7s .4s ease both;
    flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .h272-trust-logo {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  #shopify-section-{{ section.id }} .h272-trust-star-icon {
    width: 18px;
    height: 18px;
    background: var(--h272-tp-green);
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 11px;
  }
  #shopify-section-{{ section.id }} .h272-trust-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--h272-text);
  }
  #shopify-section-{{ section.id }} .h272-trust-divider {
    width: 1px;
    height: 28px;
    background: rgba(0,0,0,.15);
  }
  #shopify-section-{{ section.id }} .h272-trust-score {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  #shopify-section-{{ section.id }} .h272-trust-stars {
    display: flex;
    gap: 3px;
  }
  #shopify-section-{{ section.id }} .h272-trust-star {
    width: 19px;
    height: 19px;
    background: var(--h272-tp-green);
    display: grid;
    place-items: center;
    border-radius: 2px;
    color: #fff;
    font-size: 11px;
  }
  #shopify-section-{{ section.id }} .h272-trust-star--empty {
    background: #ddd;
  }
  #shopify-section-{{ section.id }} .h272-trust-meta {
    font-size: 11px;
    color: var(--h272-muted);
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .h272-trust-meta strong {
    color: var(--h272-text);
  }

  /* Image side */
  #shopify-section-{{ section.id }} .h272-media {
    position: relative;
    animation: h272FadeRight .8s .15s ease both;
  }
  #shopify-section-{{ section.id }} .h272-media-img {
    width: 100%;
    border-radius: var(--h272-radius);
    display: block;
    object-fit: cover;
    max-height: 360px;
  }
  #shopify-section-{{ section.id }} .h272-media-badge {
    position: absolute;
    bottom: 20px;
    left: -16px;
    background: #fff;
    border-radius: 10px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 6px 24px rgba(0,0,0,.12);
    animation: h272BadgePop .6s .8s cubic-bezier(.34,1.56,.64,1) both;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .h272-media-badge-icon {
    font-size: 20px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .h272-media-badge-text {
    font-size: 13px;
    font-weight: 700;
    color: #111;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .h272-media-badge-sub {
    font-size: 11px;
    font-weight: 400;
    color: #666;
    display: block;
  }

  /* Reviews strip */
  #shopify-section-{{ section.id }} .h272-reviews {
    display: flex;
    flex-direction: column;
    gap: 14px;
    animation: h272FadeUp .7s .5s ease both;
  }
  #shopify-section-{{ section.id }} .h272-reviews-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--h272-muted);
  }
  #shopify-section-{{ section.id }} .h272-reviews-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .h272-review-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    border: 1px solid rgba(0,0,0,.08);
    border-radius: calc(var(--h272-radius) - 2px);
    background: rgba(255,255,255,.7);
    backdrop-filter: blur(6px);
  }
  #shopify-section-{{ section.id }} .h272-review-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--h272-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .h272-review-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .h272-review-body {
    flex: 1;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .h272-review-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .h272-review-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--h272-text);
  }
  #shopify-section-{{ section.id }} .h272-review-stars {
    color: var(--h272-tp-green);
    font-size: 11px;
    letter-spacing: .05em;
  }
  #shopify-section-{{ section.id }} .h272-review-text {
    font-size: 13px;
    color: var(--h272-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Animations */
  @keyframes h272FadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes h272FadeRight {
    from { opacity: 0; transform: translateX(24px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes h272QuoteFade {
    from { opacity: 0; transform: scale(.6); }
    to   { opacity: .25; transform: scale(1); }
  }
  @keyframes h272Pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.45); opacity: .65; }
  }
  @keyframes h272BadgePop {
    from { opacity: 0; transform: scale(.8) translateY(6px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .h272-eyebrow,
    #shopify-section-{{ section.id }} .h272-headline-wrap,
    #shopify-section-{{ section.id }} .h272-subtext,
    #shopify-section-{{ section.id }} .h272-btns,
    #shopify-section-{{ section.id }} .h272-trust,
    #shopify-section-{{ section.id }} .h272-media,
    #shopify-section-{{ section.id }} .h272-media-badge,
    #shopify-section-{{ section.id }} .h272-reviews,
    #shopify-section-{{ section.id }} .h272-quote-open,
    #shopify-section-{{ section.id }} .h272-quote-close,
    #shopify-section-{{ section.id }} .h272-eyebrow-dot {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .h272-shell {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .h272-media {
      order: -1;
    }
    #shopify-section-{{ section.id }} .h272-media-badge {
      left: 10px;
    }
  }
  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .h272-shell {
      padding: {{ section.settings.mobile_padding_y }}px 16px;
    }
    #shopify-section-{{ section.id }} .h272-btns {
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .h272-btn {
      justify-content: center;
    }
  }
</style>

<div class="h272-wrap" data-section-id="{{ section.id }}">
  {%- if section.settings.background_image != blank -%}
    <div class="h272-bg-img">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000', alt: '' }}
    </div>
    <div class="h272-bg-overlay"></div>
  {%- endif -%}

  <div class="h272-shell" data-section-bounded-shell>
    <!-- Left: content -->
    <div class="h272-content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="h272-eyebrow">
          <span class="h272-eyebrow-dot" aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <div class="h272-headline-wrap">
          {%- if section.settings.show_quotes -%}
            <span class="h272-quote-open" aria-hidden="true">&ldquo;</span>
            <span class="h272-quote-close" aria-hidden="true">&rdquo;</span>
          {%- endif -%}
          <h1 class="h272-headline">{{ section.settings.heading }}</h1>
        </div>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <div class="h272-subtext">{{ section.settings.subtext }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="h272-btns">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="h272-btn h272-btn--primary">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a href="{{ section.settings.button2_link }}" class="h272-btn h272-btn--secondary">
              {{ section.settings.button2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trustpilot -%}
        <div class="h272-trust" data-section-rating-badge>
          <div class="h272-trust-logo">
            <span class="h272-trust-star-icon" aria-hidden="true">★</span>
            <span class="h272-trust-name">Trustpilot</span>
          </div>
          <div class="h272-trust-divider"></div>
          <div class="h272-trust-score">
            <div class="h272-trust-stars" aria-label="{{ section.settings.tp_score }} out of 5 stars">
              {%- assign tp_full = section.settings.tp_score | floor -%}
              {%- for i in (1..5) -%}
                {%- if i <= tp_full -%}
                  <span class="h272-trust-star" aria-hidden="true">★</span>
                {%- else -%}
                  <span class="h272-trust-star h272-trust-star--empty" aria-hidden="true">★</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="h272-trust-meta">
              <strong>{{ section.settings.tp_score }}/5</strong> &middot; {{ section.settings.tp_reviews | escape }}
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
      {%- if review_blocks.size > 0 -%}
        <div class="h272-reviews">
          {%- if section.settings.reviews_label != blank -%}
            <div class="h272-reviews-label">{{ section.settings.reviews_label | escape }}</div>
          {%- endif -%}
          <div class="h272-reviews-list">
            {%- for block in review_blocks -%}
              <div class="h272-review-item" {{ block.shopify_attributes }}>
                <div class="h272-review-avatar">
                  {%- if block.settings.avatar != blank -%}
                    {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,60,80', alt: block.settings.reviewer_name | escape }}
                  {%- else -%}
                    {{ block.settings.reviewer_name | slice: 0 | upcase }}
                  {%- endif -%}
                </div>
                <div class="h272-review-body">
                  <div class="h272-review-header">
                    {%- if block.settings.reviewer_name != blank -%}
                      <span class="h272-review-name">{{ block.settings.reviewer_name | escape }}</span>
                    {%- endif -%}
                    <span class="h272-review-stars" aria-label="{{ block.settings.rating }} out of 5">
                      {%- assign r_full = block.settings.rating | floor -%}
                      {%- for i in (1..5) -%}{% if i <= r_full %}★{% else %}☆{% endif %}{%- endfor -%}
                    </span>
                  </div>
                  {%- if block.settings.review_text != blank -%}
                    <p class="h272-review-text">{{ block.settings.review_text | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Right: hero image -->
    {%- if section.settings.hero_image != blank -%}
      <div class="h272-media">
        {{ section.settings.hero_image | image_url: width: 900 | image_tag:
          loading: 'lazy',
          widths: '400,600,800,900',
          class: 'h272-media-img',
          alt: section.settings.heading | strip_html | escape
        }}
        {%- if section.settings.badge_text != blank -%}
          <div class="h272-media-badge">
            {%- if section.settings.badge_icon != blank -%}
              <span class="h272-media-badge-icon">{{ section.settings.badge_icon }}</span>
            {%- endif -%}
            <div class="h272-media-badge-text">
              {{ section.settings.badge_text | escape }}
              {%- if section.settings.badge_subtext != blank -%}
                <span class="h272-media-badge-sub">{{ section.settings.badge_subtext | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero-272",
  "class": "shopify-section--hero-272",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "New collection" },
    { "type": "richtext", "id": "heading", "label": "Headline", "default": "<p>The product you've <em>been waiting for</em></p>" },
    { "type": "checkbox", "id": "show_quotes", "label": "Show animated quote marks", "default": true },
    { "type": "richtext", "id": "subtext", "label": "Subtext", "default": "<p>Discover our latest drop — crafted for those who demand quality without compromise.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "Learn more" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (right column)" },
    { "type": "image_picker", "id": "background_image", "label": "Background image (full section)" },
    { "type": "color", "id": "overlay_color", "label": "Background overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Floating badge" },
    { "type": "text", "id": "badge_icon", "label": "Badge emoji / icon", "default": "⭐" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Top rated 2024" },
    { "type": "text", "id": "badge_subtext", "label": "Badge subtext", "default": "Over 10,000 reviews" },
    { "type": "header", "content": "Trustpilot" },
    { "type": "checkbox", "id": "show_trustpilot", "label": "Show Trustpilot badge", "default": true },
    { "type": "range", "id": "tp_score", "label": "Trustpilot score", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "tp_reviews", "label": "Review count label", "default": "Based on 2,400+ reviews" },
    { "type": "header", "content": "Customer reviews strip" },
    { "type": "text", "id": "reviews_label", "label": "Reviews section label", "default": "What our customers say" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 900, "max": 1320, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "min_height", "label": "Min height", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "padding_y", "label": "Desktop vertical padding", "min": 40, "max": 120, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "mobile_padding_y", "label": "Mobile vertical padding", "min": 32, "max": 80, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b6b6b" },
    { "type": "color", "id": "accent_color", "label": "Accent (quote marks & dot)", "default": "#5b21b6" },
    { "type": "color", "id": "button_bg", "label": "Primary button background", "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "Primary button text", "default": "#ffffff" },
    { "type": "color", "id": "button2_text_color", "label": "Secondary button text", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
