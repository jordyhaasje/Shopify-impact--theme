{% render 'section-spacing-collapsing' %}

<style>
#shopify-section-{{ section.id }} {
  --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  --card-radius: {{ section.settings.card_radius }}px;
  --card-gap: {{ section.settings.card_gap }}px;
  --desktop-card-width: {{ section.settings.desktop_card_width }}px;
  --mobile-card-width: {{ section.settings.mobile_card_width }}px;
}

#shopify-section-{{ section.id }} .collections {
  position: relative;
}

#shopify-section-{{ section.id }} .collections__header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

#shopify-section-{{ section.id }} .collections__title {
  font-size: clamp(28px,4vw,44px);
  font-weight:600;
}

#shopify-section-{{ section.id }} .collections__title em {
  font-style: italic;
  font-family: Georgia, serif;
  font-weight:500;
}

#shopify-section-{{ section.id }} .collections__nav {
  display:flex;
  gap:10px;
}

#shopify-section-{{ section.id }} .collections__nav button {
  width:40px;
  height:40px;
  border-radius:999px;
  border:1px solid #ddd;
  background:#fff;
  cursor:pointer;
}

#shopify-section-{{ section.id }} .collections__track {
  display:flex;
  gap:var(--card-gap);
  overflow-x:auto;
  scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;
}

#shopify-section-{{ section.id }} .collections__card {
  position:relative;
  flex:0 0 var(--mobile-card-width);
  width:var(--mobile-card-width);
  border-radius:var(--card-radius);
  overflow:hidden;
  scroll-snap-align:start;
}

#shopify-section-{{ section.id }} .collections__card img {
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

#shopify-section-{{ section.id }} .collections__overlay {
  position:absolute;
  inset:0;
  background:linear-gradient(to top, rgba(0,0,0,0.4), rgba(0,0,0,0));
}

#shopify-section-{{ section.id }} .collections__label {
  position:absolute;
  bottom:16px;
  left:16px;
  color:#fff;
  font-size:18px;
  font-weight:600;
}

@media(min-width:700px){
  #shopify-section-{{ section.id }} .collections__card {
    flex:0 0 var(--desktop-card-width);
    width:var(--desktop-card-width);
  }
}
</style>

<section class="collections">
  <div {% render 'section-properties' %}>
    <div class="container">
      <div class="collections__header">
        <h2 class="collections__title">
          {{ section.settings.title }} <em>{{ section.settings.title_accent }}</em>
        </h2>
        <div class="collections__nav">
          <button data-prev>&lt;</button>
          <button data-next>&gt;</button>
        </div>
      </div>

      <div class="collections__track" data-track>
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="collections__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag }}
            {% endif %}
            <div class="collections__overlay"></div>
            <div class="collections__label">{{ block.settings.label }}</div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const section = document.querySelector('#shopify-section-{{ section.id }}');
  if(!section) return;
  const track = section.querySelector('[data-track]');
  section.querySelector('[data-prev]').onclick = ()=> track.scrollBy({left:-300,behavior:'smooth'});
  section.querySelector('[data-next]').onclick = ()=> track.scrollBy({left:300,behavior:'smooth'});
});
</script>

{% schema %}
{
  "name": "Collections carousel",
  "settings": [
    {"type":"text","id":"title","label":"Titel","default":"Ontdek onze"},
    {"type":"text","id":"title_accent","label":"Cursief woord","default":"collecties"},

    {"type":"range","id":"section_spacing","label":"Section spacing","min":0,"max":80,"step":4,"default":48},
    {"type":"range","id":"desktop_card_width","label":"Desktop card width","min":220,"max":360,"step":4,"default":280},
    {"type":"range","id":"mobile_card_width","label":"Mobile card width","min":200,"max":320,"step":4,"default":240},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":32,"step":2,"default":16},
    {"type":"range","id":"card_radius","label":"Card radius","min":0,"max":30,"step":2,"default":20}
  ],
  "blocks": [
    {
      "type":"item",
      "name":"Card",
      "settings":[
        {"type":"image_picker","id":"image","label":"Afbeelding"},
        {"type":"text","id":"label","label":"Label","default":"Collectie"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets":[
    {
      "name":"Collections carousel",
      "blocks":[
        {"type":"item","settings":{"label":"Easter sale"}},
        {"type":"item","settings":{"label":"Toppers"}},
        {"type":"item","settings":{"label":"Hoofdkussens"}},
        {"type":"item","settings":{"label":"Matrassen"}}
      ]
    }
  ]
}
{% endschema %}