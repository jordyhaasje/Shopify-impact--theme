{%- render 'section-spacing-collapsing' -%}

{%- assign sid = section.id -%}
{%- assign show_trust = section.settings.tp_show -%}
{%- assign show_review = section.settings.review_show -%}
{%- assign trust_position = section.settings.trust_position -%}

<style>
  #shopify-section-{{ sid }} {
    --hp-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --hp-subtext: {{ section.settings.subtext_color.red }}, {{ section.settings.subtext_color.green }}, {{ section.settings.subtext_color.blue }};
    --hp-accent: {{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }};
    --hp-btn-bg: {{ section.settings.button_bg.red }}, {{ section.settings.button_bg.green }}, {{ section.settings.button_bg.blue }};
    --hp-btn-text: {{ section.settings.button_text_color.red }}, {{ section.settings.button_text_color.green }}, {{ section.settings.button_text_color.blue }};
    --hp-btn2-bg: {{ section.settings.button2_bg.red }}, {{ section.settings.button2_bg.green }}, {{ section.settings.button2_bg.blue }};
    --hp-btn2-text: {{ section.settings.button2_text_color.red }}, {{ section.settings.button2_text_color.green }}, {{ section.settings.button2_text_color.blue }};
    --hp-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hp-shell-bg: {{ section.settings.trust_shell_bg.red }}, {{ section.settings.trust_shell_bg.green }}, {{ section.settings.trust_shell_bg.blue }};
    --hp-shell-text: {{ section.settings.trust_shell_text.red }}, {{ section.settings.trust_shell_text.green }}, {{ section.settings.trust_shell_text.blue }};
    --hp-shell-border: {{ section.settings.trust_shell_border.red }}, {{ section.settings.trust_shell_border.green }}, {{ section.settings.trust_shell_border.blue }};
    --hp-review-bg: {{ section.settings.review_card_bg.red }}, {{ section.settings.review_card_bg.green }}, {{ section.settings.review_card_bg.blue }};
    --hp-review-text: {{ section.settings.review_card_text.red }}, {{ section.settings.review_card_text.green }}, {{ section.settings.review_card_text.blue }};
    --hp-min-height: {{ section.settings.min_height }}px;
    --hp-min-height-mobile: {{ section.settings.min_height_mobile }}px;
    --hp-content-max: {{ section.settings.content_max_width }}px;
    --hp-content-align: {{ section.settings.content_align }};
    --hp-shell-radius: {{ section.settings.trust_shell_radius }}px;
    --hp-shell-padding-y: {{ section.settings.trust_shell_padding_y }}px;
    --hp-shell-padding-x: {{ section.settings.trust_shell_padding_x }}px;
    --hp-shell-gap: {{ section.settings.trust_shell_gap }}px;
    --hp-shell-blur: {{ section.settings.trust_shell_blur }}px;
    --hp-shell-opacity: {{ section.settings.trust_shell_opacity | divided_by: 100.0 }};
    --hp-review-radius: {{ section.settings.review_card_radius }}px;
    --hp-review-width: {{ section.settings.review_card_width }}px;
  }

  #shopify-section-{{ sid }} .hp {
    position: relative;
    min-height: var(--hp-min-height);
    overflow: hidden;
    display: flex;
    align-items: center;
    isolation: isolate;
  }

  #shopify-section-{{ sid }} .hp__bg,
  #shopify-section-{{ sid }} .hp__overlay {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ sid }} .hp__bg {
    z-index: 0;
  }

  #shopify-section-{{ sid }} .hp__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.bg_position }};
    display: block;
  }

  #shopify-section-{{ sid }} .hp__bg-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgb(var(--hp-accent)) 0%, #12141d 100%);
  }

  #shopify-section-{{ sid }} .hp__overlay {
    z-index: 1;
    background: linear-gradient(180deg, rgba(0,0,0,0.22) 0%, rgba(0,0,0,var(--hp-overlay-opacity)) 100%);
  }

  #shopify-section-{{ sid }} .hp__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 88px 24px;
  }

  #shopify-section-{{ sid }} .hp__content {
    max-width: min(var(--hp-content-max), 100%);
    text-align: var(--hp-content-align);
    margin-inline: auto;
  }

  #shopify-section-{{ sid }} .hp__content--left { margin-inline: 0 auto; }
  #shopify-section-{{ sid }} .hp__content--center { margin-inline: auto; }
  #shopify-section-{{ sid }} .hp__content--right { margin-inline: auto 0; }

  #shopify-section-{{ sid }} .hp__eyebrow,
  #shopify-section-{{ sid }} .hp__heading,
  #shopify-section-{{ sid }} .hp__sub,
  #shopify-section-{{ sid }} .hp__actions,
  #shopify-section-{{ sid }} .hp__trust-shell,
  #shopify-section-{{ sid }} .hp__review-card {
    opacity: 0;
    transform: translateY(18px);
    animation: hp-fadein .6s ease forwards;
  }

  #shopify-section-{{ sid }} .hp__eyebrow { animation-delay: .08s; }
  #shopify-section-{{ sid }} .hp__heading { animation-delay: .16s; }
  #shopify-section-{{ sid }} .hp__sub { animation-delay: .24s; }
  #shopify-section-{{ sid }} .hp__actions { animation-delay: .32s; }
  #shopify-section-{{ sid }} .hp__trust-shell { animation-delay: .40s; }
  #shopify-section-{{ sid }} .hp__review-card { animation-delay: .48s; }

  #shopify-section-{{ sid }} .hp__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    margin: 0 0 18px;
    color: rgb(var(--hp-accent));
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: rgba({{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }}, 0.14);
    border: 1px solid rgba({{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }}, 0.26);
  }

  #shopify-section-{{ sid }} .hp__heading {
    margin: 0 0 18px;
    color: rgb(var(--hp-text));
    font-size: clamp(40px, 6vw, 76px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: .98;
    text-wrap: balance;
  }

  #shopify-section-{{ sid }} .hp__accent {
    color: rgb(var(--hp-accent));
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 600;
  }

  #shopify-section-{{ sid }} .hp__sub {
    margin: 0 0 28px;
    color: rgba({{ section.settings.subtext_color.red }}, {{ section.settings.subtext_color.green }}, {{ section.settings.subtext_color.blue }}, 0.94);
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.58;
    max-width: 58ch;
  }

  #shopify-section-{{ sid }} .hp__content--center .hp__sub { margin-inline: auto; }
  #shopify-section-{{ sid }} .hp__content--right .hp__sub { margin-inline: auto 0; }
  #shopify-section-{{ sid }} .hp__sub p { margin: 0; }

  #shopify-section-{{ sid }} .hp__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0;
    justify-content: var(--hp-content-align);
  }

  #shopify-section-{{ sid }} .hp__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 14px 24px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .01em;
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease, opacity .18s ease;
  }

  #shopify-section-{{ sid }} .hp__btn--primary {
    background: rgb(var(--hp-btn-bg));
    color: rgb(var(--hp-btn-text));
    box-shadow: 0 8px 28px rgba({{ section.settings.button_bg.red }}, {{ section.settings.button_bg.green }}, {{ section.settings.button_bg.blue }}, 0.30);
  }

  #shopify-section-{{ sid }} .hp__btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px rgba({{ section.settings.button_bg.red }}, {{ section.settings.button_bg.green }}, {{ section.settings.button_bg.blue }}, 0.38);
  }

  #shopify-section-{{ sid }} .hp__btn--secondary {
    background: rgba({{ section.settings.button2_bg.red }}, {{ section.settings.button2_bg.green }}, {{ section.settings.button2_bg.blue }}, 0.12);
    color: rgb(var(--hp-btn2-text));
    border: 1px solid rgba({{ section.settings.button2_bg.red }}, {{ section.settings.button2_bg.green }}, {{ section.settings.button2_bg.blue }}, 0.26);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  #shopify-section-{{ sid }} .hp__btn--secondary:hover {
    transform: translateY(-1px);
    background: rgba({{ section.settings.button2_bg.red }}, {{ section.settings.button2_bg.green }}, {{ section.settings.button2_bg.blue }}, 0.18);
  }

  #shopify-section-{{ sid }} .hp__trust-shell {
    display: flex;
    align-items: center;
    gap: var(--hp-shell-gap);
    flex-wrap: wrap;
    width: fit-content;
    max-width: 100%;
    margin-top: 22px;
    padding: var(--hp-shell-padding-y) var(--hp-shell-padding-x);
    border-radius: var(--hp-shell-radius);
    color: rgb(var(--hp-shell-text));
    background: rgba(var(--hp-shell-bg), var(--hp-shell-opacity));
    border: 1px solid rgba(var(--hp-shell-border), 0.28);
    backdrop-filter: blur(var(--hp-shell-blur));
    -webkit-backdrop-filter: blur(var(--hp-shell-blur));
    box-shadow: 0 10px 30px rgba(0,0,0,.14);
  }

  #shopify-section-{{ sid }} .hp__trust-shell--full { width: 100%; }
  #shopify-section-{{ sid }} .hp__trust-shell--left { justify-content: flex-start; margin-inline: 0 auto; }
  #shopify-section-{{ sid }} .hp__trust-shell--center { justify-content: center; margin-inline: auto; }
  #shopify-section-{{ sid }} .hp__trust-shell--right { justify-content: flex-end; margin-inline: auto 0; }

  #shopify-section-{{ sid }} .hp__trust-col,
  #shopify-section-{{ sid }} .hp__trust-col-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  #shopify-section-{{ sid }} .hp__trust-divider {
    width: 1px;
    align-self: stretch;
    min-height: 28px;
    background: rgba(var(--hp-shell-text), 0.14);
  }

  #shopify-section-{{ sid }} .hp__tp {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ sid }} .hp__tp-logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  #shopify-section-{{ sid }} .hp__tp-logo-star,
  #shopify-section-{{ sid }} .hp__tp-star,
  #shopify-section-{{ sid }} .hp__review-star,
  #shopify-section-{{ sid }} .hp__review-badge {
    background: #00b67a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ sid }} .hp__tp-logo-star {
    width: 20px;
    height: 20px;
    border-radius: 3px;
  }

  #shopify-section-{{ sid }} .hp__tp-logo-star svg { width: 12px; height: 12px; }

  #shopify-section-{{ sid }} .hp__tp-logo-text {
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    color: inherit;
    letter-spacing: -.01em;
  }

  #shopify-section-{{ sid }} .hp__tp-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  #shopify-section-{{ sid }} .hp__tp-stars,
  #shopify-section-{{ sid }} .hp__review-stars {
    display: flex;
    gap: 2px;
  }

  #shopify-section-{{ sid }} .hp__tp-star {
    width: 16px;
    height: 16px;
    border-radius: 2px;
  }

  #shopify-section-{{ sid }} .hp__tp-star svg { width: 10px; height: 10px; }

  #shopify-section-{{ sid }} .hp__tp-label {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: baseline;
    font-size: 12px;
    line-height: 1.25;
    color: inherit;
  }

  #shopify-section-{{ sid }} .hp__tp-label strong {
    font-size: 15px;
    font-weight: 700;
  }

  #shopify-section-{{ sid }} .hp__tp-label span {
    opacity: .74;
  }

  #shopify-section-{{ sid }} .hp__review-summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  #shopify-section-{{ sid }} .hp__review-summary-avatar,
  #shopify-section-{{ sid }} .hp__review-avatar,
  #shopify-section-{{ sid }} .hp__review-avatar-placeholder {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  #shopify-section-{{ sid }} .hp__review-summary-avatar {
    width: 36px;
    height: 36px;
  }

  #shopify-section-{{ sid }} .hp__review-avatar-placeholder {
    background: rgba({{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }}, 0.16);
    color: rgb(var(--hp-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
  }

  #shopify-section-{{ sid }} .hp__review-summary-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  #shopify-section-{{ sid }} .hp__review-summary-title {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    color: rgb(var(--hp-shell-text));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #shopify-section-{{ sid }} .hp__review-summary-subtitle {
    font-size: 12px;
    line-height: 1.3;
    color: rgba(var(--hp-shell-text), 0.72);
  }

  #shopify-section-{{ sid }} .hp__trust-area--below-section {
    position: relative;
    z-index: 3;
    margin-top: -28px;
  }

  #shopify-section-{{ sid }} .hp__trust-area--overlay {
    position: absolute;
    z-index: 3;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: flex;
    pointer-events: none;
  }

  #shopify-section-{{ sid }} .hp__trust-area--overlay-left { justify-content: flex-start; }
  #shopify-section-{{ sid }} .hp__trust-area--overlay-center { justify-content: center; }
  #shopify-section-{{ sid }} .hp__trust-area--overlay-right { justify-content: flex-end; }
  #shopify-section-{{ sid }} .hp__trust-area--overlay .hp__trust-shell { pointer-events: auto; margin-top: 0; }

  #shopify-section-{{ sid }} .hp__review-card {
    position: absolute;
    z-index: 3;
    bottom: 32px;
    right: 32px;
    width: min(var(--hp-review-width), calc(100% - 48px));
    padding: 18px 18px 16px;
    border-radius: var(--hp-review-radius);
    background: rgba({{ section.settings.review_card_bg.red }}, {{ section.settings.review_card_bg.green }}, {{ section.settings.review_card_bg.blue }}, 0.96);
    color: rgb(var(--hp-review-text));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 14px 36px rgba(0,0,0,.20);
  }

  #shopify-section-{{ sid }} .hp__review-card--left { left: 32px; right: auto; }
  #shopify-section-{{ sid }} .hp__review-card--center {
    left: 50%;
    right: auto;
    transform: translate(-50%, 18px);
  }
  #shopify-section-{{ sid }} .hp__review-card--center { animation-name: hp-fadein-center; }

  #shopify-section-{{ sid }} .hp__review-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ sid }} .hp__review-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  #shopify-section-{{ sid }} .hp__review-badge {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    border: 2px solid #fff;
  }

  #shopify-section-{{ sid }} .hp__review-badge svg { width: 8px; height: 8px; }

  #shopify-section-{{ sid }} .hp__review-meta {
    flex: 1;
    min-width: 0;
  }

  #shopify-section-{{ sid }} .hp__review-name {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    color: rgb(var(--hp-review-text));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #shopify-section-{{ sid }} .hp__review-role {
    margin-top: 2px;
    font-size: 11px;
    line-height: 1.25;
    color: rgba({{ section.settings.review_card_text.red }}, {{ section.settings.review_card_text.green }}, {{ section.settings.review_card_text.blue }}, 0.58);
  }

  #shopify-section-{{ sid }} .hp__review-star {
    width: 14px;
    height: 14px;
    border-radius: 2px;
  }

  #shopify-section-{{ sid }} .hp__review-star svg { width: 8px; height: 8px; }

  #shopify-section-{{ sid }} .hp__review-quote {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: rgba({{ section.settings.review_card_text.red }}, {{ section.settings.review_card_text.green }}, {{ section.settings.review_card_text.blue }}, 0.84);
    font-style: italic;
  }

  #shopify-section-{{ sid }} .hp__review-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba({{ section.settings.review_card_text.red }}, {{ section.settings.review_card_text.green }}, {{ section.settings.review_card_text.blue }}, 0.10);
  }

  #shopify-section-{{ sid }} .hp__review-footer-chip {
    padding: 2px 6px;
    border-radius: 4px;
    background: #00b67a;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: .02em;
  }

  #shopify-section-{{ sid }} .hp__review-footer-text {
    font-size: 11px;
    color: rgba({{ section.settings.review_card_text.red }}, {{ section.settings.review_card_text.green }}, {{ section.settings.review_card_text.blue }}, 0.54);
    line-height: 1.1;
  }

  @keyframes hp-fadein {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hp-fadein-center {
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ sid }} .hp {
      min-height: var(--hp-min-height-mobile);
      align-items: flex-end;
    }

    #shopify-section-{{ sid }} .hp__inner {
      padding: 56px 20px 22px;
    }

    #shopify-section-{{ sid }} .hp__content,
    #shopify-section-{{ sid }} .hp__content--left,
    #shopify-section-{{ sid }} .hp__content--center,
    #shopify-section-{{ sid }} .hp__content--right {
      max-width: 100%;
      margin-inline: 0;
      text-align: left;
    }

    #shopify-section-{{ sid }} .hp__heading {
      font-size: clamp(32px, 9vw, 48px);
      line-height: 1.01;
      margin-bottom: 14px;
    }

    #shopify-section-{{ sid }} .hp__sub {
      margin-bottom: 22px;
      font-size: 16px;
      line-height: 1.52;
      max-width: 100%;
    }

    #shopify-section-{{ sid }} .hp__actions {
      justify-content: flex-start;
      gap: 10px;
    }

    #shopify-section-{{ sid }} .hp__btn {
      width: 100%;
      min-height: 50px;
      padding: 14px 18px;
      box-shadow: none;
    }

    #shopify-section-{{ sid }} .hp__trust-shell,
    #shopify-section-{{ sid }} .hp__trust-shell--full {
      width: 100%;
      max-width: 100%;
    }

    #shopify-section-{{ sid }} .hp__trust-shell {
      gap: 12px;
      padding: 14px 16px;
      border-radius: min(var(--hp-shell-radius), 18px);
    }

    #shopify-section-{{ sid }} .hp__trust-col,
    #shopify-section-{{ sid }} .hp__trust-col-inner,
    #shopify-section-{{ sid }} .hp__tp,
    #shopify-section-{{ sid }} .hp__review-summary {
      width: 100%;
    }

    #shopify-section-{{ sid }} .hp__trust-divider {
      width: 100%;
      min-height: 1px;
      height: 1px;
    }

    #shopify-section-{{ sid }} .hp__trust-area--below-section {
      margin-top: 16px;
    }

    #shopify-section-{{ sid }} .hp__trust-area--overlay {
      position: static;
      left: auto;
      right: auto;
      bottom: auto;
      display: block;
      margin: 16px 20px 0;
    }

    #shopify-section-{{ sid }} .hp__review-card,
    #shopify-section-{{ sid }} .hp__review-card--left,
    #shopify-section-{{ sid }} .hp__review-card--center,
    #shopify-section-{{ sid }} .hp__review-card--right {
      position: static;
      left: auto;
      right: auto;
      bottom: auto;
      width: auto;
      max-width: none;
      margin: 16px 20px 0;
      transform: translateY(18px);
      animation-name: hp-fadein;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .hp__inner {
      padding: 48px 16px 18px;
    }

    #shopify-section-{{ sid }} .hp__eyebrow {
      margin-bottom: 14px;
    }

    #shopify-section-{{ sid }} .hp__trust-area--overlay,
    #shopify-section-{{ sid }} .hp__review-card,
    #shopify-section-{{ sid }} .hp__review-card--left,
    #shopify-section-{{ sid }} .hp__review-card--center,
    #shopify-section-{{ sid }} .hp__review-card--right {
      margin-left: 16px;
      margin-right: 16px;
    }
  }
</style>

{%- capture trustpilot_markup -%}
  {%- if show_trust -%}
    <div class="hp__tp">
      {%- if section.settings.tp_show_logo -%}
        <div class="hp__tp-logo">
          <span class="hp__tp-logo-star">
            <svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="hp__tp-logo-text">{{ section.settings.tp_logo_text | escape }}</span>
        </div>
      {%- endif -%}

      <div class="hp__tp-copy">
        {%- if section.settings.tp_show_stars -%}
          <div class="hp__tp-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <span class="hp__tp-star">
                <svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="hp__tp-label">
          {%- if section.settings.tp_score != blank -%}<strong>{{ section.settings.tp_score | escape }}</strong>{%- endif -%}
          {%- if section.settings.tp_label != blank -%}<span>{{ section.settings.tp_label | escape }}</span>{%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture review_summary_markup -%}
  {%- if section.settings.trust_show_review_summary -%}
    <div class="hp__review-summary">
      {%- if section.settings.review_avatar != blank -%}
        {{ section.settings.review_avatar | image_url: width: 72 | image_tag: loading: 'lazy', widths: '36,72', class: 'hp__review-summary-avatar', alt: section.settings.review_name | default: '' }}
      {%- elsif section.settings.review_name != blank -%}
        <div class="hp__review-avatar-placeholder hp__review-summary-avatar">{{ section.settings.review_name | strip | slice: 0, 1 }}</div>
      {%- endif -%}
      <div class="hp__review-summary-copy">
        {%- if section.settings.trust_summary_title != blank -%}
          <div class="hp__review-summary-title">{{ section.settings.trust_summary_title | escape }}</div>
        {%- endif -%}
        {%- if section.settings.trust_summary_subtitle != blank -%}
          <div class="hp__review-summary-subtitle">{{ section.settings.trust_summary_subtitle | escape }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture trust_shell_markup -%}
  {%- if show_trust or section.settings.trust_show_review_summary -%}
    <div class="hp__trust-shell hp__trust-shell--{{ section.settings.trust_alignment }}{% if section.settings.trust_full_width %} hp__trust-shell--full{% endif %}">
      {%- if section.settings.trust_content_order == 'review_first' -%}
        <div class="hp__trust-col"><div class="hp__trust-col-inner">{{ review_summary_markup }}</div></div>
        {%- if show_trust and section.settings.trust_show_review_summary -%}<div class="hp__trust-divider"></div>{%- endif -%}
        <div class="hp__trust-col"><div class="hp__trust-col-inner">{{ trustpilot_markup }}</div></div>
      {%- else -%}
        <div class="hp__trust-col"><div class="hp__trust-col-inner">{{ trustpilot_markup }}</div></div>
        {%- if show_trust and section.settings.trust_show_review_summary -%}<div class="hp__trust-divider"></div>{%- endif -%}
        <div class="hp__trust-col"><div class="hp__trust-col-inner">{{ review_summary_markup }}</div></div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<section class="hp section-{{ sid }}">
  <div class="hp__bg">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '600,900,1200,1600,2000,2200', alt: section.settings.heading | default: '' }}
    {%- else -%}
      <div class="hp__bg-fallback"></div>
    {%- endif -%}
  </div>

  <div class="hp__overlay"></div>

  <div class="hp__inner">
    <div class="container">
      <div class="hp__content hp__content--{{ section.settings.content_align }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="hp__heading">
            {{ section.settings.heading | escape }}
            {%- if section.settings.heading_accent != blank -%}
              <span class="hp__accent"> {{ section.settings.heading_accent | escape }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="hp__sub rte">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
          <div class="hp__actions">
            {%- if section.settings.btn1_label != blank -%}
              <a href="{{ section.settings.btn1_link | default: '#' }}" class="hp__btn hp__btn--primary">
                {{ section.settings.btn1_label | escape }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.btn2_label != blank -%}
              <a href="{{ section.settings.btn2_link | default: '#' }}" class="hp__btn hp__btn--secondary">{{ section.settings.btn2_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if trust_position == 'below_content' -%}
          {{ trust_shell_markup }}
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if trust_position == 'below_section' -%}
    <div class="hp__trust-area--below-section">
      <div class="container">
        {{ trust_shell_markup }}
      </div>
    </div>
  {%- elsif trust_position == 'overlay_left' or trust_position == 'overlay_center' or trust_position == 'overlay_right' -%}
    <div class="hp__trust-area--overlay hp__trust-area--{{ trust_position | replace: 'overlay_', 'overlay-' }}">
      {{ trust_shell_markup }}
    </div>
  {%- endif -%}

  {%- if show_review -%}
    <div class="hp__review-card hp__review-card--{{ section.settings.review_position }}">
      <div class="hp__review-top">
        <div class="hp__review-avatar-wrap">
          {%- if section.settings.review_avatar != blank -%}
            {{ section.settings.review_avatar | image_url: width: 84 | image_tag: loading: 'lazy', widths: '42,84', class: 'hp__review-avatar', alt: section.settings.review_name | default: '' }}
          {%- else -%}
            <div class="hp__review-avatar-placeholder">{{ section.settings.review_name | strip | slice: 0, 1 }}</div>
          {%- endif -%}
          <span class="hp__review-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </div>

        <div class="hp__review-meta">
          <div class="hp__review-name">{{ section.settings.review_name | escape }}</div>
          <div class="hp__review-role">{{ section.settings.review_role | escape }}</div>
        </div>

        <div class="hp__review-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <span class="hp__review-star">
              <svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </span>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.review_quote != blank -%}
        <p class="hp__review-quote">&ldquo;{{ section.settings.review_quote | escape }}&rdquo;</p>
      {%- endif -%}

      {%- if section.settings.review_show_footer -%}
        <div class="hp__review-footer">
          {%- if section.settings.review_footer_brand != blank -%}
            <span class="hp__review-footer-chip">{{ section.settings.review_footer_brand | escape }}</span>
          {%- endif -%}
          {%- if section.settings.review_footer_text != blank -%}
            <span class="hp__review-footer-text">{{ section.settings.review_footer_text | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

