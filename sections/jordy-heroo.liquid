{"name":"Jordy-heroo","class":"shopify-section--jordy-heroo","tag":"section","disabled_on":{"templates":["password"],"groups":["header","custom.overlay"]},"max_blocks":12,"settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"range","id":"hero_height","label":"Desktop height","min":360,"max":760,"step":20,"unit":"px","default":520},{"type":"range","id":"mobile_hero_height","label":"Mobile height","min":440,"max":720,"step":20,"unit":"px","default":560},{"type":"range","id":"content_width","label":"Content width","min":900,"max":1400,"step":20,"unit":"px","default":1180},{"type":"range","id":"text_max_width","label":"Text max width","min":420,"max":760,"step":20,"unit":"px","default":660},{"type":"range","id":"content_offset_y","label":"Desktop content vertical offset","min":-80,"max":80,"step":4,"unit":"px","default":16},{"type":"range","id":"mobile_content_offset_y","label":"Mobile content vertical offset","min":-80,"max":80,"step":4,"unit":"px","default":0},{"type":"range","id":"content_padding_top","label":"Desktop top padding","min":40,"max":180,"step":4,"unit":"px","default":92},{"type":"range","id":"content_padding_bottom","label":"Desktop bottom padding","min":80,"max":220,"step":4,"unit":"px","default":120},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":40,"max":160,"step":4,"unit":"px","default":88},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":80,"max":220,"step":4,"unit":"px","default":124},{"type":"header","content":"Rating badge"},{"type":"range","id":"star_count","label":"Number of stars","min":1,"max":5,"step":1,"default":5},{"type":"text","id":"rating_text","label":"Rating text","default":"Trusted by 100,000+ customers"},{"type":"color","id":"star_background","label":"Star square background","default":"#00b67a"},{"type":"color","id":"star_color","label":"Star color","default":"#ffffff"},{"type":"header","content":"Content"},{"type":"text","id":"heading","