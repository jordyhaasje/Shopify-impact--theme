{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --collections-slider-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --collections-slider-heading-color: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --collections-slider-card-gap: {{ section.settings.card_gap }}px;
    --collections-slider-card-radius: {{ section.settings.card_radius }}px;
    --collections-slider-heading-max: {{ section.settings.heading_max_width }}px;
    --collections-slider-desktop-card-width: {{ section.settings.desktop_card_width }}px;
    --collections-slider-section-spacing: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider {
    background: rgb(var(--collections-slider-background));
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__inner {
    display: grid;
    gap: 40px;
    padding-block: var(--collections-slider-section-spacing);
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__heading {
    max-width: var(--collections-slider-heading-max);
    margin: 0;
    color: rgb(var(--collections-slider-heading-color));
    font-size: clamp(34px, 5vw, 56px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__nav {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__nav-button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 1px solid rgba(var(--collections-slider-heading-color), 0.12);
    border-radius: 999px;
    background: transparent;
    color: rgb(var(--collections-slider-heading-color));
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__nav-button:not([disabled]):hover {
    transform: translateY(-1px);
    border-color: rgba(var(--collections-slider-heading-color), 0.24);
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__nav-button[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__track {
    display: flex;
    gap: var(--collections-slider-card-gap);
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 4px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__card {
    position: relative;
    display: block;
    flex: 0 0 var(--collections-slider-desktop-card-width);
    width: var(--collections-slider-desktop-card-width);
    min-width: var(--collections-slider-desktop-card-width);
    aspect-ratio: 334 / 500;
    border-radius: var(--collections-slider-card-radius);
    overflow: hidden;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(180deg, #eceff5 0%, #bec5cf 100%);
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__card:focus-visible {
    outline: 2px solid rgba(var(--collections-slider-heading-color), 0.5);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__image,
  #shopify-section-{{ section.id }} .hazify-collections-slider__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__image {
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__placeholder {
    background:
      radial-gradient(circle at top right, rgba(244, 201, 98, 0.85), transparent 28%),
      linear-gradient(180deg, #f1f3f7 0%, #bec4cf 100%);
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__card:hover .hazify-collections-slider__image,
  #shopify-section-{{ section.id }} .hazify-collections-slider__card:focus-visible .hazify-collections-slider__image {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 13, 19, 0) 42%, rgba(10, 13, 19, 0.18) 68%, rgba(10, 13, 19, 0.76) 100%);
    z-index: 1;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hazify-collections-slider__card-title {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 22px;
    z-index: 2;
    color: #ffffff;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .hazify-collections-slider__inner {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .hazify-collections-slider__header {
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .hazify-collections-slider__heading {
      max-width: 11ch;
      font-size: clamp(28px, 10vw, 46px);
    }

    #shopify-section-{{ section.id }} .hazify-collections-slider__nav {
      display: none;
    }

    #shopify-section-{{ section.id }} .hazify-collections-slider__track {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .hazify-collections-slider__card {
      width: 100%;
      min-width: 0;
      flex-basis: auto;
    }

    #shopify-section-{{ section.id }} .hazify-collections-slider__card-title {
      left: 16px;
      right: 16px;
      bottom: 16px;
      font-size: 16px;
    }
  }

  @media screen and (min-width: 700px) and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .hazify-collections-slider__card {
      flex-basis: min(31vw, var(--collections-slider-desktop-card-width));
      width: min(31vw, var(--collections-slider-desktop-card-width));
      min-width: min(31vw, var(--collections-slider-desktop-card-width));
    }
  }
</style>

<section class="hazify-collections-slider" data-section-id="{{ section.id }}">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">
      <div class="hazify-collections-slider__inner">
        <div class="hazify-collections-slider__header">
          <h2 class="hazify-collections-slider__heading">
            {{ section.settings.heading | escape }} <em>{{ section.settings.heading_emphasis | escape }}</em>
          </h2>

          <div class="hazify-collections-slider__nav" aria-label="Slider navigatie">
            <button type="button" class="hazify-collections-slider__nav-button" data-collection-slider-prev aria-label="Vorige collectieslide">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M11.833 5.833 7.666 10l4.167 4.167" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button type="button" class="hazify-collections-slider__nav-button" data-collection-slider-next aria-label="Volgende collectieslide">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M8.167 14.167 12.334 10 8.167 5.833" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="hazify-collections-slider__track" data-collection-slider-track role="list">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- assign card_title = block.settings.title | strip | default: 'Collectie' -%}
              {%- assign fallback_image_url = block.settings.fallback_image_url | strip -%}

              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="hazify-collections-slider__card" role="listitem" {{ block.shopify_attributes }}>
              {%- else -%}
                <div class="hazify-collections-slider__card" role="listitem" {{ block.shopify_attributes }}>
              {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '334,668,900', sizes: '(max-width: 699px) calc(50vw - 28px), (max-width: 1199px) 31vw, 24vw', class: 'hazify-collections-slider__image', alt: card_title }}
                {%- elsif fallback_image_url != blank -%}
                  <img src="{{ fallback_image_url | escape }}" alt="{{ card_title | escape }}" loading="lazy" width="668" height="1000" class="hazify-collections-slider__image">
                {%- else -%}
                  <div class="hazify-collections-slider__placeholder" aria-hidden="true"></div>
                {%- endif -%}

                <div class="hazify-collections-slider__overlay"></div>
                <span class="hazify-collections-slider__card-title">{{ card_title | escape }}</span>
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="hazify-collections-slider__card" role="listitem">
              <div class="hazify-collections-slider__placeholder" aria-hidden="true"></div>
              <div class="hazify-collections-slider__overlay"></div>
              <span class="hazify-collections-slider__card-title">Collectie</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');

    if (!sectionRoot) {
      return;
    }

    const initCollectionsSlider = () => {
      const sliderRoot = sectionRoot.querySelector('.hazify-collections-slider');
      const track = sectionRoot.querySelector('[data-collection-slider-track]');
      const prevButton = sectionRoot.querySelector('[data-collection-slider-prev]');
      const nextButton = sectionRoot.querySelector('[data-collection-slider-next]');

      if (!sliderRoot || !track || !prevButton || !nextButton || sliderRoot.dataset.sliderReady === 'true') {
        return;
      }

      sliderRoot.dataset.sliderReady = 'true';

      const getStep = () => {
        const firstCard = track.querySelector('.hazify-collections-slider__card');
        const gapValue = window.getComputedStyle(track).gap || '0px';
        const gap = parseFloat(gapValue) || 0;

        if (!firstCard) {
          return track.clientWidth * 0.8;
        }

        return firstCard.getBoundingClientRect().width + gap;
      };

      const syncButtons = () => {
        const maxScrollLeft = Math.max(track.scrollWidth - track.clientWidth, 0);
        const atStart = track.scrollLeft <= 4;
        const atEnd = track.scrollLeft >= maxScrollLeft - 4;

        prevButton.disabled = atStart;
        nextButton.disabled = atEnd;
      };

      prevButton.addEventListener('click', () => {
        track.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });

      nextButton.addEventListener('click', () => {
        track.scrollBy({ left: getStep(), behavior: 'smooth' });
      });

      track.addEventListener('scroll', syncButtons, { passive: true });
      window.addEventListener('resize', syncButtons);
      syncButtons();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCollectionsSlider, { once: true });
    } else {
      initCollectionsSlider();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.target && event.target.id === 'shopify-section-{{ section.id }}') {
        initCollectionsSlider();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Hazify test collections",
  "tag": "section",
  "class": "shopify-section--hazify-collections-slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ontdek onze" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading emphasis", "default": "collecties" },
    { "type": "range", "id": "section_spacing", "label": "Section spacing", "min": 0, "max": 80, "step": 4, "default": 48 },
    { "type": "range", "id": "heading_max_width", "label": "Heading max width", "min": 300, "max": 900, "step": 20, "default": 520 },
    { "type": "range", "id": "desktop_card_width", "label": "Desktop card width", "min": 220, "max": 340, "step": 4, "default": 300 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 8, "max": 32, "step": 2, "default": 18 },
