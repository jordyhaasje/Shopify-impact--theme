{% render 'section-spacing-collapsing' %}

<style>
#shopify-section-{{ section.id }} {
  --uwb-bg: {{ section.settings.background.rgb }};
  --uwb-heading: {{ section.settings.heading_color.rgb }};
  --uwb-accent: {{ section.settings.accent_color.rgb }};
  --uwb-text: {{ section.settings.text_color.rgb }};
  --uwb-button-bg: {{ section.settings.button_background.rgb }};
  --uwb-button-text: {{ section.settings.button_text_color.rgb }};
  --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
}

#shopify-section-{{ section.id }} .uwb-wrapper {
  display: grid;
  gap: 40px;
  align-items: center;
}

@media screen and (min-width: 990px) {
  #shopify-section-{{ section.id }} .uwb-wrapper {
    grid-template-columns: 1.05fr 1fr;
    gap: 60px;
  }
}

#shopify-section-{{ section.id }} .uwb-heading {
  font-size: clamp(34px, 4vw, 56px);
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: rgb(var(--uwb-heading));
  margin: 0 0 18px;
}

#shopify-section-{{ section.id }} .uwb-heading .accent {
  color: rgb(var(--uwb-accent));
  font-style: italic;
  font-family: Georgia, 'Times New Roman', serif;
}

#shopify-section-{{ section.id }} .uwb-quote {
  display: flex;
  gap: 14px;
  margin-bottom: 22px;
}

#shopify-section-{{ section.id }} .uwb-quote img {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
}

#shopify-section-{{ section.id }} .uwb-quote-text {
  font-size: 16px;
  line-height: 1.6;
  color: rgb(var(--uwb-text));
}

#shopify-section-{{ section.id }} .uwb-button-wrap {
  margin-top: 10px;
}

#shopify-section-{{ section.id }} .uwb-delivery {
  font-size: 14px;
  color: rgb(var(--uwb-text));
  margin-top: 12px;
}

#shopify-section-{{ section.id }} .uwb-divider {
  height: 1px;
  background: rgba(0,0,0,0.08);
  margin: 28px 0;
}

#shopify-section-{{ section.id }} .uwb-features {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px 22px;
}

@media screen and (min-width: 750px) {
  #shopify-section-{{ section.id }} .uwb-features {
    grid-template-columns: 1fr 1fr;
  }
}

#shopify-section-{{ section.id }} .uwb-feature {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
}

#shopify-section-{{ section.id }} .uwb-media-main {
  position: relative;
  border-radius: 22px;
  overflow: hidden;
}

#shopify-section-{{ section.id }} .uwb-media-main video,
#shopify-section-{{ section.id }} .uwb-media-main img {
  width: 100%;
  height: auto;
  display: block;
}

#shopify-section-{{ section.id }} .uwb-thumbs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 14px;
}

#shopify-section-{{ section.id }} .uwb-thumb img {
  border-radius: 14px;
  width: 100%;
  height: auto;
  display: block;
}

@media screen and (max-width: 989px) {
  #shopify-section-{{ section.id }} .uwb-media {
    order: -1;
  }
}
</style>

<section class="uwb-section">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color %}>
    <div class="container">
      <div class="uwb-wrapper">

        <div class="uwb-content">

          <h2 class="uwb-heading">
            {{ section.settings.heading }}
            <span class="accent">{{ section.settings.heading_accent }}</span>
          </h2>

          <div class="uwb-quote">
            {% if section.settings.avatar != blank %}
              {{ section.settings.avatar | image_url: width: 96 | image_tag: loading: 'lazy' }}
            {% endif %}
            <div class="uwb-quote-text rte">
              {{ section.settings.quote }}
            </div>
          </div>

          {% if section.settings.button_label != blank %}
            <div class="uwb-button-wrap">
              {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'lg', style: 'fill', background: section.settings.button_background, text_color: section.settings.button_text_color %}
            </div>
          {% endif %}

          {% if section.settings.delivery_text != blank %}
            <div class="uwb-delivery">
              {{ section.settings.delivery_text }}
            </div>
          {% endif %}

          <div class="uwb-divider"></div>

          <div class="uwb-features">
            {% for block in section.blocks %}
              <div class="uwb-feature" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
                {% endif %}
                <span>{{ block.settings.text }}</span>
              </div>
            {% endfor %}
          </div>

        </div>

        <div class="uwb-media">

          <div class="uwb-media-main">
            {% if section.settings.video != blank %}
              {{ section.settings.video | video_tag: controls: false, autoplay: false, loop: true, muted: true }}
            {% elsif section.settings.main_image != blank %}
              {{ section.settings.main_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
            {% endif %}
          </div>

          <div class="uwb-thumbs">
            {% if section.settings.thumb_1 != blank %}
              <div class="uwb-thumb">{{ section.settings.thumb_1 | image_url: width: 400 | image_tag }}</div>
            {% endif %}
            {% if section.settings.thumb_2 != blank %}
              <div class="uwb-thumb">{{ section.settings.thumb_2 | image_url: width: 400 | image_tag }}</div>
            {% endif %}
            {% if section.settings.thumb_3 != blank %}
              <div class="uwb-thumb">{{ section.settings.thumb_3 | image_url: width: 400 | image_tag }}</div>
            {% endif %}
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Upgrade water bottle",
  "tag": "section",
  "class": "shopify-section--upgrade-water-bottle",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Reasons to upgrade"},
    {"type":"text","id":"heading_accent","label":"Heading accent","default":"your water bottle"},
    {"type":"richtext","id":"quote","label":"Quote text","default":"<p>\"I bring this bottle everywhere I go. It contains 910 ml, stays cold forever and is so easy to carry around. Perfect for my active lifestyle.\"</p>"},
    {"type":"image_picker","id":"avatar","label":"Avatar image"},
    {"type":"text","id":"button_label","label":"Button label","default":"Learn More"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"delivery_text","label":"Delivery text","default":"Fast delivery, within 1-2 days."},

    {"type":"header","content":"Media"},
    {"type":"video","id":"video","label":"Main video"},
    {"type":"image_picker","id":"main_image","label":"Fallback main image"},
    {"type":"image_picker","id":"thumb_1","label":"Thumbnail 1"},
    {"type":"image_picker","id":"thumb_2","label":"Thumbnail 2"},
    {"type":"image_picker","id":"thumb_3","label":"Thumbnail 3"},

    {"type":"header","content":"Colors"},
    {"type":"color","id":"background","label":"Background","default":"#F5F5F5"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#1A1A1A"},
    {"type":"color","id":"accent_color","label":"Accent color","default":"#8B2C2C"},
    {"type":"color","id":"text_color","label":"Text color","default":"#5C5C5C"},
    {"type":"color","id":"button_background","label":"Button background","default":"#111111"},
    {"type":"color","id":"button_text_color","label":"Button text color","default":"#FFFFFF"},

    {"type":"header","content":"Layout"},
    {"type":"range","id":"section_spacing","label":"Section spacing","min":0,"max":80,"step":4,"default":48}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type":"image_picker","id":"icon","label":"Icon"},
        {"type":"text","id":"text","label":"Feature text","default":"Holds cold for 24 hours"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Upgrade water bottle",
      "blocks": [
        {"type":"feature"},
        {"type":"feature"},
        {"type":"feature"},
        {"type":"feature"}
      ]
    }
  ]
}
{% endschema %}