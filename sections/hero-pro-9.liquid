{%- render 'section-spacing-collapsing' -%}

<style>
#shopify-section-{{ section.id }} {
  --hp9-gap: {{ section.settings.card_gap }}px;
  --hp9-card-w-desktop: {{ section.settings.desktop_card_width }}px;
  --hp9-card-w-mobile: {{ section.settings.mobile_card_width }}px;
}

#shopify-section-{{ section.id }} .hp9 {
  padding-block: {{ section.settings.section_spacing }}px;
}

#shopify-section-{{ section.id }} .hp9__inner {
  display: grid;
  gap: 32px;
}

/* Desktop split */
@media (min-width: 900px) {
  #shopify-section-{{ section.id }} .hp9__inner {
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
  }
}

#shopify-section-{{ section.id }} .hp9__content {
  max-width: {{ section.settings.content_max_width }}px;
}

#shopify-section-{{ section.id }} .hp9__heading {
  font-size: clamp(28px, 4vw, 48px);
  line-height: 1.05;
  margin: 0 0 12px;
}

#shopify-section-{{ section.id }} .hp9__sub {
  font-size: 16px;
  opacity: 0.7;
}

#shopify-section-{{ section.id }} .hp9__slider {
  display: flex;
  gap: var(--hp9-gap);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

#shopify-section-{{ section.id }} .hp9__slider::-webkit-scrollbar { display:none; }

#shopify-section-{{ section.id }} .hp9__card {
  flex: 0 0 var(--hp9-card-w-mobile);
  scroll-snap-align: start;
  background: #fff;
  border-radius: 14px;
  padding: 16px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.06);
}

@media (min-width: 900px) {
  #shopify-section-{{ section.id }} .hp9__card {
    flex-basis: var(--hp9-card-w-desktop);
  }
}

#shopify-section-{{ section.id }} .hp9__stars {
  display:flex; gap:4px; margin-bottom:10px;
}

#shopify-section-{{ section.id }} .hp9__star {
  width:16px; height:16px; background:#00b67a; border-radius:2px;
}

#shopify-section-{{ section.id }} .hp9__text {
  font-size:14px; line-height:1.5; margin-bottom:12px;
}

#shopify-section-{{ section.id }} .hp9__author {
  font-size:13px; opacity:.7;
}
</style>

<section class="hp9">
  <div {% render 'section-properties' %}>
    <div class="container">
      <div class="hp9__inner">

        <div class="hp9__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="hp9__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <div class="hp9__sub rte">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>

        <div class="hp9__slider" data-slider>
          {%- for block in section.blocks -%}
            <div class="hp9__card" {{ block.shopify_attributes }}>

              <div class="hp9__stars">
                {%- for i in (1..5) -%}
                  <span class="hp9__star" style="opacity:{% if i <= block.settings.rating %}1{% else %}0.2{% endif %}"></span>
                {%- endfor -%}
              </div>

              <div class="hp9__text">{{ block.settings.text }}</div>

              <div class="hp9__author">{{ block.settings.author }}</div>

            </div>
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const root = document.getElementById('shopify-section-{{ section.id }}');
  if(!root) return;
  const slider = root.querySelector('[data-slider]');

  function init(){
    if(!slider) return;
    slider.scrollLeft = 0;
  }

  document.addEventListener('shopify:section:load', init);
  document.addEventListener('DOMContentLoaded', init);
})();
</script>

{% schema %}
{
  "name": "Hero Pro 9",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Trusted by thousands"},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Real reviews from real customers</p>"},
    {"type":"range","id":"section_spacing","label":"Spacing","min":0,"max":80,"step":4,"default":48},
    {"type":"range","id":"content_max_width","label":"Content width","min":600,"max":1200,"step":20,"default":840},
    {"type":"range","id":"desktop_card_width","label":"Desktop card width","min":220,"max":360,"step":4,"default":280},
    {"type":"range","id":"mobile_card_width","label":"Mobile card width","min":220,"max":320,"step":4,"default":260},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":32,"step":2,"default":16}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"textarea","id":"text","label":"Text","default":"Amazing product, would recommend."},
        {"type":"text","id":"author","label":"Author","default":"John D."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Pro 9",
      "blocks": [
        {"type":"review"},
        {"type":"review"},
        {"type":"review"}
      ]
    }
  ]
}
{% endschema %}