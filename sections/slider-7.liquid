{%- comment -%}
  Slider #7 - Swiper Product Cards Slider
  Based on: https://section.store/pages/slider-7
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign padding_top = section.settings.padding_top | default: 27
  assign padding_bottom = section.settings.padding_bottom | default: 27
  assign padding_top_desktop = section.settings.padding_top_desktop | default: 36
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 36
  assign section_bg = section.settings.background_color | default: '#f8f8f8'
  assign max_width = section.settings.max_width | default: '120rem'
  assign space_between = section.settings.space_between | default: 20
  assign slides_mobile = section.settings.slides_per_view_mobile | default: 1.3
  assign slides_tablet = section.settings.slides_per_view_tablet | default: 1.0
  assign slides_desktop = section.settings.slides_per_view_desktop | default: 2.2
  assign card_radius = section.settings.card_radius | default: 12
  assign image_ratio = section.settings.image_ratio | default: '12/12'
-%}

<style>
  .slider-7-{{ section_id }} {
    border-top: solid {{ section.settings.border_color | default: '#000000' }} {{ section.settings.border_top_width | default: 0 }}px;
    border-bottom: solid {{ section.settings.border_color | default: '#000000' }} {{ section.settings.border_bottom_width | default: 0 }}px;
    margin-top: {{ section.settings.margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
    border-radius: {{ section.settings.section_radius | default: 0 }}px;
    overflow: hidden;
  }

  .slider-7-{{ section_id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    max-width: {{ max_width }};
  }

  .slider-7-{{ section_id }} .swiper {
    margin-top: 20px;
    overflow: visible !important;
  }

  .slider-7-slide-{{ section_id }} {
    padding: 30px 0px 0px 0px;
    border-radius: {{ card_radius }}px;
    border: 0px solid;
    overflow: hidden;
    box-sizing: border-box !important;
    text-decoration: none;
    transition: all 0.25s ease 0s;
    display: flex !important;
    flex-direction: column;
    justify-content: space-between;
    height: auto !important;
    box-shadow: 2px 4px 12px rgba(0,0,0,.08);
  }

  .slider-7-slide-{{ section_id }}:hover {
    transition: all 0.25s ease 0s;
    transform: scale(1.02);
  }

  .slider-7-content-{{ section_id }} {
    display: flex !important;
    flex-direction: column;
    padding: 0px 30px;
    align-items: start;
  }

  .slider-7-tag-{{ section_id }} {
    width: 100%;
    text-align: left;
    margin: 0;
    font-size: 12px;
    line-height: 130%;
    text-transform: unset;
    word-break: break-word;
    font-weight: 700;
  }

  .slider-7-heading-{{ section_id }} {
    width: 100%;
    margin-top: 12px;
    text-align: left;
  }

  .slider-7-heading-{{ section_id }} * {
    margin: 0;
    font-size: 24px;
    line-height: 130%;
    text-transform: unset;
    word-break: break-word;
  }

  .slider-7-text-{{ section_id }} {
    width: 100%;
    margin-top: 20px;
    text-align: left;
  }

  .slider-7-text-{{ section_id }} * {
    margin: 0;
    font-size: 13px;
    line-height: 130%;
    text-transform: unset;
    word-break: break-word;
  }

  .slider-7-image-{{ section_id }} {
    overflow: hidden;
    margin: 0px 0px;
    margin-top: 20px;
    aspect-ratio: {{ image_ratio }};
  }

  .slider-7-image-{{ section_id }} img,
  .slider-7-image-{{ section_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ card_radius }}px;
    border: 0px solid;
  }

  .slider-7-image-{{ section_id }} svg {
    background-color: #AFAFAF;
  }

  .slider-7-navigation-{{ section_id }} {
    display: flex;
    justify-content: end;
    align-items: center;
    gap: 16px;
  }

  .slider-7-pagination-{{ section_id }} {
    padding: 10px 10px;
    border-radius: 10px;
    backdrop-filter: blur(5px);
    border: 0px solid #000000;
    background-color: rgba(255,255,255,0.3);
    overflow: hidden;
    align-items: center;
    gap: 5px;
    display: none;
  }

  .slider-7-pagination-{{ section_id }} * {
    margin: 0px;
    font-size: 16px;
    color: #969696;
    line-height: 130%;
    text-transform: unset;
  }

  .slider-7-buttons-{{ section_id }} {
    align-items: center;
    gap: 16px;
    display: none;
  }

  .slider-7-btn-prev-{{ section_id }},
  .slider-7-btn-next-{{ section_id }} {
    display: flex;
    width: 48px;
    height: 48px;
    border: 0px;
    border: 1px solid #eaeaea;
    border-radius: 50px;
    background: transparent;
    background: rgba(248,248,248,0.3);
    backdrop-filter: blur(5px);
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease 0s;
    cursor: pointer;
    -webkit-appearance: none;
    box-shadow: 0px 0px 10px 0px rgba(0,0,0,.15);
  }

  .slider-7-btn-prev-{{ section_id }} .animate-icon,
  .slider-7-btn-next-{{ section_id }} .animate-icon {
    pointer-events: none;
    place-items: center;
    display: grid;
  }

  .slider-7-btn-prev-{{ section_id }} .animate-icon:before,
  .slider-7-btn-next-{{ section_id }} .animate-icon:before {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease-in-out;
    width: 10px;
    height: 10px;
    transform: rotate(calc(1 * 45deg));
    box-sizing: border-box;
    border-style: solid;
    border: 0px;
    border-right: 2px solid currentColor;
    border-top: 2px solid currentColor;
    position: relative;
    left: -1px;
  }

  .slider-7-btn-prev-{{ section_id }} .animate-icon:before {
    left: unset;
    right: -1px;
    border-right: 0px;
    border-top: 0px;
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
  }

  .slider-7-btn-prev-{{ section_id }} .animate-icon:after,
  .slider-7-btn-next-{{ section_id }} .animate-icon:after {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease-in-out;
    width: 9.7px;
    height: 1.6px;
    transform-origin: center;
    opacity: 0;
    background: currentColor;
    transform: scaleX(.5);
  }

  .slider-7-btn-prev-{{ section_id }} span,
  .slider-7-btn-next-{{ section_id }} span {
    color: #000000;
    transition: all 0.3s ease 0s;
  }

  .slider-7-btn-prev-{{ section_id }}.swiper-button-disabled,
  .slider-7-btn-next-{{ section_id }}.swiper-button-disabled {
    opacity: 0.5;
  }

  .slider-7-btn-next-{{ section_id }}:hover .animate-icon:before {
    transform: translate(calc(1 * 0.125rem)) rotate(calc(1 * 45deg));
  }

  .slider-7-btn-prev-{{ section_id }}:hover .animate-icon:before {
    transform: translate(calc(-1 * 0.125rem)) rotate(calc(1 * 45deg));
  }

  .slider-7-btn-prev-{{ section_id }}:hover .animate-icon:after,
  .slider-7-btn-next-{{ section_id }}:hover .animate-icon:after {
    opacity: 1;
    transform: scaleX(1);
  }

  .slider-7-{{ section_id }} .swiper-wrapper {
    align-items: stretch !important;
  }

  @media(min-width: 1024px) {
    .slider-7-{{ section_id }}-settings {
      padding-top: {{ padding_top_desktop }}px;
      padding-bottom: {{ padding_bottom_desktop }}px;
      padding-left: 5rem;
      padding-right: 5rem;
    }

    .slider-7-{{ section_id }} .swiper {
      margin-top: 24px;
    }

    .slider-7-slide-{{ section_id }} {
      padding: 30px 0px 0px 0px;
    }

    .slider-7-content-{{ section_id }} {
      padding: 0px 26px;
      align-items: start;
    }

    .slider-7-tag-{{ section_id }} {
      text-align: left;
      font-size: 12px;
    }

    .slider-7-heading-{{ section_id }} {
      margin-top: 12px;
      text-align: left;
    }

    .slider-7-heading-{{ section_id }} * {
      font-size: 28px;
    }

    .slider-7-text-{{ section_id }} {
      margin-top: 20px;
      text-align: left;
    }

    .slider-7-text-{{ section_id }} * {
      font-size: 15px;
    }

    .slider-7-image-{{ section_id }} {
      margin: 0px 0px;
      margin-top: 20px;
    }

    .slider-7-pagination-{{ section_id }} {
      padding: 10px 10px;
      display: flex;
    }

    .slider-7-pagination-{{ section_id }} * {
      font-size: 16px;
    }

    .slider-7-buttons-{{ section_id }} {
      display: flex;
    }

    .slider-7-btn-prev-{{ section_id }},
    .slider-7-btn-next-{{ section_id }} {
      width: 48px;
      height: 48px;
      transition: all 0.25s ease 0s;
    }

    .slider-7-btn-prev-{{ section_id }} .animate-icon:before,
    .slider-7-btn-next-{{ section_id }} .animate-icon:before {
      width: 10px;
      height: 10px;
    }

    .slider-7-btn-prev-{{ section_id }} .animate-icon:after,
    .slider-7-btn-next-{{ section_id }} .animate-icon:after {
      width: 9.7px;
    }
  }
</style>

<div class="slider-7-{{ section_id }}" style="background-color: {{ section_bg }};">
  <div class="slider-7-{{ section_id }}-settings">
    <div class="slider-7-navigation-{{ section_id }}">
      <div class="slider-7-pagination-{{ section_id }}">
        <span class="slider-7-current-{{ section_id }}">1</span>
        <span>/</span>
        <span>{{ section.blocks.size }}</span>
      </div>
      <div class="slider-7-buttons-{{ section_id }}">
        <button class="slider-7-btn-prev-{{ section_id }}" aria-label="Previous slide">
          <span class="animate-icon"></span>
        </button>
        <button class="slider-7-btn-next-{{ section_id }}" aria-label="Next slide">
          <span class="animate-icon"></span>
        </button>
      </div>
    </div>

    <div class="slider-7-swiper-{{ section_id }} swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_bg = block.settings.background_color | default: '#ffffff'
            assign tag_color = block.settings.tag_color | default: '#6e6e73'
            assign heading_color = block.settings.heading_color | default: '#1d1d1f'
            assign text_color = block.settings.text_color | default: '#1d1d1f'
          -%}
          <style>
            .slider-7-slide-{{ section_id }}-{{ block.id }} {
              background-color: {{ card_bg }};
            }
            .slider-7-slide-{{ section_id }}-{{ block.id }} .slider-7-tag-{{ section_id }} {
              color: {{ tag_color }};
            }
            .slider-7-slide-{{ section_id }}-{{ block.id }} .slider-7-heading-{{ section_id }} * {
              color: {{ heading_color }};
            }
            .slider-7-slide-{{ section_id }}-{{ block.id }} .slider-7-text-{{ section_id }} * {
              color: {{ text_color }};
            }
          </style>
          <div class="slider-7-slide-{{ section_id }} slider-7-slide-{{ section_id }}-{{ block.id }} swiper-slide" {{ block.shopify_attributes }}>
            <div class="slider-7-content-{{ section_id }}">
              {%- if block.settings.tag != blank -%}
                <p class="slider-7-tag-{{ section_id }}">{{ block.settings.tag }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <div class="slider-7-heading-{{ section_id }}">
                  <h3>{{ block.settings.heading }}</h3>
                </div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="slider-7-text-{{ section_id }}">
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- endif -%}
            </div>
            {%- if block.settings.image != blank -%}
              <div class="slider-7-image-{{ section_id }}">
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              </div>
            {%- else -%}
              <div class="slider-7-image-{{ section_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}" media="all" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}"></noscript>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

<script defer>
  (function() {
    var sectionId = '{{ section_id }}';
    var totalSlides = {{ section.blocks.size }};
    var spaceBetween = {{ space_between }};
    var slidesMobile = {{ slides_mobile }};
    var slidesTablet = {{ slides_tablet }};
    var slidesDesktop = {{ slides_desktop }};

    function initSlider() {
      var swiperEl = document.querySelector('.slider-7-swiper-' + sectionId);
      if (!swiperEl || typeof Swiper === 'undefined') return;

      var currentEl = document.querySelector('.slider-7-current-' + sectionId);

      new Swiper(swiperEl, {
        spaceBetween: spaceBetween,
        loop: totalSlides > 1,
        centeredSlides: true,
        navigation: {
          nextEl: '.slider-7-btn-next-' + sectionId,
          prevEl: '.slider-7-btn-prev-' + sectionId,
        },
        breakpoints: {
          320: {
            speed: 600,
            spaceBetween: spaceBetween,
            slidesPerView: slidesMobile
          },
          768: {
            speed: 600,
            spaceBetween: spaceBetween,
            slidesPerView: slidesTablet
          },
          1024: {
            speed: 300,
            spaceBetween: spaceBetween,
            slidesPerView: slidesDesktop
          }
        },
        on: {
          slideChange: function() {
            if (currentEl) {
              var currentIndex = this.realIndex + 1;
              currentEl.innerText = currentIndex;
            }
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlider);
    } else {
      initSlider();
    }
  })();
</script>

