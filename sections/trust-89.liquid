<style>
  #shopify-section-{{ section.id }} {
    --trust89-bg: {{ section.settings.background_color }};
    --trust89-card: {{ section.settings.card_color }};
    --trust89-text: {{ section.settings.text_color }};
    --trust89-muted: {{ section.settings.muted_color }};
    --trust89-accent: {{ section.settings.accent_color }};
    --trust89-empty: {{ section.settings.star_empty_color }};
    --trust89-border: color-mix(in srgb, {{ section.settings.text_color }} 10%, transparent);
  }
  #shopify-section-{{ section.id }} .trust89 { background: var(--trust89-bg); color: var(--trust89-text); padding-block: {{ section.settings.padding_y }}px; }
  #shopify-section-{{ section.id }} .trust89__shell { width: min({{ section.settings.content_max_width }}px, calc(100% - 32px)); margin-inline: auto; display: grid; grid-template-columns: minmax(260px, .9fr) minmax(0, 1.35fr); gap: clamp(18px, 3vw, 34px); align-items: start; }
  #shopify-section-{{ section.id }} .trust89__summary, #shopify-section-{{ section.id }} .trust89__card, #shopify-section-{{ section.id }} .trust89__tabs { background: var(--trust89-card); border: 1px solid var(--trust89-border); border-radius: 8px; box-shadow: 0 18px 50px color-mix(in srgb, {{ section.settings.text_color }} 10%, transparent); }
  #shopify-section-{{ section.id }} .trust89__summary { position: sticky; top: 24px; padding: clamp(20px, 2.6vw, 26px); }
  #shopify-section-{{ section.id }} .trust89__brand { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 18px; font-size: 15px; font-weight: 800; letter-spacing: 0; }
  #shopify-section-{{ section.id }} .trust89__brand-star { width: 26px; height: 26px; display: inline-grid; place-items: center; background: var(--trust89-accent); color: #fff; border-radius: 4px; font-size: 17px; line-height: 1; }
  #shopify-section-{{ section.id }} .trust89__heading { margin: 0; color: var(--trust89-text); font-size: clamp(30px, 4vw, 52px); line-height: 1.02; letter-spacing: 0; }
  #shopify-section-{{ section.id }} .trust89__intro { margin-top: 16px; color: var(--trust89-muted); font-size: 16px; line-height: 1.65; }
  #shopify-section-{{ section.id }} .trust89__intro > *, #shopify-section-{{ section.id }} .trust89__tabpanel > * { margin-block: 0 10px; }
  #shopify-section-{{ section.id }} .trust89__rating { margin-top: 22px; padding: 18px; border-radius: 8px; background: color-mix(in srgb, var(--trust89-accent) 7%, var(--trust89-card)); border: 1px solid color-mix(in srgb, var(--trust89-accent) 18%, transparent); }
  #shopify-section-{{ section.id }} .trust89__trust-label { margin: 0 0 10px; font-size: 18px; font-weight: 800; }
  #shopify-section-{{ section.id }} .trust89__stars { display: flex; align-items: center; gap: 3px; }
  #shopify-section-{{ section.id }} .trust89__star-box { width: 28px; height: 28px; display: inline-grid; place-items: center; border-radius: 2px; background: var(--trust89-accent); color: #fff; font-size: 17px; line-height: 1; }
  #shopify-section-{{ section.id }} .trust89__stars--small .trust89__star-box { width: 22px; height: 22px; font-size: 13px; }
  #shopify-section-{{ section.id }} .trust89__star-box--empty { background: var(--trust89-empty); }
  #shopify-section-{{ section.id }} .trust89__score { margin: 12px 0 0; color: var(--trust89-muted); font-size: 14px; line-height: 1.5; }
  #shopify-section-{{ section.id }} .trust89__score strong { color: var(--trust89-text); }
  #shopify-section-{{ section.id }} .trust89__button { width: 100%; margin-top: 20px; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 18px; border-radius: 999px; background: var(--trust89-text); color: var(--trust89-card); font-size: 15px; font-weight: 800; text-decoration: none; transition: transform 160ms ease, opacity 160ms ease; }
  #shopify-section-{{ section.id }} .trust89__button:hover { transform: translateY(-1px); opacity: .92; }
  #shopify-section-{{ section.id }} .trust89__content { display: grid; gap: 16px; }
  #shopify-section-{{ section.id }} .trust89__tabs { overflow: hidden; }
  #shopify-section-{{ section.id }} .trust89__tablist { display: flex; gap: 6px; padding: 8px; overflow-x: auto; border-bottom: 1px solid var(--trust89-border); }
  #shopify-section-{{ section.id }} .trust89__tab-button { appearance: none; border: 0; border-radius: 999px; background: transparent; color: var(--trust89-muted); cursor: pointer; flex: 0 0 auto; padding: 10px 14px; font: inherit; font-size: 14px; font-weight: 800; line-height: 1.2; }
  #shopify-section-{{ section.id }} .trust89__tab-button[aria-selected="true"] { background: var(--trust89-accent); color: #fff; }
  #shopify-section-{{ section.id }} .trust89__tabpanel { padding: 18px; color: var(--trust89-muted); font-size: 14px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .trust89__tabpanel[hidden] { display: none; }
  #shopify-section-{{ section.id }} .trust89__stream { display: grid; gap: 16px; }
  #shopify-section-{{ section.id }} .trust89__card { min-height: 230px; padding: clamp(20px, 2vw, 26px); display: flex; flex-direction: column; }
  #shopify-section-{{ section.id }} .trust89__card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  #shopify-section-{{ section.id }} .trust89__verified { color: var(--trust89-muted); font-size: 13px; line-height: 1.4; text-align: right; }
  #shopify-section-{{ section.id }} .trust89__review-title { margin: 18px 0 8px; color: var(--trust89-text); font-size: 20px; line-height: 1.18; font-weight: 800; }
  #shopify-section-{{ section.id }} .trust89__quote { margin: 0; color: var(--trust89-muted); font-size: 15px; line-height: 1.62; }
  #shopify-section-{{ section.id }} .trust89__person { margin-top: auto; padding-top: 18px; display: flex; align-items: center; gap: 12px; }
  #shopify-section-{{ section.id }} .trust89__avatar { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 50%; overflow: hidden; background: color-mix(in srgb, var(--trust89-accent) 14%, var(--trust89-bg)); color: var(--trust89-accent); display: grid; place-items: center; font-size: 14px; font-weight: 800; }
  #shopify-section-{{ section.id }} .trust89__avatar img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .trust89__author { color: var(--trust89-text); font-size: 14px; font-weight: 800; line-height: 1.3; }
  #shopify-section-{{ section.id }} .trust89__meta { margin-top: 2px; color: var(--trust89-muted); font-size: 13px; line-height: 1.4; }
  @media screen and (min-width: 900px) { #shopify-section-{{ section.id }} .trust89__stream { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media screen and (max-width: 899px) { #shopify-section-{{ section.id }} .trust89__shell { grid-template-columns: 1fr; } #shopify-section-{{ section.id }} .trust89__summary { position: static; } }
  @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} .trust89 { padding-block: {{ section.settings.mobile_padding_y }}px; } #shopify-section-{{ section.id }} .trust89__shell { width: min(100% - 24px, {{ section.settings.content_max_width }}px); gap: 16px; } #shopify-section-{{ section.id }} .trust89__heading { font-size: 30px; } #shopify-section-{{ section.id }} .trust89__stream { display: flex; gap: 14px; overflow-x: auto; padding: 2px 12px 10px 0; scroll-snap-type: x mandatory; scrollbar-width: thin; } #shopify-section-{{ section.id }} .trust89__card { flex: 0 0 min(82vw, 320px); min-height: 230px; scroll-snap-align: start; } }
</style>

<section id="Trust89-{{ section.id }}" class="trust89" data-section-id="{{ section.id }}">
  <div class="trust89__shell" data-section-bounded-shell>
    <aside class="trust89__summary" data-section-rating-badge>
      <div class="trust89__brand" aria-label="{{ section.settings.platform_label | escape }}">
        <span class="trust89__brand-star" aria-hidden="true">★</span>
        <span>{{ section.settings.platform_label | escape }}</span>
      </div>
      {% if section.settings.heading != blank %}<h2 class="trust89__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.intro_text != blank %}<div class="trust89__intro">{{ section.settings.intro_text }}</div>{% endif %}
      <div class="trust89__rating">
        {% if section.settings.trust_label != blank %}<p class="trust89__trust-label">{{ section.settings.trust_label | escape }}</p>{% endif %}
        <div class="trust89__stars" aria-label="{{ section.settings.rating_label | escape }}">{% for i in (1..5) %}<span class="trust89__star-box" aria-hidden="true">★</span>{% endfor %}</div>
        <p class="trust89__score">{% if section.settings.trust_score != blank %}<strong>{{ section.settings.trust_score | escape }}</strong>{% endif %}{% if section.settings.review_count != blank %} <span>{{ section.settings.review_count | escape }}</span>{% endif %}</p>
      </div>
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}<a class="trust89__button" href="{{ section.settings.button_link }}">{{ section.settings.button_text | escape }}</a>{% endif %}
    </aside>

    <div class="trust89__content">
      <div class="trust89__tabs" data-section-tabs>
        <div class="trust89__tablist" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
          {% assign tab_button_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'tab' %}
              {% assign tab_button_index = tab_button_index | plus: 1 %}
              <button type="button" class="trust89__tab-button" role="tab" id="Trust89Tab-{{ section.id }}-{{ block.id }}" aria-controls="Trust89Panel-{{ section.id }}-{{ block.id }}" aria-selected="{% if tab_button_index == 1 %}true{% else %}false{% endif %}" tabindex="{% if tab_button_index == 1 %}0{% else %}-1{% endif %}" data-trust89-tab="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.tab_title | escape }}</button>
            {% endif %}
          {% endfor %}
        </div>
        {% assign tab_panel_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            {% assign tab_panel_index = tab_panel_index | plus: 1 %}
            <div class="trust89__tabpanel" role="tabpanel" id="Trust89Panel-{{ section.id }}-{{ block.id }}" aria-labelledby="Trust89Tab-{{ section.id }}-{{ block.id }}" data-trust89-panel="{{ block.id }}" data-block-id="{{ block.id }}" {% if tab_panel_index != 1 %}hidden{% endif %} {{ block.shopify_attributes }}>{% if block.settings.tab_content != blank %}{{ block.settings.tab_content }}{% endif %}</div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="trust89__stream" aria-label="{{ section.settings.reviews_label | escape }}">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            {% assign rating_value = block.settings.rating_or_star_count | default: 5 %}
            {% assign author_initial = block.settings.author_or_name | strip | slice: 0, 1 | upcase %}
            <article class="trust89__card" data-section-review-item {{ block.shopify_attributes }}>
              <div class="trust89__card-top">
                <div class="trust89__stars trust89__stars--small" aria-label="{{ rating_value }} out of 5 stars">{% for i in (1..5) %}<span class="trust89__star-box{% if i > rating_value %} trust89__star-box--empty{% endif %}" aria-hidden="true">★</span>{% endfor %}</div>
                {% if block.settings.review_label != blank %}<span class="trust89__verified">{{ block.settings.review_label | escape }}</span>{% endif %}
              </div>
              {% if block.settings.review_title != blank %}<h3 class="trust89__review-title">{{ block.settings.review_title | escape }}</h3>{% endif %}
              {% if block.settings.quote_or_comment != blank %}<p class="trust89__quote">{{ block.settings.quote_or_comment | escape }}</p>{% endif %}
              <div class="trust89__person">
                <div class="trust89__avatar" aria-hidden="true">{% if block.settings.avatar != blank %}{{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40, 80', alt: block.settings.author_or_name }}{% elsif author_initial != blank %}<span>{{ author_initial }}</span>{% else %}<span>R</span>{% endif %}</div>
                <div>{% if block.settings.author_or_name != blank %}<div class="trust89__author">{{ block.settings.author_or_name | escape }}</div>{% endif %}{% if block.settings.review_date != blank %}<div class="trust89__meta">{{ block.settings.review_date | escape }}</div>{% endif %}</div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sectionId = 'Trust89-{{ section.id }}';
    function setupTrust89(root) {
      if (!root || root.dataset.trust89Ready === 'true') return;
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-trust89-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-trust89-panel]'));
      function activateTab(blockId, focusTab) {
        tabs.forEach(function(tab) {
          var active = tab.getAttribute('data-trust89-tab') === blockId;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.setAttribute('tabindex', active ? '0' : '-1');
          if (active && focusTab) tab.focus();
        });
        panels.forEach(function(panel) { panel.hidden = panel.getAttribute('data-trust89-panel') !== blockId; });
      }
      tabs.forEach(function(tab, index) {
        tab.addEventListener('click', function() { activateTab(tab.getAttribute('data-trust89-tab'), false); });
        tab.addEventListener('keydown', function(event) {
          var nextIndex = index;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          activateTab(tabs[nextIndex].getAttribute('data-trust89-tab'), true);
        });
      });
      root.dataset.trust89Ready = 'true';
    }
    function initTrust89() { setupTrust89(document.getElementById(sectionId)); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTrust89); else initTrust89();
    document.addEventListener('shopify:section:load', initTrust89);
    document.addEventListener('shopify:block:select', function(event) {
      var root = document.getElementById(sectionId);
      if (!root || !event.detail || !event.detail.blockId) return;
      var tab = root.querySelector('[data-trust89-tab="' + event.detail.blockId + '"]');
      if (tab) tab.click();
    });
  })();
</script>

{% schema %}
{
  "name": "Trust 89 reviews",
  "tag": "section",
  "class": "shopify-section--trust-89",
  "settings": [
    { "type": "text", "id": "platform_label", "label": "Platform label", "default": "Trustpilot" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Excellent service, reviewed by real customers" },
    { "type": "richtext", "id": "intro_text", "label": "Intro text", "default": "<p>Show recent customer feedback in a clean Trustpilot-style layout. Edit every score, review and call to action from the theme editor.</p>" },
    { "type": "text", "id": "trust_label", "label": "Rating label", "default": "Excellent" },
    { "type": "text", "id": "rating_label", "label": "Accessible star rating label", "default": "Rated 5 out of 5 stars" },
    { "type": "text", "id": "trust_score", "label": "Trust score", "default": "TrustScore 4.8" },
    { "type": "text", "id": "review_count", "label": "Review count text", "default": "Based on 1,234 reviews" },
    { "type": "text", "id": "tabs_label", "label": "Tabs label", "default": "Review information" },
    { "type": "text", "id": "reviews_label", "label": "Reviews region label", "default": "Customer reviews" },
    { "type": "text", "id": "button_text", "label": "Primary button text", "default": "Read all reviews" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f5f7f6" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#17201b" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5f6b65" },
    { "type": "color", "id": "accent_color", "label": "Trust accent", "default": "#00b67a" },
    { "type": "color", "id": "star_empty_color", "label": "Empty star background", "default": "#d7deda" },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 860, "max": 1120, "step": 20, "unit": "px", "default": 1040 },
    { "type": "range", "id": "padding_y", "label": "Desktop vertical padding", "min": 36, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "mobile_padding_y", "label": "Mobile vertical padding", "min": 24, "max": 72, "step": 4, "unit": "px", "default": 44 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Trust tab",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "tab_title", "label": "Tab title", "default": "Why customers trust us" },
        { "type": "richtext", "id": "tab_content", "label": "Tab content", "default": "<p>Use this area for review policy, delivery promises or service guarantees. It renders as an accessible tab panel without any external script.</p>" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating_or_star_count", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "review_label", "label": "Review label", "default": "Verified review" },
        { "type": "text", "id": "review_title", "label": "Review title", "default": "Fast delivery and brilliant support" },
        { "type": "textarea", "id": "quote_or_comment", "label": "Review quote or comment", "default": "The experience felt premium from start to finish. Clear communication, quick delivery and exactly what we needed." },
        { "type": "text", "id": "author_or_name", "label": "Reviewer name", "default": "Sophie M." },
        { "type": "text", "id": "review_date", "label": "Date or customer detail", "default": "2 days ago" },
        { "type": "image_picker", "id": "avatar", "label": "Reviewer avatar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust 89 reviews",
      "blocks": [
        { "type": "tab", "settings": { "tab_title": "Review standards", "tab_content": "<p>Highlight how you collect and display customer feedback, including service quality, response time and product satisfaction.</p>" } },
        { "type": "tab", "settings": { "tab_title": "Service promise", "tab_content": "<p>Use this tab for delivery promises, support expectations or satisfaction guarantees customers should know before ordering.</p>" } },
        { "type": "review", "settings": { "rating_or_star_count": 5, "review_label": "Verified review", "review_title": "Beautiful experience from start to finish", "quote_or_comment": "Everything was easy to arrange and the result looked better than expected. I would happily order again.", "author_or_name": "Emma R.", "review_date": "1 day ago" } },
        { "type": "review", "settings": { "rating_or_star_count": 5, "review_label": "Verified review", "review_title": "Reliable, fast and friendly", "quote_or_comment": "The team replied quickly, kept me updated and delivered exactly on time. A very smooth customer experience.", "author_or_name": "Lucas V.", "review_date": "3 days ago" } },
        { "type": "review", "settings": { "rating_or_star_count": 5, "review_label": "Verified review", "review_title": "Premium quality and clear service", "quote_or_comment": "Great value, polished presentation and no surprises. The whole process felt professional and trustworthy.", "author_or_name": "Mila K.", "review_date": "Last week" } },
        { "type": "review", "settings": { "rating_or_star_count": 4, "review_label": "Verified review", "review_title": "Would recommend to friends", "quote_or_comment": "Very happy with the service and final result. Support was helpful when I had a small question before ordering.", "author_or_name": "Noah D.", "review_date": "Last week" } }
      ]
    }
  ]
}
{% endschema %}