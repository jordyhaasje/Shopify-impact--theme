{% liquid
  assign section_id = 'video-header-' | append: section.id
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
  assign section_height = section.settings.section_height
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign show_dots = section.settings.show_dots
  assign enable_swipe = section.settings.enable_swipe
  assign color_scheme = section.settings.color_scheme
%}

{% style %}
  .{{ section_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .{{ section_id }}__viewport {
    position: relative;
    width: 100%;
  }

  .{{ section_id }}__track {
    display: flex;
    width: 100%;
    transition: transform 500ms ease;
    will-change: transform;
  }

  .{{ section_id }}__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    overflow: hidden;
    isolation: isolate;
  }

  .{{ section_id }}__media,
  .{{ section_id }}__placeholder {
    position: relative;
    width: 100%;
    min-height: 420px;
    height: var(--desktop-height);
  }

  .{{ section_id }}__media video,
  .{{ section_id }}__placeholder-inner {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .{{ section_id }}__placeholder-inner {
    background: linear-gradient(135deg, rgba(20,20,20,.92), rgba(60,60,60,.55));
  }

  .{{ section_id }}__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ overlay_opacity }});
    z-index: 1;
    pointer-events: none;
  }

  .{{ section_id }}__content-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: var(--content_alignment_desktop);
    padding: 4rem 5rem;
  }

  .{{ section_id }}__content {
    width: min(100%, {{ section.settings.content_width }}px);
    text-align: var(--text_alignment);
  }

  .{{ section_id }}__eyebrow {
    margin: 0 0 .75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .85;
    font-size: 1.2rem;
  }

  .{{ section_id }}__heading {
    margin: 0;
    line-height: 1.02;
    max-width: 12ch;
    font-size: clamp(3.2rem, 7vw, {{ section.settings.heading_size }}px);
  }

  .{{ section_id }}__subheading {
    margin: 1.4rem 0 0;
    max-width: 62ch;
    font-size: clamp(1.5rem, 2.1vw, {{ section.settings.subheading_size }}px);
    line-height: 1.5;
    opacity: .95;
  }

  .{{ section_id }}__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .{{ section_id }}__dots {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: .75rem;
  }

  .{{ section_id }}__dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.7);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: transform .2s ease, background .2s ease, opacity .2s ease;
    opacity: .8;
  }

  .{{ section_id }}__dot.is-active {
    background: rgba(255,255,255,1);
    transform: scale(1.08);
    opacity: 1;
  }

  .{{ section_id }} .fade-up {
    opacity: 0;
    transform: translateY(24px);
    animation: {{ section.settings.effect_style }} 900ms ease forwards;
    animation-delay: var(--anim-delay, 0ms);
  }

  @keyframes fade-up-video-header {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in-video-header {
    to {
      opacity: 1;
    }
  }

  @keyframes zoom-out-video-header {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .{{ section_id }}__slide[data-mobile-stack='true'] .{{ section_id }}__content-wrap {
    align-items: flex-end;
  }

  @media screen and (max-width: 989px) {
    .{{ section_id }}__media,
    .{{ section_id }}__placeholder {
      min-height: 360px;
      height: var(--mobile-height);
    }

    .{{ section_id }}__content-wrap {
      justify-content: var(--content_alignment_mobile);
      padding: 2.4rem 2rem 4.8rem;
    }

    .{{ section_id }}__content {
      width: 100%;
    }

    .{{ section_id }}__heading {
      max-width: none;
    }

    .{{ section_id }}__subheading {
      max-width: none;
    }

    .{{ section_id }}__dots {
      bottom: 1.25rem;
    }
  }
{% endstyle %}

<div
  class="{{ section_id }} color-{{ color_scheme }}"
  style="--desktop-height: {{ section_height }}vh; --mobile-height: {{ section.settings.mobile_height }}vh; --text_alignment: {{ section.settings.text_alignment }}; --content_alignment_desktop: {{ section.settings.content_alignment_desktop }}; --content_alignment_mobile: {{ section.settings.content_alignment_mobile }};"
  data-video-header-slider
  data-autoplay="{{ autoplay }}"
  data-speed="{{ autoplay_speed }}"
  data-show-dots="{{ show_dots }}"
  data-enable-swipe="{{ enable_swipe }}"
>
  <div class="{{ section_id }}__viewport">
    <div class="{{ section_id }}__track" data-track>
      {% for block in section.blocks %}
        <section
          class="{{ section_id }}__slide"
          {{ block.shopify_attributes }}
          data-index="{{ forloop.index0 }}"
          data-mobile-stack="{{ section.settings.mobile_stack_content }}"
        >
          {% if block.settings.video != blank %}
            <div class="{{ section_id }}__media">
              {{ block.settings.video | video_tag:
                image_size: '2000x',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                preload: 'metadata'
              }}
            </div>
          {% else %}
            <div class="{{ section_id }}__placeholder">
              <div class="{{ section_id }}__placeholder-inner"></div>
            </div>
          {% endif %}

          <div class="{{ section_id }}__overlay"></div>

          <div class="{{ section_id }}__content-wrap page-width">
            <div class="{{ section_id }}__content">
              {% if block.settings.eyebrow != blank %}
                <p class="{{ section_id }}__eyebrow fade-up" style="--anim-delay: 80ms;">{{ block.settings.eyebrow }}</p>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2 class="{{ section_id }}__heading fade-up" style="--anim-delay: 140ms;">{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.subheading != blank %}
                <div class="{{ section_id }}__subheading fade-up" style="--anim-delay: 220ms;">{{ block.settings.subheading }}</div>
              {% endif %}

              {% if block.settings.button_label != blank or block.settings.secondary_button_label != blank %}
                <div class="{{ section_id }}__buttons fade-up" style="--anim-delay: 300ms;">
                  {% if block.settings.button_label != blank %}
                    <a
                      {% if block.settings.button_link != blank %}
                        href="{{ block.settings.button_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                    >
                      {{ block.settings.button_label }}
                    </a>
                  {% endif %}

                  {% if block.settings.secondary_button_label != blank %}
                    <a
                      {% if block.settings.secondary_button_link != blank %}
                        href="{{ block.settings.secondary_button_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="button {% if block.settings.secondary_button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                    >
                      {{ block.settings.secondary_button_label }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </section>
      {% endfor %}
    </div>

    {% if show_dots and section.blocks.size > 1 %}
      <div class="{{ section_id }}__dots" data-dots>
        {% for block in section.blocks %}
          <button
            type="button"
            class="{{ section_id }}__dot {% if forloop.first %}is-active{% endif %}"
            data-dot="{{ forloop.index0 }}"
            aria-label="Ga naar slide {{ forloop.index }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const track = root.querySelector('[data-track]');
    const slides = Array.from(root.querySelectorAll('[data-index]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    if (!track || slides.length <= 1) return;

    let index = 0;
    let timer = null;
    const autoplay = root.dataset.autoplay === 'true';
    const speed = parseInt(root.dataset.speed || '5000', 10);
    const enableSwipe = root.dataset.enableSwipe === 'true';

    const goTo = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      track.style.transform = `translate3d(-${index * 100}%, 0, 0)`;
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    const start = () => {
      stop();
      if (!autoplay) return;
      timer = setInterval(() => goTo(index + 1), Math.max(speed, 2500));
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(parseInt(dot.dataset.dot, 10));
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    if (enableSwipe) {
      let startX = 0;
      let deltaX = 0;

      track.addEventListener('touchstart', (event) => {
        startX = event.touches[0].clientX;
      }, { passive: true });

      track.addEventListener('touchmove', (event) => {
        deltaX = event.touches[0].clientX - startX;
      }, { passive: true });

      track.addEventListener('touchend', () => {
        if (Math.abs(deltaX) > 50) {
          goTo(deltaX < 0 ? index + 1 : index - 1);
          start();
        }
        startX = 0;
        deltaX = 0;
      });
    }

    goTo(0);
    start();
  })();
</script>

{% schema %}
{
  "name": "Video header slider",
  "tag": "section",
  "class": "section section-video-header-slider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Desktop height (vh)",
      "min": 45,
      "max": 100,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height (vh)",
      "min": 35,
      "max": 100,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-rotate speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slider dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_swipe",
      "label": "Enable swipe on touch devices",
      "default": true
    },
    {
      "type": "select",
      "id": "content_alignment_desktop",
      "label": "Desktop content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "content_alignment_mobile",
      "label": "Mobile content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 420,
      "max": 1200,
      "step": 20,
      "default": 720,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Max heading size",
      "min": 36,
      "max": 110,
      "step": 2,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Max subheading size",
      "min": 14,
      "max": 34,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "mobile_stack_content",
      "label": "Anchor content lower on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "effect_style",
      "label": "Content effect",
      "options": [
        { "value": "fade-up-video-header", "label": "Fade up" },
        { "value": "fade-in-video-header", "label": "Fade in" },
        { "value": "zoom-out-video-header", "label": "Zoom out" }
      ],
      "default": "fade-up-video-header"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Video slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video upload"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Tell your story in motion"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p>Use an uploaded Shopify video as your homepage hero and combine it with strong messaging, buttons, and smooth slider navigation.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Use secondary style for primary button",
          "default": false
        },
        {
          "type": "text",
          "id": "secondary_button_label",
          "label": "Secondary button label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary button link"
        },
        {
          "type": "checkbox",
          "id": "secondary_button_style_secondary",
          "label": "Use secondary style for secondary button",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Video header slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}