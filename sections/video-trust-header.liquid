{% render 'section-spacing-collapsing' %}

<style>
#shopify-section-{{ section.id }} {
  --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  --trust-color: {{ section.settings.trust_color }};
  --text-color: {{ section.settings.text_color }};
}

.video-trust-header {
  position: relative;
  overflow: hidden;
  color: var(--text-color);
}
.video-trust-header__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.video-trust-header__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,var(--overlay-opacity));
}
.video-trust-header__content {
  position: relative;
  z-index: 2;
  padding: 60px 20px;
  text-align: center;
}

.video-trust-header__stars {
  display:flex;
  gap:4px;
  justify-content:center;
}
.video-trust-header__star {
  width:22px;height:22px;
  background: var(--trust-color);
  display:flex;align-items:center;justify-content:center;
  border-radius:3px;
}
.video-trust-header__star svg {fill:#fff;width:14px;height:14px;}

.video-trust-header__rating {
  margin-top:10px;
  font-size:16px;
}
.video-trust-header__label {
  font-size:12px;
  opacity:.7;
}

</style>

<section class="video-trust-header">
  {% if section.settings.video != blank %}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'video-trust-header__video' }}
  {% endif %}
  <div class="video-trust-header__overlay"></div>

  <div class="video-trust-header__content container">

    <h2>{{ section.settings.heading }}</h2>

    <div class="video-trust-header__stars">
      {% for i in (1..5) %}
        <div class="video-trust-header__star">
          <svg viewBox="0 0 20 20">
            <path d="M10 15l-5.878 3.09L5.3 11.545.6 7.41l6.1-.885L10 1l3.3 5.525 6.1.885-4.7 4.136 1.178 6.545z"/>
          </svg>
        </div>
      {% endfor %}
    </div>

    <div class="video-trust-header__rating">
      {{ section.settings.rating }} / 5 – {{ section.settings.review_count }} reviews
    </div>

    <div class="video-trust-header__label">
      ★ Trustpilot – {{ section.settings.rating_label }}
    </div>

    {% render 'button', content: section.settings.button_label, href: section.settings.button_link %}

  </div>
</section>

{% schema %}
{
  "name": "Video Trust Advanced",
  "settings": [
    {"type":"video","id":"video","label":"Video"},
    {"type":"range","id":"overlay_opacity","min":0,"max":80,"step":5,"default":40,"label":"Overlay opacity"},

    {"type":"text","id":"heading","default":"Trusted by thousands","label":"Heading"},

    {"type":"range","id":"rating","min":0,"max":5,"step":0.1,"default":4.8,"label":"Rating"},
    {"type":"text","id":"review_count","default":"2,000+","label":"Review count"},
    {"type":"text","id":"rating_label","default":"Excellent","label":"Rating label"},

    {"type":"color","id":"trust_color","default":"#00b67a","label":"Star color"},
    {"type":"color","id":"text_color","default":"#ffffff","label":"Text color"},

    {"type":"text","id":"button_label","default":"Shop now","label":"Button label"},
    {"type":"url","id":"button_link","label":"Button link"}
  ]
}
{% endschema %}