{% liquid
  assign section_id = section.id
%}

<section id="hero-{{ section_id }}" class="hero-trustpilot" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="hero-media">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: class: 'hero-bg', loading: 'lazy' }}
    {% endif %}
    {% if section.settings.enable_overlay %}
      <div class="hero-overlay"></div>
    {% endif %}
  </div>

  <div class="hero-content">
    <div class="hero-inner">
      {% if section.settings.show_rating %}
        <div class="hero-rating">
          <div class="rating-stars">
            {% for i in (1..5) %}
              <span class="star">★</span>
            {% endfor %}
          </div>
          <div class="rating-text">
            <strong>{{ section.settings.rating_label }}</strong>
            <span>{{ section.settings.rating_value }}</span>
            <small>{{ section.settings.review_count }}</small>
          </div>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="hero-subtext rte">{{ section.settings.subtext }}</div>
      {% endif %}

      <div class="hero-buttons">
        {% if section.settings.primary_button_label != blank %}
          <a href="{{ section.settings.primary_button_link }}" class="btn-primary">
            {{ section.settings.primary_button_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a href="{{ section.settings.secondary_button_link }}" class="btn-secondary">
            {{ section.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
#hero-{{ section_id }} {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: {{ section.settings.desktop_height }}px;
  text-align: center;
}

#hero-{{ section_id }} .hero-media {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

#hero-{{ section_id }} .hero-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#hero-{{ section_id }} .hero-overlay {
  position: absolute;
  inset: 0;
  background: black;
  opacity: var(--overlay-opacity);
}

#hero-{{ section_id }} .hero-content {
  position: relative;
  z-index: 2;
  max-width: {{ section.settings.content_max_width }}px;
  padding: 20px;
}

.hero-heading {
  font-size: 42px;
  font-weight: 700;
  margin-bottom: 16px;
}

.hero-subtext {
  font-size: 16px;
  margin-bottom: 20px;
}

.hero-buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.btn-primary {
  background: #00B67A;
  color: white;
  padding: 12px 20px;
  border-radius: 6px;
  text-decoration: none;
}

.btn-secondary {
  border: 1px solid black;
  padding: 12px 20px;
  border-radius: 6px;
  text-decoration: none;
}

.hero-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 16px;
}

.rating-stars {
  display: flex;
  gap: 2px;
}

.rating-stars .star {
  background: #00B67A;
  color: white;
  font-size: 12px;
  padding: 4px;
}

@media screen and (max-width: 768px) {
  #hero-{{ section_id }} {
    min-height: {{ section.settings.mobile_height }}px;
  }

  .hero-heading {
    font-size: 28px;
  }

  .hero-buttons {
    flex-direction: column;
  }
}
</style>

{% schema %}
{
  "name": "Hero Trustpilot Style",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "range", "id": "desktop_height", "min": 300, "max": 900, "step": 50, "default": 600, "label": "Desktop height" },
    { "type": "range", "id": "mobile_height", "min": 200, "max": 700, "step": 50, "default": 400, "label": "Mobile height" },

    { "type": "checkbox", "id": "enable_overlay", "label": "Enable overlay", "default": true },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "default": 30, "label": "Overlay opacity" },

    { "type": "text", "id": "heading", "label": "Heading", "default": "Sterk bewijs. Direct vertrouwen." },
    { "type": "richtext", "id": "subtext", "label": "Subtext" },

    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "Uitstekend" },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.8/5" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "3.214 reviews" },

    { "type": "text", "id": "primary_button_label", "label": "Primary button label" },
    { "type": "url", "id": "primary_button_link", "label": "Primary button link" },

    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },

    { "type": "range", "id": "content_max_width", "min": 600, "max": 1200, "step": 20, "default": 800, "label": "Content width" }
  ],
  "presets": [
    {
      "name": "Hero Trustpilot",
      "category": "Hero"
    }
  ]
}
{% endschema %}