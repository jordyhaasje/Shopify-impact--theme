{%- render 'section-spacing-collapsing', background: section.settings.background_color -%}

<style>
  #shopify-section-{{ section.id }} {
    --hero-127-bg: {{ section.settings.background_color }};
    --hero-127-text: {{ section.settings.text_color }};
    --hero-127-star: {{ section.settings.star_color }};
    --hero-127-star-bg: {{ section.settings.star_background }};
    --hero-127-card: {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .hero-127 {
    position: relative;
    overflow: hidden;
    color: var(--hero-127-text);
    background: linear-gradient(180deg, color-mix(in srgb, var(--hero-127-bg) 88%, #fff) 0%, var(--hero-127-bg) 100%);
  }

  #shopify-section-{{ section.id }} .hero-127__shell {
    max-width: {{ section.settings.content_width }}px;
    margin-inline: auto;
    min-height: {{ section.settings.desktop_min_height }}px;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .76fr);
    align-items: center;
    gap: clamp(24px, 4vw, {{ section.settings.desktop_gap }}px);
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .hero-127__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: {{ section.settings.content_text_width }}px;
  }

  #shopify-section-{{ section.id }} .hero-127__proof {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 20px;
    margin-bottom: {{ section.settings.proof_margin_bottom }}px;
  }

  #shopify-section-{{ section.id }} .hero-127__avatars {
    display: flex;
    align-items: center;
    padding-left: {{ section.settings.avatar_overlap }}px;
  }

  #shopify-section-{{ section.id }} .hero-127__avatar {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    margin-left: calc({{ section.settings.avatar_overlap }}px * -1);
    border-radius: 999px;
    border: {{ section.settings.avatar_border_width }}px solid rgba(255,255,255,.86);
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: 0 10px 20px rgba(80,31,38,.1);
    color: #161616;
    font-size: 12px;
    font-weight: 800;
    background: var(--avatar-bg, #efe8e1);
  }

  #shopify-section-{{ section.id }} .hero-127__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .hero-127__rating-wrap,
  #shopify-section-{{ section.id }} .hero-127__stars-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 18px;
  }

  #shopify-section-{{ section.id }} .hero-127__customers {
    font-size: {{ section.settings.customers_font_size }}px;
    line-height: 1;
    letter-spacing: .12em;
    font-weight: 400;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hero-127__stars {
    display: inline-flex;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .hero-127__star {
    width: {{ section.settings.star_box_size }}px;
    height: {{ section.settings.star_box_size }}px;
    display: grid;
    place-items: center;
    background: var(--hero-127-star-bg);
    color: var(--hero-127-star);
    font: {{ section.settings.star_font_size }}px/1 Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .hero-127__score {
    font-size: {{ section.settings.rating_font_size }}px;
    line-height: 1;
    letter-spacing: .08em;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .hero-127__heading {
    margin: 0;
    max-width: 760px;
    color: var(--hero-127-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: -.045em;
    font-weight: 900;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .hero-127__heading-line {
    display: inline-block;
    position: relative;
  }

  #shopify-section-{{ section.id }} .hero-127__heading-line::after {
    content: '';
    position: absolute;
    left: .07em;
    right: .03em;
    bottom: -.1em;
    height: {{ section.settings.underline_height }}px;
    background: rgba(255,255,255,.92);
    box-shadow: 0 {{ section.settings.underline_gap }}px 0 rgba(255,255,255,.92);
  }

  #shopify-section-{{ section.id }} .hero-127__heading-emphasis {
    display: block;
    margin-top: .32em;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .hero-127__text {
    margin: {{ section.settings.text_margin_top }}px 0 0;
    max-width: {{ section.settings.text_width }}px;
    color: var(--hero-127-text);
    font-size: {{ section.settings.text_size }}px;
    line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    letter-spacing: {{ section.settings.text_letter_spacing | divided_by: 100.0 }}em;
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .hero-127__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.button_gap }}px;
    width: 100%;
    margin-top: {{ section.settings.button_margin_top }}px;
  }

  #shopify-section-{{ section.id }} .hero-127__button {
    min-width: min({{ section.settings.button_min_width }}px, 100%);
    min-height: {{ section.settings.button_height }}px;
    padding: 18px 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--hero-127-text);
    background: var(--hero-127-card);
    border: 1px solid rgba(17,17,17,.04);
    box-shadow: 0 16px 36px rgba(76,21,29,.07);
    font-size: {{ section.settings.button_font_size }}px;
    line-height: 1;
    letter-spacing: .16em;
    font-weight: 800;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #shopify-section-{{ section.id }} .hero-127__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px rgba(76,21,29,.12);
  }

  #shopify-section-{{ section.id }} .hero-127__bottom-proof {
    margin-top: {{ section.settings.bottom_proof_margin_top }}px;
    width: 100%;
    text-align: left;
    font-size: {{ section.settings.bottom_proof_font_size }}px;
    line-height: 1.2;
    letter-spacing: .14em;
    font-weight: 900;
  }

  #shopify-section-{{ section.id }} .hero-127__visual {
    position: relative;
    min-height: 360px;
    align-self: stretch;
  }

  #shopify-section-{{ section.id }} .hero-127__hand {
    position: absolute;
    top: {{ section.settings.hand_top }}%;
    right: {{ section.settings.hand_right }}%;
    width: min({{ section.settings.hand_width }}px, 48vw);
    height: {{ section.settings.hand_height }}px;
    border-radius: 999px 0 0 999px;
    background: linear-gradient(90deg, #f2ad90 0%, #f7c1ad 46%, #e6967f 100%);
    box-shadow: 30px 38px 0 rgba(157,35,48,.16);
    transform: rotate(12deg);
  }

  #shopify-section-{{ section.id }} .hero-127__hand::before {
    content: '';
    position: absolute;
    left: 8%;
    top: -50px;
    width: 170px;
    height: 72px;
    border-radius: 999px;
    background: linear-gradient(90deg, #f6b89f, #e89079);
    transform: rotate(-12deg);
  }

  #shopify-section-{{ section.id }} .hero-127__product {
    position: absolute;
    left: {{ section.settings.product_left }}%;
    bottom: {{ section.settings.product_bottom }}%;
    width: min({{ section.settings.product_width }}px, 84%);
    min-height: {{ section.settings.product_height }}px;
    padding: 16px 22px;
    border-radius: 12px;
    display: grid;
    align-content: center;
    background: #fff7f2;
    color: #151515;
    box-shadow: 0 26px 54px rgba(110,32,45,.18);
    transform: rotate({{ section.settings.product_rotation }}deg);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hero-127__product::before,
  #shopify-section-{{ section.id }} .hero-127__product::after {
    content: '';
    position: absolute;
    top: 0;
    width: 36px;
    height: 100%;
    background: repeating-linear-gradient(90deg, rgba(0,0,0,.06) 0 2px, transparent 2px 6px);
  }
  #shopify-section-{{ section.id }} .hero-127__product::before { left: 0; }
  #shopify-section-{{ section.id }} .hero-127__product::after { right: 0; }

  #shopify-section-{{ section.id }} .hero-127__product-image { position: absolute; inset: 0; z-index: 1; }
  #shopify-section-{{ section.id }} .hero-127__product-image img { width: 100%; height: 100%; object-fit: cover; }

  #shopify-section-{{ section.id }} .hero-127__product-fallback {
    position: relative;
    z-index: 2;
    padding-inline: 34px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .hero-127__product-kicker { font-size: 12px; letter-spacing: .15em; font-weight: 900; }
  #shopify-section-{{ section.id }} .hero-127__product-title { margin-top: 3px; font-family: Georgia, 'Times New Roman', serif; font-size: 34px; line-height: .84; letter-spacing: -.06em; font-weight: 900; }
  #shopify-section-{{ section.id }} .hero-127__product-flavor { margin-top: 4px; font-size: 11px; letter-spacing: .1em; font-weight: 700; }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hero-127__shell {
      display: block;
      max-width: {{ section.settings.mobile_content_width }}px;
      min-height: 0;
      padding: {{ section.settings.mobile_padding_top }}px 18px {{ section.settings.mobile_padding_bottom }}px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .hero-127__content { align-items: center; max-width: none; }
    #shopify-section-{{ section.id }} .hero-127__proof { justify-content: center; margin-bottom: {{ section.settings.mobile_proof_margin_bottom }}px; gap: {{ section.settings.mobile_proof_gap }}px; }
    #shopify-section-{{ section.id }} .hero-127__rating-wrap { justify-content: center; gap: {{ section.settings.mobile_rating_gap }}px; }
    #shopify-section-{{ section.id }} .hero-127__avatars { width: 100%; justify-content: center; padding-left: {{ section.settings.mobile_avatar_overlap }}px; }
    #shopify-section-{{ section.id }} .hero-127__avatar { width: {{ section.settings.mobile_avatar_size }}px; height: {{ section.settings.mobile_avatar_size }}px; margin-left: calc({{ section.settings.mobile_avatar_overlap }}px * -1); }
    #shopify-section-{{ section.id }} .hero-127__customers { width: 100%; font-size: {{ section.settings.mobile_customers_font_size }}px; }
    #shopify-section-{{ section.id }} .hero-127__star { width: {{ section.settings.mobile_star_box_size }}px; height: {{ section.settings.mobile_star_box_size }}px; font-size: {{ section.settings.mobile_star_font_size }}px; }
    #shopify-section-{{ section.id }} .hero-127__score { font-size: {{ section.settings.mobile_rating_font_size }}px; }
    #shopify-section-{{ section.id }} .hero-127__heading { font-size: {{ section.settings.mobile_heading_size }}px; line-height: {{ section.settings.mobile_heading_line_height | divided_by: 100.0 }}; max-width: {{ section.settings.mobile_heading_width }}px; }
    #shopify-section-{{ section.id }} .hero-127__heading-line::after { height: {{ section.settings.mobile_underline_height }}px; box-shadow: 0 {{ section.settings.mobile_underline_gap }}px 0 rgba(255,255,255,.92); }
    #shopify-section-{{ section.id }} .hero-127__text { margin-top: {{ section.settings.mobile_text_margin_top }}px; max-width: {{ section.settings.mobile_text_width }}px; font-size: {{ section.settings.mobile_text_size }}px; line-height: {{ section.settings.mobile_text_line_height | divided_by: 100.0 }}; letter-spacing: {{ section.settings.mobile_text_letter_spacing | divided_by: 100.0 }}em; }
    #shopify-section-{{ section.id }} .hero-127__buttons { justify-content: center; margin-top: {{ section.settings.mobile_button_margin_top }}px; gap: {{ section.settings.mobile_button_gap }}px; }
    #shopify-section-{{ section.id }} .hero-127__button { flex: 0 1 calc(50% - {{ section.settings.mobile_button_gap | divided_by: 2 }}px); min-width: 0; min-height: {{ section.settings.mobile_button_height }}px; padding: 16px 12px; font-size: {{ section.settings.mobile_button_font_size }}px; }
    #shopify-section-{{ section.id }} .hero-127__bottom-proof { margin-top: {{ section.settings.mobile_bottom_proof_margin_top }}px; text-align: center; font-size: {{ section.settings.mobile_bottom_proof_font_size }}px; }

    #shopify-section-{{ section.id }} .hero-127__visual { display: block; position: absolute; inset: 0; min-height: 0; pointer-events: none; z-index: -1; opacity: {{ section.settings.mobile_visual_opacity | divided_by: 100.0 }}; }
    #shopify-section-{{ section.id }} .hero-127__hand { top: {{ section.settings.mobile_hand_top }}%; right: {{ section.settings.mobile_hand_right }}%; width: {{ section.settings.mobile_hand_width }}vw; min-width: 0; height: {{ section.settings.mobile_hand_height }}px; }
    #shopify-section-{{ section.id }} .hero-127__product { left: {{ section.settings.mobile_product_left }}%; bottom: {{ section.settings.mobile_product_bottom }}%; width: {{ section.settings.mobile_product_width }}vw; min-height: {{ section.settings.mobile_product_height }}px; }
  }
</style>

<section class="hero-127" data-section-id="{{ section.id }}">
  <div class="hero-127__shell" data-section-bounded-shell>
    <div class="hero-127__content">
      <div class="hero-127__proof" aria-label="{{ section.settings.customers_text | escape }}">
        <div class="hero-127__avatars" aria-hidden="true">
          {%- assign avatar_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'avatar' -%}
              {%- assign avatar_count = avatar_count | plus: 1 -%}
              <span class="hero-127__avatar" style="--avatar-bg: {{ block.settings.background_color }};" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: block.settings.alt_text }}
                {%- elsif block.settings.initial != blank -%}
                  {{ block.settings.initial | escape }}
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endfor -%}

          {%- if avatar_count == 0 -%}
            <span class="hero-127__avatar" style="--avatar-bg:#e8edf5;">A</span>
            <span class="hero-127__avatar" style="--avatar-bg:#eadcca;">J</span>
            <span class="hero-127__avatar" style="--avatar-bg:#d8e2df;">M</span>
            <span class="hero-127__avatar" style="--avatar-bg:#efe4d9;">N</span>
          {%- endif -%}
        </div>

        <div class="hero-127__rating-wrap">
          {%- if section.settings.customers_text != blank -%}<div class="hero-127__customers">{{ section.settings.customers_text | escape }}</div>{%- endif -%}
          <div class="hero-127__stars-row">
            <span class="hero-127__stars" aria-hidden="true">{%- for i in (1..5) -%}<span class="hero-127__star">★</span>{%- endfor -%}</span>
            {%- if section.settings.rating_score != blank -%}<span class="hero-127__score">{{ section.settings.rating_score | escape }}</span>{%- endif -%}
          </div>
        </div>
      </div>

      {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
        <h1 class="hero-127__heading">
          {%- if section.settings.heading_line_1 != blank -%}<span class="hero-127__heading-line">{{ section.settings.heading_line_1 | escape }}</span>{%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}<span class="hero-127__heading-emphasis">{{ section.settings.heading_line_2 | escape }}</span>{%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}<div class="hero-127__text">{{ section.settings.text }}</div>{%- endif -%}

      <div class="hero-127__buttons">
        {%- if section.settings.button_1_label != blank -%}<a class="hero-127__button" href="{{ section.settings.button_1_link | default: '#' }}">{{ section.settings.button_1_label | escape }}</a>{%- endif -%}
        {%- if section.settings.button_2_label != blank -%}<a class="hero-127__button" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_label | escape }}</a>{%- endif -%}
      </div>

      {%- if section.settings.bottom_proof != blank -%}<div class="hero-127__bottom-proof">{{ section.settings.bottom_proof | escape }}</div>{%- endif -%}
    </div>

    <div class="hero-127__visual" aria-hidden="true">
      <div class="hero-127__hand"></div>
      <div class="hero-127__product">
        {%- if section.settings.product_image != blank -%}
          <div class="hero-127__product-image">{{ section.settings.product_image | image_url: width: 800 | image_tag: loading: 'eager', widths: '280,420,560,800', alt: section.settings.product_title }}</div>
        {%- else -%}
          <div class="hero-127__product-fallback">
            <div class="hero-127__product-kicker">{{ section.settings.product_kicker | escape }}</div>
            <div class="hero-127__product-title">{{ section.settings.product_title | escape }}</div>
            <div class="hero-127__product-flavor">{{ section.settings.product_flavor | escape }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero-127",
  "class": "shopify-section--hero-127",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "customers_text", "label": "Customers text", "default": "50K+ Happy Customers" },
    { "type": "text", "id": "rating_score", "label": "Rating score", "default": "4.7" },
    { "type": "text", "id": "heading_line_1", "label": "Heading first line", "default": "It's all about the" },
    { "type": "text", "id": "heading_line_2", "label": "Heading second line", "default": "crave" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our products are easy to understand, made from organic nutritious and delicious ingredients.</p>" },
    { "type": "text", "id": "button_1_label", "label": "First button label", "default": "Shop bars" },
    { "type": "url", "id": "button_1_link", "label": "First button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Shop chips" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "text", "id": "bottom_proof", "label": "Bottom proof text", "default": "Over 50.000 Happy Customers" },
    { "type": "header", "content": "Product visual" },
    { "type": "image_picker", "id": "product_image", "label": "Product image" },
    { "type": "text", "id": "product_kicker", "label": "Product kicker", "default": "The Organic" },
    { "type": "text", "id": "product_title", "label": "Product title", "default": "CRAVE" },
    { "type": "text", "id": "product_flavor", "label": "Product flavor", "default": "Cocoa & Nibs" },

    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 960, "max": 1320, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "content_text_width", "label": "Text column width", "min": 520, "max": 760, "step": 20, "unit": "px", "default": 680 },
    { "type": "range", "id": "desktop_min_height", "label": "Desktop minimum height", "min": 360, "max": 680, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "desktop_gap", "label": "Desktop column gap", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 80 },

    { "type": "header", "content": "Desktop typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 44, "max": 56, "step": 1, "unit": "px", "default": 56 },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 84, "max": 110, "step": 1, "unit": "%", "default": 90 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 16, "max": 20, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "text_line_height", "label": "Text line height", "min": 140, "max": 190, "step": 5, "unit": "%", "default": 170 },
    { "type": "range", "id": "text_letter_spacing", "label": "Text letter spacing", "min": 0, "max": 25, "step": 1, "unit": "%", "default": 15 },
    { "type": "range", "id": "text_margin_top", "label": "Text top spacing", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "text_width", "label": "Text max width", "min": 420, "max": 700, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "bottom_proof_font_size", "label": "Bottom proof size", "min": 15, "max": 26, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "bottom_proof_margin_top", "label": "Bottom proof top spacing", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 30 },

    { "type": "header", "content": "Desktop proof row" },
    { "type": "range", "id": "proof_margin_bottom", "label": "Proof row bottom spacing", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "avatar_size", "label": "Avatar size", "min": 34, "max": 64, "step": 1, "unit": "px", "default": 50 },
    { "type": "range", "id": "avatar_overlap", "label": "Avatar overlap", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "avatar_border_width", "label": "Avatar border width", "min": 0, "max": 5, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "customers_font_size", "label": "Customers text size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "star_box_size", "label": "Star box size", "min": 20, "max": 34, "step": 1, "unit": "px", "default": 31 },
    { "type": "range", "id": "star_font_size", "label": "Star icon size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "rating_font_size", "label": "Rating score size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 24 },

    { "type": "header", "content": "Desktop buttons" },
