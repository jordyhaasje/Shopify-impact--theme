{% liquid
  assign section_id = 'video-review-testimonials-' | append: section.id
%}

<section id="{{ section_id }}" class="video-review-testimonials section section--flush">
  <div class="video-review-testimonials__inner">
    <div class="video-review-testimonials__top">
      <div class="video-review-testimonials__avatars">
        {% for i in (1..4) %}
          {% liquid
            assign avatar_key = 'avatar_' | append: i
            assign avatar = section.settings[avatar_key]
          %}
          <div class="video-review-testimonials__avatar {% if avatar == blank %}video-review-testimonials__avatar--placeholder{% endif %}">
            {% if avatar != blank %}
              {{ avatar | image_url: width: 84 | image_tag: loading: 'lazy', widths: '42,56,84', class: 'video-review-testimonials__avatar-image' }}
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="video-review-testimonials__trust">
        <div class="video-review-testimonials__trust-line video-review-testimonials__trust-line--customers">{{ section.settings.customer_count_text }}</div>
        <div class="video-review-testimonials__trust-line video-review-testimonials__trust-line--rating">
          <span class="video-review-testimonials__rating-text">{{ section.settings.rating_text }}</span>
          <span class="video-review-testimonials__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <span class="video-review-testimonials__star-box {% if i == 5 and section.settings.partial_last_star %}is-partial{% endif %}">
                <svg viewBox="0 0 20 20" fill="none" focusable="false" aria-hidden="true">
                  <path d="M10 1.6l2.57 5.2 5.74.84-4.15 4.04.98 5.72L10 14.7 4.86 17.4l.98-5.72L1.7 7.64l5.73-.84L10 1.6Z" fill="currentColor"/>
                </svg>
              </span>
            {% endfor %}
          </span>
        </div>
      </div>
    </div>

    <div class="video-review-testimonials__header">
      <h2 class="video-review-testimonials__heading">
        {{ section.settings.heading | replace: '[underline]', '<span class="video-review-testimonials__underline">' | replace: '[/underline]', '</span>' }}
      </h2>
    </div>

    <div class="video-review-testimonials__carousel-wrapper">
      <div class="video-review-testimonials__carousel">
        {% for block in section.blocks %}
          {% liquid
            assign has_uploaded_video = false
            assign has_external_video = false
            if block.settings.video != blank
              assign has_uploaded_video = true
            endif
            if block.settings.external_video != blank
              assign has_external_video = true
            endif
            assign media_image = block.settings.poster_image
            if media_image == blank
              assign media_image = block.settings.fallback_image
            endif
          %}

          <article class="video-review-testimonials__card" {{ block.shopify_attributes }}>
            <div class="video-review-testimonials__media">
              {% if has_uploaded_video %}
                {{ block.settings.video | video_tag: class: 'video-review-testimonials__video', image_size: '900x', controls: false, autoplay: false, loop: false, muted: false, playsinline: true }}
              {% elsif has_external_video %}
                {{ block.settings.external_video | external_video_tag: class: 'video-review-testimonials__video-embed', loading: 'lazy' }}
              {% elsif media_image != blank %}
                {{ media_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,420,540,720,900', class: 'video-review-testimonials__image' }}
              {% else %}
                <div class="video-review-testimonials__media-placeholder"></div>
              {% endif %}

              {% if block.settings.overlay_text != blank %}
                <div class="video-review-testimonials__overlay-text">{{ block.settings.overlay_text }}</div>
              {% endif %}

              <button type="button" class="video-review-testimonials__play-button" data-video-review-play aria-label="{{ block.settings.play_label | default: 'Play video review' | escape }}">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 6.5v11l9-5.5-9-5.5Z" fill="currentColor"/></svg>
              </button>
            </div>

            <div class="video-review-testimonials__content">
              <div class="video-review-testimonials__quote rte">{{ block.settings.quote }}</div>

              <div class="video-review-testimonials__meta">
                <div class="video-review-testimonials__review-row">
                  <span class="video-review-testimonials__review-stars" aria-hidden="true">
                    {% for i in (1..5) %}
                      <span class="video-review-testimonials__star-box {% if i == 5 and block.settings.partial_last_star %}is-partial{% endif %}">
                        <svg viewBox="0 0 20 20" fill="none" focusable="false" aria-hidden="true">
                          <path d="M10 1.6l2.57 5.2 5.74.84-4.15 4.04.98 5.72L10 14.7 4.86 17.4l.98-5.72L1.7 7.64l5.73-.84L10 1.6Z" fill="currentColor"/>
                        </svg>
                      </span>
                    {% endfor %}
                  </span>

                  {% if block.settings.verified_text != blank %}
                    <span class="video-review-testimonials__verified">{{ block.settings.verified_text }}</span>
                  {% endif %}
                </div>

                {% if block.settings.author != blank %}
                  <div class="video-review-testimonials__author">{{ block.settings.author }}</div>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.button_label != blank %}
      <div class="video-review-testimonials__buttons">
        <a class="video-review-testimonials__button video-review-testimonials__button--primary" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label }}</a>
        {% if section.settings.secondary_button_label != blank %}
          <a class="video-review-testimonials__button video-review-testimonials__button--secondary" {% if section.settings.secondary_button_link != blank %}href="{{ section.settings.secondary_button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.secondary_button_label }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #{{ section_id }} {
    --vrt-bg: {{ section.settings.background_color }};
    --vrt-card-bg: {{ section.settings.card_background_color }};
    --vrt-text: {{ section.settings.text_color }};
    --vrt-accent: {{ section.settings.accent_color }};
    --vrt-button-text: {{ section.settings.button_text_color }};
    --vrt-secondary-text: {{ section.settings.secondary_button_text_color }};
    --vrt-secondary-bg: {{ section.settings.secondary_button_bg_color }};
    --vrt-secondary-border: {{ section.settings.secondary_button_border_color }};
    background: var(--vrt-bg);
    color: var(--vrt-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .video-review-testimonials__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 56px;
  }

  #{{ section_id }} .video-review-testimonials__top {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  #{{ section_id }} .video-review-testimonials__avatars {
    display: flex;
    align-items: center;
  }

  #{{ section_id }} .video-review-testimonials__avatar {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    overflow: hidden;
    border: 2px solid #fff;
    background: linear-gradient(135deg, #f7d7a7, #d8e7ef);
    margin-left: -10px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.08);
  }

  #{{ section_id }} .video-review-testimonials__avatar:first-child { margin-left: 0; }
  #{{ section_id }} .video-review-testimonials__avatar-image { width: 100%; height: 100%; object-fit: cover; display: block; }

  #{{ section_id }} .video-review-testimonials__trust-line--customers {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-bottom: 4px;
  }

  #{{ section_id }} .video-review-testimonials__trust-line--rating {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 18px;
    line-height: 1.2;
  }

  #{{ section_id }} .video-review-testimonials__rating-text { order: 2; }
  #{{ section_id }} .video-review-testimonials__stars,
  #{{ section_id }} .video-review-testimonials__review-stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: #ffffff;
  }

  #{{ section_id }} .video-review-testimonials__star-box {
    width: 32px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #10b981;
    position: relative;
  }

  #{{ section_id }} .video-review-testimonials__star-box.is-partial::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 26%;
    height: 100%;
    background: #d9d9d9;
  }

  #{{ section_id }} .video-review-testimonials__star-box svg { width: 14px; height: 14px; position: relative; z-index: 1; }

  #{{ section_id }} .video-review-testimonials__header {
    text-align: center;
    margin-bottom: 46px;
  }

  #{{ section_id }} .video-review-testimonials__heading {
    margin: 0;
    font-size: clamp(44px, 5vw, 68px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 700;
  }

  #{{ section_id }} .video-review-testimonials__underline {
    position: relative;
    display: inline-block;
  }

  #{{ section_id }} .video-review-testimonials__underline::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 0.08em;
    background: var(--vrt-accent);
    border-radius: 999px;
  }

  #{{ section_id }} .video-review-testimonials__carousel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  #{{ section_id }} .video-review-testimonials__card {
    background: var(--vrt-card-bg);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #{{ section_id }} .video-review-testimonials__media {
    position: relative;
    aspect-ratio: 0.73;
    background: #dcdcdc;
    overflow: hidden;
  }

  #{{ section_id }} .video-review-testimonials__video,
  #{{ section_id }} .video-review-testimonials__video-embed,
  #{{ section_id }} .video-review-testimonials__image,
  #{{ section_id }} .video-review-testimonials__media-placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border: 0;
  }

  #{{ section_id }} .video-review-testimonials__overlay-text {
    position: absolute;
    left: 50%;
    bottom: 34px;
    transform: translateX(-50%);
    color: #fff;
    font-size: 16px;
    line-height: 1.15;
    font-weight: 600;
    text-align: center;
    text-shadow: 0 2px 8px rgba(0,0,0,0.45);
    max-width: calc(100% - 40px);
    z-index: 2;
    pointer-events: none;
  }

  #{{ section_id }} .video-review-testimonials__play-button {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 84px;
    height: 84px;
    border-radius: 999px;
    border: 0;
    background: rgba(0,0,0,0.92);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #{{ section_id }} .video-review-testimonials__play-button:hover { transform: translate(-50%, -50%) scale(1.04); }
  #{{ section_id }} .video-review-testimonials__play-button svg { width: 30px; height: 30px; margin-left: 4px; }

  #{{ section_id }} .video-review-testimonials__content {
    padding: 22px 26px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  #{{ section_id }} .video-review-testimonials__quote {
    font-size: 19px;
    line-height: 1.46;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  #{{ section_id }} .video-review-testimonials__quote p { margin: 0; }
  #{{ section_id }} .video-review-testimonials__meta { margin-top: auto; }

  #{{ section_id }} .video-review-testimonials__review-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  #{{ section_id }} .video-review-testimonials__verified {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 5px 12px;
    border-radius: 4px;
    background: #10b981;
    color: #fff;
    font-size: 15px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  #{{ section_id }} .video-review-testimonials__author {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .video-review-testimonials__buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: 38px;
  }

  #{{ section_id }} .video-review-testimonials__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 460px;
    min-height: 78px;
    padding: 18px 28px;
    border-radius: 16px;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 24px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.03em;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #{{ section_id }} .video-review-testimonials__button:hover { transform: translateY(-1px); }
  #{{ section_id }} .video-review-testimonials__button--primary { background: var(--vrt-accent); color: var(--vrt-button-text); }
  #{{ section_id }} .video-review-testimonials__button--secondary {
    min-width: 326px;
    min-height: 56px;
    padding: 14px 22px;
    background: var(--vrt-secondary-bg);
    color: var(--vrt-secondary-text);
    border: 1.5px solid var(--vrt-secondary-border);
    text-transform: none;
    font-size: 18px;
    letter-spacing: 0.01em;
    font-weight: 700;
  }

  @media screen and (max-width: 1199px) {
    #{{ section_id }} .video-review-testimonials__inner { padding: 0 28px; }
    #{{ section_id }} .video-review-testimonials__carousel { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 767px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .video-review-testimonials__inner { padding: 0 0 0 22px; }

    #{{ section_id }} .video-review-testimonials__top {
      justify-content: flex-start;
      gap: 14px;
      margin-bottom: 28px;
      padding-right: 22px;
    }

    #{{ section_id }} .video-review-testimonials__avatar {
      width: 42px;
      height: 42px;
      margin-left: -8px;
    }

    #{{ section_id }} .video-review-testimonials__trust-line--customers,
    #{{ section_id }} .video-review-testimonials__trust-line--rating {
      font-size: 16px;
    }

    #{{ section_id }} .video-review-testimonials__star-box {
      width: 24px;
      height: 24px;
    }

    #{{ section_id }} .video-review-testimonials__header {
      text-align: left;
      padding-right: 22px;
      margin-bottom: 28px;
    }

    #{{ section_id }} .video-review-testimonials__heading {
      font-size: 43px;
      line-height: 0.95;
    }

    #{{ section_id }} .video-review-testimonials__carousel-wrapper {
      overflow: hidden;
    }

    #{{ section_id }} .video-review-testimonials__carousel {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-right: 22px;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    #{{ section_id }} .video-review-testimonials__carousel::-webkit-scrollbar { display: none; }

    #{{ section_id }} .video-review-testimonials__card {
      flex: 0 0 68.6vw;
      max-width: 414px;
      scroll-snap-align: start;
      border-radius: 22px;
    }

    #{{ section_id }} .video-review-testimonials__media { aspect-ratio: 0.755; }
    #{{ section_id }} .video-review-testimonials__play-button { width: 68px; height: 68px; }
    #{{ section_id }} .video-review-testimonials__play-button svg { width: 24px; height: 24px; }

    #{{ section_id }} .video-review-testimonials__content {
      padding: 24px 28px 28px;
    }

    #{{ section_id }} .video-review-testimonials__quote {
      font-size: 22px;
      line-height: 1.44;
      margin-bottom: 24px;
    }

    #{{ section_id }} .video-review-testimonials__review-row { gap: 8px; margin-bottom: 18px; }
    #{{ section_id }} .video-review-testimonials__verified { min-height: 28px; font-size: 15px; }
    #{{ section_id }} .video-review-testimonials__author { font-size: 18px; }

    #{{ section_id }} .video-review-testimonials__buttons {
      margin-top: 38px;
      padding-right: 22px;
    }

    #{{ section_id }} .video-review-testimonials__button {
      width: 100%;
      min-width: 0;
      min-height: 78px;
      font-size: 26px;
      border-radius: 14px;
    }

    #{{ section_id }} .video-review-testimonials__button--secondary {
      width: auto;
      min-width: 0;
      min-height: 56px;
      font-size: 17px;
      padding: 16px 28px;
      border-radius: 12px;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('{{ section_id }}');
    if (!root) return;

    root.querySelectorAll('[data-video-review-play]').forEach((button) => {
      button.addEventListener('click', () => {
        const media = button.closest('.video-review-testimonials__media');
        if (!media) return;

        const video = media.querySelector('video');
        if (video) {
          video.setAttribute('controls', 'controls');
          video.play();
          button.style.display = 'none';
          return;
        }

        const iframe = media.querySelector('iframe');
        if (iframe) {
          const src = iframe.getAttribute('src');
          if (src && src.indexOf('autoplay=1') === -1) {
            iframe.setAttribute('src', src + (src.indexOf('?') === -1 ? '?' : '&') + 'autoplay=1');
          }
          button.style.display = 'none';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Video review testimonials",
  "tag": "section",
  "class": "shopify-section--video-review-testimonials",
  "enabled_on": {
    "templates": ["index", "page", "product"]
  },
  "settings": [
    { "type": "text", "id": "customer_count_text", "label": "Customer count text", "default": "50K+ Happy Customers" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Excellent 4.7" },
    { "type": "checkbox", "id": "partial_last_star", "label": "Show partial last star", "default": true },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>In [underline]your[/underline] own words —</p>" },
    { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
    { "type": "image_picker", "id": "avatar_4", "label": "Avatar 4" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "SHOP NOW" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Money-Back Guarantee" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#EEF5F1" },
    { "type": "color", "id": "card_background_color", "label": "Card background color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#10B981" },
    { "type": "color", "id": "button_text_color", "label": "Primary button text color", "default": "#FFFFFF" },
    { "type": "color", "id": "secondary_button_bg_color", "label": "Secondary button background color", "default": "#BCECD8" },
    { "type": "color", "id": "secondary_button_text_color", "label": "Secondary button text color", "default": "#11A66E" },
    { "type": "color", "id": "secondary_button_border_color", "label": "Secondary button border color", "default": "#11A66E" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 0, "max": 160, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 0, "max": 160, "step": 4, "default": 36, "unit": "px" },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 0, "max": 160, "step": 4, "default": 20, "unit": "px" },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 0, "max": 160, "step": 4, "default": 36, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "video", "id": "video", "label": "Uploaded video" },
        { "type": "video_url", "id": "external_video", "label": "External video", "accept": ["youtube", "vimeo"], "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc" },
        { "type": "image_picker", "id": "poster_image", "label": "Poster image" },
        { "type": "image_picker", "id": "fallback_image", "label": "Fallback image" },
        { "type": "text", "id": "overlay_text", "label": "Overlay text" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I'm hitting with more power and control than ever before, and my serve has improved dramatically." },
        { "type": "checkbox", "id": "partial_last_star", "label": "Show partial last star", "default": true },
        { "type": "text", "id": "verified_text", "label": "Verified badge text", "default": "Verified" },
        { "type": "text", "id": "author", "label": "Author", "default": "David Smith" },
        { "type": "text", "id": "play_label", "label": "Play button label", "default": "Play video review" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Video review testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "I'm hitting with more power and control than ever before, and my serve has improved dramatically.",
            "author": "David Smith",
            "verified_text": "Verified"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "It's incredibly lightweight and maneuverable, which allows me to react quickly and hit with more power.",
            "author": "Michael Wilson",
