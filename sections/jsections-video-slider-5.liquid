{%- comment -%}
  JSections - Video Slider #5
  Version: 1.0.0
  Installed by: Hazify Sections

  ⚠️ Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-video-slider-5.css' | asset_url | stylesheet_tag }}

<div 
  class="video-slider-section section-{{ section.id }}-padding"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg-color: {{ section.settings.background_color }};
    --section-text-color: {{ section.settings.text_color }};
  "
>
  <div class="video-slider-wrapper">
    <div class="page-width">
      {%- if section.settings.subheading != blank -%}
        <div class="video-slider__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="video-slider__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="video-slider__description">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="video-slider-carousel" id="video-slider-{{ section.id }}">
          <div class="video-slider-track">
            {%- for block in section.blocks -%}
              {%- if block.type == 'video' -%}
                <div class="video-slide" {{ block.shopify_attributes }}>
                    <div class="video-slide__container">
                      <div class="video-slide__video-wrapper">
                      {%- if block.settings.video_file != blank -%}
                        {{
                          block.settings.video_file
                          | video_tag:
                            autoplay: block.settings.autoplay,
                            loop: block.settings.loop,
                            muted: block.settings.muted,
                            controls: false,
                            playsinline: true,
                            preload: 'metadata',
                            class: 'video-slide__video'
                        }}
                        <button type="button" class="video-play-button" aria-label="Play video" aria-pressed="false">
                          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.9"/>
                            <path class="video-play-button__play" d="M18 14L34 24L18 34V14Z" fill="black"/>
                            <path class="video-play-button__pause" d="M17 15H22V33H17V15ZM26 15H31V33H26V15Z" fill="black"/>
                          </svg>
                        </button>
                      {%- elsif block.settings.video_url != blank -%}
                        <video 
                          class="video-slide__video"
                          playsinline
                          preload="metadata"
                          {% if block.settings.autoplay %}autoplay{% endif %}
                          {% if block.settings.loop %}loop{% endif %}
                          {% if block.settings.muted %}muted{% endif %}
                        >
                          <source src="{{ block.settings.video_url }}" type="video/mp4">
                        </video>
                        <button type="button" class="video-play-button" aria-label="Play video" aria-pressed="false">
                          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.9"/>
                            <path class="video-play-button__play" d="M18 14L34 24L18 34V14Z" fill="black"/>
                            <path class="video-play-button__pause" d="M17 15H22V33H17V15ZM26 15H31V33H26V15Z" fill="black"/>
                          </svg>
                        </button>
                      {%- elsif block.settings.placeholder_image != blank -%}
                        <img
                          src="{{ block.settings.placeholder_image | image_url: width: 600 }}"
                          alt="{{ block.settings.author_name | escape }}"
                          width="600"
                          height="800"
                          loading="lazy"
                          class="video-slide__placeholder"
                        >
                      {%- endif -%}
                    </div>

                    <div class="video-slide__overlay">
                      {%- if block.settings.show_stars -%}
                        <div class="video-slide__stars">
                          {%- for i in (1..5) -%}
                            <svg width="20" height="19" viewBox="0 0 20 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M10 0L12.9389 6.90983L20 8.09017L15 13.0902L16.1803 20L10 16.6098L3.81966 20L5 13.0902L0 8.09017L7.06107 6.90983L10 0Z" fill="{{ section.settings.star_color }}"/>
                            </svg>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      
                      <div class="video-slide__info">
                        {%- if block.settings.author_name != blank -%}
                          <h3 class="video-slide__author">{{ block.settings.author_name }}</h3>
                        {%- endif -%}
                        
                        {%- if block.settings.product_name != blank -%}
                          <p class="video-slide__product">{{ block.settings.product_name }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if section.settings.show_navigation and section.blocks.size > 1 -%}
            <div class="video-slider-navigation">
              <button type="button" class="video-nav-button prev" aria-label="Previous video">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button type="button" class="video-nav-button next" aria-label="Next video">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function() {
  class VideoSliderCarousel {
    constructor(section) {
      this.section = section;
      this.carousel = section.querySelector('.video-slider-carousel');
      if (!this.carousel) return;
      if (section.videoSliderCarousel) {
        section.videoSliderCarousel.destroy();
      }
      if (this.carousel.dataset.initialized === 'true') return;

      this.track = this.carousel.querySelector('.video-slider-track');
      this.slides = Array.from(this.carousel.querySelectorAll('.video-slide'));
      this.prevButton = section.querySelector('.video-nav-button.prev');
      this.nextButton = section.querySelector('.video-nav-button.next');
      this.currentIndex = 0;
      this.isAnimating = false;
      this.touchStartX = 0;
      this.touchEndX = 0;
      this.autoScrollInterval = null;
      section.videoSliderCarousel = this;

      this.init();
    }

    init() {
      this.carousel.dataset.initialized = 'true';
      this.updateSlidePositions();
      this.setupEventListeners();
      this.updateButtons();
      this.setupVideoPlayback();
    }

    setupEventListeners() {
      if (this.prevButton) {
        this.prevButton.addEventListener('click', () => this.prev());
      }
      if (this.nextButton) {
        this.nextButton.addEventListener('click', () => this.next());
      }

      // Touch events
      this.track.addEventListener('touchstart', (e) => {
        this.touchStartX = e.touches[0].clientX;
      }, { passive: true });

      this.track.addEventListener('touchmove', (e) => {
        this.touchEndX = e.touches[0].clientX;
      }, { passive: true });

      this.track.addEventListener('touchend', () => {
        this.handleSwipe();
      });

      // Keyboard navigation
      this.carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.prev();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.next();
        }
      });

      // Auto-scroll on interval
      if (this.slides.length > 1) {
        this.startAutoScroll();
      }
    }

    setupVideoPlayback() {
      const videos = this.slides.map((slide) => slide.querySelector('video')).filter(Boolean);
      const anyVideoPlaying = () => videos.some((video) => !video.paused && !video.ended);

      const syncState = (slide, video, playButton) => {
        const isPlaying = !video.paused && !video.ended;
        slide.classList.toggle('is-video-playing', isPlaying);
        slide.classList.toggle('is-video-paused', !isPlaying);
        playButton.setAttribute('aria-label', isPlaying ? 'Pause video' : 'Play video');
        playButton.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
      };

      const pauseOtherVideos = (activeVideo) => {
        videos.forEach((video) => {
          if (video !== activeVideo && !video.paused) {
            video.pause();
          }
        });
      };

      this.slides.forEach((slide) => {
        const video = slide.querySelector('video');
        const playButton = slide.querySelector('.video-play-button');
        
        if (video && playButton) {
          const toggleVideo = (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (video.paused || video.ended) {
              pauseOtherVideos(video);
              this.stopAutoScroll();
              const playAttempt = video.play();
              if (playAttempt && typeof playAttempt.then === 'function') {
                playAttempt
                  .then(() => syncState(slide, video, playButton))
                  .catch(() => syncState(slide, video, playButton));
              } else {
                syncState(slide, video, playButton);
              }
            } else {
              video.pause();
            }
            syncState(slide, video, playButton);
          };

          playButton.addEventListener('click', toggleVideo);

          video.addEventListener('click', (e) => {
            toggleVideo(e);
          });

          video.addEventListener('play', () => {
            this.stopAutoScroll();
            syncState(slide, video, playButton);
          });

          video.addEventListener('pause', () => {
            syncState(slide, video, playButton);
            if (!anyVideoPlaying()) {
              this.startAutoScroll();
            }
          });

          video.addEventListener('ended', () => {
            syncState(slide, video, playButton);
            if (!anyVideoPlaying()) {
              this.startAutoScroll();
            }
          });

          syncState(slide, video, playButton);
        }
      });
    }

    handleSwipe() {
      const diff = this.touchStartX - this.touchEndX;
      const threshold = 50;

      if (Math.abs(diff) > threshold) {
        if (diff > 0) {
          this.next();
        } else {
          this.prev();
        }
      }
    }

    updateSlidePositions() {
      const slideWidth = this.slides[0]?.offsetWidth || 0;
      const gap = 20;
      const offset = -(this.currentIndex * (slideWidth + gap));
      
      this.track.style.transform = `translateX(${offset}px)`;
    }

    prev() {
      if (this.isAnimating || this.currentIndex === 0) return;
      
      this.isAnimating = true;
      this.currentIndex--;
      this.updateSlidePositions();
      this.updateButtons();
      
      setTimeout(() => {
        this.isAnimating = false;
      }, 300);
    }

    next() {
      if (this.isAnimating || this.currentIndex >= this.slides.length - this.getVisibleCount()) return;
      
      this.isAnimating = true;
      this.currentIndex++;
      this.updateSlidePositions();
      this.updateButtons();
      
      setTimeout(() => {
        this.isAnimating = false;
      }, 300);
    }

    getVisibleCount() {
      const containerWidth = this.carousel.offsetWidth;
      const slideWidth = this.slides[0]?.offsetWidth || 0;
      return Math.floor(containerWidth / slideWidth) || 1;
    }

    updateButtons() {
      if (this.prevButton) {
        this.prevButton.disabled = this.currentIndex === 0;
      }
      if (this.nextButton) {
        this.nextButton.disabled = this.currentIndex >= this.slides.length - this.getVisibleCount();
      }
    }

    startAutoScroll() {
      this.stopAutoScroll();
      if (this.slides.length <= this.getVisibleCount()) return;
      this.autoScrollInterval = setInterval(() => {
        if (this.currentIndex >= this.slides.length - this.getVisibleCount()) {
          this.currentIndex = 0;
        } else {
          this.currentIndex++;
        }
        this.updateSlidePositions();
        this.updateButtons();
      }, 5000);
    }

    stopAutoScroll() {
      if (this.autoScrollInterval) {
        clearInterval(this.autoScrollInterval);
        this.autoScrollInterval = null;
      }
    }

    destroy() {
      this.stopAutoScroll();
      this.slides.forEach((slide) => {
        const video = slide.querySelector('video');
        if (video && !video.paused) {
          video.pause();
        }
      });
      if (this.carousel) {
        delete this.carousel.dataset.initialized;
      }
      if (this.section && this.section.videoSliderCarousel === this) {
        delete this.section.videoSliderCarousel;
      }
    }
  }

  function findVideoSliderSection(sectionRoot) {
    if (!sectionRoot) return null;
    if (sectionRoot.matches && sectionRoot.matches('.video-slider-section')) return sectionRoot;
    return sectionRoot.querySelector ? sectionRoot.querySelector('.video-slider-section') : null;
  }

  function initVideoSlider(sectionRoot) {
    const section = findVideoSliderSection(sectionRoot);
    if (section) new VideoSliderCarousel(section);
  }

  function destroyVideoSlider(sectionRoot) {
    const section = findVideoSliderSection(sectionRoot);
    if (section && section.videoSliderCarousel) {
      section.videoSliderCarousel.destroy();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.video-slider-section').forEach((section) => {
      initVideoSlider(section);
    });
  });

  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', (event) => {
      initVideoSlider(event.target);
    });
    document.addEventListener('shopify:section:unload', (event) => {
      destroyVideoSlider(event.target);
    });
  }
})();
</script>

