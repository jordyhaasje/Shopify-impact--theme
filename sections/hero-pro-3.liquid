    {"type":"slide","settings":{"logo_text":"Trustpilot","badge":"Excellent","rating":5,"quote":"The slider immediately adds social proof. Customers understand the value faster and the mobile version feels incredibly smooth.","highlight_phrase":"mobile version feels incredibly smooth","name":"Noah Jansen","meta":"Store owner","verified_text":"Verified review"}},
    {"type":"slide","settings":{"logo_text":"Trustpilot","badge":"Top rated","rating":5,"quote":"The design looks premium and the controls work. We can add new review slides ourselves without touching code.","highlight_phrase":"add new review slides ourselves","name":"Mila Bakker","meta":"Marketing lead","verified_text":"Verified review"}}
  ]}]
