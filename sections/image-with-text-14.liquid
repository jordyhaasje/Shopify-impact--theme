{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-block: {{ section.settings.section_padding }}px;
    padding-inline: {{ section.settings.section_padding }}px;
    background: transparent;
  }

  .iwt14-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 20px;
    overflow: hidden;
    min-height: 540px;
    background: {{ section.settings.bg_color }};
    position: relative;
  }

  .iwt14-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 52px 60px;
    position: relative;
    z-index: 1;
  }

  .iwt14-heading {
    font-family: var(--font-heading-family), sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 700;
    line-height: 1.1;
    color: #2e2c28;
    margin-bottom: 20px;
    opacity: 0;
    animation: iwt14-fadein 0.8s cubic-bezier(0.16,1,0.3,1) 0.15s forwards;
  }

  .iwt14-body {
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.7;
    color: #4a4844;
    max-width: 34ch;
    margin-bottom: 36px;
    opacity: 0;
    animation: iwt14-fadein 0.8s cubic-bezier(0.16,1,0.3,1) 0.3s forwards;
  }

  .iwt14-btn {
    display: inline-block;
    padding: 14px 34px;
    border: 1.5px solid #2e2c28;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2e2c28;
    text-decoration: none;
    background: transparent;
    transition: background 0.22s ease, color 0.22s ease;
    width: fit-content;
    opacity: 0;
    animation: iwt14-fadein 0.8s cubic-bezier(0.16,1,0.3,1) 0.45s forwards;
  }

  .iwt14-btn:hover {
    background: #2e2c28;
    color: {{ section.settings.bg_color }};
  }

  .iwt14-ticker-col {
    position: absolute;
    left: calc(50% - 28px);
    top: 0;
    bottom: 0;
    width: 56px;
    overflow: hidden;
    z-index: 10;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .iwt14-ticker-track {
    display: flex;
    flex-direction: column;
    animation: iwt14-ticker 10s linear infinite;
    will-change: transform;
  }

  .iwt14-ticker-item {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #706e68;
    white-space: nowrap;
    padding: 10px 0;
    user-select: none;
    line-height: 1;
  }

  .iwt14-image-col {
    position: relative;
    overflow: hidden;
    min-height: 540px;
  }

  .iwt14-image-col img,
  .iwt14-image-col .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes iwt14-ticker {
    0%   { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }

  @keyframes iwt14-fadein {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (max-width: 749px) {
    .iwt14-wrapper {
      grid-template-columns: 1fr;
      border-radius: 16px;
    }
    .iwt14-image-col {
      order: -1;
      min-height: 280px;
    }
    .iwt14-ticker-col {
      display: none;
    }
    .iwt14-content {
      padding: 32px 28px 40px;
    }
    .iwt14-body {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iwt14-ticker-track { animation-play-state: paused; }
    .iwt14-heading, .iwt14-body, .iwt14-btn {
      animation: none;
      opacity: 1;
    }
  }
{%- endstyle -%}

{%- assign ticker_raw = section.settings.ticker_text | default: 'just in' -%}
{%- assign ticker_sym = section.settings.ticker_symbol | default: '✳' -%}
{%- assign ticker_item = ticker_raw | append: ' ' | append: ticker_sym | append: ' ' -%}

<div class="iwt14-wrapper">

  <div class="iwt14-content">
    {%- if section.settings.heading != blank -%}
      <h2 class="iwt14-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="iwt14-body">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_url | default: '#' }}"
        class="iwt14-btn"
        {% if section.settings.button_url == blank %}aria-disabled="true"{% endif %}
      >{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="iwt14-ticker-col" aria-hidden="true">
    <div class="iwt14-ticker-track">
      {%- for i in (1..16) -%}
        <span class="iwt14-ticker-item">{{ ticker_item }}</span>
      {%- endfor -%}
    </div>
  </div>

  <div class="iwt14-image-col">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 900
        | image_tag:
          loading: 'lazy',
          widths: '400,600,800,900',
          sizes: '(max-width: 749px) 100vw, 50vw'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "Image with Text 14",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Targeted Solutions"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "Whether you struggle with dryness, sensitivity, or acne, our brand has a targeted skincare solution for you. Achieve your healthiest, most balanced complexion."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "just in"
    },
    {
      "type": "text",
      "id": "ticker_symbol",
      "label": "Ticker symbol",
      "default": "✳"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#edeae4"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Image with Text 14"
    }
  ],
  "enabled_on": {
    "templates": ["*"]
  }
}
{% endschema %}