{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --hero-bg: {{ section.settings.bg_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-text-muted: {{ section.settings.muted_text_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-button-primary: {{ section.settings.button_primary_color }};
    --hero-button-primary-text: {{ section.settings.button_primary_text_color }};
    --hero-button-secondary: {{ section.settings.button_secondary_color }};
    --hero-button-secondary-text: {{ section.settings.button_secondary_text_color }};
    --tp-star: #00b674;
    --tp-black: #000000;
  }

  #shopify-section-{{ section.id }} .hero-p-3 {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.desktop_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--hero-bg);
  }

  #shopify-section-{{ section.id }} .hero-p-3__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .hero-p-3__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,{{ section.settings.overlay_opacity }}) 0%, rgba(0,0,0,{{ section.settings.overlay_opacity_bottom }}) 100%);
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .hero-p-3__content {
    position: relative;
    z-index: 3;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: {{ section.settings.text_alignment }};
  }

  #shopify-section-{{ section.id }} .hero-p-3__eyebrow {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--hero-text);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .hero-p-3__title {
    margin: 0 0 20px;
    color: var(--hero-text);
    font-family: var(--heading-font-family);
    font-size: clamp(18px, 2.5vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: {{ section.settings.title_weight }};
  }

  #shopify-section-{{ section.id }} .hero-p-3__title span {
    display: block;
    font-style: italic;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .hero-p-3__text {
    margin: 0 0 24px;
    color: var(--hero-text);
    font-size: 16px;
    line-height: 1.5;
    max-width: {{ section.settings.text_max_width }}px;
    opacity: 0.95;
  }

  #shopify-section-{{ section.id }} .hero-p-3__trustpilot {
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hero-p-3__stars {
    display: flex;
    gap: 3px;
    color: var(--tp-star);
    font-size: 18px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .hero-p-3__rating-text {
    color: var(--hero-text);
    font-size: 14px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .hero-p-3__rating-count {
    color: var(--hero-text-muted);
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .hero-p-3__buttons {
    display: flex;
    gap: 12px;
    justify-content: {{ section.settings.text_alignment }};
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hero-p-3__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    cursor: pointer;
    border: none;
  }

  #shopify-section-{{ section.id }} .hero-p-3__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }

  #shopify-section-{{ section.id }} .hero-p-3__btn--primary {
    background: var(--hero-button-primary);
    color: var(--hero-button-primary-text);
  }

  #shopify-section-{{ section.id }} .hero-p-3__btn--secondary {
    background: var(--hero-button-secondary);
    color: var(--hero-button-secondary-text);
    border: 1px solid rgba(255,255,255,0.3);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hero-p-3 {
      min-height: {{ section.settings.mobile_height }}vh;
    }

    #shopify-section-{{ section.id }} .hero-p-3__content {
      padding: {{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .hero-p-3__title {
      font-size: clamp(16px, 4vw, 20px);
    }

    #shopify-section-{{ section.id }} .hero-p-3__text {
      font-size: 14px;
      margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .hero-p-3__trustpilot {
      justify-content: center;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .hero-p-3__buttons {
      justify-content: center;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .hero-p-3__btn {
      padding: 12px 20px;
      font-size: 13px;
      min-width: 140px;
    }
  }
</style>

<section class="hero-p-3" data-section-id="{{ section.id }}">
  {%- if section.settings.video != blank -%}
    <video 
      class="hero-p-3__video" 
      autoplay 
      muted 
      loop 
      playsinline
      {% if section.settings.video_mobile == blank %}poster="{{ section.settings.video.preview_image | image_url: width: 1200 }}"{% endif %}
    >
      {%- if section.settings.video_mobile != blank -%}
        <source src="{{ section.settings.video_mobile | image_url: width: 800 }}" type="video/mp4" media="(max-width: 749px)">
      {%- endif -%}
      <source src="{{ section.settings.video | image_url: width: 1920 }}" type="video/mp4">
    </video>
  {%- elsif section.settings.video_url != blank -%}
    <div class="hero-p-3__video">
      <iframe 
        src="{{ section.settings.video_url | replace: 'watch?v=', 'embed/' | replace: '&t=', '?start=' }}" 
        frameborder="0" 
        allow="autoplay; muted" 
        allowfullscreen
        style="position:absolute;top:0;left:0;width:100%;height:100%;"
      ></iframe>
    </div>
  {%- endif -%}

  <div class="hero-p-3__overlay"></div>

  <div class="hero-p-3__content">
    {%- if section.settings.eyebrow != blank -%}
      <div class="hero-p-3__eyebrow">{{ section.settings.eyebrow | escape }}</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero-p-3__title">
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hero-p-3__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.show_trustpilot -%}
      <div class="hero-p-3__trustpilot">
        <div class="hero-p-3__stars" aria-label="{{ section.settings.rating }} van 5 sterren">
          ★★★★★
        </div>
        <div>
          <div class="hero-p-3__rating-text">{{ section.settings.rating }} van 5</div>
          {%- if section.settings.review_count != blank -%}
            <div class="hero-p-3__rating-count">op basis van {{ section.settings.review_count }} reviews</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="hero-p-3__buttons">
      {%- if section.settings.button_primary_text != blank and section.settings.button_primary_link != blank -%}
        <a href="{{ section.settings.button_primary_link }}" class="hero-p-3__btn hero-p-3__btn--primary">
          {{ section.settings.button_primary_text | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.button_secondary_text != blank and section.settings.button_secondary_link != blank -%}
        <a href="{{ section.settings.button_secondary_link }}" class="hero-p-3__btn hero-p-3__btn--secondary">
          {{ section.settings.button_secondary_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
