<style>
  #shopify-section-{{ section.id }} {
    --page-max-width: {{ section.settings.content_width }};
  }

  #shopify-section-{{ section.id }} .faq-modern-wrapper {
    max-width: min(var(--page-max-width), 920px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .faq-modern-title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  #shopify-section-{{ section.id }} .faq-modern-intro {
    color: rgb(var(--text-color) / .7);
    margin-top: 1rem;
  }

  #shopify-section-{{ section.id }} .faq-modern-card {
    margin-top: 2.5rem;
    border-radius: 20px;
    background: rgb(var(--background));
    box-shadow: 0 20px 60px rgb(var(--text-color) / .08);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} details {
    border-bottom: 1px solid rgb(var(--text-color) / .08);
  }

  #shopify-section-{{ section.id }} summary {
    list-style: none;
    cursor: pointer;
    padding: 1.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    font-size: 1.2rem;
  }

  #shopify-section-{{ section.id }} summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .icon {
    transition: transform .35s cubic-bezier(.4,0,.2,1);
  }

  #shopify-section-{{ section.id }} details[open] .icon {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height .4s ease, opacity .3s ease;
    opacity: 0;
    padding: 0 1.6rem;
  }

  #shopify-section-{{ section.id }} details[open] .faq-answer {
    max-height: 300px;
    opacity: 1;
    padding-bottom: 1.6rem;
  }

  #shopify-section-{{ section.id }} .faq-support {
    margin-top: 3rem;
    padding: 1.5rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(135deg, rgb(var(--text-color) / .05), rgb(var(--text-color) / .02));
  }

  #shopify-section-{{ section.id }} .faq-support-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--text-color));
    color: white;
  }

  #shopify-section-{{ section.id }} .faq-support-text {
    font-size: 0.95rem;
  }
</style>

<div class="container">
  <div class="page-spacer">
    <div class="faq-modern-wrapper">

      <h1 class="faq-modern-title">{{ page.title }}</h1>

      {% if section.settings.intro_text != blank %}
        <p class="faq-modern-intro">{{ section.settings.intro_text }}</p>
      {% endif %}

      <div class="faq-modern-card">
        {% for block in section.blocks %}
          <details {{ block.shopify_attributes }}>
            <summary>
              {{ block.settings.question }}
              <span class="icon">⌄</span>
            </summary>

            <div class="faq-answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endfor %}
      </div>

      <div class="faq-support">
        <div class="faq-support-icon">
          ✉️
        </div>
        <div class="faq-support-text">
          <div>{{ section.settings.support_text }}</div>
          <small>{{ section.settings.response_time }}</small>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ page",
  "settings": [
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support text"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ]
}
{% endschema %}