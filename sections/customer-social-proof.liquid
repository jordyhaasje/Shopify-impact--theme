    { "type": "range", "id": "facebook_text_size", "label": "Facebook text size", "min": 18, "max": 32, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "facebook_text_size_mobile", "label": "Facebook text size mobile", "min": 16, "max": 24, "step": 1, "unit": "px", "default": 21 },
    { "type": "range", "id": "facebook_action_size", "label": "Facebook action size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 22 },
