{%- comment -%}
  JSections - Stats #3
  Version: 1.0.0
  Installed by: Hazify Sections

  Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-stats-3.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign card_count = section.blocks.size
  assign desktop_columns = section.settings.desktop_columns

  if card_count > 0
    assign desktop_columns = desktop_columns | at_most: card_count
  endif
-%}

<div
  class="jstats3"
  style="
    --jstats3-section-bg: {{ section.settings.section_background }};
    --jstats3-panel-bg: {{ section.settings.panel_background }};
    --jstats3-panel-border: {{ section.settings.panel_border_color }};
    --jstats3-text: {{ section.settings.text_color }};
    --jstats3-muted: {{ section.settings.muted_text_color }};
    --jstats3-card-bg: {{ section.settings.card_background }};
    --jstats3-stat-bg: {{ section.settings.stat_background }};
    --jstats3-max-width: {{ section.settings.max_width }}px;
    --jstats3-columns: {{ desktop_columns }};
    --jstats3-gap: {{ section.settings.card_gap }}px;
    --jstats3-padding-top: {{ section.settings.padding_top }}px;
    --jstats3-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jstats3-panel-padding: {{ section.settings.panel_padding }}px;
    --jstats3-panel-radius: {{ section.settings.panel_radius }}px;
    --jstats3-card-radius: {{ section.settings.card_radius }}px;
    --jstats3-image-radius: {{ section.settings.image_radius }}px;
    --jstats3-image-ratio: {{ section.settings.image_ratio }};
    --jstats3-heading-size: {{ section.settings.heading_size }}px;
    --jstats3-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --jstats3-stat-size: {{ section.settings.stat_size }}px;
    --jstats3-mobile-card-width: {{ section.settings.mobile_card_width }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="jstats3__panel">
    {%- if heading != blank -%}
      <div class="jstats3__header jstats3__header--{{ section.settings.heading_alignment }}">
        <h2 class="jstats3__heading">{{ heading }}</h2>
      </div>
    {%- endif -%}

    <div class="jstats3__cards" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_image = block.settings.image
            assign card_title = block.settings.title
            assign stat_number = block.settings.stat_number
            assign stat_suffix = block.settings.stat_suffix
            assign stat_text = block.settings.stat_text
            assign fallback_style = block.settings.fallback_style
            assign image_alt = card_title

            if card_image != blank and card_image.alt != blank
              assign image_alt = card_image.alt
            endif
          -%}
          <article class="jstats3__card" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="jstats3__media-link" href="{{ block.settings.link }}" aria-label="{{ card_title | escape }}">
            {%- endif -%}
            <div class="jstats3__media jstats3__media--{{ fallback_style }}">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, 78vw',
                    alt: image_alt,
                    class: 'jstats3__image'
                }}
              {%- else -%}
                <span class="jstats3__fallback" aria-hidden="true">
                  <span class="jstats3__fallback-orb jstats3__fallback-orb--one"></span>
                  <span class="jstats3__fallback-orb jstats3__fallback-orb--two"></span>
                  <span class="jstats3__fallback-line jstats3__fallback-line--one"></span>
                  <span class="jstats3__fallback-line jstats3__fallback-line--two"></span>
                </span>
                <span class="jstats3__visually-hidden">{{ image_alt }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}

            {%- if card_title != blank -%}
              <h3 class="jstats3__card-title">{{ card_title }}</h3>
            {%- endif -%}

            <div class="jstats3__stat">
              <div class="jstats3__stat-value" aria-label="{{ stat_number | append: stat_suffix | escape }}">
                <span>{{ stat_number }}</span>
                {%- if stat_suffix != blank -%}
                  <small>{{ stat_suffix }}</small>
                {%- endif -%}
              </div>
              {%- if stat_text != blank -%}
                <div class="jstats3__stat-copy">{{ stat_text }}</div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..3) -%}
          <article class="jstats3__card" role="listitem">
            <div class="jstats3__media jstats3__media--glow">
              <span class="jstats3__fallback" aria-hidden="true">
                <span class="jstats3__fallback-orb jstats3__fallback-orb--one"></span>
                <span class="jstats3__fallback-orb jstats3__fallback-orb--two"></span>
                <span class="jstats3__fallback-line jstats3__fallback-line--one"></span>
                <span class="jstats3__fallback-line jstats3__fallback-line--two"></span>
              </span>
            </div>
            <h3 class="jstats3__card-title">Add your best stat</h3>
            <div class="jstats3__stat">
              <div class="jstats3__stat-value"><span>0</span><small>%</small></div>
              <div class="jstats3__stat-copy">Share a proof point that helps shoppers buy with confidence.</div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

