{%- render 'section-spacing-collapsing', background: section.settings.background -%}

{%- liquid
  assign review_count = section.blocks.size
  assign average_rating = section.settings.average_rating | replace: ',', '.' | plus: 0
-%}

<style>
  #shopify-section-{{ section.id }} {
    --rn-bg: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --rn-card: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
    --rn-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --rn-heading: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --rn-muted: {{ section.settings.muted_color.red }}, {{ section.settings.muted_color.green }}, {{ section.settings.muted_color.blue }};
    --rn-trust: {{ section.settings.trust_color.red }}, {{ section.settings.trust_color.green }}, {{ section.settings.trust_color.blue }};
    --rn-empty: {{ section.settings.empty_star_color.red }}, {{ section.settings.empty_star_color.green }}, {{ section.settings.empty_star_color.blue }};
    --rn-border: {{ section.settings.border_color.red }}, {{ section.settings.border_color.green }}, {{ section.settings.border_color.blue }};
    --rn-radius: {{ section.settings.card_radius }}px;
    --rn-gap: {{ section.settings.card_gap }}px;
    --rn-card-width: {{ section.settings.desktop_card_width }}px;
    --rn-shadow: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
  }

  #shopify-section-{{ section.id }} .review-newest {
    overflow: hidden;
    padding-block: clamp(34px, 6vw, var(--section-outer-spacing-block));
    background: rgb(var(--rn-bg));
    color: rgb(var(--rn-text));
  }

  #shopify-section-{{ section.id }} .review-newest__shell {
    display: grid;
    gap: clamp(22px, 3vw, 34px);
  }

  #shopify-section-{{ section.id }} .review-newest__header {
    display: grid;
    gap: 18px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .review-newest__copy {
    max-width: 720px;
  }

  #shopify-section-{{ section.id }} .review-newest__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 12px;
    color: rgb(var(--rn-trust));
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .review-newest__eyebrow:before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(var(--rn-trust));
    box-shadow: 0 0 0 5px rgba(var(--rn-trust), .12);
  }

  #shopify-section-{{ section.id }} .review-newest__heading {
    margin: 0;
    color: rgb(var(--rn-heading));
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -.045em;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .review-newest__heading em {
    color: rgb(var(--rn-trust));
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .review-newest__intro {
    max-width: 610px;
    margin-top: 12px;
    color: rgb(var(--rn-muted));
    font-size: 15px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .review-newest__intro p { margin: 0; }

  #shopify-section-{{ section.id }} .review-newest__trust-panel {
    display: grid;
    gap: 12px;
    padding: 18px;
    border: 1px solid rgba(var(--rn-border), .85);
    border-radius: 18px;
    background: rgb(var(--rn-card));
    box-shadow: 0 16px 46px rgba(15, 23, 42, var(--rn-shadow));
  }

  #shopify-section-{{ section.id }} .review-newest__trust-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .review-newest__trust-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgb(var(--rn-heading));
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -.025em;
  }

  #shopify-section-{{ section.id }} .review-newest__trust-brand svg {
    width: 22px;
    height: 22px;
    color: rgb(var(--rn-trust));
  }

  #shopify-section-{{ section.id }} .review-newest__rating {
    color: rgb(var(--rn-heading));
    font-size: 28px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -.05em;
  }

  #shopify-section-{{ section.id }} .review-newest__rating span {
    color: rgb(var(--rn-muted));
    font-size: 13px;
    letter-spacing: 0;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .review-newest__stars,
  #shopify-section-{{ section.id }} .review-newest__card-stars {
    display: flex;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .review-newest__star,
  #shopify-section-{{ section.id }} .review-newest__card-star {
    display: grid;
    place-items: center;
    border-radius: 2px;
    background: rgb(var(--rn-trust));
    color: #fff;
  }

  #shopify-section-{{ section.id }} .review-newest__star {
    width: 32px;
    height: 32px;
  }

  #shopify-section-{{ section.id }} .review-newest__card-star {
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .is-empty { background: rgb(var(--rn-empty)); }
  #shopify-section-{{ section.id }} .review-newest__star svg { width: 18px; height: 18px; }
  #shopify-section-{{ section.id }} .review-newest__card-star svg { width: 13px; height: 13px; }

  #shopify-section-{{ section.id }} .review-newest__score-text {
    margin: 0;
    color: rgb(var(--rn-muted));
    font-size: 12px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .review-newest__score-text strong {
    color: rgb(var(--rn-heading));
  }

  #shopify-section-{{ section.id }} .review-newest__viewport-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .review-newest__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-block: 4px 18px;
  }

  #shopify-section-{{ section.id }} .review-newest__viewport::-webkit-scrollbar { display: none; }

  #shopify-section-{{ section.id }} .review-newest__track {
    display: flex;
    gap: var(--rn-gap);
  }

  #shopify-section-{{ section.id }} .review-newest__card {
    flex: 0 0 min(86vw, 360px);
    display: flex;
    flex-direction: column;
    min-height: 286px;
    padding: 18px;
    border: 1px solid rgba(var(--rn-border), .9);
    border-radius: var(--rn-radius);
    background: rgb(var(--rn-card));
    box-shadow: 0 12px 34px rgba(15, 23, 42, calc(var(--rn-shadow) * .82));
    scroll-snap-align: center;
    transform: translateY(10px);
    opacity: 0;
    animation: rnReveal-{{ section.id }} .62s cubic-bezier(.22,.61,.36,1) forwards;
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  #shopify-section-{{ section.id }} .review-newest__card:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--rn-trust), .45);
    box-shadow: 0 18px 48px rgba(15, 23, 42, calc(var(--rn-shadow) + .035));
  }

  #shopify-section-{{ section.id }} .review-newest__card-head {
    display: grid;
    gap: 10px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .review-newest__card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .review-newest__date {
    color: rgb(var(--rn-muted));
    font-size: 12px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .review-newest__title {
    margin: 0;
    color: rgb(var(--rn-heading));
    font-size: 16px;
    line-height: 1.25;
    font-weight: 850;
    letter-spacing: -.02em;
  }

  #shopify-section-{{ section.id }} .review-newest__quote {
    margin: 0;
    color: rgb(var(--rn-text));
    font-size: 14px;
    line-height: 1.58;
  }

  #shopify-section-{{ section.id }} .review-newest__person {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: auto;
    padding-top: 18px;
  }

  #shopify-section-{{ section.id }} .review-newest__avatar,
  #shopify-section-{{ section.id }} .review-newest__avatar-fallback {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .review-newest__avatar { object-fit: cover; }

  #shopify-section-{{ section.id }} .review-newest__avatar-fallback {
    display: grid;
    place-items: center;
    background: #f1f5f3;
    color: rgb(var(--rn-trust));
    font-weight: 900;
  }

  #shopify-section-{{ section.id }} .review-newest__name-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .review-newest__name {
    color: rgb(var(--rn-heading));
    font-size: 13px;
    font-weight: 850;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .review-newest__verified {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: rgb(var(--rn-trust));
    color: #fff;
  }

  #shopify-section-{{ section.id }} .review-newest__verified svg { width: 10px; height: 10px; }

  #shopify-section-{{ section.id }} .review-newest__meta {
    margin-top: 2px;
    color: rgb(var(--rn-muted));
    font-size: 12px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .review-newest__controls {
    display: grid;
    gap: 14px;
    justify-items: center;
  }

  #shopify-section-{{ section.id }} .review-newest__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .review-newest__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(var(--rn-heading), .18);
    cursor: pointer;
    transition: width .2s ease, background .2s ease;
  }

  #shopify-section-{{ section.id }} .review-newest__dot[aria-current='true'] {
    width: 26px;
    background: rgb(var(--rn-trust));
  }

  #shopify-section-{{ section.id }} .review-newest__buttons {
    display: flex;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .review-newest__arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(var(--rn-border), .95);
    border-radius: 999px;
    background: rgb(var(--rn-card));
    color: rgb(var(--rn-heading));
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    transition: transform .18s ease, border-color .18s ease, opacity .18s ease;
  }

  #shopify-section-{{ section.id }} .review-newest__arrow:hover {
    transform: translateY(-1px);
    border-color: rgba(var(--rn-trust), .5);
  }

  #shopify-section-{{ section.id }} .review-newest__arrow[disabled] {
    opacity: .38;
    cursor: not-allowed;
    transform: none;
  }

  @keyframes rnReveal-{{ section.id }} {
    to { transform: translateY(0); opacity: 1; }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .review-newest {
      padding-block: 34px;
    }

    #shopify-section-{{ section.id }} .review-newest__header {
      text-align: left;
    }

    #shopify-section-{{ section.id }} .review-newest__heading {
      font-size: clamp(29px, 8.7vw, 39px);
    }

    #shopify-section-{{ section.id }} .review-newest__trust-panel {
      width: 100%;
      padding: 15px;
    }

    #shopify-section-{{ section.id }} .review-newest__star {
      width: 27px;
      height: 27px;
    }

    #shopify-section-{{ section.id }} .review-newest__viewport {
      margin-inline: -20px;
      padding-inline: 20px;
      scroll-padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .review-newest__card {
      flex-basis: calc(100vw - 40px);
      width: calc(100vw - 40px);
      min-height: 300px;
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .review-newest__header {
      grid-template-columns: minmax(0, 1fr) minmax(290px, 370px);
    }

    #shopify-section-{{ section.id }} .review-newest__card {
      flex-basis: var(--rn-card-width);
      width: var(--rn-card-width);
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .review-newest__controls {
      grid-template-columns: 1fr auto;
      justify-items: stretch;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .review-newest__dots {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .review-newest__card {
      animation: none;
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .review-newest__viewport {
      scroll-behavior: auto;
    }
  }
</style>

<section class="review-newest" data-review-newest data-section-id="{{ section.id }}">
  <div class="container">
    <div class="review-newest__shell">
      <div class="review-newest__header">
        <div class="review-newest__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="review-newest__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="review-newest__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <div class="review-newest__intro rte">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>

        <aside class="review-newest__trust-panel" aria-label="{{ section.settings.score_label | escape }} {{ section.settings.average_rating | escape }} van 5">
          <div class="review-newest__trust-top">
            <div class="review-newest__trust-brand">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="m12 2 2.95 6.31 6.92.83-5.1 4.63 1.35 6.8L12 17.18 5.88 20.57l1.35-6.8-5.1-4.63 6.92-.83L12 2Z"/></svg>
              Trustpilot
            </div>
            <div class="review-newest__rating">{{ section.settings.average_rating | escape }}<span>/5</span></div>
          </div>

          <div class="review-newest__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <span class="review-newest__star{% if i > average_rating %} is-empty{% endif %}"><svg viewBox="0 0 20 20"><path fill="currentColor" d="M10 1.5 12.6 7l6 .75-4.42 4.05 1.17 5.95L10 14.76l-5.35 2.99 1.17-5.95L1.4 7.75 7.4 7 10 1.5Z"/></svg></span>
            {%- endfor -%}
          </div>

          {%- if section.settings.score_text != blank -%}
            <p class="review-newest__score-text"><strong>{{ section.settings.score_label | escape }}</strong> {{ section.settings.score_text | escape }}</p>
          {%- endif -%}
        </aside>
      </div>

      {%- if review_count > 0 -%}
        <div class="review-newest__viewport-wrap">
          <div class="review-newest__viewport" data-review-viewport tabindex="0" aria-label="Review slider">
            <div class="review-newest__track" role="list">
              {%- for block in section.blocks -%}
                <article class="review-newest__card" role="listitem" style="animation-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
                  <div class="review-newest__card-head">
                    <div class="review-newest__card-meta">
                      <div class="review-newest__card-stars" aria-label="{{ block.settings.rating }} van 5 sterren">
                        {%- for i in (1..5) -%}
                          <span class="review-newest__card-star{% if i > block.settings.rating %} is-empty{% endif %}" aria-hidden="true"><svg viewBox="0 0 20 20"><path fill="currentColor" d="M10 1.5 12.6 7l6 .75-4.42 4.05 1.17 5.95L10 14.76l-5.35 2.99 1.17-5.95L1.4 7.75 7.4 7 10 1.5Z"/></svg></span>
                        {%- endfor -%}
                      </div>
                      {%- if block.settings.date != blank -%}<span class="review-newest__date">{{ block.settings.date | escape }}</span>{%- endif -%}
                    </div>

                    {%- if block.settings.title != blank -%}<h3 class="review-newest__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
                  </div>

                  {%- if block.settings.review != blank -%}<p class="review-newest__quote">{{ block.settings.review | escape }}</p>{%- endif -%}

                  <div class="review-newest__person">
                    {%- if block.settings.avatar != blank -%}
                      {{ block.settings.avatar | image_url: width: 96 | image_tag: loading: 'lazy', widths: '42,84,96', class: 'review-newest__avatar', alt: block.settings.name }}
                    {%- else -%}
                      <span class="review-newest__avatar-fallback" aria-hidden="true">{{ block.settings.name | strip | slice: 0, 1 | upcase }}</span>
                    {%- endif -%}
                    <div>
                      <div class="review-newest__name-row">
                        <span class="review-newest__name">{{ block.settings.name | escape }}</span>
                        {%- if block.settings.verified -%}<span class="review-newest__verified" title="Geverifieerde review" aria-label="Geverifieerde review"><svg viewBox="0 0 20 20"><path fill="currentColor" d="M7.7 14.1 3.9 10.3l1.4-1.4 2.4 2.4 7-7 1.4 1.4-8.4 8.4Z"/></svg></span>{%- endif -%}
                      </div>
                      {%- if block.settings.meta != blank -%}<div class="review-newest__meta">{{ block.settings.meta | escape }}</div>{%- endif -%}
                    </div>
                  </div>
                </article>
              {%- endfor -%}
            </div>
          </div>

          <div class="review-newest__controls" aria-label="Slider controls">
            <div class="review-newest__dots" data-review-dots aria-label="Slides"></div>
            <div class="review-newest__buttons">
              <button class="review-newest__arrow" type="button" data-review-prev aria-label="Vorige reviews"><svg viewBox="0 0 20 20" width="18" height="18" focusable="false"><path fill="currentColor" d="M12.7 15.7 7 10l5.7-5.7 1.1 1.1L9.2 10l4.6 4.6-1.1 1.1Z"/></svg></button>
              <button class="review-newest__arrow" type="button" data-review-next aria-label="Volgende reviews"><svg viewBox="0 0 20 20" width="18" height="18" focusable="false"><path fill="currentColor" d="m7.3 15.7-1.1-1.1 4.6-4.6-4.6-4.6 1.1-1.1L13 10l-5.7 5.7Z"/></svg></button>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const initReviewNewest = (root) => {
      if (!root || root.dataset.reviewNewestReady === 'true') return;
      root.dataset.reviewNewestReady = 'true';

      const viewport = root.querySelector('[data-review-viewport]');
      const cards = Array.from(root.querySelectorAll('.review-newest__card'));
      const prev = root.querySelector('[data-review-prev]');
      const next = root.querySelector('[data-review-next]');
      const dots = root.querySelector('[data-review-dots]');
      if (!viewport || !cards.length || !prev || !next || !dots) return;

      const step = () => {
        const card = cards[0];
        const styles = window.getComputedStyle(root);
        const gap = parseFloat(styles.getPropertyValue('--rn-gap')) || 18;
        return card ? card.getBoundingClientRect().width + gap : viewport.clientWidth;
      };

      const index = () => Math.max(0, Math.min(cards.length - 1, Math.round(viewport.scrollLeft / step())));

      dots.innerHTML = '';
      cards.forEach((card, cardIndex) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'review-newest__dot';
        dot.setAttribute('aria-label', `Ga naar review ${cardIndex + 1}`);
        dot.addEventListener('click', () => viewport.scrollTo({ left: cardIndex * step(), behavior: 'smooth' }));
        dots.appendChild(dot);
      });

      const update = () => {
        const active = index();
        prev.disabled = viewport.scrollLeft <= 2;
        next.disabled = viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 2;
        Array.from(dots.children).forEach((dot, dotIndex) => dot.setAttribute('aria-current', dotIndex === active ? 'true' : 'false'));
      };

      prev.addEventListener('click', () => viewport.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => viewport.scrollBy({ left: step(), behavior: 'smooth' }));
      viewport.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    };

    const boot = () => document.querySelectorAll('[data-review-newest]').forEach(initReviewNewest);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
    document.addEventListener('shopify:section:load', (event) => initReviewNewest(event.target.querySelector('[data-review-newest]')));
  })();
</script>

{% schema %}
{
  "name": "Review newest",
  "tag": "section",
  "class": "shopify-section--review-newest",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Geverifieerde Trustpilot reviews" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Wat klanten zeggen over <em>onze service</em>" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Lees de nieuwste ervaringen van klanten die ons beoordelen op kwaliteit, levering en service.</p>" },
    { "type": "text", "id": "score_label", "label": "Score label", "default": "Uitstekend" },
    { "type": "text", "id": "average_rating", "label": "Average rating", "default": "4.8" },
    { "type": "text", "id": "score_text", "label": "Score text", "default": "gebaseerd op 1.247+ reviews" },
