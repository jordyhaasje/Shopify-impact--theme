{%- render 'section-spacing-collapsing' -%}

<style>
#shopify-section-{{ section.id }} {
  --hp9-gap: {{ section.settings.card_gap }}px;
  --hp9-card-w-desktop: {{ section.settings.desktop_card_width }}px;
  --hp9-card-w-mobile: {{ section.settings.mobile_card_width }}px;
}

#shopify-section-{{ section.id }} .hp9 { padding-block: {{ section.settings.section_spacing }}px; }

#shopify-section-{{ section.id }} .hp9__inner { display:grid; gap:28px; }

@media (min-width:900px){
  #shopify-section-{{ section.id }} .hp9__inner{
    grid-template-columns:1.1fr .9fr; align-items:center;
  }
}

#shopify-section-{{ section.id }} .hp9__heading{
  font-size:clamp(28px,4vw,44px); margin-bottom:8px;
}

#shopify-section-{{ section.id }} .hp9__sub{ font-size:15px; opacity:.7; }

/* Trustpilot stars */
.tp-stars{display:flex;gap:3px}
.tp-star{width:18px;height:18px;background:#00b67a;display:flex;align-items:center;justify-content:center}
.tp-star svg{width:12px;height:12px;fill:#fff}

.hp9__rating{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:14px}

.hp9__slider{display:flex;gap:var(--hp9-gap);overflow-x:auto;scroll-snap-type:x mandatory}

.hp9__card{
  flex:0 0 var(--hp9-card-w-mobile);
  scroll-snap-align:start;
  background:#fff;
  border-radius:10px;
  padding:16px;
  border:1px solid #e6e6e6;
}

@media(min-width:900px){
  .hp9__card{flex-basis:var(--hp9-card-w-desktop)}
}

.hp9__card-title{font-weight:600;margin:6px 0}
.hp9__meta{font-size:12px;opacity:.6;margin-bottom:6px}
.hp9__verified{color:#00b67a;font-size:12px;font-weight:600}
.hp9__text{font-size:14px;line-height:1.5;margin:8px 0}
.hp9__author{font-size:13px;opacity:.8}

.hp9__nav{position:absolute;top:50%;transform:translateY(-50%);width:32px;height:32px;border-radius:50%;background:#fff;border:1px solid #ddd;display:flex;align-items:center;justify-content:center}
.hp9__nav--prev{left:-10px}
.hp9__nav--next{right:-10px}

</style>

<section class="hp9">
  <div {% render 'section-properties' %}>
    <div class="container">
      <div class="hp9__inner">

        <div>
          <h2 class="hp9__heading">{{ section.settings.heading }}</h2>
          {%- if section.settings.subheading != blank -%}
            <div class="hp9__sub rte">{{ section.settings.subheading }}</div>
          {%- endif -%}

          <div class="hp9__rating">
            <div class="tp-stars">
              {% for i in (1..5) %}
                <div class="tp-star">
                  <svg viewBox="0 0 20 20"><path d="M10 15l-5 3 1-6-4-4 6-1 2-5 2 5 6 1-4 4 1 6z"/></svg>
                </div>
              {% endfor %}
            </div>
            <span>TrustScore 4.8 | 2,000+ reviews</span>
          </div>
        </div>

        <div style="position:relative">
          <button class="hp9__nav hp9__nav--prev" data-prev>‹</button>
          <div class="hp9__slider" data-slider>
            {% for block in section.blocks %}
              <div class="hp9__card" {{ block.shopify_attributes }}>

                <div class="tp-stars">
                  {% for i in (1..5) %}
                    <div class="tp-star" style="opacity:{% if i <= block.settings.rating %}1{% else %}.2{% endif %}">
                      <svg viewBox="0 0 20 20"><path d="M10 15l-5 3 1-6-4-4 6-1 2-5 2 5 6 1-4 4 1 6z"/></svg>
                    </div>
                  {% endfor %}
                </div>

                <div class="hp9__card-title">{{ block.settings.title }}</div>
                <div class="hp9__meta">{{ block.settings.date }}</div>

                {% if block.settings.verified %}
                  <div class="hp9__verified">✔ Verified</div>
                {% endif %}

                <div class="hp9__text">{{ block.settings.text }}</div>
                <div class="hp9__author">{{ block.settings.author }}</div>

              </div>
            {% endfor %}
          </div>
          <button class="hp9__nav hp9__nav--next" data-next>›</button>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root) return;
  const slider=root.querySelector('[data-slider]');
  const next=root.querySelector('[data-next]');
  const prev=root.querySelector('[data-prev]');

  function scroll(dir){
    const card=slider.querySelector('.hp9__card');
    if(!card) return;
    slider.scrollBy({left: card.offsetWidth * dir, behavior:'smooth'});
  }

  next.addEventListener('click',()=>scroll(1));
  prev.addEventListener('click',()=>scroll(-1));
})();
</script>

{% schema %}
{
  "name": "Hero Pro 9",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Excellent"},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Based on real customer reviews</p>"},
    {"type":"range","id":"section_spacing","label":"Spacing","min":0,"max":80,"step":4,"default":48},
    {"type":"range","id":"content_max_width","label":"Content width","min":600,"max":1200,"step":20,"default":840},
    {"type":"range","id":"desktop_card_width","label":"Desktop card width","min":220,"max":360,"step":4,"default":280},
    {"type":"range","id":"mobile_card_width","label":"Mobile card width","min":220,"max":320,"step":4,"default":260},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":32,"step":2,"default":16}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"text","id":"title","label":"Title","default":"Great service"},
        {"type":"text","id":"date","label":"Date","default":"2 days ago"},
        {"type":"checkbox","id":"verified","label":"Verified","default":true},
        {"type":"textarea","id":"text","label":"Text","default":"Amazing experience."},
        {"type":"text","id":"author","label":"Author","default":"John D."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Pro 9",
      "blocks": [
        {"type":"review"},
        {"type":"review"},
        {"type":"review"}
      ]
    }
  ]
}
{% endschema %}