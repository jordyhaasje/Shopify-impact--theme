{{ 'jsections-beauty-image-banner.css' | asset_url | stylesheet_tag }}

<section
  id="jsections-beauty-image-banner-{{ section.id }}"
  class="jbib{% if section.settings.full_width %} jbib--full{% endif %}"
  style="
    --jbib-text: {{ section.settings.text_color }};
    --jbib-radius: {{ section.settings.corner_radius }}px;
    --jbib-height-desktop: {{ section.settings.height_desktop }}px;
    --jbib-height-mobile: {{ section.settings.height_mobile }}px;
    --jbib-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="jbib__frame">
    <div class="jbib__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', class: 'jbib__image', sizes: '100vw', alt: section.settings.heading }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'jbib__placeholder' }}
      {% endif %}
      <div class="jbib__shade"></div>
    </div>
    <div class="jbib__content">
      {% if section.settings.heading != blank %}
        <h2 class="jbib__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="jbib__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="jbib__button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beauty image banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Use full viewport width",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spring Glow Routine"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore our limited edition collection perfect for spring. Mix and match these items displaying pink and red colors with shimmery accents handpicked by you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DISCOVER"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 420,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 380,
      "max": 680,
      "step": 20,
      "unit": "px",
      "default": 540
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Beauty image banner"
    }
  ]
}
{% endschema %}
