{%- comment -%} Product Video Gallery Section {%- endcomment -%}
<section class="section section--tight">
  <div class="container">
    <h2 class="h2 text-center">Loved by 200,000+ happy customers.</h2>
    <div class="video-gallery" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-top: 20px;">
      {%- for media in product.media limit: 3 -%}
        {%- if media.media_type == 'video' -%}
          <div class="video-item" style="cursor: pointer;" onclick="openLightbox('{{ media | video_tag: autoplay: true, muted: true }}')">
            {{ media | video_tag: image_size: 'master', autoplay: true, muted: true, loop: true }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="progress-container" style="height: 4px; background: #eee; margin-top: 15px;">
      <div class="progress-bar" style="width: 50%; height: 100%; background: #e09f7d;"></div>
    </div>
  </div>
</section>

<style>
  .video-item video { width: 100%; border-radius: 8px; pointer-events: none; }
</style>

{% schema %}
{
  "name": "Product Video Gallery",
  "settings": [],
  "presets": [{ "name": "Product Video Gallery" }]
}
{% endschema %}
