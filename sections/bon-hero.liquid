{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --bon-hero-bg: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --bon-hero-heading: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    --bon-hero-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    --bon-hero-button-bg: {{ section.settings.button_background.red }}, {{ section.settings.button_background.green }}, {{ section.settings.button_background.blue }};
    --bon-hero-button-text: {{ section.settings.button_text_color.red }}, {{ section.settings.button_text_color.green }}, {{ section.settings.button_text_color.blue }};
    --bon-hero-box-top: {{ section.settings.box_top.red }}, {{ section.settings.box_top.green }}, {{ section.settings.box_top.blue }};
    --bon-hero-box-bottom: {{ section.settings.box_bottom.red }}, {{ section.settings.box_bottom.green }}, {{ section.settings.box_bottom.blue }};
    --bon-hero-device: {{ section.settings.device_color.red }}, {{ section.settings.device_color.green }}, {{ section.settings.device_color.blue }};
    --bon-hero-wave: {{ section.settings.wave_color.red }}, {{ section.settings.wave_color.green }}, {{ section.settings.wave_color.blue }};
    --section-outer-spacing-block: {{ section.settings.section_spacing }}px;
    --bon-hero-radius: {{ section.settings.button_radius }}px;
    --bon-hero-content-max: {{ section.settings.content_max_width }}px;
    --bon-hero-visual-max: {{ section.settings.visual_max_width }}px;
  }

  #shopify-section-{{ section.id }} .bon-hero {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bon-hero__shell {
    position: relative;
    background: rgb(var(--bon-hero-bg));
    min-height: {{ section.settings.desktop_min_height }}px;
  }

  #shopify-section-{{ section.id }} .bon-hero__shell::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: {{ section.settings.wave_height_desktop }}px;
    background: rgb(var(--bon-hero-wave));
    clip-path: ellipse(84% 62% at 50% 100%);
    z-index: 1;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bon-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, var(--bon-hero-visual-max));
    align-items: center;
    gap: 34px;
    padding: {{ section.settings.padding_top }}px 0 calc({{ section.settings.padding_bottom }}px + {{ section.settings.wave_height_desktop | times: 0.45 | round }}px);
  }

  #shopify-section-{{ section.id }} .bon-hero__content {
    max-width: var(--bon-hero-content-max);
    padding-left: {{ section.settings.content_offset_left }}px;
  }

  #shopify-section-{{ section.id }} .bon-hero__heading {
    margin: 0;
    color: rgb(var(--bon-hero-heading));
    font-size: clamp(44px, 5.6vw, 64px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-transform: uppercase;
    max-width: 7ch;
  }

  #shopify-section-{{ section.id }} .bon-hero__text {
    margin-top: 24px;
    max-width: 560px;
    color: rgb(var(--bon-hero-text));
    font-size: 21px;
    line-height: 1.36;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .bon-hero__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .bon-hero__actions {
    margin-top: 34px;
  }

  #shopify-section-{{ section.id }} .bon-hero__button {
    min-width: 294px;
    justify-content: center;
    border-radius: var(--bon-hero-radius);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    padding-inline: 36px;
    min-height: 80px;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .bon-hero__visual {
    position: relative;
    min-height: 500px;
  }

  #shopify-section-{{ section.id }} .bon-hero__media-stage {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .bon-hero__drink {
    position: absolute;
    left: 7%;
    top: 7%;
    width: 23%;
    max-width: 148px;
    z-index: 4;
  }

  #shopify-section-{{ section.id }} .bon-hero__drink img,
  #shopify-section-{{ section.id }} .bon-hero__phone-screen img,
  #shopify-section-{{ section.id }} .bon-hero__box-face img {
    width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .bon-hero__product-box {
    position: absolute;
    right: 8%;
    top: 23%;
    width: 48%;
    max-width: 330px;
    transform: skewX(-8deg);
    transform-origin: center;
    z-index: 3;
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, 0.16));
  }

  #shopify-section-{{ section.id }} .bon-hero__box-top,
  #shopify-section-{{ section.id }} .bon-hero__box-bottom {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.02em;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bon-hero__box-top {
    background: linear-gradient(180deg, rgba(var(--bon-hero-box-top), 0.92), rgba(var(--bon-hero-box-top), 1));
    min-height: 112px;
    border-radius: 6px 6px 0 0;
    border: 2px solid rgba(124, 74, 39, 0.28);
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .bon-hero__box-top::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.18), transparent 42%, transparent 58%, rgba(0,0,0,0.05));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bon-hero__box-top-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 12px;
    transform: skewX(8deg);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bon-hero__box-top-small {
    font-size: 10px;
    line-height: 1.1;
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .bon-hero__box-top-large {
    font-size: clamp(20px, 2vw, 28px);
    line-height: 0.95;
  }

  #shopify-section-{{ section.id }} .bon-hero__box-bottom {
    background: linear-gradient(180deg, rgba(var(--bon-hero-box-bottom), 0.95), rgba(var(--bon-hero-box-bottom), 1));
    min-height: 62px;
    border-radius: 0 0 6px 6px;
    border: 2px solid rgba(80, 32, 83, 0.22);
  }

  #shopify-section-{{ section.id }} .bon-hero__box-bottom-text {
    transform: skewX(8deg);
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone {
    position: absolute;
    right: 0;
    bottom: -8px;
    width: 43%;
    max-width: 290px;
    aspect-ratio: 0.58;
    background: rgb(var(--bon-hero-device));
    border-radius: 18px;
    padding: 13px;
    z-index: 5;
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.16);
  }

  #shopify-section-{{ section.id }} .bon-hero__phone::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 54px;
    height: 7px;
    border-radius: 999px;
    background: #3b3b3b;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-screen {
    position: relative;
    height: 100%;
    border-radius: 12px;
    background: rgb(var(--bon-hero-bg));
    overflow: hidden;
    padding: 34px 16px 22px;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-screen::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: {{ section.settings.wave_height_mobile }}px;
    background: rgb(var(--bon-hero-wave));
    clip-path: ellipse(88% 55% at 50% 100%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-title {
    margin: 0;
    color: rgb(var(--bon-hero-heading));
    font-size: 27px;
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-visual {
    position: relative;
    margin: 18px auto 0;
    width: 88%;
    height: 146px;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-drink {
    position: absolute;
    left: 3%;
    bottom: 0;
    width: 30%;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-box {
    position: absolute;
    right: 0;
    bottom: 7px;
    width: 68%;
    transform: skewX(-8deg);
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.12));
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-copy {
    position: relative;
    z-index: 2;
    margin-top: 16px;
    color: rgb(var(--bon-hero-text));
    font-size: 14px;
    line-height: 1.35;
    text-align: center;
    max-width: 220px;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-copy p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-button-wrap {
    position: relative;
    z-index: 2;
    margin-top: 16px;
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .bon-hero__phone-button {
    min-height: 56px;
    min-width: 176px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    justify-content: center;
    padding-inline: 24px;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .bon-hero__slide-badges {
    display: none;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .bon-hero__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: {{ section.settings.padding_top_mobile }}px 0 calc({{ section.settings.padding_bottom_mobile }}px + {{ section.settings.wave_height_mobile }}px);
    }

    #shopify-section-{{ section.id }} .bon-hero__content {
      padding-left: 0;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .bon-hero__heading {
      font-size: clamp(34px, 9vw, 52px);
      max-width: 8ch;
    }

    #shopify-section-{{ section.id }} .bon-hero__text {
      margin-top: 18px;
      font-size: 17px;
      max-width: 340px;
    }

    #shopify-section-{{ section.id }} .bon-hero__actions {
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .bon-hero__button {
      min-width: 228px;
      min-height: 64px;
      font-size: 18px;
      padding-inline: 28px;
    }

    #shopify-section-{{ section.id }} .bon-hero__visual {
      min-height: 540px;
    }

    #shopify-section-{{ section.id }} .bon-hero__drink {
      left: 10%;
      top: 2%;
      width: 20%;
      max-width: 100px;
    }

    #shopify-section-{{ section.id }} .bon-hero__product-box {
      right: 16%;
      top: 12%;
      width: 54%;
      max-width: 260px;
    }

    #shopify-section-{{ section.id }} .bon-hero__phone {
      right: 50%;
      transform: translateX(50%);
      bottom: 8px;
      width: min(78vw, 286px);
      max-width: none;
    }

    #shopify-section-{{ section.id }} .bon-hero__shell::after {
      height: {{ section.settings.wave_height_mobile }}px;
      clip-path: ellipse(100% 52% at 50% 100%);
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .bon-hero__shell {
      min-height: {{ section.settings.mobile_min_height }}px;
    }

    #shopify-section-{{ section.id }} .bon-hero__heading {
      max-width: 7ch;
    }

    #shopify-section-{{ section.id }} .bon-hero__phone-title {
      font-size: 23px;
    }

    #shopify-section-{{ section.id }} .bon-hero__phone-copy {
      font-size: 13px;
      max-width: 208px;
    }
  }
</style>

<section class="bon-hero">
  <div {% render 'section-properties', background: section.settings.background, text_color: section.settings.heading_color, full_width: true %}>
    <div class="bon-hero__shell">
      <div class="container">
        <div class="bon-hero__inner">
          <div class="bon-hero__content">
            {%- if section.settings.heading != blank -%}
              <h2 class="bon-hero__heading">{{ section.settings.heading | newline_to_br }}</h2>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <div class="bon-hero__text rte">{{ section.settings.text }}</div>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
              <div class="bon-hero__actions">
                {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'xl', style: 'fill', background: section.settings.button_background, text_color: section.settings.button_text_color, class: 'bon-hero__button' %}
              </div>
            {%- endif -%}
          </div>

          <div class="bon-hero__visual">
            <div class="bon-hero__media-stage">
              <div class="bon-hero__drink">
                {%- if section.settings.drink_image != blank -%}
                  {{ section.settings.drink_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120,180,240,320,400', alt: section.settings.drink_alt | escape }}
                {%- else -%}
                  <svg viewBox="0 0 160 360" aria-hidden="true" role="presentation">
                    <defs>
                      <linearGradient id="bon-drink-{{ section.id }}" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="#dac6a4"/>
                        <stop offset="100%" stop-color="#efe4cf"/>
                      </linearGradient>
                    </defs>
                    <rect x="44" y="12" width="20" height="58" rx="4" fill="#7f7f82"/>
                    <ellipse cx="80" cy="96" rx="42" ry="12" fill="#d4bd94"/>
                    <path d="M34 94h92l-10 218c-1 20-17 36-37 36H81c-20 0-36-16-37-36L34 94z" fill="url(#bon-drink-{{ section.id }})"/>
                    <ellipse cx="80" cy="308" rx="34" ry="14" fill="#3c261e" opacity="0.8"/>
                    <circle cx="60" cy="304" r="8" fill="#3c261e"/>
                    <circle cx="78" cy="314" r="9" fill="#3c261e"/>
                    <circle cx="98" cy="302" r="8" fill="#3c261e"/>
                    <circle cx="70" cy="286" r="7" fill="#3c261e"/>
                    <circle cx="96" cy="284" r="7" fill="#3c261e"/>
                    <path d="M48 138c11 8 16 9 24 0M72 166c12 9 17 9 24 0M54 196c11 8 16 9 24 0M86 128c10 7 15 7 22 0M94 204c10 7 16 7 24 0" stroke="#dbcdb5" stroke-width="6" stroke-linecap="round" opacity="0.55"/>
                  </svg>
                {%- endif -%}
              </div>

              <div class="bon-hero__product-box">
                <div class="bon-hero__box-top">
                  <div class="bon-hero__box-top-text">
                    <span class="bon-hero__box-top-small">{{ section.settings.box_eyebrow | escape }}</span>
                    <span class="bon-hero__box-top-large">{{ section.settings.box_title | escape }}</span>
                  </div>
                </div>
                <div class="bon-hero__box-bottom">
                  <span class="bon-hero__box-bottom-text">{{ section.settings.box_subtitle | escape }}</span>
                </div>
              </div>

              <div class="bon-hero__phone">
                <div class="bon-hero__phone-screen">
                  <h3 class="bon-hero__phone-title">{{ section.settings.phone_heading | newline_to_br }}</h3>

                  <div class="bon-hero__phone-visual">
                    <div class="bon-hero__phone-drink">
                      {%- if section.settings.drink_image != blank -%}
                        {{ section.settings.drink_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '110,160,220', alt: section.settings.drink_alt | escape }}
                      {%- else -%}
                        <svg viewBox="0 0 160 360" aria-hidden="true" role="presentation">
                          <defs>
                            <linearGradient id="bon-drink-mini-{{ section.id }}" x1="0" x2="0" y1="0" y2="1">
                              <stop offset="0%" stop-color="#dac6a4"/>
                              <stop offset="100%" stop-color="#efe4cf"/>
                            </linearGradient>
                          </defs>
                          <rect x="44" y="12" width="20" height="58" rx="4" fill="#7f7f82"/>
                          <ellipse cx="80" cy="96" rx="42" ry="12" fill="#d4bd94"/>
                          <path d="M34 94h92l-10 218c-1 20-17 36-37 36H81c-20 0-36-16-37-36L34 94z" fill="url(#bon-drink-mini-{{ section.id }})"/>
                          <ellipse cx="80" cy="308" rx="34" ry="14" fill="#3c261e" opacity="0.8"/>
                          <circle cx="60" cy="304" r="8" fill="#3c261e"/>
                          <circle cx="78" cy="314" r="9" fill="#3c261e"/>
                          <circle cx="98" cy="302" r="8" fill="#3c261e"/>
                        </svg>
                      {%- endif -%}
                    </div>

                    <div class="bon-hero__phone-box">
                      <div class="bon-hero__box-top">
                        <div class="bon-hero__box-top-text">
                          <span class="bon-hero__box-top-small">{{ section.settings.box_eyebrow | escape }}</span>
                          <span class="bon-hero__box-top-large">{{ section.settings.box_title | escape }}</span>
                        </div>
                      </div>
                      <div class="bon-hero__box-bottom">
                        <span class="bon-hero__box-bottom-text">{{ section.settings.box_subtitle | escape }}</span>
                      </div>
                    </div>
                  </div>

                  <div class="bon-hero__phone-copy rte">{{ section.settings.text }}</div>

                  {%- if section.settings.button_label != blank -%}
                    <div class="bon-hero__phone-button-wrap">
                      {% render 'button', content: section.settings.button_label, href: section.settings.button_link, size: 'lg', style: 'fill', background: section.settings.button_background, text_color: section.settings.button_text_color, class: 'bon-hero__phone-button' %}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bon hero",
  "tag": "section",
  "class": "shopify-section--bon-hero",
  "settings": [
    {"type":"textarea","id":"heading","label":"Heading","default":"BUBBLE TEA\nTIME CHAMPS\nN' VIBERS"},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Get that bubbly feeling going with our fantastic bubble tea!</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"SHOP NOW"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"header","content":"Media"},
    {"type":"image_picker","id":"drink_image","label":"Drink image"},
    {"type":"text","id":"drink_alt","label":"Drink image alt text","default":"Bubble tea cup"},
    {"type":"text","id":"box_eyebrow","label":"Box eyebrow","default":"Freshly"},
    {"type":"text","id":"box_title","label":"Box title","default":"Original Milk Tea Kit"},
    {"type":"text","id":"box_subtitle","label":"Box subtitle","default":"Taro Milk Tea"},
    {"type":"textarea","id":"phone_heading","label":"Phone heading","default":"BUBBLE TEA\nTIME CHAMPS N'\nVIBERS"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"section_spacing","label":"Section spacing","min":0,"max":80,"step":4,"default":0},
    {"type":"range","id":"content_max_width","label":"Content max width","min":320,"max":720,"step":20,"default":520},
    {"type":"range","id":"visual_max_width","label":"Visual max width","min":320,"max":680,"step":20,"default":560},
    {"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":120,"step":4,"default":60},
    {"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"default":92},
    {"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":120,"step":4,"default":28},
    {"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":160,"step":4,"default":84},
    {"type":"range","id":"content_offset_left","label":"Desktop content offset left","min":0,"max":120,"step":4,"default":16},
    {"type":"range","id":"desktop_min_height","label":"Desktop min height","min":400,"max":900,"step":20,"default":620},
    {"type":"range","id":"mobile_min_height","label":"Mobile min height","min":500,"max":1000,"step":20,"default":700},
    {"type":"range","id":"wave_height_desktop","label":"Desktop wave height","min":40,"max":220,"step":4,"default":84},
    {"type":"range","id":"wave_height_mobile","label":"Mobile wave height","min":40,"max":220,"step":4,"default":92},
    {"type":"range","id":"button_radius","label":"Button radius","min":0,"max":60,"step":2,"default":28},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background","label":"Background","default":"#EAE0EC"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#4A2F63"},
    {"type":"color","id":"text_color","label":"Text color","default":"#574664"},
    {"type":"color","id":"button_background","label":"Button background","default":"#4A2F63"},
    {"type":"color","id":"button_text_color","label":"Button text color","default":"#FFFFFF"},
    {"type":"color","id":"box_top","label":"Box top color","default":"#C88F62"},
    {"type":"color","id":"box_bottom","label":"Box bottom color","default":"#8B4A87"},
    {"type":"color","id":"device_color","label":"Phone color","default":"#000000"},
    {"type":"color","id":"wave_color","label":"Wave color","default":"#F4F4F4"}
  ],
  "presets": [
    {
      "name": "Bon hero"
    }
  ]
}
{% endschema %}