<style>
  #shopify-section-{{ section.id }} {
    --clt-bg-start: {{ section.settings.background_start }};
    --clt-bg-end: {{ section.settings.background_end }};
    --clt-accent: {{ section.settings.accent_color }};
    --clt-text: {{ section.settings.text_color }};
    --clt-card: {{ section.settings.card_color }};
    --clt-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  #shopify-section-{{ section.id }} .clt-hero {
    position: relative;
    overflow: hidden;
    color: var(--clt-text);
    background:
      radial-gradient(circle at 16% 18%, color-mix(in srgb, var(--clt-accent) 34%, transparent), transparent 30rem),
      radial-gradient(circle at 82% 12%, rgba(255, 255, 255, 0.26), transparent 24rem),
      linear-gradient(135deg, var(--clt-bg-start), var(--clt-bg-end));
  }

  #shopify-section-{{ section.id }} .clt-hero__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .clt-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(10, 14, 30, var(--clt-overlay-opacity));
  }

  #shopify-section-{{ section.id }} .clt-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .clt-hero__shape {
    position: absolute;
    border-radius: 999px;
    filter: blur(0.5px);
    opacity: 0.72;
  }

  #shopify-section-{{ section.id }} .clt-hero__shape--one {
    width: 18rem;
    height: 18rem;
    right: 8%;
    top: 18%;
    background: color-mix(in srgb, var(--clt-accent) 42%, #ffffff);
  }

  #shopify-section-{{ section.id }} .clt-hero__shape--two {
    width: 12rem;
    height: 12rem;
    right: 24%;
    bottom: 12%;
    background: rgba(255, 255, 255, 0.28);
  }

  #shopify-section-{{ section.id }} .clt-hero__inner {
    position: relative;
    z-index: 1;
    max-width: {{ section.settings.content_width }}px;
    min-height: {{ section.settings.min_height }}vh;
    margin-inline: auto;
    padding: {{ section.settings.padding_block }}px 20px;
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(280px, 0.72fr);
    gap: clamp(28px, 5vw, 48px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .clt-hero__eyebrow {
    display: inline-flex;
    width: fit-content;
    margin: 0 0 18px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px);
    font-size: 12px;
    font-weight: 760;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .clt-hero__heading {
    max-width: 11ch;
    margin: 0;
    color: inherit;
    font-size: clamp(42px, 6.5vw, {{ section.settings.heading_size }}px);
    line-height: 0.94;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .clt-hero__text {
    max-width: 640px;
    margin-top: 22px;
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .clt-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  #shopify-section-{{ section.id }} .clt-hero__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.34);
    font-weight: 760;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  #shopify-section-{{ section.id }} .clt-hero__button:hover {
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .clt-hero__button--primary {
    background: #ffffff;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .clt-hero__button--secondary {
    background: rgba(255, 255, 255, 0.13);
    color: inherit;
  }

  #shopify-section-{{ section.id }} .clt-hero__panel {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 28px;
    background: color-mix(in srgb, var(--clt-card) 74%, transparent);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(22px);
  }

  #shopify-section-{{ section.id }} .clt-hero__panel-inner {
    min-height: 360px;
    padding: clamp(22px, 3vw, 34px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .clt-hero__review {
    border-radius: 22px;
    padding: 20px;
    background: rgba(255, 255, 255, 0.9);
    color: #151515;
  }

  #shopify-section-{{ section.id }} .clt-hero__review-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .clt-hero__avatars {
    display: flex;
    padding-left: 10px;
  }

  #shopify-section-{{ section.id }} .clt-hero__avatar {
    width: 38px;
    height: 38px;
    margin-left: -10px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 2px solid #ffffff;
    border-radius: 999px;
    background: color-mix(in srgb, var(--clt-accent) 58%, #ffffff);
    color: #141414;
    font-size: 12px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .clt-hero__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .clt-hero__stars {
    color: #f7a700;
    font-weight: 800;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .clt-hero__quote {
    margin-top: 16px;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .clt-hero__reviewer {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .clt-hero__reviewer strong {
    font-size: 15px;
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .clt-hero__inner {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: {{ section.settings.mobile_padding_block }}px;
    }

    #shopify-section-{{ section.id }} .clt-hero__heading {
      font-size: clamp(38px, 13vw, 58px);
    }

    #shopify-section-{{ section.id }} .clt-hero__panel-inner {
      min-height: 300px;
    }
  }
</style>

<section class="clt-hero" data-section-id="{{ section.id }}">
  <div class="clt-hero__media" aria-hidden="true">
    {% if section.settings.hero_image != blank %}
      {% assign clt_hero_alt = section.settings.hero_image.alt | default: section.settings.heading | strip_html %}
      {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '720, 960, 1200, 1500, 1800', sizes: '100vw', alt: clt_hero_alt }}
    {% else %}
      <span class="clt-hero__shape clt-hero__shape--one"></span>
      <span class="clt-hero__shape clt-hero__shape--two"></span>
    {% endif %}
  </div>

  <div class="clt-hero__inner">
    <div class="clt-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="clt-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="clt-hero__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="clt-hero__text">{{ section.settings.text }}</div>
      {% endif %}

      <div class="clt-hero__actions">
        {% if section.settings.primary_button_text != blank and section.settings.primary_button_link != blank %}
          <a class="clt-hero__button clt-hero__button--primary" href="{{ section.settings.primary_button_link }}">
            {{ section.settings.primary_button_text | escape }}
          </a>
        {% endif %}
        {% if section.settings.secondary_button_text != blank and section.settings.secondary_button_link != blank %}
          <a class="clt-hero__button clt-hero__button--secondary" href="{{ section.settings.secondary_button_link }}">
            {{ section.settings.secondary_button_text | escape }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="clt-hero__panel" data-section-bounded-shell>
      <div class="clt-hero__panel-inner">
        <div class="clt-hero__review">
          <div class="clt-hero__review-top">
            <div class="clt-hero__avatars" aria-label="Customer avatars">
              <span class="clt-hero__avatar">
                {% if section.settings.avatar_1 != blank %}
                  {% assign clt_avatar_1_alt = section.settings.avatar_1.alt | default: section.settings.avatar_1_label %}
                  {{ section.settings.avatar_1 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: clt_avatar_1_alt }}
                {% else %}
                  {{ section.settings.avatar_1_label | slice: 0 | upcase }}
                {% endif %}
              </span>
              <span class="clt-hero__avatar">
                {% if section.settings.avatar_2 != blank %}
                  {% assign clt_avatar_2_alt = section.settings.avatar_2.alt | default: section.settings.avatar_2_label %}
                  {{ section.settings.avatar_2 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: clt_avatar_2_alt }}
                {% else %}
                  {{ section.settings.avatar_2_label | slice: 0 | upcase }}
                {% endif %}
              </span>
              <span class="clt-hero__avatar">
                {% if section.settings.avatar_3 != blank %}
                  {% assign clt_avatar_3_alt = section.settings.avatar_3.alt | default: section.settings.avatar_3_label %}
                  {{ section.settings.avatar_3 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: clt_avatar_3_alt }}
                {% else %}
                  {{ section.settings.avatar_3_label | slice: 0 | upcase }}
                {% endif %}
              </span>
            </div>
            <span class="clt-hero__stars" aria-label="{{ section.settings.rating_label | escape }}">★★★★★</span>
          </div>

          {% if section.settings.review_quote != blank %}
            <div class="clt-hero__quote">{{ section.settings.review_quote }}</div>
          {% endif %}

          <div class="clt-hero__reviewer">
            {% if section.settings.reviewer_name != blank %}
              <strong>{{ section.settings.reviewer_name | escape }}</strong>
            {% endif %}
            {% if section.settings.reviewer_role != blank %}
              <span>{{ section.settings.reviewer_role | escape }}</span>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Codex live hero test",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium opening" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make the first impression unforgettable" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A flexible hero section with premium styling, clear calls to action and social proof that can be edited in the theme editor.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },
    { "type": "text", "id": "primary_button_text", "label": "Primary button text", "default": "Start exploring" },
    { "type": "url", "id": "primary_button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_text", "label": "Secondary button text", "default": "View details" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "Rated five out of five stars" },
    { "type": "richtext", "id": "review_quote", "label": "Review quote", "default": "<p>The experience felt polished, premium and easy to trust from the first moment.</p>" },
    { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "A verified customer" },
    { "type": "text", "id": "reviewer_role", "label": "Reviewer role", "default": "Repeat buyer" },
    { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1 image" },
    { "type": "text", "id": "avatar_1_label", "label": "Avatar 1 fallback label", "default": "Mila" },
    { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2 image" },
    { "type": "text", "id": "avatar_2_label", "label": "Avatar 2 fallback label", "default": "Noah" },
    { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3 image" },
    { "type": "text", "id": "avatar_3_label", "label": "Avatar 3 fallback label", "default": "Sara" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 960, "max": 1320, "step": 20, "unit": "px", "default": 1180 },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 60, "max": 100, "step": 5, "unit": "vh", "default": 80 },
    { "type": "range", "id": "heading_size", "label": "Maximum heading size", "min": 56, "max": 96, "step": 2, "unit": "px", "default": 78 },
    { "type": "range", "id": "padding_block", "label": "Desktop vertical padding", "min": 56, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "mobile_padding_block", "label": "Mobile vertical padding", "min": 40, "max": 88, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 55, "step": 5, "unit": "%", "default": 20 },
    { "type": "color", "id": "background_start", "label": "Background start", "default": "#2F2A75" },
    { "type": "color", "id": "background_end", "label": "Background end", "default": "#F05D9E" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#9CF6D4" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Glass card color", "default": "#FFFFFF" }
  ],
  "presets": [
    {
      "name": "Codex live hero test"
    }
  ]
}
{% endschema %}