{%- comment -%}
  JSections - Hero #33
  Version: 1.0.0
  Installed by: Hazify Sections

  ⚠️ Do not modify - updates will overwrite changes.
  To customize, duplicate this section in your theme.
{%- endcomment -%}

{{ 'jsections-hero-33.css' | asset_url | stylesheet_tag }}

<div
  class="hero-33"
  style="
    --bg-color: {{ section.settings.background_color }};
    --border-radius: {{ section.settings.border_radius }}px;
    --section-margin: {{ section.settings.section_margin }}px;
    --section-padding: {{ section.settings.section_padding }}px;
    --min-height: {{ section.settings.min_height }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
  {{ section.shopify_attributes }}
>
  <div class="hero-33__container">
    <div class="hero-33__background">
      {%- if section.settings.background_video != blank -%}
        {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero-33__video' }}
      {%- elsif section.settings.image != blank -%}
        <img
          srcset="
            {%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {%- if section.settings.image.width >= 2000 -%}{{ section.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {%- if section.settings.image.width >= 3000 -%}{{ section.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
            {{ section.settings.image | image_url }} {{ section.settings.image.width }}w
          "
          src="{{ section.settings.image | image_url: width: 1500 }}"
          loading="lazy"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          class="hero-33__image"
        >
      {%- endif -%}
    </div>

    <div class="hero-33__body">
      <div class="hero-33__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <div
                class="hero-33__heading"
                style="
                  --heading-color: {{ block.settings.color }};
                  --heading-size: {{ block.settings.font_size }}px;
                  --heading-align: {{ block.settings.text_align }};
                  --heading-spacing: {{ block.settings.margin_top }}px;
                "
                {{ block.shopify_attributes }}
              >
                <h1>{{ block.settings.heading }}</h1>
              </div>

            {%- when 'text' -%}
              <div
                class="hero-33__text"
                style="
                  --text-color: {{ block.settings.color }};
                  --text-size: {{ block.settings.font_size }}px;
                  --text-align: {{ block.settings.text_align }};
                  --text-spacing: {{ block.settings.margin_top }}px;
                "
                {{ block.shopify_attributes }}
              >
                <p>{{ block.settings.text }}</p>
              </div>

            {%- when 'buttons' -%}
              <div
                class="hero-33__buttons"
                style="--buttons-spacing: {{ block.settings.margin_top }}px;"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.button_label_1 != blank -%}
                  <a
                    href="{{ block.settings.button_link_1 }}"
                    class="hero-33__button"
                    style="
                      --button-bg: {{ block.settings.button_bg_1 }};
                      --button-color: {{ block.settings.button_color_1 }};
                      --button-hover-bg: {{ block.settings.button_hover_bg_1 }};
                      --button-hover-color: {{ block.settings.button_hover_color_1 }};
                      --button-border-radius: {{ block.settings.button_border_radius }}px;
                    "
                  >
                    <span>{{ block.settings.button_label_1 }}</span>
                  </a>
                {%- endif -%}

                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    href="{{ block.settings.button_link_2 }}"
                    class="hero-33__button"
                    style="
                      --button-bg: {{ block.settings.button_bg_2 }};
                      --button-color: {{ block.settings.button_color_2 }};
                      --button-hover-bg: {{ block.settings.button_hover_bg_2 }};
                      --button-hover-color: {{ block.settings.button_hover_color_2 }};
                      --button-border-radius: {{ block.settings.button_border_radius }}px;
                    "
                  >
                    <span>{{ block.settings.button_label_2 }}</span>
                  </a>
                {%- endif -%}
              </div>

            {%- when 'review' -%}
              <div
                class="hero-33__review-container"
                style="--review-spacing: {{ block.settings.margin_top }}px;"
                {{ block.shopify_attributes }}
              >
                <div class="hero-33__review">
                  <div
                    class="hero-33__review-text"
                    style="--review-text-color: {{ block.settings.text_color }};"
                  >
                    <p>{{ block.settings.review_label }} <strong>{{ block.settings.rating }}</strong> | {{ block.settings.customer_count }}</p>
                  </div>
                  <div class="hero-33__stars" style="--star-color: {{ block.settings.star_color }};">
                    {%- for i in (1..5) -%}
                      {%- if block.settings.star_icon == 'image' and block.settings.star_image != blank -%}
                        {{ block.settings.star_image | image_url: width: 20 | image_tag: loading: 'lazy', width: 20, height: 20 }}
                      {%- else -%}
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="19" viewBox="0 0 20 19" fill="none">
                          <path d="M10 0L12.9389 5.95492L19.5106 6.90983L14.7553 11.5451L15.8779 18.0902L10 15L4.12215 18.0902L5.24472 11.5451L0.489435 6.90983L7.06107 5.95492L10 0Z" fill="currentColor"/>
                        </svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>

                {%- if block.settings.show_testimonial -%}
                  <div class="hero-33__author">
                    {%- if block.settings.author_image != blank -%}
                      <div class="hero-33__author-image">
                        {{ block.settings.author_image | image_url: width: 128 | image_tag: loading: 'lazy', width: 64, height: 64 }}
                      </div>
                    {%- endif -%}
                    <div class="hero-33__author-content">
                      <div
                        class="hero-33__author-text"
                        style="--author-text-color: {{ block.settings.testimonial_color }};"
                      >
                        <p>{{ block.settings.testimonial }}</p>
                      </div>
                      <p
                        class="hero-33__author-name"
                        style="--author-name-color: {{ block.settings.author_color }};"
                      >
                        {{ block.settings.author_name }}
                      </p>
                    </div>
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

