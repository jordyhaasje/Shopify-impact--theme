{% comment %}
Trustpilot Style Reviews Section V4 (Fixed Syntax)
{% endcomment %}

<section id="trustpilot-{{ section.id }}" class="tp-clone">
  <div class="tp-inner">

    <div class="tp-header">
      <h2>{{ section.settings.rating_title }}</h2>
      <div class="tp-stars">
        {% assign full = section.settings.score | floor %}
        {% for i in (1..5) %}
          <span class="star {% if i <= full %}full{% else %}empty{% endif %}">★</span>
        {% endfor %}
      </div>
      <p>{{ section.settings.rating_caption }}</p>
    </div>

    {% if section.settings.show_breakdown %}
      <div class="tp-breakdown">
        {% for block in section.blocks %}
          {% if block.type == 'rating_bar' %}
            <div class="row">
              <span>{{ block.settings.label }}</span>
              <div class="bar">
                <div style="width:{{ block.settings.percentage }}%; background:{{ block.settings.bar_color }}"></div>
              </div>
              <span>{{ block.settings.count }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_reviews %}
      <div class="tp-reviews">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="card">
              <div class="stars">
                {% for i in (1..block.settings.stars) %}★{% endfor %}
              </div>
              <p>{{ block.settings.text }}</p>
              <strong>{{ block.settings.author }}</strong>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Trustpilot Reviews",
  "settings": [
    { "type": "text", "id": "rating_title", "default": "Rated 4.6 / 5", "label": "Title" },
    { "type": "text", "id": "rating_caption", "default": "Based on 147 reviews", "label": "Caption" },
    { "type": "range", "id": "score", "min": 0, "max": 5, "step": 0.1, "default": 4.6, "label": "Score" },
    { "type": "checkbox", "id": "show_breakdown", "default": true, "label": "Show breakdown" },
    { "type": "checkbox", "id": "show_reviews", "default": true, "label": "Show reviews" }
  ],
  "blocks": [
    {
      "type": "rating_bar",
      "name": "Rating bar",
      "settings": [
        { "type": "text", "id": "label", "default": "5 stars", "label": "Label" },
        { "type": "range", "id": "percentage", "min": 0, "max": 100, "step": 5, "default": 80, "label": "Percentage" },
        { "type": "number", "id": "count", "default": 212, "label": "Count" },
        { "type": "color", "id": "bar_color", "default": "#00b67a", "label": "Color" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Stars" },
        { "type": "textarea", "id": "text", "default": "Great!", "label": "Text" },
        { "type": "text", "id": "author", "default": "John", "label": "Author" }
      ]
    }
  ],
  "presets": [
    { "name": "Trustpilot Reviews" }
  ]
}
{% endschema %}