<section class="mv-hero">
  <div class="mv-hero__slides" data-slider>

    {% for block in section.blocks %}
      <div class="mv-hero__slide {% if forloop.first %}is-active{% endif %}" data-slide>

        {% if block.settings.video != blank %}
          <video
            class="mv-hero__video"
            autoplay
            muted
            loop
            playsinline
          >
            <source src="{{ block.settings.video }}" type="video/mp4">
          </video>
        {% else %}
          {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'mv-hero__image' }}
        {% endif %}

        <div class="mv-hero__overlay"></div>

        <div class="mv-hero__content">
          <h2>{{ block.settings.heading }}</h2>
          <p>{{ block.settings.text }}</p>

          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link }}" class="mv-hero__btn">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>

      </div>
    {% endfor %}

  </div>

  <div class="mv-hero__dots">
    {% for block in section.blocks %}
      <button data-dot="{{ forloop.index0 }}"></button>
    {% endfor %}
  </div>
</section>

<style>
.mv-hero {
  position: relative;
  height: 90vh;
  overflow: hidden;
}

.mv-hero__slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity .6s ease;
}

.mv-hero__slide.is-active {
  opacity: 1;
}

.mv-hero__video,
.mv-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mv-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,.3), rgba(0,0,0,.6));
}

.mv-hero__content {
  position: absolute;
  bottom: 10%;
  left: 5%;
  color: white;
  max-width: 500px;
}

.mv-hero__content h2 {
  font-size: 60px;
  line-height: 1;
}

.mv-hero__btn {
  display: inline-block;
  margin-top: 20px;
  background: white;
  color: black;
  padding: 12px 20px;
  border-radius: 999px;
}

.mv-hero__dots {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
}

.mv-hero__dots button {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: white;
  opacity: .5;
}

.mv-hero__dots button.active {
  opacity: 1;
}

/* Mobile */
@media (max-width: 768px) {
  .mv-hero {
    height: 80vh;
  }

  .mv-hero__content h2 {
    font-size: 36px;
  }
}
</style>

<script>
(function(){
  const section = document.querySelector('.mv-hero');
  if (!section) return;

  const slides = section.querySelectorAll('[data-slide]');
  const dots = section.querySelectorAll('[data-dot]');
  let index = 0;

  function show(i){
    slides.forEach(s => s.classList.remove('is-active'));
    dots.forEach(d => d.classList.remove('active'));

    slides[i].classList.add('is-active');
    dots[i].classList.add('active');
    index = i;
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      show(parseInt(dot.dataset.dot));
    });
  });

  setInterval(() => {
    let next = (index + 1) % slides.length;
    show(next);
  }, 5000);
})();
</script>

{% schema %}
{
  "name": "Modern Video Hero",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "url", "id": "video", "label": "Video URL (mp4)" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modern Video Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}